{
  "name": "coinliqui",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/gen-assets.mjs && astro build",
    "preview": "astro preview",
    "gen:margin": "node --experimental-strip-types scripts/gen-margin-tables.ts",
    "build:worker": "esbuild worker/ingest.ts --bundle --format=esm --target=es2022 --outfile=worker-dist/ingest.bundle.js",
    "gen:lastmod": "node scripts/gen-lastmod.mjs",
    "gen:assets": "node scripts/gen-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cadence": "node scripts/cadence-check.mjs",
    "suites": "node scripts/blind-cases.mjs && node scripts/ingest-guard-cases.mjs && node scripts/watchlist-order.mjs && node scripts/watchlist-order.mjs --blind",
    "typecheck": "astro check",
    "check": "npm run typecheck && npm run build && npm run suites && node scripts/smoke.mjs --warm .wrangler/smoke",
    "apply": "node scripts/apply-edits.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
