---
import Base from "../../layouts/Base.astro";
import Overview from "../../components/Overview.astro";
import { getSnapshot, coldStart, findPerp, getLive, oldestStamp } from "../../lib/hyperliquid.ts";
import { usd, pct, paysClass, paysLabel, carryCost, LEGEND_PAYS } from "../../lib/funding.ts";
import { extremeBy } from "../../lib/extreme.ts";
import Spark from "../../components/Spark.astro";
import { readSparks, sparkScale, SPARK_POINTS, SPARK_STEP_MS } from "../../lib/sparks.ts";
import { COINS, isLive } from "../../lib/coins.ts";

import { priceDp } from "../../lib/funding.ts";
const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();
/* THE BASIS NEEDS BOTH PRICES ON ONE CLOCK, AND IT DID NOT HAVE THEM.
   The mark came from the 5-minute snapshot; spot comes from the KV `spot` key that the
   1-minute cron rewrites. Basis is a DIFFERENCE of two large, nearly-equal prices expressed
   in single-digit basis points, so any skew between the two clocks lands in the answer at
   full size. Measured across a cycle: worst error 11.1 bps against a signal of 3-20, and the
   SIGN inverted repeatedly — ADA -0.6 where the matched-clock value was +2.2, LINK +9.2 where
   it was -1.9. A reader was told the perpetual was cheaper than spot when it was richer.

   The site already had the matched-clock mark and was already using it in the wrong place:
   /api/live.json merges KV `live` over the snapshot, and interact.js recomputed the basis
   from that and silently overwrote the cell ~300ms after paint. So there were two values and
   only the wrong one was server-rendered — which is the only one an AI crawler ever sees, and
   the reason this could not be dismissed as a display nicety.

   `live` and `spot` are written by the same minute() pass (worker/ingest.ts:156,160), so
   preferring live.mark puts both halves of the subtraction on one clock. Falling back to the
   snapshot keeps a just-deployed page working, one clock slower, exactly as live.json does.

   AND SINCE 19 AUGUST THE CLIENT NO LONGER RECOMPUTES IT AT ALL. /api/live.json stopped
   carrying Coinbase spot — a licensing question resolved toward removal rather than waiting to
   be closed — the governing document is still unread after three HTTP 403s — see the note in that file — so the basis a reader sees is the server-rendered one
   for the life of the page, which is the value this comment argued for in the first place. The
   overlay freezes the mark alongside it rather than moving one half of a subtraction whose
   other half is pinned. */
const live = await getLive(env?.SNAPSHOT);
const markOf = (sym: string, fallback: number) => live?.mark?.[sym] ?? fallback;

const rows = COINS.map((c) => {
  const perp = findPerp(snap.perps, c.symbol);
  /* Hyperliquid's own published dollar turnover, not a price times a base volume. The old
     column multiplied a spot last by a spot base volume from another venue entirely; this is
     one number from one feed, and it is the same number the contract pages sort on. */
  const ntl = perp?.dayNtlVlm ?? NaN;
  return {
    ...c,
    live: isLive(c),
    perp,
    mark: perp ? markOf(c.symbol, perp.markPx) : NaN,
    chg: perp && perp.prevDayPx > 0 ? markOf(c.symbol, perp.markPx) / perp.prevDayPx - 1 : NaN,
    ntl,
    apr: perp?.venues.find((v) => v.venue === "HlPerp")?.apr ?? NaN,
  };
}).sort((a, b) => (b.ntl || 0) - (a.ntl || 0));

const pending = rows.filter((r) => !r.live);
const stripUp = snap.perps.filter((p) => Number.isFinite(p.change24h) && p.change24h > 0).length;
const stripDown = snap.perps.filter((p) => Number.isFinite(p.change24h) && p.change24h < 0).length;

/* THE STATED SITUATION. What this page claims to be for is "the thing a price table leaves out"
   — what the contract charges to hold the exposure — and a reader on a phone could not see that
   column at all: the table scrolled sideways and stopped after Coin, Mark and 24h change. The
   column moved left, and the cost it carries is said in words here before any table.

   IN MONEY, NOT ONLY IN PERCENT. "10.95% a year" is a rate a reader has to do arithmetic on;
   "about $21 a week per $10,000" is the same fact already spent. carryCost is the same function
   the calculators use, so this sentence and /tools/funding-cost cannot disagree. */
const priced = rows.filter((r) => Number.isFinite(r.apr));
const costing = priced.filter((r) => r.apr > 0).length;
const paying = priced.filter((r) => r.apr < 0).length;
const dearest = extremeBy(priced, (r) => r.apr, "max");
const bestPaid = extremeBy(priced, (r) => r.apr, "min");
const weekOn = (apr: number) => carryCost(10_000, apr, 7);

/* THE SHAPE COLUMN. One KV get; the scale is computed once over the ten series this table draws
   and shared by every row — see src/lib/sparks.ts for why a per-row axis makes the column
   decoration. Computed over THESE ten rather than over the whole map, because the axis has to
   describe the comparison a reader is actually making on this page. */
const sparks = await readSparks(env?.SNAPSHOT);
const sparkOf = (sym: string) => (sparks.status === "ready" ? sparks.map.series[sym] : undefined);
const sparkScaleAll = sparks.status === "ready"
  ? sparkScale(rows.map((r) => sparkOf(r.symbol)).filter((v): v is number[] => Array.isArray(v) && v.length > 1))
  : null;
const sparkDays = sparks.status === "ready"
  ? Math.max(1, Math.round((Math.min(sparks.covered, SPARK_POINTS) * SPARK_STEP_MS) / 86_400_000))
  : 0;
const dp = priceDp;
const arrow = (n: number) => (n >= 0 ? "▲" : "▼");
const fmtDate = (s: string) => new Date(s + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "UTC" });

const title = "Crypto perpetual prices, and what leverage costs on each";
const description = "Perpetual futures prices for the major coins on Hyperliquid, each next to its funding rate, 24-hour turnover and open interest — the cost of the position beside the price of the contract.";
---

<Base title={title} description={description} fetchedAt={oldestStamp(snap.fetchedAt, live?.at)}>
  <div class="page-head">
    <h1>Perpetual prices</h1>
    {/* THE ANSWER FIRST. The four-figure readout that stood here — coins covered, perpetuals,
        open interest, 24h breadth — is gone except for the breadth, which is the only one of the
        four that was a conclusion rather than a count. See src/components/Overview.astro. */}
    <Overview>
      Across the {snap.perps.length} perpetuals, <b>{stripUp} are up over 24 hours and {stripDown} are down</b>.
      {costing > 0 && <>{" "}Holding a <b>long costs money on {costing} of the {priced.length} coins below</b></>}
      {costing > 0 && paying > 0 && <> and is paid on {paying}</>}
      {costing === 0 && paying > 0 && <>{" "}A <b>long is paid on {paying} of the {priced.length} coins below</b></>}.
      {dearest.kind === "unique" && dearest.value > 0 && <>{" "}It is dearest on <b>{dearest.item.name}</b> at {pct(dearest.value)} a year &mdash; about <b>{usd(Math.abs(weekOn(dearest.value)), 0)}</b> a week per $10,000 held.</>}
      {dearest.kind === "tied" && dearest.value > 0 && <>{" "}{dearest.items.length} of them share the dearest rate, {pct(dearest.value)} a year &mdash; about {usd(Math.abs(weekOn(dearest.value)), 0)} a week per $10,000 held.</>}
      {bestPaid.kind === "unique" && bestPaid.value < 0 && <>{" "}On <b>{bestPaid.item.name}</b> it runs the other way: {paysLabel(bestPaid.value)}{" "}{pct(Math.abs(bestPaid.value))}.</>}
    </Overview>
    <p class="section-note" style="margin-top:12px">
      These are <strong>contract prices, not spot prices</strong> &mdash; the perpetual can trade
      above or below the coin, and the funding rate is the mechanism that pulls it back.
      Funding colour: {LEGEND_PAYS}.
      {sparkScaleAll && <> The <b>{sparkDays}-day shape</b> is Hyperliquid funding in four-hour means,
      on <b>one axis shared by every row</b> running &plusmn;{pct(sparkScaleAll.max)} a year, so a taller
      shape is a bigger move rather than a differently-scaled one.</>}
    </p>
  </div>

  <div class="panel">
    <table class="tbl" data-sortable>
      <thead>
        <tr>
          {/* FUNDING THIRD, NOT FIFTH. At 375px this table scrolls sideways and a reader sees
              three columns; measured on production those three were Coin, Mark and 24h change,
              so the column this page exists for — "the thing a price table leaves out" — was off
              screen behind a horizontal scroll with no affordance pointing at it. Ordering by
              what the page is for costs nothing on the desktop and is the whole difference on a
              phone. */}
          <th>Coin</th><th class="num">Mark</th><th class="num">Funding APR</th>
          {sparkScaleAll && <th class="spark-col">{sparkDays}d shape</th>}
          <th class="num">24h change</th><th class="num">24h volume</th><th class="num">Open interest</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="sym">
              {r.live ? <a href={`/coins/${r.slug}`}>{r.name}</a> : <span class="dim">{r.name}</span>}
              <span class="tick">{r.symbol}</span>
            </td>
            <td class="num" data-repaint="mark" data-sym={r.symbol} data-dp={Number.isFinite(r.mark) ? dp(r.mark) : 2}>
              {Number.isFinite(r.mark) ? usd(r.mark, dp(r.mark)) : "—"}
            </td>
            <td class:list={["num", Number.isFinite(r.apr) && paysClass(r.apr)]} style="font-weight:600">
              {Number.isFinite(r.apr) ? pct(r.apr) : "—"}
            </td>
            {sparkScaleAll && (
              <td class="spark-col">
                <Spark values={sparkOf(r.symbol)} scale={sparkScaleAll} symbol={r.symbol} days={sparkDays} />
              </td>
            )}
            {/* chgmark, not chg — see the note on the coin page hero. The spot kinds require a
                payload block that no longer exists, so this cell never repainted. */}
            <td class="num" data-repaint="chgmark" data-sym={r.symbol} data-prev={r.perp?.prevDayPx}>
              {Number.isFinite(r.chg) ? `${arrow(r.chg)} ${(Math.abs(r.chg) * 100).toFixed(2)}%` : "—"}
            </td>
            <td class="num">{Number.isFinite(r.ntl) ? usd(r.ntl) : "—"}</td>
            <td class="num">{r.perp ? usd(r.perp.oiNotional) : "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {/* THE LEGEND DEFINED A MARK THIS PAGE DOES NOT DRAW, AND DEFINED IT BACKWARDS. It read
      "▲ longs pay shorts · ▼ shorts pay longs" — but the only ▲▼ anywhere in this table come
      from `arrow(r.chg)` above, which is the 24-hour PRICE direction. So a reader looking at
      Ethereum's "▼ 0.63%" beside a funding APR of +10.95% was told by the line underneath that
      the ▼ meant shorts pay longs, when it meant price fell and funding was the other way.

      src/lib/funding.ts:160 records this exact prohibition: LEGEND_PAYS is kept arrow-free
      because "folding the arrows into that sentence would have them describe a mark those pages
      do not use". This page hand-rolled the arrow-bearing wording instead of importing either
      constant, which is how it acquired the arrows the library had deliberately removed. It
      takes the shared constant now, and names what the arrows on THIS page actually are. */}
  <p class="legend" style="margin-top:10px">
    Funding APR colour: {LEGEND_PAYS}. The ▲▼ in the 24-hour change column are price direction,
    not funding.
  </p>

  {pending.length > 0 && (
    <div class="verdict verdict--ok">
      <div>
        <b>{pending.length} of these open on {fmtDate(pending[0].publishAt)}.</b> This site publishes
        no more than 25–30 new pages a week. The
        remaining coins are listed here with live figures but have no page yet — the limit is
        enforced by the code that builds the sitemap, not by anyone remembering it.
      </div>
    </div>
  )}

  <h2 class="section">Why this is a perpetual price, not a spot price</h2>
  <p class="prose">
    Until 19 August 2026 this page led with a <strong>spot</strong> price from a third-party
    exchange, and printed the basis between that price and the perpetual. Both are gone. The terms
    governing that exchange's market data were read in full on that date and forbid displaying the
    data, or anything derived from it, to anyone outside your own organisation. It was removed
    rather than kept while the question was argued.
  </p>
  <p class="prose">
    What is here instead is Hyperliquid's own perpetual mark, from the same feed as the funding
    and the open interest beside it. That is a real traded contract price, and it is the honest
    label for it: a perpetual future on the coin, not the coin. Hyperliquid has no meaningful
    spot market to substitute — its spot book is HIP-1 tokens and bridged wrappers — and its
    oracle price is a validator median across venues, an index nobody can trade, so neither is
    presented as a spot price here.
  </p>
  <p class="prose">
    The consequence worth stating: <strong>the basis is gone from this site.</strong> It was the
    gap between the perpetual and the underlying, and computing it needs a spot price there is no
    longer a defensible way to publish. Nothing approximates it against the oracle, because that
    would be a different number wearing the old one's name.
    {" "}<a class="link" href="/data-sources">Data sources</a> lists every endpoint behind every
    figure here.
  </p>

  <style>
    .tick { color: var(--text-faint); font-weight: 400; margin-left: 8px; font-size: 12px; }
    .tbl td.sym a { font-weight: 600; }
  </style>
</Base>
