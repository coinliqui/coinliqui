---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, findPerp, getLive, oldestStamp } from "../../lib/hyperliquid.ts";
import { usd, pct, paysClass } from "../../lib/funding.ts";
import { COINS, isLive, getSpot, basisBps, SPOT_SOURCE } from "../../lib/coins.ts";

const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();
const spotSet = await getSpot(env?.SNAPSHOT, import.meta.env.DEV);
/* THE BASIS NEEDS BOTH PRICES ON ONE CLOCK, AND IT DID NOT HAVE THEM.
   The mark came from the 5-minute snapshot; spot comes from the KV `spot` key that the
   1-minute cron rewrites. Basis is a DIFFERENCE of two large, nearly-equal prices expressed
   in single-digit basis points, so any skew between the two clocks lands in the answer at
   full size. Measured across a cycle: worst error 11.1 bps against a signal of 3-20, and the
   SIGN inverted repeatedly — ADA -0.6 where the matched-clock value was +2.2, LINK +9.2 where
   it was -1.9. A reader was told the perpetual was cheaper than spot when it was richer.

   The site already had the matched-clock mark and was already using it in the wrong place:
   /api/live.json merges KV `live` over the snapshot, and interact.js recomputed the basis
   from that and silently overwrote the cell ~300ms after paint. So there were two values and
   only the wrong one was server-rendered — which is the only one an AI crawler ever sees, and
   the reason this could not be dismissed as a display nicety.

   `live` and `spot` are written by the same minute() pass (worker/ingest.ts:156,160), so
   preferring live.mark puts both halves of the subtraction on one clock. Falling back to the
   snapshot keeps a just-deployed page working, one clock slower, exactly as live.json does.

   AND SINCE 19 AUGUST THE CLIENT NO LONGER RECOMPUTES IT AT ALL. /api/live.json stopped
   carrying Coinbase spot — a licensing question resolved toward removal rather than waiting to
   be closed, see the note in that file — so the basis a reader sees is the server-rendered one
   for the life of the page, which is the value this comment argued for in the first place. The
   overlay freezes the mark alongside it rather than moving one half of a subtraction whose
   other half is pinned. */
const live = await getLive(env?.SNAPSHOT);
const markOf = (sym: string, fallback: number) => live?.mark?.[sym] ?? fallback;

const rows = COINS.map((c) => {
  const q = spotSet?.q[c.symbol] ?? null;
  const perp = findPerp(snap.perps, c.symbol);
  const ntl = q ? q.last * q.volume24h : NaN;
  return {
    ...c,
    live: isLive(c),
    q,
    perp,
    chg: q && q.open24h > 0 ? q.last / q.open24h - 1 : NaN,
    basis: perp && q ? basisBps(markOf(c.symbol, perp.markPx), q.last) : NaN,
    ntl,
    apr: perp?.venues.find((v) => v.venue === "HlPerp")?.apr ?? NaN,
  };
}).sort((a, b) => (b.ntl || 0) - (a.ntl || 0));

const pending = rows.filter((r) => !r.live);
const dp = (v: number) => (v >= 100 ? 2 : v >= 1 ? 3 : v >= 0.01 ? 5 : 7);
const arrow = (n: number) => (n >= 0 ? "▲" : "▼");
const fmtDate = (s: string) => new Date(s + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "UTC" });

const title = "Crypto coin prices, and what leverage costs on each";
const description = `Spot prices for the major coins from ${SPOT_SOURCE}, each next to its perpetual basis, funding rate and open interest — the cost of the position beside the price of the asset.`;
---

<Base title={title} description={description} fetchedAt={oldestStamp(snap.fetchedAt, spotSet?.at, live?.at)}>
  <div class="page-head">
    <h1>Coin prices</h1>
    <p>
      Spot prices from <strong>{SPOT_SOURCE}</strong> — a real USD order book, not an index — each
      beside the thing a price table leaves out: what the perpetual is charging to hold the same
      exposure. The <strong>basis</strong> is how far the perpetual trades from spot; the funding
      rate is what pulls it back, and what it costs you while it does.
    </p>
  </div>

  <div class="panel">
    <table class="tbl">
      <thead>
        <tr>
          <th>Coin</th><th class="num">Spot</th><th class="num">24h change</th><th class="num">24h volume</th>
          <th class="num">Basis (bps)</th><th class="num">Funding APR</th><th class="num">Open interest</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="sym">
              {r.live ? <a href={`/coins/${r.slug}`}>{r.name}</a> : <span class="dim">{r.name}</span>}
              <span class="tick">{r.symbol}</span>
            </td>
            <td class="num" data-spot="last" data-sym={r.symbol} data-dp={r.q ? dp(r.q.last) : 2}>
              {r.q ? usd(r.q.last, dp(r.q.last)) : "—"}
            </td>
            <td class="num" data-spot="chg" data-sym={r.symbol}>
              {Number.isFinite(r.chg) ? `${arrow(r.chg)} ${(Math.abs(r.chg) * 100).toFixed(2)}%` : "—"}
            </td>
            <td class="num">{Number.isFinite(r.ntl) ? usd(r.ntl) : "—"}</td>
            <td class="num" data-spot="basis" data-sym={r.symbol}>
              {Number.isFinite(r.basis) ? `${r.basis >= 0 ? "+" : ""}${r.basis.toFixed(1)}` : "—"}
            </td>
            <td class:list={["num", Number.isFinite(r.apr) && paysClass(r.apr)]} style="font-weight:600">
              {Number.isFinite(r.apr) ? pct(r.apr) : "—"}
            </td>
            <td class="num">{r.perp ? usd(r.perp.oiNotional) : "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="legend" style="margin-top:10px">
    Basis in basis points: positive means the perpetual is richer than spot. ▲ longs pay shorts ·
    ▼ shorts pay longs — colour encodes the direction of the funding payment only, never price.
  </p>

  {pending.length > 0 && (
    <div class="verdict verdict--ok">
      <div>
        <b>{pending.length} of these open on {fmtDate(pending[0].publishAt)}.</b> This site publishes
        no more than 25–30 new pages a week. The
        remaining coins are listed here with live figures but have no page yet — the limit is
        enforced by the code that builds the sitemap, not by anyone remembering it.
      </div>
    </div>
  )}

  <h2 class="section">Why the price here is Coinbase</h2>
  <p class="prose">
    A "coin price" should be a <strong>traded spot price</strong>, and the honest sources are
    fewer than they look. Hyperliquid — which supplies everything else on this site — has no
    Bitcoin spot market at all: its spot book is HIP-1 tokens and bridged wrappers turning over
    about $60M a day in total, so a price from there would not be Bitcoin's.
  </p>
  <p class="prose">
    Binance and Bybit are unreachable from this site's servers. OKX is reachable but its API
    agreement forbids displaying the data, so it is never shown or credited here. CoinGecko's free
    tier is non-commercial. <strong>{SPOT_SOURCE}</strong> is a real USD order book, free, without
    a key, permits display with attribution, and covers every coin listed above — so that is what
    these prices are, and they are labelled as such everywhere they appear.
  </p>
  <p class="prose">
    Hyperliquid also publishes an <strong>oracle price</strong>, a median across major spot venues.
    It is a good index but nobody can trade it, so it is not used as the headline. Where the two
    disagree, the difference is venue composition — Coinbase is one US venue, the oracle is a
    global median.
  </p>

  <style>
    .tick { color: var(--text-faint); font-weight: 400; margin-left: 8px; font-size: 12px; }
    .tbl td.sym a { font-weight: 600; }
  </style>
</Base>
