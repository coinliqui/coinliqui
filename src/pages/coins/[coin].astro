---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, findPerp, getLive, oldestStamp } from "../../lib/hyperliquid.ts";
import { usd, pct, VENUE_LABEL, paysClass, paysLabel, carryCost, type Venue } from "../../lib/funding.ts";
import { findCoin, isLive, liveCoins } from "../../lib/coins.ts";
import { liqMapHref } from "../../lib/routes.ts";
import { getCandles, getHourly, getM15 } from "../../lib/candles.ts";
import { freshness, ageWords, minutesSince } from "../../lib/freshness.ts";
import { TIMEFRAMES, DEFAULT_TF, MIN_CHART_BARS, aggregate, buildPriceChart, CHART_H, type ChartMode } from "../../lib/series.ts";
import { CH } from "../../lib/chart.ts";

import { priceDp } from "../../lib/funding.ts";
/* =========================================================================================
   ONE COIN.

   WHY THIS IS NOT /funding/{symbol} IN A HAT. That page answers a derivatives question: what
   is the funding, on which venue, against which margin tiers. This one answers the question
   people actually type — "bitcoin price" — and then earns the visit by putting next to that
   price the thing no price page has: what it costs to hold the position instead of the coin.

   THIS WAS A SPOT PAGE UNTIL 19 AUGUST 2026 and it is now a PERPETUAL page. Every figure came
   from Coinbase Exchange; its Market Data Terms (https://www.coinbase.com/legal/market_data,
   last updated 2026-08-07) were read in full that day and forbid displaying the data or anything
   derived from it. See the header of src/lib/coins.ts for the clauses. So the
   price here is the Hyperliquid perpetual mark, the chart is Hyperliquid's own candles, and the
   24-hour figures come from the same series.

   THE BASIS DIED WITH SPOT and is not faked. It was the gap between the perpetual and the
   underlying, and computing it needs a spot price this site no longer has any defensible way to
   publish. Nothing here approximates it from the oracle: Hyperliquid's oraclePx is a validator
   median across venues, it is an index nobody can trade, and printing a "basis" against it
   would be a different number wearing the old one's name.

   WHAT THE CHANGE BOUGHT: the perpetual series carries 15-minute bars. The 15m and 30m
   timeframes work on these pages now; spot never had a series that could serve them.
   ========================================================================================= */

const env = (Astro.locals as any)?.runtime?.env;
const coin = findCoin(Astro.params.coin);
/* ONE URL PER COIN, the same answer /funding/[symbol] already gives.
   findCoin() lowercases its argument, so /coins/BITCOIN and /coins/Bitcoin both resolved and
   rendered — and because the canonical tag is built from the REQUESTED pathname, each declared
   ITSELF canonical. That is a duplicate-content split across every coin page, and a canonical
   tag cannot fix it when both copies are self-referencing. The sibling template has had the
   301 since the trailing-slash work; this one was simply never given it. */
if (coin && Astro.params.coin !== coin.slug) {
  return new Response(null, {
    status: 301,
    headers: { location: `/coins/${coin.slug}`, "cache-control": "public, max-age=86400" },
  });
}
// Staged publication: a coin that has not reached its date has no URL yet. See COINS.
if (!coin || !isLive(coin)) return Astro.rewrite(`/404?symbol=${encodeURIComponent(Astro.params.coin ?? "")}`);

const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

/* `live` IS FETCHED WITH THE CANDLES, not after the figures are computed. It used to be awaited
   forty lines below, which meant `price` and `chg24` were derived from the five-minute snapshot
   while the one-minute value was fetched, assigned to `markNow`, and then used by nothing at all.
   The headline price on ten pages was up to five minutes staler than the value already in hand.
   Introduced when this page was re-based off spot: the old line read `q?.last`, and replacing it
   with `perp?.markPx` looked right and skipped the faster clock. */
const [dayset, hourset, m15set, live] = await Promise.all([
  getCandles(env?.SNAPSHOT, coin.symbol, import.meta.env.DEV),
  getHourly(env?.SNAPSHOT, coin.symbol, import.meta.env.DEV),
  getM15(env?.SNAPSHOT, coin.symbol, import.meta.env.DEV),
  getLive(env?.SNAPSHOT),
]);
const perp = findPerp(snap.perps, coin.symbol);

/* THE ONE CLOCK THAT MATTERS HERE. `live` is written by the one-minute cron; the snapshot is
   five-minutely. Preferring live.mark puts the headline price and the funding beside it on the
   same tick, and the fallback keeps a just-deployed page working one clock slower. */
const markNow = live?.mark?.[coin.symbol] ?? perp?.markPx ?? NaN;
const price = markNow;
const dp = priceDp(price);
const px = (v: number) => usd(v, dp);
/* 24h CHANGE AGAINST THE VENUE'S OWN PREVIOUS-DAY PRICE — but against the LIVE mark, not the
   snapshot's. Both halves on one clock is the same rule the basis used to need, and it outlived
   the basis: a numerator five minutes older than the page's own headline price would make this
   percentage disagree with the number printed directly above it. */
const chg24 = perp && perp.prevDayPx > 0 && Number.isFinite(markNow) ? markNow / perp.prevDayPx - 1 : NaN;
/* 24h HIGH AND LOW COME FROM THE HOURLY SERIES, because the snapshot does not carry them. The
   last 24 closed hourly bars of the same Hyperliquid feed the chart is drawn from, so the
   figures beside the chart and the figures in it cannot disagree. */
const last24 = (hourset?.d ?? []).slice(-24);
const high24 = last24.length ? Math.max(...last24.map((c) => c[2])) : NaN;
const low24 = last24.length ? Math.min(...last24.map((c) => c[3])) : NaN;
/* 24h VOLUME IS HYPERLIQUID'S OWN NOTIONAL, already in USD on the snapshot. The old figure was
   spot base-units times the spot price; this one is the venue's published dollar turnover, so
   the open-interest ratio beneath it is now perp OI against perp volume — the same market on
   both sides of the fraction, which the old ratio never was. */
/* WHEN THE HOURLY STORE WAS LAST WRITTEN, so the sentence beside the 24-hour high and low can
   name their real clock instead of borrowing the snapshot's. */
const hourAge = hourset?.u ? Math.max(0, Math.round((Date.now() - hourset.u) / 60000)) : null;
const perpNtl = perp?.dayNtlVlm ?? NaN;
const oiToVol = perp && Number.isFinite(perpNtl) && perpNtl > 0 ? perp.oiNotional / perpNtl : NaN;

const ORDER: Venue[] = ["HlPerp", "BinPerp", "BybitPerp"];
const by = new Map((perp?.venues ?? []).map((v) => [v.venue, v]));
const hl = by.get("HlPerp");
/** What a $10,000 leveraged long pays (or receives) in a week, at the current rate. */
const week = (apr: number) => carryCost(10_000, apr, 7);

/* --- the chart: two modes, four timeframes, all server-rendered ------------------------
   The mode is a GET parameter and the switch is a submit button, exactly like the timeframe
   control: crawlers never submit forms, so one coin stays one URL. Both modes for all four
   timeframes are rendered up front — a line panel is a single polyline and costs almost
   nothing next to 300 candle bodies — so switching either mode or timeframe is instant, works
   with JavaScript disabled, and cannot shift the layout. */
const MODES: { key: ChartMode; label: string }[] = [{ key: "candle", label: "Candles" }, { key: "line", label: "Line" }];
const qs = Astro.url.searchParams;
const tfKey = TIMEFRAMES.some((t) => t.key === qs.get("tf")) ? qs.get("tf")! : DEFAULT_TF;
const modeKey: ChartMode = qs.get("view") === "line" ? "line" : "candle";

/* ONE PANEL, for the same reason as the contract page — and here it matters more, because this
   template multiplies: six timeframes times two chart styles is TWELVE renders of the same
   series to show one. Availability is a length check on the base series, not a built chart. */
/* THREE BASES NOW, WHERE SPOT COULD ONLY OFFER TWO. The note that stood here explained why the
   m15 timeframes had to resolve to `undefined` — spot had no fifteen-minute series, and a
   two-armed ternary would have aggregated daily bars as though they were fifteen-minute ones and
   drawn a chart that is wrong rather than absent. The perpetual series has all three, so 15m and
   30m are real here for the first time. The shape of the guard is kept: a base that is missing
   still resolves to undefined and drops its buttons off the bar, because a timeframe whose data
   has not arrived must be absent rather than approximated. */
const baseFor = (tf: (typeof TIMEFRAMES)[number]) =>
  (tf.base === "m15" ? m15set?.d : tf.base === "hour" ? hourset?.d : dayset?.d);
/* Same correction as the contract template: the test is on the aggregated bar count, because
   that is what gets drawn. See MIN_CHART_BARS in src/lib/series.ts. */
const barsFor = (tf: (typeof TIMEFRAMES)[number]) => {
  const b = baseFor(tf);
  return b ? aggregate(b, tf.factor).slice(-tf.bars).length : 0;
};
const tfsAvailable = TIMEFRAMES.filter((tf) => barsFor(tf) >= MIN_CHART_BARS).map((tf) => tf.key);
const missingTf = TIMEFRAMES.filter((tf) => !tfsAvailable.includes(tf.key)).map((tf) => tf.label);
const activeTf = TIMEFRAMES.find((tf) => tf.key === tfKey && tfsAvailable.includes(tf.key))
  ?? TIMEFRAMES.find((tf) => tfsAvailable.includes(tf.key));
const activeMode = MODES.find((m) => m.key === modeKey) ?? MODES[0];
const activeChart = activeTf
  ? buildPriceChart(aggregate(baseFor(activeTf)!, activeTf.factor).slice(-activeTf.bars), null, activeTf, activeMode.key)
  : null;
const active = activeTf && activeChart ? { tf: activeTf, mode: activeMode, chart: activeChart } : null;
const panels = active ? [active] : [];
const hasChart = Boolean(active);
/* A CHAIN OF TERNARIES ENDING IN "weekly bars" IS A DEFAULT THAT LIES. Adding 12H and 1M made
   it say "over 90 weekly bars" on the 12-hour panel — rendered, on the live page, because a
   fall-through default answers confidently for any key it has never heard of. A lookup with an
   explicit fallback to the timeframe's own label cannot invent a unit it was not given. */
const SPAN: Record<string, string> = {
  "1h": "hourly bars", "4h": "4-hour bars", "12h": "12-hour bars",
  "1d": "daily bars", "1w": "weekly bars", "1m": "monthly bars",
};
const span = (k: string) => SPAN[k] ?? `${(TIMEFRAMES.find((t) => t.key === k)?.label ?? k)} bars`;
const arrow = (n: number) => (n >= 0 ? "▲" : "▼");
/* Stats are lifted from the fetched document now, not precomputed per panel. */
const stat = (_fn: (p: NonNullable<typeof active>) => string) => ({});

/* THE SENTENCE IS CONDITIONAL NOW — see src/lib/freshness.ts. It used to assert "update every
   minute" whatever the clocks said, which is a promise a single-sourced site cannot keep on its
   own word. */
const fresh = freshness(live?.at, snap.fetchedAt,
  "The mark and the funding update every minute.", "The mark and the funding");

const others = liveCoins().filter((c) => c.slug !== coin.slug);
const title = `${coin.name} price — ${coin.symbol} perpetual, and what leverage costs`;
const description = `Live ${coin.name} (${coin.symbol}) perpetual price from Hyperliquid, with the funding rate across three venues, open interest, and what holding a leveraged position actually costs per week.`;
---

<Base title={title} description={description} fetchedAt={oldestStamp(snap.fetchedAt, live?.at)} crumb={{ href: "/coins", label: "Coins", current: coin.name }}>
  <div class="page-head">
    <p class="crumb"><a href="/coins">Coins</a> › {coin.name}</p>
    <h1>{coin.name} price</h1>
    <p>{coin.blurb}</p>
  </div>

  {/* A PUBLISHED COIN WHOSE CONTRACT IS NOT IN THE SNAPSHOT. Coverage is gated on a publication
      date and an open-interest floor, so a contract that falls below the floor, is delisted, or
      simply stops appearing in Hyperliquid's response leaves this page rendering "—" in every
      slot with a title that still promises a price. That is a page saying nothing while looking
      like a page saying something, and it is indexed. It now says which it is. */}
  {!perp && (
    <div class="verdict verdict--warn">
      <div>
        <b>{coin.symbol} is not in the current snapshot.</b> The perpetual is either below this
        site's coverage floor or not being returned by the venue right now, so the figures below
        are unavailable rather than zero. Nothing here is an assertion about the market.
      </div>
    </div>
  )}

  <div class="hero">
    {/* `mark` AND `chgmark`, NOT `last` AND `chg`. These carried the spot kinds until the page was
        re-based onto the perpetual, and the attribute names are a contract with interact.js: the
        spot branches require a `spot` block that /api/live.json no longer sends, so the overlay
        went inert here — price, change, mark and the page clock all frozen — while /funding
        pages, which already used `mark`, kept updating. Nothing in the markup looked wrong and no
        check reads overlay behaviour; it was found by watching a live page for two pulls. */}
    <span class="hero__price" data-repaint="mark" data-sym={coin.symbol} data-dp={dp}>{Number.isFinite(price) ? px(price) : "—"}</span>
    <span class:list={["hero__chg"]} data-repaint="chgmark" data-sym={coin.symbol} data-prev={perp?.prevDayPx}>
      {Number.isFinite(chg24) ? `${arrow(chg24)} ${(Math.abs(chg24) * 100).toFixed(2)}%` : "—"}
    </span>
    <span class="hero__span">24-hour change · Hyperliquid perpetual</span>
  </div>

  <div class="hero__meta">
    <div>24h high<b>{Number.isFinite(high24) ? px(high24) : "—"}</b></div>
    <div>24h low<b>{Number.isFinite(low24) ? px(low24) : "—"}</b></div>
    <div>24h volume<b>{Number.isFinite(perpNtl) ? usd(perpNtl) : "—"}</b></div>
    <div>Oracle index <span class="scope">Hyperliquid</span><b>{perp && perp.oraclePx > 0 ? px(perp.oraclePx) : "—"}</b></div>
    <div>Open interest <span class="scope">Hyperliquid</span><b>{perp ? usd(perp.oiNotional) : "—"}</b></div>
  </div>
  {/* THREE CLOCKS, NOT TWO — the same correction the contract template already carries, which
      had never been applied here. This sentence put "the 24-hour figures and open interest" on
      one clock, the five-minute snapshot. Open interest and 24-hour volume do come from there.
      The 24-hour HIGH and LOW do not: they are the extremes of the last 24 closed bars of the
      hourly candle store, swept every two hours, so this page could print "taken 2 min ago"
      over a low that was set up to two hours before the last sweep and had not been collected
      yet. The figures were right; the sentence explaining where they came from was not, on a
      template whose whole argument is that it names its sources. */}
  <p class="clock">
    {fresh.note} Open interest and 24-hour volume come from the snapshot taken
    <b><time data-fresh={snap.fetchedAt} data-clock="snapAt">{ageWords(minutesSince(snap.fetchedAt))}</time></b>.
    The 24-hour high and low are the extremes of the last 24 closed hourly bars, read from the
    same candle series the chart is drawn from, collected every 2 hours{hourAge !== null ? <> and last written <b>{hourAge} min ago</b></> : null}.
  </p>

  {hasChart ? (
    <>
      <form method="GET" class="tfbar" data-tfgroup="cx">
        <div class="tf" role="group" aria-label="Chart timeframe">
          {TIMEFRAMES.filter((t) => tfsAvailable.includes(t.key)).map((tf) => (
            <button type="submit" name="tf" value={tf.key} data-tf={tf.key} aria-pressed={tf.key === active!.tf.key}>{tf.label}</button>
          ))}
          <input type="hidden" name="view" value={modeKey} data-tfcarry="view" />
        </div>
        <div class="tf" role="group" aria-label="Chart style">
          {MODES.map((m) => (
            <button type="submit" name="view" value={m.key} data-mode={m.key} aria-pressed={m.key === active!.mode.key}>{m.label}</button>
          ))}
          <input type="hidden" name="tf" value={active!.tf.key} data-tfcarry="tf" />
        </div>
        <span class="tfbar__note">
          Hyperliquid perpetual candles — the traded contract, not the oracle index.
          {/* A GAP MUST BE STATED, NOT INFERRED FROM A MISSING BUTTON. The contract template has
              said this since its button bar was fixed; this one dropped timeframes silently, so a
              reader looking for a monthly view on a young contract found no button and no reason.
              Both pages now name what is absent and why. */}
          {missingTf.length > 0 && (
            <> {missingTf.join(" and ")}{" "}{missingTf.length === 1 ? "is" : "are"} not offered: there is not
            yet enough history to draw {missingTf.length === 1 ? "it" : "them"} — fewer than {MIN_CHART_BARS} bars
            at that size.</>
          )}
        </span>
      </form>

      {[active!].map(({ tf, mode, chart }) => (
        <div data-tfpanel={`${tf.key}.${mode.key}`} data-group="cx"
             data-on={tf.key === active!.tf.key && mode.key === active!.mode.key ? "" : undefined}
             class="chart chart--price" style={`--chartRatio: ${CH.w} / ${CHART_H}`}>
          <Fragment set:html={chart!.svg.replace("<svg ",
            `<svg data-xhair="cpts-${tf.key}" data-feed="mark" data-plot="${chart!.plot.join(",")}" data-prange="${chart!.range[0]},${chart!.range[1]}" ` +
            `data-axx="${chart!.axisX}" data-slot="${chart!.slot.toFixed(2)}" data-taxisy="${CHART_H - 27}" data-unit="${coin.symbol}" data-dp="${chart!.dp}" data-intraday="${tf.hours < 24 ? 1 : 0}" `)} />
          {/* INSIDE THE PANEL, because only the panel is fetched.
              public/interact.js copies `[data-tfpanel][data-group]` out of the response and
              nothing else. This block sat NEXT to the panel, so switching a timeframe on a coin
              page brought the chart across and left its crosshair payload behind: the new svg
              asked for `cpts-4h` and the document still held only `cpts-1d`. The tooltip then
              failed silently — getElementById returns null, JSON.parse throws, the handler
              returns. Measured on the live page: after switching, jsonIds was still `cpts-1d`.
              The contract template already had it inside, which is why only this one broke. */}
          <script type="application/json" id={`cpts-${tf.key}`}
                  set:html={JSON.stringify(chart!.points)} />
        </div>
      ))}

      <p class="legend">
        Period high <b data-tfstat="high" data-group="cx" {...stat((p) => px(p.chart!.high))}>{px(active!.chart!.high)}</b>,
        low <b data-tfstat="low" data-group="cx" {...stat((p) => px(p.chart!.low))}>{px(active!.chart!.low)}</b>,
        over <b data-tfstat="bars" data-group="cx" {...stat((p) => `${p.chart!.bars} ${span(p.tf.key)}`)}>{active!.chart!.bars} {span(active!.tf.key)}</b>.
        Candles are green for up and red for down, with the up candles hollow so direction reads
        without relying on colour. No funding band here — funding is a property of the perpetual,
        not of spot, and it has
        {" "}<a class="link" href={`/funding/${coin.symbol.toLowerCase()}`}>its own chart</a>.
      </p>
    </>
  ) : (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">Candles not collected yet</p>
        <p class="empty__text">Hyperliquid candles are refreshed every two hours, and a series that is missing entirely is filled on the next five-minute tick rather than waiting for that. Every figure above and below is unaffected.</p>
      </div>
    </div>
  )}

  {/* THIS HEADING SAID "Spot against the perpetual" AND THE SECTION HAD NO SPOT IN IT. The cards
      beneath were re-based when Coinbase was removed and the heading above them was not — a
      survival of the old premise, live on ten indexed pages, found by listing the headings of
      the two page families side by side rather than by reading the file. The lesson is the one
      the uncited-claims sweep already taught: a sentence deleted in one place has copies, and
      the copies are not always sentences. */}
  <h2 class="section">What the position costs</h2>
  <p class="section-note">
    The number a price page usually leaves out. A perpetual has no expiry, so nothing pulls it
    back toward the underlying except the funding payment — which means the rate is not a fee on
    the side, it is the mechanism, and it is what holding this exposure actually costs.
  </p>
  <div class="cards">
    {/* THIS CARD WAS THE BASIS and there is deliberately nothing in its place pretending to be
        it. The nearest available number is the mark against Hyperliquid's oraclePx, and that is
        a different quantity: an index median across venues rather than a traded underlying.
        Printing it under the old label would have kept the card and lost the meaning. */}
    <div class="card card--lead">
      <div class="card__label">Open interest <span class="card__scope">Hyperliquid</span></div>
      <div class="card__value">{perp ? usd(perp.oiNotional) : "—"}</div>
      <div class="card__meta">notional currently open</div>
    </div>
    <div class="card">
      <div class="card__label">Hyperliquid funding</div>
      <div class:list={["card__value", hl && paysClass(hl.apr)]}>{hl ? pct(hl.apr) : "—"}</div>
      <div class="card__meta">{hl ? paysLabel(hl.apr) : "—"}</div>
    </div>
    <div class="card">
      <div class="card__label">Cost to hold $10,000 long</div>
      <div class="card__value" data-repaint={hl ? "carry" : undefined} data-sym={coin.symbol} data-venue="HlPerp"
           data-notional="10000" data-days="7">{hl ? usd(Math.abs(week(hl.apr)), 2) : "—"}</div>
      <div class="card__meta">{hl ? `per week · ${hl.apr >= 0 ? "you pay" : "you receive"}` : "—"}</div>
    </div>
    <div class="card">
      <div class="card__label">Open interest ÷ 24h volume <span class="card__scope">Hyperliquid</span></div>
      <div class="card__value">{Number.isFinite(oiToVol) ? `${oiToVol.toFixed(2)}×` : "—"}</div>
      <div class="card__meta">how long the open book takes to turn over</div>
    </div>
  </div>

  <h2 class="section">What leverage costs, per venue</h2>
  <p class="section-note">
    Each venue settles funding on its own interval, so the quoted numbers are not comparable to
    each other. The weekly column is, because it is the same $10,000 position on all three.
  </p>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Venue</th><th class="num">Interval</th><th class="num">Annualised</th><th class="num">$10,000 long, per week</th><th>Direction</th></tr></thead>
      <tbody>
        {ORDER.map((v) => {
          const f = by.get(v);
          const ok = f && Number.isFinite(f.apr);
          return (
            <tr>
              <td>{VENUE_LABEL[v]}</td>
              <td class="num">{f && Number.isFinite(f.intervalHours) ? `${f.intervalHours}h` : <span class="faint">—</span>}</td>
              <td class:list={["num", ok && paysClass(f!.apr)]} style="font-weight:600"
                  data-repaint={ok ? "apr" : undefined} data-sym={coin.symbol} data-venue={v}>{ok ? pct(f!.apr) : "—"}</td>
              {/* Both cells are DERIVED FROM THE SAME f.apr the cell before them carries, so
                  they must be repainted with it or the row contradicts itself one minute after
                  load. notional and days travel as attributes so the overlay applies this
                  page's rule rather than carrying its own copy of it. */}
              <td class="num" data-repaint={ok ? "carry" : undefined} data-sym={coin.symbol} data-venue={v}
                  data-notional="10000" data-days="7">{ok ? usd(Math.abs(week(f!.apr)), 2) : "—"}</td>
              <td data-repaint={ok ? "dir" : undefined} data-sym={coin.symbol} data-venue={v}
                  data-pay="longs pay" data-recv="longs receive">{ok ? (f!.apr >= 0 ? "longs pay" : "longs receive") : <span class="faint">—</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <h2 class="section">Where the numbers come from</h2>
  <p class="prose">
    Every figure on this page is <strong>Hyperliquid</strong>: the mark price, the 24-hour
    figures, the candles, the funding and the open interest, all from the same feed the rest of
    the site reads. This is a perpetual futures price, not a spot price — the contract, not the
    coin — and the two can diverge.
  </p>
  <p class="prose">
    Until 19 August 2026 this page led with a spot price from a third-party exchange, and showed
    the basis between that price and the perpetual. Both are gone: the terms governing that data
    forbid displaying it or anything derived from it, so it was removed rather than kept while
    the question was argued. <a class="link" href="/data-sources">Data sources</a> lists every
    endpoint behind every number here, and what is deliberately absent.
  </p>

  <p style="margin-top:24px">
    <a class="link" href={`/funding/${coin.symbol.toLowerCase()}`}>{coin.symbol} funding across three venues →</a>
    · <a class="link" href={liqMapHref(coin.symbol)}>Where {coin.symbol} leverage breaks →</a>
    · <a class="link" href={`/liquidations/survival?symbol=${coin.symbol}`}>What the rules did to past positions →</a>
  </p>

  <h2 class="section">Other coins</h2>
  <p class="related">
    {others.map((c) => <a class="chip-link" href={`/coins/${c.slug}`}>{c.name}</a>)}
  </p>

  <style>
    .hero__span { font-size: var(--fs-sm); color: var(--text-faint); }
    .tfbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: var(--inset-panel) 0 var(--gap-block); }
    .tfbar__note { font-size: var(--fs-xs); color: var(--text-faint); }
    .chart--price :global(svg) { aspect-ratio: var(--chartRatio); }
    .legend { max-width: 88ch; line-height: 1.6; margin-top: 12px; }
    .related { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
    .chip-link {
      display: inline-block; padding: var(--gap-pair) var(--gap-cluster); border-radius: var(--r-pill);
      background: var(--surface-2); border: 1px solid var(--border-soft);
      text-decoration: none; font-size: 13px; font-weight: 500;
      transition: background .14s var(--ease), color .14s var(--ease);
    }
    .chip-link:hover { background: var(--surface-3); color: var(--accent); }
    /* The live layer only ever changes the TEXT of these, never their box. */
    [data-repaint] { transition: color .35s var(--ease); }
    [data-repaint][data-moved="up"] { color: var(--accent); }
    [data-repaint][data-moved="down"] { color: var(--accent); }
    @media (max-width: 700px) { .hero__meta { gap: var(--gap-cluster) 20px; } }
  </style>
</Base>
