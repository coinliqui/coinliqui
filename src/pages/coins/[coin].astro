---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, findPerp, getLive, oldestStamp, currentMark } from "../../lib/hyperliquid.ts";
import { usd, pct, VENUE_LABEL, paysClass, paysLabel, carryCost, type Venue } from "../../lib/funding.ts";
import { maintenanceMarginFraction, corridorAt, type MarginTable, tableFor, sortedTiers } from "../../lib/margin.ts";
import { oiMoves } from "../../lib/oi-history.ts";
import { findCoin, isLive, liveCoins, coinPageFor } from "../../lib/coins.ts";
import { liqMapHref, canonicalRedirect } from "../../lib/routes.ts";
import { countWords } from "../../lib/site.ts";
import { getCandles, getHourly, getM15, type Candle } from "../../lib/candles.ts";
import { utcStamp } from "../../lib/freshness.ts";
import Overview from "../../components/Overview.astro";
import PricePanel from "../../components/PricePanel.astro";
import Versus from "../../components/Versus.astro";
import { narrowChart, TIMEFRAMES, DEFAULT_TF, MIN_CHART_BARS, drawnBars, barSpan, buildPriceChart, timeframeGapNote, CHART_H, versusRows, type ChartMode } from "../../lib/series.ts";
import { bookWords, fundingStandingWords, closedDays, daysThatReached, rungDaysWords, dayProfile, dayProfileWords, fitAgainst, fitWords } from "../../lib/cohort.ts";
import DayMoves from "../../components/DayMoves.astro";
import { aboutOf } from "../../lib/contracts.ts";
import { extremeBy } from "../../lib/extreme.ts";
import { CH } from "../../lib/chart.ts";

import { priceDp, changeWords, signedPct, weekCarry } from "../../lib/funding.ts";
/* =========================================================================================
   ONE COIN.

   WHY THIS IS NOT /funding/{symbol} IN A HAT. That page answers a derivatives question: what
   is the funding, on which venue, against which margin tiers. This one answers the question
   people actually type — "bitcoin price" — and then earns the visit by putting next to that
   price the thing no price page has: what it costs to hold the position instead of the coin.

   THIS WAS A SPOT PAGE UNTIL 19 AUGUST 2026 and it is now a PERPETUAL page. Every figure came
   from Coinbase Exchange; its Market Data Terms (https://www.coinbase.com/legal/market_data,
   last updated 2026-08-07) were read in full that day and forbid displaying the data or anything
   derived from it. See the header of src/lib/coins.ts for the clauses. So the
   price here is the Hyperliquid perpetual mark, the chart is Hyperliquid's own candles, and the
   24-hour figures come from the same series.

   THE BASIS DIED WITH SPOT and is not faked. It was the gap between the perpetual and the
   underlying, and computing it needs a spot price this site no longer has any defensible way to
   publish. Nothing here approximates it from the oracle: Hyperliquid's oraclePx is a validator
   median across venues, it is an index nobody can trade, and printing a "basis" against it
   would be a different number wearing the old one's name.

   WHAT THE CHANGE BOUGHT: the perpetual series carries 15-minute bars. The 15m and 30m
   timeframes work on these pages now; spot never had a series that could serve them.
   ========================================================================================= */

const env = (Astro.locals as any)?.runtime?.env;
const coin = findCoin(Astro.params.coin);
/* ONE URL PER COIN, the same answer /funding/[symbol] already gives.
   findCoin() lowercases its argument, so /coins/BITCOIN and /coins/Bitcoin both resolved and
   rendered — and because the canonical tag is built from the REQUESTED pathname, each declared
   ITSELF canonical. That is a duplicate-content split across every coin page, and a canonical
   tag cannot fix it when both copies are self-referencing. The sibling template has had the
   301 since the trailing-slash work; this one was simply never given it. */
if (coin && Astro.params.coin !== coin.slug) return canonicalRedirect(`/coins/${coin.slug}`, Astro.url.searchParams);
// Staged publication: a coin that has not reached its date has no URL yet. See COINS.
if (!coin || !isLive(coin)) return Astro.rewrite(`/404?coin=${encodeURIComponent(Astro.params.coin ?? "")}`);

const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

/* `live` IS FETCHED WITH THE CANDLES, not after the figures are computed. It used to be awaited
   forty lines below, which meant `price` and `chg24` were derived from the five-minute snapshot
   while the one-minute value was fetched, assigned to `markNow`, and then used by nothing at all.
   The headline price on ten pages was up to five minutes staler than the value already in hand.
   Introduced when this page was re-based off spot: the old line read `q?.last`, and replacing it
   with `perp?.markPx` looked right and skipped the faster clock. */
const [dayset, hourset, m15set, live] = await Promise.all([
  getCandles(env?.SNAPSHOT, coin.symbol, import.meta.env.DEV),
  getHourly(env?.SNAPSHOT, coin.symbol, import.meta.env.DEV),
  getM15(env?.SNAPSHOT, coin.symbol, import.meta.env.DEV),
  getLive(env?.SNAPSHOT),
]);
const perp = findPerp(snap.perps, coin.symbol);

/* THE ONE CLOCK THAT MATTERS HERE. `live` is written by the one-minute cron; the snapshot is
   five-minutely. Preferring live.mark puts the headline price and the funding beside it on the
   same tick, and the fallback keeps a just-deployed page working one clock slower. */
const cur = perp ? currentMark(snap, live, perp) : null;
const markNow = cur ? cur.px : NaN;
/* Open interest's change, by the hub's rule (oiMoves), so this page and /open-interest agree. */
const oiMv = perp ? await oiMoves(env?.DB, perp.symbol, perp.oiNotional) : { d24: null, d7: null };
const oiMvWords = [oiMv.d24 != null ? `24h ${signedPct(oiMv.d24)}` : null, oiMv.d7 != null ? `7d ${signedPct(oiMv.d7)}` : null].filter(Boolean).join(" · ");

/* AGAINST BITCOIN — the comparison a price page leaves to the reader, and the one a chat answer
   cannot give without two lookups and a subtraction. Bitcoin's own page is set against Ether. Both
   sides use the same snapshot's marks, so "now" is one instant; 7 and 30 days are measured from the
   same daily close in both series (dailyCloseBy), and a window where the two closes differ is left
   out rather than compared across different starts. */
const refSymbol = coin.symbol === "BTC" ? "ETH" : "BTC";
const refPerp = findPerp(snap.perps, refSymbol);
const refDay = refPerp ? await getCandles(env?.SNAPSHOT, refSymbol, import.meta.env.DEV) : null;
const refCoin = coinPageFor(refSymbol);
const vsRows = versusRows(perp, refPerp, dayset?.d, refDay?.d, snap.fetchedAt);
const price = markNow;
const dp = priceDp(price);
const px = (v: number) => usd(v, dp);
/* 24h CHANGE AGAINST THE VENUE'S OWN PREVIOUS-DAY PRICE — but against the LIVE mark, not the
   snapshot's. Both halves on one clock is the same rule the basis used to need, and it outlived
   the basis: a numerator five minutes older than the page's own headline price would make this
   percentage disagree with the number printed directly above it. */
const chg24 = perp && perp.prevDayPx > 0 && Number.isFinite(markNow) ? markNow / perp.prevDayPx - 1 : NaN;
/* 24h HIGH AND LOW COME FROM THE HOURLY SERIES, because the snapshot does not carry them. The
   last 24 hourly bars of the same Hyperliquid feed the chart is drawn from, so the figures
   beside the chart and the figures in it cannot disagree.

   NOT 24 CLOSED BARS, WHICH IS WHAT THIS COMMENT AND THE LINE UNDER THE CHART BOTH SAID.
   fetchHourly (src/lib/candles.ts:67) requests candleSnapshot with endTime = Date.now() and
   filters only on v > 0, so the hour in progress at collection time has volume and survives.
   slice(-24) is therefore 23 closed bars plus one open one, frozen at whatever it held when
   the two-hourly sweep ran. The window is kept — an extreme set in the current hour belongs in
   a 24-hour high, and dropping the newest bar would age the figure by up to two more hours for
   nothing — so the WORDS moved to match it, here and beside the chart. The newest bar's high
   and low are provisional and will move on the next sweep; the age printed next to them is
   what tells a reader how provisional. */
const last24 = (hourset?.d ?? []).slice(-24);
const high24 = last24.length ? Math.max(...last24.map((c) => c[2])) : NaN;
const low24 = last24.length ? Math.min(...last24.map((c) => c[3])) : NaN;
/* 24h VOLUME IS HYPERLIQUID'S OWN NOTIONAL, already in USD on the snapshot. The old figure was
   spot base-units times the spot price; this one is the venue's published dollar turnover, so
   the open-interest ratio beneath it is now perp OI against perp volume — the same market on
   both sides of the fraction, which the old ratio never was. */
/* WHEN THE HOURLY STORE WAS LAST WRITTEN, so the sentence beside the 24-hour high and low can
   name their real clock instead of borrowing the snapshot's. */
const perpNtl = perp?.dayNtlVlm ?? NaN;
const oiToVol = perp && Number.isFinite(perpNtl) && perpNtl > 0 ? perp.oiNotional / perpNtl : NaN;

const ORDER: Venue[] = ["HlPerp", "BinPerp", "BybitPerp"];
const by = new Map((perp?.venues ?? []).map((v) => [v.venue, v]));
const hl = by.get("HlPerp");
/** What a $10,000 leveraged long pays (or receives) in a week, at the current rate. */
const week = (apr: number) => carryCost(10_000, apr, 7);
/* THE OPENING SENTENCE NAMES THE SIDE ITS DOLLARS BELONG TO. It said "Holding it is paid: shorts
   pay longs at 13.77% a year, which is $26.41 a week on a $10,000 position, paid to you" —
   checked on the local render of /coins/avalanche on 16 September 2026, with bitcoin reading
   "Holding it is a cost … $21.00 a week on a $10,000 position". `week()` is a LONG's carry, and
   the card below says so ("Cost to hold $10,000 long"); a short holding the same position is paid
   exactly what the long is charged, so "holding it" and "you" were true for half the readers.
   The sentence now says "long" in both places the figure is claimed. And a rate that rounds to
   no money — funding at 0.00%, or close enough that the week is under a cent — was "a cost"
   of "$0.00"; it is decided from the same formatted figure the sentence would print, so the
   words cannot call a sum a cost that the digits show as nothing. */
const carryWeek = hl && Number.isFinite(hl.apr) ? weekCarry(hl.apr).text : "—";
const carryNil = hl && Number.isFinite(hl.apr) ? weekCarry(hl.apr).nil : false;
/* ONE ROW PER VENUE IN ORDER, WITH WHAT IT CAN PRINT decided here, once, so the venue table and
   the sentences about it read the same two flags instead of each re-deriving them. The table
   renders every ORDER venue unconditionally; a venue with no usable interval and no usable rate
   stays in it as a row of dashes. */
const venueRows = ORDER.map((v) => {
  const f = by.get(v);
  const ok = !!f && Number.isFinite(f.apr);
  const hasInterval = !!f && Number.isFinite(f.intervalHours);
  return { v, f, ok, hasInterval };
});
/** "Binance", "Binance and Bybit", "Binance, Bybit and OKX". */
const andList = (xs: string[]) =>
  xs.length < 3 ? xs.join(" and ") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`;
/* THE FIGURES ON THIS PAGE THAT ARE NOT HYPERLIQUID'S, read off the rows the venue table
   renders. "Where the numbers come from" said every figure on the page was Hyperliquid, "the
   funding" named among them, below a table whose Binance and Bybit rows print those venues'
   own rates. Measured on production on 16 September 2026: /coins/bitcoin showed Binance 2.31%
   ($4.44 a week) and Bybit 5.46% ($10.47) under that sentence, /coins/chainlink -1.10% and
   -3.52%. The rates do travel through Hyperliquid's predictedFundings feed, which is the only
   sense in which the sentence held — a rate another venue sets is still that venue's figure.

   The exception counts the rows that print a figure, not the rows that exist. A venue that
   stops returning a rate keeps its row — as dashes, which carry no figure — and leaves the
   sentence; the first version of this note said the row left too, and it does not. A venue
   added to ORDER gets a row and, once it prints anything, a place in the sentence, and
   `andList` keeps a third name from reading "Binance and Bybit and X". The follow-on sentence
   says what those rows are worked from rather than calling a row a rate: a row is an
   interval, a rate, a weekly cost and a direction, the last two computed here from the rate. */
const secondHand = venueRows.filter((r) => r.v !== "HlPerp" && (r.ok || r.hasInterval)).map((r) => VENUE_LABEL[r.v]);
const exceptRows = secondHand.length
  ? ` except the ${andList(secondHand)} ${secondHand.length === 1 ? "row" : "rows"} of the per-venue table above`
  : "";
/* THE VENUE COUNT IS COUNTED, NOT TYPED. Three sentences said "three" — the note over the table
   ("all three"), the link to the funding page ("across three venues") and the meta description —
   next to a table built from ORDER and a sources sentence built from the snapshot. Flagged on 16
   September 2026 beside the fix above: true today, with nothing tying it to either. The note
   counts the table's rows, which is what "all" ranges over; the link and the description count
   the venues that have a rate, which is what "funding across N venues" promises. */
const rated = venueRows.filter((r) => r.ok);
const allRows = venueRows.length === 2 ? "both venues" : `all ${countWords(venueRows.length, "venue", "venues")}`;
const fundingReach = rated.length > 1
  ? `across ${countWords(rated.length, "venue", "venues")}`
  : rated.length === 1 ? `on ${VENUE_LABEL[rated[0].v]}` : "";

/* =========================================================================================
   THE OTHER HALF OF "WHAT LEVERAGE COSTS", WHICH THIS PAGE PROMISED IN ITS TITLE AND DID NOT
   SHOW.

   The section below it costs a position in FUNDING. The cost nobody quotes is the distance
   price is allowed to travel before the position is closed, and it is the half this site can
   compute and the venues do not publish: Hyperliquid gives a tier table and a maximum
   leverage, not a maintenance margin fraction and not a corridor.

   MEASURED, NOT SUSPECTED. The computed-figure floor added on 31 August 2026 scored this
   template at TWO figures it computes — an aggregated candle series and a weekly carry — under
   a floor of three, and it was the only template on the site under it. Three other readings
   agreed: 68% five-gram overlap between sibling coin pages against /funding/{symbol}'s 10%,
   545 words against 3,187, and 8 Search Console impressions across five pages against 392
   across twenty-five. The coin pages were the site's price table with a chart on it.

   DERIVED, NOT MODELLED, and the note under the table says so. Every figure here is arithmetic
   over the published tier and the live mark. Nothing on this page assumes a position
   distribution — that is the map, and it is linked rather than imitated.
   ========================================================================================= */
const marginTable = perp ? tableFor(perp) : undefined;
const tier1 = marginTable ? sortedTiers(marginTable)[0] : undefined;
/* The cap, then three rungs beneath it. A general-audience page does not need the seven the
   liquidation map draws; it needs the shape, and the shape is legible in four rows. */
/* THE SAME MARK AS THE HEADLINE, AND THE MOMENT IT WAS TAKEN, NAMED. These rungs were worked
   from `perp.markPx`, the five-minute snapshot, while the price at the top of the page is
   `markNow`, the one-minute tick — two marks in one response and nothing saying so. Measured on
   production on 16 September 2026, /coins/bnb?tf=1d: "BNB trades at $711.11" above "a mark of
   $711.47", and the table rebuilt to the cent from $711.47, not from the price the reader was
   shown. 47 of 93 renders that day carried a gap (cardano $0.19294 against $0.19282).
   The rungs now use `markNow`. They still cannot follow the headline after load — the price at
   the top is repainted every 30 seconds by public/interact.js, and these are server arithmetic —
   so the sentence names the mark and its UTC time instead of calling it "a mark", and says that
   the price above moves on without it. `markAt` is the clock `markNow` actually came from. */
const markAt = cur ? cur.at : snap.fetchedAt;
const markClock = Number.isFinite(markAt) && markAt > 0 ? utcStamp(markAt) : null;
const rungs = tier1 && perp && Number.isFinite(markNow) && markNow > 0
  ? [...new Set([1, 0.6, 0.4, 0.25].map((f) => Math.max(2, Math.round(tier1.maxLeverage * f))))]
      .filter((L) => L >= 2 && L <= tier1.maxLeverage)
      .map((L) => corridorAt(markNow, L, maintenanceMarginFraction(tier1.maxLeverage)))
  : [];

/* --- the chart: two modes, four timeframes, all server-rendered ------------------------
   The mode is a GET parameter and the switch is a submit button, exactly like the timeframe
   control: crawlers never submit forms, so one coin stays one URL. Both modes for all four
   timeframes are rendered up front — a line panel is a single polyline and costs almost
   nothing next to 300 candle bodies — so switching either mode or timeframe is instant, works
   with JavaScript disabled, and cannot shift the layout. */
const MODES: { key: ChartMode; label: string }[] = [{ key: "candle", label: "Candles" }, { key: "line", label: "Line" }];
const qs = Astro.url.searchParams;
/* THE PRESSED BUTTON WINS, AND IT WINS BY NAME, NOT BY POSITION. The carry inputs that keep the
   other axis on a no-JS submit were named `tf` and `view`, the same names as the buttons, and the
   view carry sat in the timeframe group — ahead of the Candles and Line buttons in document
   order. A form serialises in document order and this line took the FIRST `view`, so pressing
   Line submitted view=candle&view=line and got candles back. Measured on production on 16
   September 2026: /coins/cardano?view=candle&view=line&tf=1d rendered 1d.candle with Candles
   pressed, and from a line page Candles did nothing the same way. The timeframe buttons only
   worked because they happened to come before their carry.
   The carries are now `keep_tf` and `keep_view` and are read only when the axis itself is
   absent. Only a pressed button (or a shared URL) sends `tf` or `view`, so no arrangement of the
   markup can put a carry ahead of the reader's choice. */
const tfAsked = qs.get("tf") ?? qs.get("keep_tf");
const tfKey = TIMEFRAMES.some((t) => t.key === tfAsked) ? tfAsked! : DEFAULT_TF;
const modeKey: ChartMode = (qs.get("view") ?? qs.get("keep_view")) === "line" ? "line" : "candle";

/* ONE PANEL, for the same reason as the contract page — and here it matters more, because this
   template multiplies: six timeframes times two chart styles is TWELVE renders of the same
   series to show one. Availability is a length check on the base series, not a built chart. */
/* THREE BASES NOW, WHERE SPOT COULD ONLY OFFER TWO. The note that stood here explained why the
   m15 timeframes had to resolve to `undefined` — spot had no fifteen-minute series, and a
   two-armed ternary would have aggregated daily bars as though they were fifteen-minute ones and
   drawn a chart that is wrong rather than absent. The perpetual series has all three, so 15m and
   30m are real here for the first time. The shape of the guard is kept: a base that is missing
   still resolves to undefined and drops its buttons off the bar, because a timeframe whose data
   has not arrived must be absent rather than approximated. */
const baseFor = (tf: (typeof TIMEFRAMES)[number]) =>
  (tf.base === "m15" ? m15set?.d : tf.base === "hour" ? hourset?.d : dayset?.d);
/* Bars come from drawnBars() in src/lib/series.ts, the one place that says where a bar opens —
   it was written here first and the contract page never got it. */
const barsOf = (tf: (typeof TIMEFRAMES)[number]): Candle[] => drawnBars(baseFor(tf), tf);
/* Same correction as the contract template: the test is on the aggregated bar count, because
   that is what gets drawn. See MIN_CHART_BARS in src/lib/series.ts. */
const tfsAvailable = TIMEFRAMES.filter((tf) => barsOf(tf).length >= MIN_CHART_BARS).map((tf) => tf.key);
/* TWO REASONS A TIMEFRAME IS MISSING, AND THE NOTE GAVE ONLY ONE. It said every absent button
   had "not yet enough history — fewer than 6 bars at that size". That is true of a series too
   short to aggregate, and false of a series that was not there at all: getCandles, getHourly and
   getM15 return null when the store is missing or cannot be read. Measured on the local render on
   16 September 2026, /coins/dogecoin?tf=12h drew the 15m panel under "1H and 4H and 12H and 1D and
   1W and 1M are not offered: there is not yet enough history" — the hourly and daily series had
   not been read at all (null, zero bars), and the page blamed the length of a history it never
   saw. The reason is now decided from the base series itself, each list joined with andList
   rather than "and … and", and its verb and pronoun follow its own count. */
const missing = TIMEFRAMES.filter((tf) => !tfsAvailable.includes(tf.key));
const tfGapNote = timeframeGapNote(missing.map((tf) => ({ tf, baseBars: baseFor(tf)?.length ?? 0 })));
const activeTf = TIMEFRAMES.find((tf) => tf.key === tfKey && tfsAvailable.includes(tf.key))
  ?? TIMEFRAMES.find((tf) => tfsAvailable.includes(tf.key));
const activeMode = MODES.find((m) => m.key === modeKey) ?? MODES[0];
const activeCandles = activeTf ? barsOf(activeTf) : [];
/* The x axis dates its own ticks now — timeTicks() in src/lib/chart.ts. This page used to relabel
   bare "06:00" ticks after the chart was built, and /funding/[symbol] never got that fix. */
const activeChart = activeTf
  ? buildPriceChart(activeCandles, null, activeTf, activeMode.key)
  : null;
const active = activeTf && activeChart ? { tf: activeTf, mode: activeMode, chart: activeChart } : null;
const panels = active ? [active] : [];
const hasChart = Boolean(active);
/* The legend's bar count and unit come from barSpan() in src/lib/series.ts, shared with the contract
   page — which still called thirty-day bars "monthly" after this page stopped. */

/* THIS CONTRACT AMONG THE OTHERS, AND WHAT ITS OWN MONTH DID TO EACH LEVERAGE — src/lib/cohort.ts.
   These replaced paragraphs every coin page carried word for word (19 October 2026). */
const book = bookWords(snap.perps, coin.symbol);
const fundStanding = fundingStandingWords(snap.perps, coin.symbol);
const month = closedDays(dayset?.d, snap.fetchedAt);
const rungDays = rungs.map((r) => ({ L: r.L, ...daysThatReached(month, r.longDist, r.shortDist) }));
const rungNote = rungDaysWords(coin.symbol, rungDays);
const profile = dayProfile(month);
const about = aboutOf(coin.symbol);
const fitRef = fitAgainst(dayset?.d, refDay?.d, snap.fetchedAt);
const fitNote = fitRef ? fitWords(coin.symbol, refSymbol, fitRef) : null;
/* THE VENUE TABLE'S SENTENCE IS ITS RESULT: which venue is cheapest for the same long, tie-aware. */
const weekRows = venueRows.filter((r) => r.ok).map((r) => ({ name: VENUE_LABEL[r.v], cost: week(r.f!.apr) }));
const cheapest = extremeBy(weekRows, (r) => r.cost, "min", 0.005);
const dearest = extremeBy(weekRows, (r) => r.cost, "max", 0.005);
const venueVerdict = weekRows.length < 2 || cheapest.kind === "none" || dearest.kind === "none" ? null
  : Math.abs(dearest.value - cheapest.value) < 0.005
    ? `All ${weekRows.length} venues charge the same week on a $10,000 long right now.`
    : `${cheapest.kind === "unique" ? cheapest.item.name : cheapest.items.map((x) => x.name).join(" and ")} ${cheapest.value < 0 ? `pays the long the most, ${usd(-cheapest.value, 2)} a week` : `is the cheapest place to hold it, ${usd(cheapest.value, 2)} a week`}; ${dearest.kind === "unique" ? dearest.item.name : dearest.items.map((x) => x.name).join(" and ")} ${dearest.value < 0 ? `pays the least, ${usd(-dearest.value, 2)}` : `charges the most, ${usd(dearest.value, 2)}`}.`;

const others = liveCoins().filter((c) => c.slug !== coin.slug);
const title = `${coin.name} price — ${coin.symbol} perpetual, and what leverage costs`;
const description = `Live ${coin.name} (${coin.symbol}) perpetual price from Hyperliquid, with ${fundingReach ? `the funding rate ${fundingReach}, ` : ""}open interest, and what holding a leveraged position actually costs per week.`;
---

<Base title={title} description={description} fetchedAt={oldestStamp(snap.fetchedAt, live?.at)} crumb={{ href: "/coins", label: "Coins", current: coin.name }}>
  <div class="page-head">
    <p class="crumb"><a href="/coins">Coins</a> › {coin.name}</p>
    <h1>{coin.name} price</h1>
    {/* THE PRICE IS THE HEADLINE AND THE COST IS THE POINT. This template's own argument — and
        the sentence on /coins — is that it prints "the thing a price table leaves out": what the
        contract charges to hold the exposure. Read cold, it opened with a one-line blurb and
        then a very large price, and the cost lived under an h2 a screen and a half down. The
        blurb is still here, after the claim it was standing in front of. */}
    {perp && hl && Number.isFinite(hl.apr) ? (
      <Overview>
        {/* THE SAME MARK AS THE BIG PRICE UNDER IT, SO IT REPAINTS WITH IT. The hero figure is
            data-repaint="mark" and this one was plain text, so thirty seconds after load the
            sentence and the number beneath it named two prices for one contract. */}
        <b>{coin.name} trades at <span data-repaint="mark" data-sym={coin.symbol} data-dp={dp}>{px(markNow)}</span></b> on the Hyperliquid perpetual.
        {/* ON ONE LINE. Adjacent JSX expressions split across lines render a whitespace text
            node between them, which put a space before the full stop — the same defect the
            note at the quotable sentence in /funding/[symbol] records. */}
        {carryNil ? (
          <Fragment>Holding it long costs <b>next to nothing</b> right now: funding is <b>{pct(Math.abs(hl.apr))} a year</b>, under a cent a week on a $10,000 long.</Fragment>
        ) : (
          <Fragment>Holding it long is <b>{hl.apr >= 0 ? "a cost" : "paid"}</b>: {paysLabel(hl.apr)} at <b>{pct(Math.abs(hl.apr))} a year</b>, which is <b>{carryWeek}</b> a week {hl.apr >= 0 ? "on" : "to"} a $10,000 long.</Fragment>
        )}{" "}{coin.blurb}
      </Overview>
    ) : (
      <p>{coin.blurb}</p>
    )}
  </div>

  {/* A PUBLISHED COIN WHOSE CONTRACT IS NOT IN THE SNAPSHOT. Coverage is gated on a publication
      date and an open-interest floor, so a contract that falls below the floor, is delisted, or
      simply stops appearing in Hyperliquid's response leaves this page rendering "—" in every
      slot with a title that still promises a price. That is a page saying nothing while looking
      like a page saying something, and it is indexed. It now says which it is. */}
  {!perp && (
    <div class="verdict verdict--warn">
      <div>
        <b>{coin.symbol} is not in the current snapshot.</b> The perpetual is either below this
        site's coverage floor or not being returned by the venue right now, so the figures below
        are unavailable rather than zero. Nothing here is an assertion about the market.
      </div>
    </div>
  )}

  <div class="hero">
    {/* `mark` AND `chgmark`, NOT `last` AND `chg`. These carried the spot kinds until the page was
        re-based onto the perpetual, and the attribute names are a contract with interact.js: the
        spot branches require a `spot` block that /api/live.json no longer sends, so the overlay
        went inert here — price, change, mark and the page clock all frozen — while /funding
        pages, which already used `mark`, kept updating. Nothing in the markup looked wrong and no
        check reads overlay behaviour; it was found by watching a live page for two pulls. */}
    <span class="hero__price" data-repaint="mark" data-sym={coin.symbol} data-dp={dp}>{Number.isFinite(price) ? px(price) : "—"}</span>
    <span class:list={["hero__chg"]} data-repaint="chgmark" data-sym={coin.symbol} data-prev={perp?.prevDayPx}>
      {changeWords(chg24)}
    </span>
    <span class="hero__span">24-hour change · Hyperliquid perpetual</span>
  </div>

  <div class="hero__meta">
    <div>24h high<b>{Number.isFinite(high24) ? px(high24) : "—"}</b></div>
    <div>24h low<b>{Number.isFinite(low24) ? px(low24) : "—"}</b></div>
    <div>24h volume<b>{Number.isFinite(perpNtl) ? usd(perpNtl) : "—"}</b></div>
    <div>Oracle index <span class="scope">Hyperliquid</span><b>{perp && perp.oraclePx > 0 ? px(perp.oraclePx) : "—"}</b></div>
    <div>Open interest <span class="scope">Hyperliquid</span><b>{perp ? usd(perp.oiNotional) : "—"}</b></div>
  </div>
  <p class="datanote">
    24-hour high and low: the hourly series{hourset?.u ? <>, written <b>{utcStamp(hourset.u)}</b></> : null}.
    {" "}<a class="link" href="/methodology#clocks">Every figure's clock →</a>
  </p>

  {hasChart ? (
    <>
      <form method="GET" class="tfbar" data-tfgroup="cx">
        <div class="tf" role="group" aria-label="Chart timeframe">
          {TIMEFRAMES.filter((t) => tfsAvailable.includes(t.key)).map((tf) => (
            <button type="submit" name="tf" value={tf.key} data-tf={tf.key} aria-pressed={tf.key === active!.tf.key}>{tf.label}</button>
          ))}
        </div>
        <div class="tf" role="group" aria-label="Chart style">
          {MODES.map((m) => (
            <button type="submit" name="view" value={m.key} data-mode={m.key} aria-pressed={m.key === active!.mode.key}>{m.label}</button>
          ))}
        </div>
        {/* NAMED APART FROM THE BUTTONS — see `tfAsked` in the frontmatter. A carry that shared
            the button's name lost to its own position in the markup. `active!.mode.key`, not
            `modeKey`, so the carry holds the style that was drawn, as `keep_tf` already does. */}
        <input type="hidden" name="keep_view" value={active!.mode.key} data-tfcarry="view" />
        <input type="hidden" name="keep_tf" value={active!.tf.key} data-tfcarry="tf" />
        <span class="tfbar__note">
          Hyperliquid perpetual candles — the traded contract, not the oracle index.
          {/* A GAP MUST BE STATED, NOT INFERRED FROM A MISSING BUTTON. The contract template has
              said this since its button bar was fixed; this one dropped timeframes silently, so a
              reader looking for a monthly view on a young contract found no button and no reason.
              Both pages now name what is absent and why. */}
          {tfGapNote}
        </span>
      </form>

      {/* The panel, its crosshair islands and the phone-width chart: src/components/PricePanel.astro. */}
      <PricePanel chart={active!.chart} narrow={narrowChart(activeCandles, null, active!.tf, active!.mode.key)} tf={active!.tf}
                  unit={coin.symbol} ptsPrefix="cpts" panel={`${active!.tf.key}.${active!.mode.key}`} group="cx" on={true} />

      <p class="legend">
        Period high <b data-tfstat="high" data-group="cx">{px(active!.chart!.high)}</b>,
        low <b data-tfstat="low" data-group="cx">{px(active!.chart!.low)}</b>,
        over <b data-tfstat="bars" data-group="cx">{barSpan(active!.tf, active!.chart!.bars)}</b>.
        Candles are green where a bar closed at or above its open, red where it closed below.
        {" "}<a class="link" href="/methodology#charts">How the chart is drawn →</a>
      </p>
    </>
  ) : (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">Candles not collected yet</p>
        <p class="empty__text">A missing series is filled on the next five-minute tick. Every figure above and below is unaffected.</p>
      </div>
    </div>
  )}

  <Versus symbol={coin.symbol} refSymbol={refSymbol} refHref={refCoin ? `/coins/${refCoin.slug}` : null} rows={vsRows} at={snap.fetchedAt} fit={fitNote} />

  {/* THIS HEADING SAID "Spot against the perpetual" AND THE SECTION HAD NO SPOT IN IT. The cards
      beneath were re-based when Coinbase was removed and the heading above them was not — a
      survival of the old premise, live on ten indexed pages, found by listing the headings of
      the two page families side by side rather than by reading the file. The lesson is the one
      the uncited-claims sweep already taught: a sentence deleted in one place has copies, and
      the copies are not always sentences. */}
  <h2 class="section">What holding {coin.symbol} costs</h2>
  {(fundStanding || book) && (
    <p class="section-note">
      {hl && Number.isFinite(hl.apr) && <>Hyperliquid funding on {coin.symbol} is <b>{pct(hl.apr)}</b>. </>}{fundStanding}{book && <>{" "}{book}</>}
    </p>
  )}
  <div class="cards">
    {/* THIS CARD WAS THE BASIS and there is deliberately nothing in its place pretending to be
        it. The nearest available number is the mark against Hyperliquid's oraclePx, and that is
        a different quantity: an index median across venues rather than a traded underlying.
        Printing it under the old label would have kept the card and lost the meaning. */}
    <div class="card card--lead">
      <div class="card__label">Open interest <span class="card__scope">Hyperliquid</span></div>
      <div class="card__value">{perp ? usd(perp.oiNotional) : "—"}</div>
      <div class="card__meta">notional currently open{oiMvWords && <> · <a class="link" href="/open-interest?w=7d">{oiMvWords}</a></>}</div>
    </div>
    <div class="card">
      <div class="card__label">Hyperliquid funding</div>
      {/* Repainted with the venue table beside it, so a live pull cannot leave the card on the old rate. */}
      <div class:list={["card__value", hl && paysClass(hl.apr)]} data-repaint={hl ? "apr" : undefined} data-sym={coin.symbol} data-venue="HlPerp">{hl ? pct(hl.apr) : "—"}</div>
      <div class="card__meta" data-repaint={hl ? "dir" : undefined} data-sym={coin.symbol} data-venue="HlPerp" data-pay="longs pay shorts" data-recv="shorts pay longs">{hl ? paysLabel(hl.apr) : "—"}</div>
    </div>
    <div class="card">
      <div class="card__label">Open interest ÷ 24h volume <span class="card__scope">Hyperliquid</span></div>
      <div class="card__value">{Number.isFinite(oiToVol) ? `${oiToVol.toFixed(2)}×` : "—"}</div>
      <div class="card__meta">how long the open book takes to turn over</div>
    </div>
  </div>

  <h2 class="section">{coin.symbol} carry, per venue</h2>
  <p class="section-note">
    {venueVerdict ?? `The same $10,000 long on ${allRows}, a week at the current rate.`}
    {" "}<a class="link" href="/methodology">Why the quoted rates cannot be compared →</a>
  </p>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Venue</th><th class="num">Interval</th><th class="num">Annualised</th><th class="num">$10,000 long, per week</th><th>Direction</th></tr></thead>
      <tbody>
        {venueRows.map(({ v, f, ok, hasInterval }) => {
          return (
            <tr>
              <td>{VENUE_LABEL[v]}</td>
              <td class="num">{hasInterval ? `${f!.intervalHours}h` : <span class="faint">—</span>}</td>
              <td class:list={["num", ok && paysClass(f!.apr)]} style="font-weight:600"
                  data-repaint={ok ? "apr" : undefined} data-sym={coin.symbol} data-venue={v}>{ok ? pct(f!.apr) : "—"}</td>
              {/* Both cells are DERIVED FROM THE SAME f.apr the cell before them carries, so
                  they must be repainted with it or the row contradicts itself one minute after
                  load. notional and days travel as attributes so the overlay applies this
                  page's rule rather than carrying its own copy of it. */}
              <td class="num" data-repaint={ok ? "carry" : undefined} data-sym={coin.symbol} data-venue={v}
                  data-notional="10000" data-days="7">{ok ? usd(Math.abs(week(f!.apr)), 2) : "—"}</td>
              <td data-repaint={ok ? "dir" : undefined} data-sym={coin.symbol} data-venue={v}
                  data-pay="longs pay" data-recv="longs receive">{ok ? (f!.apr >= 0 ? "longs pay" : "longs receive") : <span class="faint">—</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {rungs.length > 0 && perp && tier1 && (
    <>
      <h2 class="section">How far {coin.symbol} can move before each leverage closes you</h2>
      <p class="section-note" style="max-width:88ch">
        From the mark of {px(markNow)}{markClock ? ` at ${markClock}` : ""} and {coin.name}'s first margin tier, {tier1.maxLeverage}× at most.
        {profile && <>{" "}{dayProfileWords(coin.symbol, profile)}</>}
        {rungNote && <>{" "}{rungNote}</>}
        {" "}<a class="link" href="/methodology#levels">How these are worked out →</a>
      </p>
      <div class="panel">
        <table class="tbl">
          <thead>
            <tr>
              <th class="num">Leverage</th>
              <th class="num">Long closed at</th>
              <th class="num">Move down</th>
              <th class="num">Short closed at</th>
              <th class="num">Corridor width</th>
              {month.length >= 10 && <th class="num">Days that closed it, long · short</th>}
            </tr>
          </thead>
          <tbody>
            {rungs.map((r, i) => (
              <tr class={r.L === tier1.maxLeverage ? "is-active" : undefined}>
                <td class="num">{r.L}×{r.L === tier1.maxLeverage ? " · max" : ""}</td>
                <td class="num">{usd(r.longLiq, dp)}</td>
                <td class="num">{signedPct(-r.longDist)}</td>
                <td class="num">{usd(r.shortLiq, dp)}</td>
                <td class="num">{pct(r.corridor)}</td>
                {month.length >= 10 && <td class="num">{rungDays[i].long} · {rungDays[i].short} of {rungDays[i].of}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <DayMoves days={month} rungs={rungs} symbol={coin.symbol} />
    </>
  )}

  <p class="datanote">
    Every figure here is Hyperliquid's{exceptRows}; the price is the perpetual contract's, not spot.
    {" "}<a class="link" href="/data-sources">Every endpoint behind it →</a>
  </p>

  <p style="margin-top:24px">
    <a class="link" href={`/funding/${coin.symbol.toLowerCase()}`}>{coin.symbol} funding{fundingReach ? ` ${fundingReach}` : ""} →</a>
    · <a class="link" href={liqMapHref(coin.symbol)}>Where {coin.symbol} leverage breaks →</a>
    · <a class="link" href={`/liquidations/survival?symbol=${coin.symbol}`}>What the rules did to past positions →</a>
  </p>

  {about && (
    <section id="about">
      <h2 class="section">What {about.name} is</h2>
      <p class="prose">{about.about}</p>
    </section>
  )}

  <h2 class="section">Other coins</h2>
  <p class="related">
    {others.map((c) => <a class="chip-link" href={`/coins/${c.slug}`}>{c.name}</a>)}
  </p>

  <style>
    .hero__span { font-size: var(--fs-sm); color: var(--text-faint); }
    .tfbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: var(--inset-panel) 0 var(--gap-block); }
    .tfbar__note { font-size: var(--fs-xs); color: var(--text-faint); }
    .chart--price :global(svg.pxw) { aspect-ratio: var(--chartRatio); }
    .chart--price :global(svg.pxn) { aspect-ratio: var(--chartRatioN); }
    .legend { max-width: 88ch; line-height: 1.6; margin-top: 12px; }
    .legend__style { display: inline; }
    .related { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
    .chip-link {
      display: inline-block; padding: var(--gap-pair) var(--gap-cluster); border-radius: var(--r-pill);
      background: var(--surface-2); border: 1px solid var(--border-soft);
      text-decoration: none; font-size: 13px; font-weight: 500;
      transition: background .14s var(--ease), color .14s var(--ease);
    }
    .chip-link:hover { background: var(--surface-3); color: var(--accent); }
    /* The live layer only ever changes the TEXT of these, never their box. */
    [data-repaint] { transition: color .35s var(--ease); }
    [data-repaint][data-moved="up"] { color: var(--accent); }
    [data-repaint][data-moved="down"] { color: var(--accent); }
    @media (max-width: 700px) { .hero__meta { gap: var(--gap-cluster) 20px; } }
  </style>
</Base>
