---
import Base from "../layouts/Base.astro";
import { getSnapshot, coldStart } from "../lib/hyperliquid.ts";
import { usd, pct } from "../lib/funding.ts";
import { maintenanceMarginFraction, nextTierBoundary, type MarginTable } from "../lib/margin.ts";
import { getHourly } from "../lib/candles.ts";
import { buildLiqMap, rampColor, RAMP, PROFILES } from "../lib/liqmap.ts";
import tables from "../data/margin-tables.json";

const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

const q = Astro.url.searchParams;
const symbol = (q.get("symbol") ?? "BTC").toUpperCase();
const perp = snap.perps.find((p) => p.symbol === symbol) ?? snap.perps[0];
const table = (tables as Record<string, MarginTable>)[String(perp.marginTableId)];
const tiers = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound);
const tier1 = tiers[0];
const mark = perp.markPx;
const mmf = maintenanceMarginFraction(tier1.maxLeverage);
const nextTier = nextTierBoundary(table, tier1.lowerBound);

const dp = mark >= 100 ? 2 : mark >= 1 ? 3 : mark >= 0.01 ? 5 : 7;
const px = (v: number) => usd(v, dp);
const axisDp = mark >= 100 ? 0 : mark >= 1 ? 2 : dp;
const axisPx = (v: number) => usd(v, axisDp);

// MODEL INPUTS. Chosen by the reader, printed beside the picture, applied here.
const WINDOWS = [{ h: 72, label: "3 days" }, { h: 168, label: "7 days" }, { h: 336, label: "14 days" }];
const winH = WINDOWS.some((w) => w.h === Number(q.get("win"))) ? Number(q.get("win")) : 168;
const profile = PROFILES.find((p) => p.key === q.get("profile")) ?? PROFILES[1];

const hourly = await getHourly(env?.SNAPSHOT, perp.symbol, import.meta.env.DEV);
const bars = hourly ? hourly.d.slice(-winH) : [];
const map =
  bars.length > 24
    ? buildLiqMap({ candles: bars, mark, mmf, maxLeverage: tier1.maxLeverage, openInterest: perp.oiNotional, profile, rows: 60 })
    : null;

/* SVG built as a string with INLINE presentation attributes. Astro scopes class selectors to
   [data-astro-cid-…]; markup injected with set:html never carries that attribute, so a
   class-styled <text> here renders in SVG's default black on a dark page. That shipped once. */
const MW = 1000, MH = 560, mL = 88, mR = 104, mT = 74, mB = 46;
let mapSvg = "";
if (map) {
  const pw = MW - mL - mR, ph = MH - mT - mB;
  const colW = pw / map.cols, rowH = ph / map.rows;
  const FAINT = "#6c737d", DIM = "#9aa1ab", TXT = "#e6e8ec";
  const o: string[] = [];

  // The MODEL badge lives in the visual, where the reference puts its model tabs.
  o.push(`<rect x="${mL}" y="12" width="92" height="23" rx="11.5" fill="#8ab4f8" fill-opacity="0.18" stroke="#8ab4f8" stroke-opacity="0.55"/>`);
  o.push(`<text x="${mL + 46}" y="27.5" text-anchor="middle" font-size="11.5" font-weight="700" fill="#8ab4f8" letter-spacing="0.7">MODELLED</text>`);
  o.push(`<text x="${mL + 104}" y="27.5" font-size="12.5" fill="${DIM}">${profile.label} leverage mix · ${WINDOWS.find((w) => w.h === winH)!.label} · notional scaled to open interest</text>`);

  RAMP.forEach((c, i) => o.push(`<rect x="${mL + i * 17}" y="47" width="17" height="9" fill="${c}"/>`));
  o.push(`<text x="${mL + RAMP.length * 17 + 10}" y="55.5" font-size="11.5" fill="${FAINT}">less ← modelled notional liquidated at this price → more</text>`);

  // density field, run-length merged along time: far fewer rects, and no seams
  for (let r = 0; r < map.rows; r++) {
    let c = 0;
    while (c < map.cols) {
      const col = rampColor(map.grid[r][c], map.maxDensity);
      if (!col) { c++; continue; }
      let e = c;
      while (e + 1 < map.cols && rampColor(map.grid[r][e + 1], map.maxDensity) === col) e++;
      o.push(`<rect x="${(mL + c * colW).toFixed(1)}" y="${(mT + r * rowH).toFixed(1)}" width="${((e - c + 1) * colW + 0.4).toFixed(1)}" height="${(rowH + 0.4).toFixed(1)}" fill="${col}"/>`);
      c = e + 1;
    }
  }

  for (let i = 0; i <= 6; i++) {
    const p = map.hiPrice - ((map.hiPrice - map.loPrice) * i) / 6;
    const y = mT + (ph * i) / 6;
    o.push(`<line x1="${mL}" x2="${MW - mR}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}" stroke="#2e343b" stroke-width="1" stroke-opacity="0.6"/>`);
    o.push(`<text x="${mL - 10}" y="${(y + 4).toFixed(1)}" text-anchor="end" font-size="11.5" fill="${FAINT}">${axisPx(p)}</text>`);
  }

  // observed price path, over the modelled field, with a dark halo so it reads on any cell
  const yPrice = (p: number) => mT + ((map.hiPrice - p) / (map.hiPrice - map.loPrice)) * ph;
  const pts = map.closes.map((v, i) => `${(mL + i * colW + colW / 2).toFixed(1)},${yPrice(v).toFixed(1)}`).join(" ");
  o.push(`<polyline points="${pts}" fill="none" stroke="#0d0f12" stroke-width="4" stroke-linejoin="round" stroke-opacity="0.8"/>`);
  o.push(`<polyline points="${pts}" fill="none" stroke="${TXT}" stroke-width="1.8" stroke-linejoin="round"/>`);

  const ym = yPrice(mark);
  o.push(`<line x1="${mL}" x2="${MW - mR}" y1="${ym.toFixed(1)}" y2="${ym.toFixed(1)}" stroke="${TXT}" stroke-width="1.2" stroke-dasharray="5 4" stroke-opacity="0.75"/>`);
  o.push(`<text x="${MW - mR + 10}" y="${(ym - 5).toFixed(1)}" font-size="11" fill="${FAINT}">mark</text>`);
  o.push(`<text x="${MW - mR + 10}" y="${(ym + 11).toFixed(1)}" font-size="12.5" font-weight="600" fill="${TXT}">${px(mark)}</text>`);

  const step = Math.max(1, Math.round(map.cols / 6));
  for (let i = 0; i < map.cols; i += step) {
    const d = new Date(map.times[i]);
    const lab = winH <= 72
      ? d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "UTC" })
      : d.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
    o.push(`<text x="${(mL + i * colW + colW / 2).toFixed(1)}" y="${MH - mB + 20}" text-anchor="middle" font-size="11.5" fill="${FAINT}">${lab}</text>`);
  }
  o.push(`<text x="${mL}" y="${MH - mB + 38}" font-size="11.5" fill="${FAINT}">UTC →</text>`);
  mapSvg = o.join("");
}
const totalClustered = map ? map.clusters.reduce((s, c) => s + c.notional, 0) : 0;

/* --- corridor ladder: derived, not modelled --- */
const CHART_FRACTIONS = [1, 0.75, 0.6, 0.5, 0.4, 0.3, 0.25];
const rung = (L: number) => {
  const longLiq = (mark * (1 - 1 / L)) / (1 - mmf);
  const shortLiq = (mark * (1 + 1 / L)) / (1 + mmf);
  return { L, longLiq, shortLiq, longDist: (mark - longLiq) / mark, shortDist: (shortLiq - mark) / mark, corridor: (shortLiq - longLiq) / mark, margin: 1 / L };
};
const rungs = [...new Set(CHART_FRACTIONS.map((f) => Math.max(2, Math.round(tier1.maxLeverage * f))))]
  .filter((l) => l <= tier1.maxLeverage && l >= 2)
  .sort((a, b) => b - a)
  .map(rung);
const CW = 980, CH = 460, cpL = 92, cpR = 108, cpT = 26, cpB = 64;
const cPlotW = CW - cpL - cpR, cPlotH = CH - cpT - cpB;
const cLo = Math.min(...rungs.map((r) => r.longLiq)), cHi = Math.max(...rungs.map((r) => r.shortLiq));
const cGap = (cHi - cLo) * 0.06;
const yMin = cLo - cGap, yMax = cHi + cGap;
const cy = (p: number) => cpT + ((yMax - p) / (yMax - yMin)) * cPlotH;
const groupW = Math.min(cPlotW, rungs.length * 132);
const groupX = cpL + (cPlotW - groupW) / 2;
const colW2 = groupW / rungs.length;
const cx = (i: number) => groupX + (i + 0.5) * colW2;
const barW = Math.min(72, colW2 * 0.58);
const gridPrices = Array.from({ length: 6 }, (_, i) => yMin + ((yMax - yMin) * i) / 5);

const title = `${perp.symbol} liquidation map — modelled density and the corridor each leverage permits | Basis`;
const description = `A modelled liquidation density map for ${perp.symbol} with its assumptions stated and adjustable, alongside the tier-correct liquidation corridor, which is derived rather than modelled.`;
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt}>
  <div class="page-head">
    <h1>Liquidation map</h1>
    <p>
      Two pictures of the same contract. The first is a <strong>model</strong> — where
      liquidation levels would sit if positions were opened the way the assumptions below
      describe. The second is <strong>derived</strong>: the corridor {perp.symbol} permits at each
      leverage, which follows from the published tier table and assumes nothing. Both are labelled
      wherever they appear.
    </p>
  </div>

  <form method="GET" class="calc" style="margin-bottom:16px">
    <label>Contract
      <select name="symbol">{snap.perps.map((p) => <option value={p.symbol} selected={p.symbol === perp.symbol}>{p.symbol}</option>)}</select>
    </label>
    <label>Assumed leverage mix
      <select name="profile">{PROFILES.map((p) => <option value={p.key} selected={p.key === profile.key}>{p.label}</option>)}</select>
    </label>
    <label>Window
      <select name="win">{WINDOWS.map((w) => <option value={w.h} selected={w.h === winH}>{w.label}</option>)}</select>
    </label>
    <button class="btn btn--primary" type="submit">Redraw</button>
  </form>

  {map ? (
    <>
      <figure class="chart">
        <div class="chart__scroll">
          <svg viewBox={`0 0 ${MW} ${MH}`} class="chart__svg lmap" role="img"
               aria-label={`Modelled liquidation density for ${perp.symbol} over ${WINDOWS.find((w) => w.h === winH)!.label} using the ${profile.label} leverage mix. Assumptions and the resulting clusters are tabulated below.`}>
            <Fragment set:html={mapSvg} />
          </svg>
        </div>
        <figcaption>
          Brighter means more modelled notional would be liquidated at that price. The white line
          is the observed {perp.symbol} price; everything behind it is the model. Bands stop where
          price traded through them, because a position liquidated once cannot be liquidated again.
        </figcaption>
      </figure>

      <div class="verdict verdict--warn">
        <div>
          <b>This surface is a model, and the assumptions below drive it.</b> No venue publishes
          the distribution of open positions by leverage and entry price, so nobody can observe
          this — not us, and not anyone shipping a similar picture. Change the leverage mix in the
          form above and the bands move: that is the honest version of being handed someone else's
          Model 1, 2 and 3. The <a class="link" href="/liquidations/survival">survival map</a> and
          the corridor chart below assume nothing at all.
        </div>
      </div>

      <h2 class="section">The assumptions, in full</h2>
      <div class="panel" style="max-width:900px">
        <table class="tbl">
          <thead><tr><th class="num">#</th><th>Assumption</th><th>Value used</th><th class="num">Observed?</th></tr></thead>
          <tbody>
            <tr><td class="num">1</td><td>Total notional modelled</td><td>Equal to current open interest, {usd(perp.oiNotional)}</td><td class="num">observed</td></tr>
            <tr><td class="num">2</td><td>When positions were opened</td><td>Spread over {map.cols} hourly bars in proportion to each bar's traded volume</td><td class="num">observed</td></tr>
            <tr class="is-active"><td class="num">3</td><td>Leverage mix</td><td><strong>{profile.label}</strong> — {profile.note}</td><td class="num">assumed</td></tr>
            <tr><td class="num">4</td><td>Direction</td><td>Half long, half short at every leverage</td><td class="num">assumed</td></tr>
            <tr><td class="num">5</td><td>How positions end</td><td>Only by liquidation — no manual close, no added margin. This overstates what survives.</td><td class="num">assumed</td></tr>
            <tr><td class="num">6</td><td>Maintenance margin</td><td>{pct(mmf, 3)} at tier 1, from the published table</td><td class="num">observed</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="section">Leverage mix used: {profile.label}</h2>
      <p class="section-note">The exact weight vector behind the picture. Every other profile is one form submission away.</p>
      <div class="panel" style="max-width:560px">
        <table class="tbl">
          <thead><tr><th class="num">Leverage</th><th class="num">Share of notional</th><th class="num">Modelled notional</th></tr></thead>
          <tbody>
            {profile.weights.filter(([L]) => L <= tier1.maxLeverage).map(([L, w]) => (
              <tr><td class="num">{L}×</td><td class="num">{pct(w)}</td><td class="num">{usd(perp.oiNotional * w)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="section">Where the model puts the biggest clusters</h2>
      <p class="section-note">
        Price levels still carrying modelled notional at the right-hand edge of the chart, largest
        first — {usd(totalClustered)} across the twelve listed. These are the numbers the bright
        bands stand for.
      </p>
      <div class="panel">
        <table class="tbl">
          <thead><tr><th class="num">Price</th><th class="num">Distance from mark</th><th>Side closed</th><th class="num">Modelled notional</th><th class="num">Share of open interest</th></tr></thead>
          <tbody>
            {map.clusters.map((c) => (
              <tr>
                <td class="num">{px(c.price)}</td>
                <td class="num">{c.distance >= 0 ? "+" : ""}{(c.distance * 100).toFixed(2)}%</td>
                <td>{c.side === "long" ? "longs" : "shorts"}</td>
                <td class="num">{usd(c.notional)}</td>
                <td class="num">{pct(c.notional / Math.max(1, perp.oiNotional))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">Hourly candles not collected yet</p>
        <p class="empty__text">The density map needs hourly candles for {perp.symbol}. The ingest worker refreshes them every six hours; this section fills in on the first run. Everything below is unaffected.</p>
      </div>
    </div>
  )}

  <h2 class="section">The corridor each leverage permits — derived, not modelled</h2>
  <p class="section-note">
    No assumptions here. Given the tier table and a mark these prices are arithmetic: the upper cap
    is where a short is closed, the lower cap where a long is closed.
  </p>
  <figure class="chart">
    <div class="chart__scroll">
      <svg viewBox={`0 0 ${CW} ${CH}`} class="chart__svg corr" role="img"
           aria-label={`Liquidation corridor for ${perp.symbol} at a mark of ${px(mark)}. Every value is in the table beneath.`}>
        {gridPrices.map((p) => (
          <g>
            <line x1={cpL} x2={CW - cpR} y1={cy(p)} y2={cy(p)} class="grid" />
            <text x={cpL - 12} y={cy(p) + 4} class="axis" text-anchor="end">{axisPx(p)}</text>
          </g>
        ))}
        {rungs.map((r, i) => {
          const yTop = cy(r.shortLiq), yBot = cy(r.longLiq);
          const op = 0.5 - (0.36 * i) / Math.max(1, rungs.length - 1);
          return (
            <g>
              <rect x={cx(i) - barW / 2} y={yTop} width={barW} height={Math.max(2, yBot - yTop)} rx="4"
                    fill="var(--accent)" fill-opacity={op} stroke="var(--accent)" stroke-opacity="0.55" />
              <line x1={cx(i) - barW / 2} x2={cx(i) + barW / 2} y1={yTop} y2={yTop} class="cap" />
              <line x1={cx(i) - barW / 2} x2={cx(i) + barW / 2} y1={yBot} y2={yBot} class="cap" />
              <text x={cx(i)} y={CH - cpB + 26} class="lev" text-anchor="middle">{r.L}×</text>
              <text x={cx(i)} y={CH - cpB + 44} class="levsub" text-anchor="middle">±{(((r.longDist + r.shortDist) / 2) * 100).toFixed(1)}%</text>
            </g>
          );
        })}
        <line x1={cpL} x2={CW - cpR} y1={cy(mark)} y2={cy(mark)} class="mark" />
        <text x={CW - cpR + 10} y={cy(mark) - 6} class="marklab">mark</text>
        <text x={CW - cpR + 10} y={cy(mark) + 13} class="markval">{px(mark)}</text>
      </svg>
    </div>
  </figure>

  <div class="panel" style="margin-top:12px">
    <table class="tbl">
      <thead><tr><th class="num">Leverage</th><th class="num">Initial margin</th><th class="num">Long liquidation</th><th class="num">Move</th><th class="num">Short liquidation</th><th class="num">Move</th><th class="num">Corridor width</th></tr></thead>
      <tbody>
        {rungs.map((r) => (
          <tr class={r.L === tier1.maxLeverage ? "is-active" : undefined}>
            <td class="num">{r.L}×{r.L === tier1.maxLeverage ? " · max" : ""}</td>
            <td class="num">{pct(r.margin)}</td>
            <td class="num">{px(r.longLiq)}</td>
            <td class="num">−{(r.longDist * 100).toFixed(2)}%</td>
            <td class="num">{px(r.shortLiq)}</td>
            <td class="num">+{(r.shortDist * 100).toFixed(2)}%</td>
            <td class="num">{(r.corridor * 100).toFixed(2)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section">Where {perp.symbol} steps down</h2>
  <p class="section-note">
    Maintenance margin is set by the tier the notional falls in.
    {nextTier && <> Above {usd(nextTier.lowerBound)} the corridor widens, because maintenance margin rises to {pct(maintenanceMarginFraction(nextTier.maxLeverage), 3)}.</>}
  </p>
  <div class="panel" style="max-width:720px">
    <table class="tbl">
      <thead><tr><th>Tier</th><th class="num">Notional from</th><th class="num">Max leverage</th><th class="num">Maintenance margin</th></tr></thead>
      <tbody>
        {tiers.map((t, i) => (
          <tr class={i === 0 ? "is-active" : undefined}>
            <td>{i + 1}{i === 0 ? " · charted" : ""}</td>
            <td class="num">{usd(t.lowerBound)}</td>
            <td class="num">{t.maxLeverage}×</td>
            <td class="num">{pct(maintenanceMarginFraction(t.maxLeverage), 3)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section">What is deliberately absent</h2>
  <p class="prose">
    No liquidation totals and no cascade tracker. Those need an event feed, and every available one
    is throttled — Binance publishes at most one liquidation per symbol per second, so a sum over
    it understates by an unknown factor, worst exactly when the number is most quoted.
    <a class="link" href="/methodology/liquidations">The full reasoning →</a>
  </p>

  <p style="margin-top:24px">
    <a class="link" href="/liquidations/survival">Leverage survival — nothing modelled →</a>
    · <a class="link" href="/tools/liquidation-price">Work out a specific position →</a>
    · <a class="link" href={`/funding/${perp.symbol.toLowerCase()}`}>{perp.symbol} funding →</a>
  </p>

  <style>
    .chart { margin: 0; }
    .chart__scroll { overflow-x: auto; background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md); }
    .chart__svg { display: block; width: 100%; height: auto; }
    .lmap { min-width: 720px; aspect-ratio: 1000 / 560; }
    .lmap rect { shape-rendering: crispEdges; }
    .corr { min-width: 660px; aspect-ratio: 980 / 460; }
    figcaption { font-size: 13px; color: var(--text-faint); margin-top: 10px; max-width: 82ch; }
    .grid { stroke: var(--border-soft); stroke-width: 1; }
    .cap { stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; }
    .mark { stroke: var(--text); stroke-width: 1.5; stroke-dasharray: 5 4; opacity: .8; }
    text { font-family: var(--sans); font-variant-numeric: tabular-nums; }
    .axis { font-size: 12.5px; fill: var(--text-faint); }
    .lev { font-size: 15px; font-weight: 600; fill: var(--text); }
    .levsub { font-size: 12px; fill: var(--text-faint); }
    .marklab { font-size: 11.5px; fill: var(--text-faint); }
    .markval { font-size: 13px; font-weight: 600; fill: var(--text); }
  </style>
</Base>
