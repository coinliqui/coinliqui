---
/* =========================================================================================
   THE LIQUIDATION MAP FOR THE PINNED DEFAULT, AND THE INDEX OF EVERY OTHER ONE.

   THIS FILE USED TO BE THE WHOLE TEMPLATE. It rendered fifty distinct pages — a different
   title, heading, chart and every figure per contract — and published all fifty at this one
   URL behind `?symbol=`, while Base built the canonical tag from the pathname alone. So each
   of the forty-nine non-default renderings told every crawler it was this page. They could
   not be reached, could not be linked, and disavowed themselves.

   The body now lives in src/components/LiqMap.astro and /liquidations/[symbol].astro serves
   the rest. What stays here: the default contract, and the list that makes the others
   crawlable at all. A template whose only inbound link is a <select> is a template no
   crawler will ever enumerate — nothing submits forms.

   WHY THE DEFAULT KEEPS THIS URL rather than redirecting to /liquidations/btc. This is the
   one URL on the site with measured demand behind it: 70 impressions in the week to
   22 August 2026 at position 40.2, against 392 across the twenty-five /funding/{symbol}
   pages that have any. Moving an indexed page to buy symmetry is a cost paid for nothing.
   ========================================================================================= */
import Base from "../layouts/Base.astro";
import LiqMap from "../components/LiqMap.astro";
import { getSnapshot, coldStart, requestedPerp } from "../lib/hyperliquid.ts";
import { usd, pct, priceDp } from "../lib/funding.ts";
import { maintenanceMarginFraction, corridorAt, type MarginTable } from "../lib/margin.ts";
import { mapTitle, mapDescription } from "../lib/liqmap.ts";
import { liqMapHref } from "../lib/routes.ts";
import tables from "../data/margin-tables.json";

const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

const q = Astro.url.searchParams;
const TABLES = tables as Record<string, MarginTable>;

/* THE DEFAULT IS ASKED FOR THE SAME WAY IT ALWAYS WAS — with no symbol, so requestedPerp
   applies its pinned "BTC" fallback. Reading it from the same function the redirect below
   uses is what makes the two agree about which contract this URL is: hardcoding "BTC" here
   would be a second answer to a question src/lib/hyperliquid.ts already answers, and it
   would be the wrong one on any day BTC's tier table is missing. */
const def = requestedPerp(snap.perps, null, TABLES);
if (def === null || def === "unknown") return coldStart();
const { perp, table } = def;

/* ?symbol= IS NOW AN ALIAS, NOT AN ADDRESS.
   Every contract has its own URL, so the parameter form has exactly one job left: to be
   what the <select> in the form produces, and to be converted into the real address. A 301
   means that any ?symbol= URL already discovered — the sitemaps never carried one, but a
   link in the wild is not ours to control — consolidates onto the page it was a copy of.

   ONE HOUR OF CACHING, NOT A DAY. The mapping for a named contract is permanent, but the
   one case that is not is ?symbol=BTC → /liquidations, which holds only while BTC is the
   pinned default. An hour bounds how long a browser would keep believing that after BTC
   left coverage; the sibling 301s in /funding/[symbol] cache for a day because a case-fold
   cannot stop being true. */
const wanted = q.get("symbol");
if (wanted !== null) {
  const asked = requestedPerp(snap.perps, wanted, TABLES);
  if (asked === null) return coldStart();
  if (asked === "unknown") return Astro.rewrite(`/404?symbol=${encodeURIComponent(wanted)}`);
  const rest = new URLSearchParams(q);
  rest.delete("symbol");
  const qs = rest.toString() ? `?${rest.toString()}` : "";
  const path = asked.perp.symbol === perp.symbol ? "/liquidations" : `/liquidations/${asked.perp.symbol.toLowerCase()}`;
  return new Response(null, {
    status: 301,
    headers: { location: `${path}${qs}`, "cache-control": "public, max-age=3600" },
  });
}

/* THE INDEX. Every contract that has a tier table has a map, and this is the only place a
   crawler can find out. The three columns are arithmetic rather than model output — mark,
   open interest, and the corridor a max-leverage position has before the published
   maintenance margin closes it — so building the list costs one pass over the snapshot and
   nothing else. Fifty calls to buildLiqMap would have made this page the slowest on the
   site to serve the least important part of it. */
const rows = snap.perps
  .filter((p) => Object.prototype.hasOwnProperty.call(TABLES, String(p.marginTableId)))
  .map((p) => {
    const t = [...TABLES[String(p.marginTableId)].marginTiers].sort((a, b) => a.lowerBound - b.lowerBound)[0];
    const L = t.maxLeverage;
    const { corridor } = corridorAt(p.markPx, L, maintenanceMarginFraction(L));
    return { p, L, corridor, href: liqMapHref(p.symbol) };
  });
const others = rows.filter((r) => r.p.symbol !== perp.symbol);

const title = mapTitle(perp.symbol);
const description = mapDescription(perp.symbol);
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt}>
  <LiqMap perp={perp} table={table} snap={snap} params={q} />

  <h2 class="section">A map for every covered contract</h2>
  <p class="section-note" style="max-width:88ch">
    {rows.length} contracts have a published margin table, and each one has its own map at its own
    address. The corridor column is not modelled: it is the distance price has to travel before a
    position at that contract's maximum leverage is closed by the maintenance margin in the
    published table — the widest of them is the safest place to be wrong, and the narrowest is
    where a normal hour is enough.
  </p>
  <div class="panel">
    <table class="tbl">
      {/* ONE LINK PER ROW, AND THE ANCHOR TEXT IS THE QUERY. The first version put the bare
          symbol in a "Contract" column and repeated the same href in a "Map" column — two
          links to one destination, ninety-eight of them on a page that also carries the site
          chrome. Worse, half of them said "ETH" where the thing a reader searches for, and the
          thing Search Console shows people typing, is "eth liquidation map". Anchor text is
          the one part of an internal link a crawler reads as a description of the target. */}
      <thead>
        <tr>
          <th>Liquidation map</th>
          <th class="num">Mark</th>
          <th class="num">Open interest</th>
          <th class="num">Max leverage</th>
          <th class="num">Corridor at max</th>
        </tr>
      </thead>
      <tbody>
        {others.map((r) => (
          <tr>
            <td><a class="link" href={r.href}>{r.p.symbol} liquidation map →</a></td>
            <td class="num">{usd(r.p.markPx, priceDp(r.p.markPx))}</td>
            <td class="num">{usd(r.p.oiNotional)}</td>
            <td class="num">{r.L}×</td>
            <td class="num">{(r.corridor * 100).toFixed(2)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="section-note">
    Maintenance margin at tier 1 sets every corridor above; the tiers themselves are on each
    contract's own page, together with the map and the assumptions behind it.
  </p>
</Base>
