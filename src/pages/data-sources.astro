---
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import { getSnapshot, coldStart, OI_NOTIONAL_FLOOR } from "../lib/hyperliquid.ts";
import { usd } from "../lib/funding.ts";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();
/**
 * EVERY upstream operation that puts a number on a page. The heading above this table promises
 * a complete list, so it has to be one.
 *
 * It was not. The table listed three Hyperliquid endpoints and the code calls five: the two
 * that draw every candle and every funding series were missing, as were the Ethereum endpoints
 * behind /unlocks — which meant the page promising "every endpoint behind every number" covered
 * five of nine operations and two of five hosts. Nothing broke; the table was simply tidy and
 * incomplete, which is the harder kind of wrong to notice.
 *
 * The cadences were wrong too, and in a way worth naming: funding and mark were listed at
 * 5 min because that is the full-ingest cron, but worker/ingest.ts:154 minute() runs on
 * `* * * * *` and calls fetchLive(), which fetches BOTH metaAndAssetCtxs and predictedFundings.
 * They refresh every minute. Understating your own freshness is still a page telling a reader
 * something untrue about its numbers.
 *
 * Cadences below are the constants, not prose: RETAIN/CANDLE/HOURLY/FUNDING_REFRESH_HOURS in
 * worker/ingest.ts and the two crons in wrangler.toml.
 */
/* NAMING AN UPSTREAM WITHOUT LINKING TO IT IS HALF A CITATION.
   This table is the site's provenance claim — every number, the endpoint behind it, the
   cadence. It named five upstreams and linked to none, on a site that had zero external hrefs
   anywhere. A reader who wants to confirm that `predictedFundings` returns what this page says
   it returns had to go and find the documentation themselves. */
const UPSTREAM_DOCS: Record<string, string> = {"Hyperliquid": "https://hyperliquid.gitbook.io/hyperliquid-docs/for-developers/api", "Ethereum JSON-RPC": "https://ethereum.org/en/developers/docs/apis/json-rpc/", "Cloudflare": "https://developers.cloudflare.com/"};
const sources = [
  { what: "Funding rate, per venue", ep: "POST /info {\"type\":\"predictedFundings\"}", who: "Hyperliquid", freq: "1 min" },
  /* SPLIT, because one row was claiming one cadence for five figures fetched on two.
     fetchLive — the minute tick — returns ONLY mark and funding. Open interest, volume, the
     oracle price and the premium come from the five-minute snapshot, and that snapshot has
     been succeeding on roughly half its scheduled ticks (npm run cadence: 47% over 24h, p90
     gap 20 min), so calling them one-minute figures was wrong twice over. The contract pages
     already say this correctly — "Open interest, volume and the period figures come from the
     snapshot taken N min ago" — which made this table the drifted copy of the two. */
  { what: "Perpetual mark price", ep: "POST /info {\"type\":\"metaAndAssetCtxs\"}", who: "Hyperliquid", freq: "1 min" },
  /* THE QUALIFIER STAYS UNTIL A DAY OF DATA REMOVES IT. Measured after moving the cron off
     the round minutes: 21 of 21 runs succeeded, against 308 failures in 854 on the old
     schedule. Under the old 36% rate, twenty-one consecutive successes has probability about
     0.0001, so the fix is real — but 21 runs is under two hours, and dropping the qualifier on
     that evidence would repeat the "0% from a sample of three" mistake this file's history is
     full of. `npm run cadence` is the trigger: a full day at or above 95% and this reads a
     plain "5 min". */
  { what: "Open interest, 24h volume, oracle price, premium", ep: "POST /info {\"type\":\"metaAndAssetCtxs\"}", who: "Hyperliquid", freq: "5 min, when the tick succeeds" },
  { what: "Price candles behind every chart, hourly and daily", ep: "POST /info {\"type\":\"candleSnapshot\"}", who: "Hyperliquid", freq: "2 h / 12 h" },
  { what: "Realised funding history, behind the funding series", ep: "POST /info {\"type\":\"fundingHistory\"}", who: "Hyperliquid", freq: "6 h" },
  { what: "Maintenance-margin tiers", ep: "POST /info {\"type\":\"marginTable\",\"id\":N}", who: "Hyperliquid", freq: "build time" },
  { what: "Vesting and lock contract state behind the register", ep: "eth_call, eth_blockNumber", who: "Ethereum JSON-RPC", freq: "on demand" },
];
---
<Base title="Data sources" description="Every endpoint behind every number on this site, its refresh cadence, and an explicit list of what is deliberately absent.">
  <div class="page-head"><h1>Data sources</h1></div>
  <p class="prose">Every displayed figure comes from the table below and is rendered on the server before the page is sent, so it is present for readers, search crawlers and answer engines alike.</p>
  <div class="panel"><table class="tbl">
    <thead><tr><th>Figure</th><th>Endpoint</th><th>Source</th><th>Refresh</th></tr></thead>
    <tbody>{sources.map((s) => (<tr><td>{s.what}</td><td><code>{s.ep}</code></td><td>{UPSTREAM_DOCS[s.who] ? <a href={UPSTREAM_DOCS[s.who]} rel="noopener" target="_blank">{s.who}</a> : s.who}</td><td>{s.freq}</td></tr>))}</tbody>
  </table></div>
  <h2>The source that was withdrawn</h2>
  <p class="prose">
    Until <strong>19 August 2026</strong> the coin pages carried a spot price, 24-hour statistics
    and spot candle charts from Coinbase Exchange, plus the basis between that price and the
    perpetual. All of it has been removed and none of it is served anywhere, including through
    this site's JSON endpoint.
  </p>
  <p class="prose">
    Coinbase's <a href="https://www.coinbase.com/legal/market_data" rel="noopener" target="_blank">Market
    Data Terms of Use</a> (last updated 7 August 2026) were read in full on that date. Quoting that
    document, <code>https://www.coinbase.com/legal/market_data</code>: they bind on access alone — <em>"By accessing or using Coinbase Market Data, you agree to be bound by these
    Market Data Terms of Use"</em> — grant a licence only for <em>"personal or research purposes"</em>
    that <em>"may not be used to build an application intended for use by end users"</em>, and
    provide that, absent prior express written consent, you may not <em>"Redistribute, display, or
    disseminate the Market Data—or any data, charts, analytics, research, or other works based on,
    referring to, or derived from the Market Data"</em> to any third party outside your
    organisation. This site is a public website; that is the whole of the question.
  </p>
  <p class="prose">
    So the coin pages are now perpetual pages, drawn from the same Hyperliquid feed as the rest of
    the site. The <strong>basis</strong> went with the spot price, because computing it requires
    one. Nothing here substitutes Hyperliquid's oracle index for a spot price: the oracle is a
    validator median across venues rather than a traded market, and using it under the old label
    would be a different number wearing the old one's name.
  </p>

  <h2>The two venues we never contact</h2>
  <p class="prose">
    Binance and Bybit funding rates appear on this site, and <strong>no request is ever made to
    either.</strong> They arrive inside Hyperliquid's <code>predictedFundings</code> response — one
    query, to one venue — and that is checkable: there is no Binance or Bybit hostname anywhere in
    this codebase. Both venues' terms bind on accessing <em>their</em> service, and we do not.
  </p>
  <p class="prose">
    That is the whole of the position, and it is worth being exact about its shape rather than
    comfortable about it. <strong>We rely on not being party to those venues' terms — not on any
    permission from them.</strong> Neither has granted this site anything, neither has been asked,
    and nothing here should be read as a claim that they permit the display. It is an argument
    about who a contract reaches, and a lawyer has not tested it.
    {" "}<a href="https://www.bybit.com/en/help-center/article/Bybit-API-Terms-and-Conditions" rel="noopener" target="_blank">Bybit's
    API terms</a> were read on 19 August 2026; they bar providing access to Bybit's platform to a
    third party and bar automated retrieval, which is why this site does neither.
  </p>

  <h2>Which Ethereum endpoints</h2>
  <p class="prose">
    The on-chain figures are read from three interchangeable public JSON-RPC endpoints —
    <code>ethereum-rpc.publicnode.com</code>, <code>eth.drpc.org</code> and <code>1rpc.io</code> — whichever
    answers first. The table calls that "Ethereum JSON-RPC" because the reader's question is which chain and
    which method, not which mirror. They are named here anyway, for the narrower question that only a
    hostname can answer: whose terms apply, and where to read them.
  </p>

  <h2>Coverage</h2>
  <p class="prose">A coin is published once its perpetual holds {usd(OI_NOTIONAL_FLOOR)} of open interest, and keeps its page until that falls below $3.5M. {snap.eligibleCount} of {snap.universeCount} perpetuals clear that floor today; {snap.perps.length} are published.</p>
  {/* NAMED HERE BECAUSE THE PROMISE IS "EVERY HOST WE TALK TO", NOT "EVERY HOST BEHIND A
      NUMBER". The gate refused the push that added it until it appeared on this page, which is
      the check doing its job — but putting it in the table above would have been the wrong fix,
      because that table answers "where did this figure come from" and no figure comes from
      here. It gets its own heading instead. */}
  <h2>Outbound, and behind no figure</h2>
  <p class="prose">
    Five hosts are contacted that supply nothing you see. When a contract crosses the coverage
    floor or a coin reaches its publication date, a URL exists that did not exist before, and
    the ingest worker announces that one URL through the
    {" "}<a href="https://www.indexnow.org/" rel="noopener" target="_blank">IndexNow</a>
    {" "}protocol — to <code>api.indexnow.org</code> and, separately, to
    {" "}<code>www.bing.com</code>, <code>yandex.com</code>, <code>search.seznam.cz</code> and
    {" "}<code>searchadvisor.naver.com</code>. The protocol says one endpoint shares a
    submission with the others, and until 19 August only the shared one was called; the five
    were measured answering independently that day — one of them returns a different status
    code for the same request — so a success from the aggregator is not evidence that any
    particular index received anything. These are server-to-server calls: nothing about you is
    sent, because nothing about you is known — see
    {" "}<a class="link" href="/privacy">Privacy</a>.
    <strong>They fire on new URLs only</strong>, never on the prices moving. Every page here
    changes every five minutes; announcing that would be announcing nothing, twelve times an
    hour, which is the behaviour the protocol exists to be distinguished from.
  </p>

  <h2>What is deliberately absent</h2>
  <ul class="prose">
    <li><strong>Liquidation totals.</strong> Exchange feeds are throttled and any total would be understated — <a href="/methodology/liquidations">the full explanation</a>.</li>
    <li><strong>Market capitalisation and circulating supply.</strong> Every source that carries these
      restricts their display — CoinGecko's free tier is non-commercial, and the paid feeds are a purchase
      decision rather than an engineering one. So they are absent rather than quietly borrowed, and the
      <a href="/coins">coin pages</a> are ordered by measured traded volume rather than by a market cap
      this site cannot cite.</li>
    <li><strong>Binance and Bybit spot.</strong> Both are unreachable from this site's servers. Their
      <em>funding rates</em> appear because Hyperliquid publishes them in its own predicted-funding feed;
      their order books do not.</li>
    {/* This used to say OKX "is used as an internal cross-check". It is not used at all — there
        is no OKX request anywhere in this codebase. The sentence described a fallback that was
        considered and never built, which is a page making a claim about its own behaviour that
        is not true, and on this site that is the one thing that cannot be allowed to stand. */}
    <li><strong>OKX.</strong> Not called at all. There is no OKX request anywhere in this
      codebase and nothing here is derived from it, directly or as a cross-check — that half is
      checkable and is the part that matters. It was ruled out on a reading of its API Agreement
      recorded in July 2026; that reading is <em>uncited and unverified</em>, so it is given as
      our reason for a decision rather than as a statement about what OKX's terms say.</li>
    <li><strong>Predicted or forecast rates.</strong> Only the venues' own published next-interval rates appear; nothing here is a model output.</li>
  </ul>
  <Related items={[
    { href: "/status", label: "Status", note: "Whether the ingest described here actually ran, and what it saw." },
    { href: "/coins", label: "Coins", note: "Perpetual prices for the major coins, and why they are no longer spot prices." },
    { href: "/methodology", label: "Methodology", note: "What is done to these numbers once they arrive." },
    { href: "/privacy", label: "Privacy", note: "What is collected while serving them, and what is not." },
  ]} />

  <style>
    h2 { font-size: 16px; font-weight: 600; letter-spacing: -.01em; margin: 32px 0 var(--gap-block); }
    .p { max-width: 72ch; }
  </style>
</Base>
