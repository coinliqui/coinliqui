---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, requestedPerp } from "../../lib/hyperliquid.ts";
import { usd, pct, queryNum } from "../../lib/funding.ts";
import { liquidationPrice, tierFor, maintenanceMarginFraction, nextTierBoundary, type MarginTable, type Side } from "../../lib/margin.ts";
import tables from "../../data/margin-tables.json";

import Advisory from "../../components/Advisory.astro";
import Figure from "../../components/Figure.astro";
import Interests from "../../components/Interests.astro";
import { priceDp } from "../../lib/funding.ts";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();

const q = Astro.url.searchParams;
/* The contract and its tier table are chosen together — see pickPerp in src/lib/hyperliquid.ts
   for why these were two lines and what the second one did when the first one won. */
/* Pinned default, and an unknown symbol answers 404 instead of substituting the default.
   See requestedPerp in src/lib/hyperliquid.ts for what each of those replaced. */
const wantedSymbol = q.get("symbol");
const picked = requestedPerp(snap.perps, wantedSymbol, tables as Record<string, MarginTable>);
if (picked === null) return coldStart();
if (picked === "unknown") return Astro.rewrite(`/404?symbol=${encodeURIComponent(wantedSymbol!)}`);
const { perp, table } = picked;
const side = (q.get("side") === "short" ? "short" : "long") as Side;

// A notional large enough to land past the first tier boundary by default, so the page opens
// on the case the headline number gets wrong rather than on the case where it happens to hold.
const boundary = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound)[1]?.lowerBound;
const defaultNotional = boundary ? Math.round(boundary * 1.2) : 250_000;
const notional = queryNum(q.get("notional"), defaultNotional, { min: 1 });
const requested = queryNum(q.get("leverage"), perp.maxLeverage, { min: 1, max: 1000 });

/* PRICE PRECISION FROM MAGNITUDE, the same rule the contract pages use
   (src/pages/funding/[symbol].astro). usd(x, 2) annihilates anything under half a cent, so
   /tools/leverage?symbol=PUMP rendered "Liquidation falls at $0.00, 5.26% from the mark" —
   two statements that cannot both be true, server-side, at first byte. */
const pdp = priceDp(perp.markPx);
const px = (v: number) => usd(v, pdp);
const { tier, index } = tierFor(table, notional);
const permitted = tier.maxLeverage;
const mmf = maintenanceMarginFraction(permitted);
const effective = Math.min(requested, permitted);
const clamped = requested > permitted;

const headline = perp.maxLeverage;                 // what the contract advertises
const initialMargin = notional / effective;
const maintenanceMargin = notional * mmf;
const size = perp.markPx > 0 ? notional / perp.markPx : 0;
const r = liquidationPrice({ entryPrice: perp.markPx, positionSize: size, leverage: requested, side, table });
const next = nextTierBoundary(table, notional);

// Headroom: how far the price can move before maintenance margin is breached.
const buffer = initialMargin - maintenanceMargin;

/* THE STEP-DOWN, DRAWN, because it is the page's entire claim and it was only ever a sentence.
   "The advertised maximum applies to the smallest tier only" is abstract until the ladder is in
   front of you: five bars, each a tier's real ceiling, shrinking as the position grows. The
   tier the reader is actually in is marked, so the figure answers "what do I get" and "what
   would I lose by sizing up" in the same glance.

   Bars are the LEVERAGE, not the notional, because leverage is what the reader came to find and
   what steps; the notional range is the row's label. */
const ladder = [...table.marginTiers]
  .sort((a, b) => a.lowerBound - b.lowerBound)
  .map((t, i, all) => ({
    max: t.maxLeverage,
    from: t.lowerBound,
    to: all[i + 1]?.lowerBound ?? null,
    active: i === index,
  }));
const ladderMax = Math.max(...ladder.map((t) => t.max), 1);
const compactUsd = (v: number) => (v >= 1e6 ? `$${(v / 1e6).toFixed(v >= 1e7 ? 0 : 1)}M` : v >= 1e3 ? `$${Math.round(v / 1e3)}K` : `$${Math.round(v)}`);

const title = `Leverage calculator — what ${perp.symbol} actually allows at your size`;
/* THE DESCRIPTION MUST NOT PROMISE A STEP THAT DOES NOT EXIST. It asserted unconditionally
   that leverage "steps down as position size grows" — true for 30 of the 50 published
   contracts and false for the other 20, whose margin table has a single tier (LDO, ZRO,
   PENDLE, JTO, TAO, ETHFI and fourteen more). The page BODY was already honest: it renders
   the next-step sentence only when nextTierBoundary returns one. The meta description was
   not, and that is the copy a search result and an answer engine quote — the one place the
   claim is read without the page beside it to correct it. */
/* FIXED ONCE AND STILL WRONG, because the two branches answered different questions.
   `next` is nextTierBoundary(table, notional) — "is there a step ABOVE MY CURRENT NOTIONAL" —
   and the else-branch claimed "this contract has a single margin tier". Those coincide only
   when the notional sits in the first tier. Live, /tools/leverage told Google "BTC perpetuals
   have a single margin tier" while the table on the same page rendered two: at the default
   $180M notional BTC is already in its LAST tier, so there is no next step and the contract
   still has more than one. The description now counts tiers, which is the thing it asserts. */
const tierCount = table.marginTiers.length;
const description = tierCount > 1
  ? `Maximum leverage on ${perp.symbol} perpetuals steps down as position size grows, across ${tierCount} margin tiers. This shows the tier that applies at your notional, the margin required, and where the next step falls.`
  : `${perp.symbol} perpetuals have a single margin tier: the same maximum leverage and maintenance margin at every position size. This shows what that means for the margin you post and the liquidation price you get.`;
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt} crumb={{ href: "/tools", label: "Tools", current: "Leverage" }}>
  <div class="page-head">
    <p class="crumb"><a href="/tools">Tools</a> › Leverage</p>
    <h1>Leverage calculator</h1>
    <p>
      The advertised maximum applies to the smallest tier only &mdash; at the size this opens on,
      the real ceiling is <strong>{permitted}&times;</strong> against the {headline}&times; on the
      front of the page. Opens on {perp.symbol} at
      {" "}{px(perp.markPx)}, advertised at {perp.maxLeverage}×; this shows what that really allows
      at <strong>your</strong> notional, and what it costs in margin.
    </p>
    <Advisory />
  </div>

  <form method="GET" class="calc">
    <label>Coin
      <select name="symbol">{snap.perps.map((p) => <option value={p.symbol} selected={p.symbol === perp.symbol}>{p.symbol}</option>)}</select>
    </label>
    <label>Side
      <select name="side">
        <option value="long" selected={side === "long"}>Long</option>
        <option value="short" selected={side === "short"}>Short</option>
      </select>
    </label>
    <label>Position notional (USD)
      <input type="number" name="notional" value={notional} step="any" min="0" />
    </label>
    <label>Leverage wanted
      <input type="number" name="leverage" value={requested} step="1" min="1" />
    </label>
    <button class="btn btn--primary" type="submit">Calculate</button>
  </form>

  <Figure
    title={`${perp.symbol} margin tiers \u2014 the ceiling at every size`}
    lead={`${permitted}\u00d7`}
    leadNote={`at your ${compactUsd(notional)} notional \u00b7 the contract advertises ${headline}\u00d7`}
    fetchedAt={snap.fetchedAt}>
    <div class="bars">
      {ladder.map((t) => (
        <>
          <span class="bars__label">{t.to ? `${compactUsd(t.from)}\u2013${compactUsd(t.to)}` : `${compactUsd(t.from)}+`}</span>
          <span class="bars__track">
            <span
              class="bars__fill"
              style={`width:${Math.max(3, (t.max / ladderMax) * 100)}%${t.active ? ";background:var(--accent)" : ""}`}></span>
          </span>
          <span class="bars__value">{t.max}&times;{t.active && <span class="faint"> you</span>}</span>
        </>
      ))}
    </div>
    <p slot="note">
      {/* THE SENTENCE CANNOT ASSUME THE STEP HAS HAPPENED. It read "the most this contract will
          give you is 40x, not the 40x on the front of the page" — nonsense, and printed for
          every reader whose size is still in the first tier, which is most of them. The ladder
          is a fact about the contract; whether YOU have stepped down is a fact about your size,
          and they are different sentences. */}
      Every venue publishes a ladder like this and quotes only its top rung. Yours is the
      highlighted row.
      {permitted < headline
        ? <> At {compactUsd(notional)} the most this contract will give you is <b>{permitted}&times;</b>,
          not the {headline}&times; on the front of the page.</>
        : <> At {compactUsd(notional)} you are still in the top rung, so the advertised
          {" "}<b>{headline}&times;</b> is really available &mdash; it is size, not the contract, that
          takes it away.</>}
      {next && <> The next step down begins at {compactUsd(next.lowerBound)}, where the ceiling becomes {next.maxLeverage}&times;.</>}
    </p>
  </Figure>

  <div class="cards" style="margin-top:12px">
    <div class="card card--lead">
      <div class="card__label">Allowed at this size</div>
      <div class="card__value" id="out-permitted">{permitted}×</div>
      <div class="card__meta">tier <span id="out-tier">{index + 1}</span> · maintenance <span id="out-mmf">{pct(mmf, 3)}</span></div>
    </div>
    <div class="card">
      <div class="card__label">Advertised maximum</div>
      <div class="card__value dim" id="out-headline">{headline}×</div>
      <div class="card__meta">applies to the smallest tier only</div>
    </div>
    <div class="card">
      <div class="card__label">Initial margin</div>
      <div class="card__value" id="out-im">{usd(initialMargin)}</div>
      <div class="card__meta">at <span id="out-eff">{effective}</span>× effective</div>
    </div>
    <div class="card">
      <div class="card__label">Maintenance margin</div>
      <div class="card__value" id="out-mm">{usd(maintenanceMargin)}</div>
      <div class="card__meta">buffer <span id="out-buffer">{usd(buffer)}</span> before liquidation</div>
    </div>
  </div>

  <div class:list={["verdict", clamped ? "verdict--warn" : "verdict--ok"]} id="out-verdict">
    <div id="out-verdict-text">
      {clamped ? (
        <><b>{requested}× is not available at this size.</b> {usd(notional)} of notional falls in tier
        {" "}{index + 1}, which caps leverage at <b>{permitted}×</b>. The order is filled at the cap or
        rejected, depending on the venue — either way the position is not the one you sized.</>
      ) : (
        <><b>{requested}× is available at this size.</b> {usd(notional)} of notional sits in tier
        {" "}{index + 1}, where the cap is {permitted}×. Liquidation falls at
        {" "}<b>{px(r.liquidationPrice)}</b>, {pct(r.distancePct)} from the mark.</>
      )}
    </div>
  </div>

  <h2 class="section">Why the advertised number is not your number</h2>
  <p class="prose">
    Exchanges publish a single headline maximum — {headline}× on this contract — and then apply a
    <strong>margin tier table</strong> that steps the cap down as position size grows. The headline
    applies only to the smallest tier. Above it, both the permitted leverage and the maintenance
    margin change, and the liquidation price moves with them.
  </p>
  {next && (
    <p class="prose">
      The next step here is at <strong>{usd(next.lowerBound)}</strong>, where the cap drops to
      {" "}<strong>{next.maxLeverage}×</strong> and maintenance margin rises to
      {" "}<strong>{pct(maintenanceMarginFraction(next.maxLeverage), 3)}</strong>. Sizing across that
      boundary changes the terms of the position already open.
    </p>
  )}

  <h2 class="section">Every tier on {perp.symbol}</h2>
  <p class="section-note">
    Contract table <code>{perp.marginTableId}</code>{table.description ? ` — ${table.description}` : ""}.
    Your notional of <strong style="color:var(--text)">{usd(notional)}</strong> is in tier {index + 1}.
  </p>
  <div class="panel" style="max-width:720px">
    <table class="tbl">
      <thead><tr><th>Tier</th><th class="num">Notional from</th><th class="num">Max leverage</th><th class="num">Maintenance margin</th><th class="num">Initial margin on {usd(notional)}</th></tr></thead>
      <tbody>
        {table.marginTiers.map((t, i) => (
          <tr class={i === index ? "is-active" : undefined}>
            <td>{i + 1}{i === index ? " · yours" : ""}</td>
            <td class="num">{usd(t.lowerBound)}</td>
            <td class="num">{t.maxLeverage}×</td>
            <td class="num">{pct(maintenanceMarginFraction(t.maxLeverage), 3)}</td>
            <td class="num">{usd(notional / t.maxLeverage)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p style="margin-top:24px">
    <a class="link" href="/tools/position-size">Size it against a stop →</a>
    · <a class="link" href="/methodology">How these numbers are produced →</a>
  </p>

  <script is:inline define:vars={{ table, markPx: perp.markPx, headline, pdp }}>
    const form = document.querySelector(".calc");
    if (form) {
      /* MUST MATCH the server's px() above. Math.round() is right for notional and margin —
         whole dollars — and catastrophic for a PRICE: it turns every sub-cent liquidation into
         $0. The server picks decimals from magnitude; so does this. */
      const money = (x) => "$" + Math.round(Math.abs(x)).toLocaleString("en-US");
      const price = (x) => "$" + Math.abs(x).toLocaleString("en-US", { minimumFractionDigits: pdp, maximumFractionDigits: pdp });
      const pc = (x, d = 3) => (x * 100).toFixed(d) + "%";
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      const tiers = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound);
      const recalc = () => {
        const N = Number(form.notional.value), L = Number(form.leverage.value);
        if (!(N >= 0) || !(L > 0)) return;
        let idx = 0;
        tiers.forEach((t, i) => { if (N >= t.lowerBound) idx = i; });
        const permitted = tiers[idx].maxLeverage;
        const mmf = 1 / (2 * permitted);
        const eff = Math.min(L, permitted);
        const im = N / eff, mm = N * mmf;
        set("out-permitted", permitted + "×");
        set("out-tier", String(idx + 1));
        set("out-mmf", pc(mmf));
        set("out-im", money(im));
        set("out-eff", String(eff));
        set("out-mm", money(mm));
        set("out-buffer", money(im - mm));
        const v = document.getElementById("out-verdict");
        if (v) v.className = "verdict " + (L > permitted ? "verdict--warn" : "verdict--ok");
        const t = document.getElementById("out-verdict-text");
        if (t) t.textContent = L > permitted
          ? `${L}× is not available at this size. ${money(N)} of notional falls in tier ${idx + 1}, which caps leverage at ${permitted}×. The order is filled at the cap or rejected, depending on the venue — either way the position is not the one you sized.`
          : `${L}× is available at this size. ${money(N)} of notional sits in tier ${idx + 1}, where the cap is ${permitted}×.`;
      };
      form.addEventListener("input", recalc);
      form.addEventListener("change", (e) => { if (e.target.name === "symbol") form.submit(); else recalc(); });
    }
  </script>
  <Interests />
</Base>
