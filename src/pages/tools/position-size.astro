---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, requestedPerp } from "../../lib/hyperliquid.ts";
import { usd, pct, queryNum, stopVerdict } from "../../lib/funding.ts";
import ASSETS from "../../data/assets.json";
import { liquidationPrice, tierFor, maintenanceMarginFraction, type MarginTable, type Side } from "../../lib/margin.ts";
import tables from "../../data/margin-tables.json";

import Advisory from "../../components/Advisory.astro";
import Figure from "../../components/Figure.astro";
import Interests from "../../components/Interests.astro";
import { priceDp } from "../../lib/funding.ts";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();

const q = Astro.url.searchParams;
/* The contract and its tier table are chosen together — see pickPerp in src/lib/hyperliquid.ts
   for why these were two lines and what the second one did when the first one won. */
/* Pinned default, and an unknown symbol answers 404 instead of substituting the default.
   See requestedPerp in src/lib/hyperliquid.ts for what each of those replaced. */
const wantedSymbol = q.get("symbol");
const picked = requestedPerp(snap.perps, wantedSymbol, tables as Record<string, MarginTable>);
if (picked === null) return coldStart();
if (picked === "unknown") return Astro.rewrite(`/404?symbol=${encodeURIComponent(wantedSymbol!)}`);
const { perp, table } = picked;
const side = (q.get("side") === "short" ? "short" : "long") as Side;

const account = queryNum(q.get("account"), 25_000, { min: 1 });
const riskPct = queryNum(q.get("risk"), 1, { min: 0.01, max: 100 });
const entry = queryNum(q.get("entry"), perp.markPx, { min: 1e-9 });
/* PRICE PRECISION IS A FUNCTION OF MAGNITUDE, not a constant. Same rule as the contract
   pages: src/pages/funding/[symbol].astro:48. */
const dp = priceDp(entry);
const px = (v: number) => usd(v, dp);
const defaultStop = side === "long" ? entry * 0.95 : entry * 1.05;
/* .toFixed(2) HERE WAS A REAL POSITION-SIZING ERROR, not a display one. It rounded the default
   stop — a PRICE — to two decimals, so on DOGE at $0.070063 the intended 5% stop became
   "0.07", which is 0.09% from entry. `perUnit` collapsed, size = risk / perUnit exploded to
   3.97M DOGE, and the page confidently described a $278,028 notional position that needs
   $27,803 of margin on the $25,000 account it was told about. On kBONK every price on the page
   rounded to "$0.00" and it explained a position priced at nothing. The stop now carries the
   same precision as the price it is derived from. */
const stop = queryNum(q.get("stop"), Number(defaultStop.toFixed(dp)), { min: 1e-9 });
const leverage = queryNum(q.get("leverage"), 10, { min: 1, max: 1000 });

// The formula every sizing guide gives: risk budget divided by the distance to the stop.
const riskUsd = account * (riskPct / 100);
const perUnit = Math.abs(entry - stop);
const size = perUnit > 0 ? riskUsd / perUnit : 0;
const notional = size * entry;

// What that formula assumes and never checks: that the stop is reached before liquidation.
const r = liquidationPrice({ entryPrice: entry, positionSize: size, leverage, side, table });
const { tier } = tierFor(table, notional);
const mmf = maintenanceMarginFraction(tier.maxLeverage);
/* THREE STATES, NOT TWO, and the third was being reported as the safest of them.
 *
 * This line used to be a bare price ordering: for a long, liquidation above the stop meant
 * liquidation came first. It is a proxy for the real question — does an ADVERSE move reach the
 * stop before it reaches liquidation — and the two agree only while the stop is on the losing
 * side of entry, which nothing checked.
 *
 * Measured live before this change: ?side=short&entry=110000&stop=100000&leverage=5 rendered
 * data-state="stop" and "the stop executes first and the loss is bounded by the $250.00 you
 * budgeted", for a short whose stop sits 9.09% into profit and can never fill on the losing
 * side. The rule now lives in public/shared.js so the calculator's own script cannot disagree
 * with the server about it — this page has already shipped that disagreement twice. */
const verdict = stopVerdict(side, entry, stop, r.liquidationPrice);
const liquidatedFirst = verdict === "liq";
const stopUnreachable = verdict === "wrongside";
/* Both non-benign states earn the alert colour. Only one of them used to. */
const alarming = liquidatedFirst || stopUnreachable;

/* THE BRANCH THAT IS NOT TRUE IS NOT IN THE DOCUMENT.
 *
 * Both verdicts used to be rendered as divs, with `hidden` on the false one. The note here
 * argued that `hidden` was the honest form — "a text extractor that applies no stylesheet,
 * which is what an AI crawler is, would otherwise read BOTH sentences and take the first".
 * That reasoning was right about the danger and wrong about the remedy: `hidden` is
 * display:none from the UA stylesheet, and display has no bearing on textContent. Anything
 * extracting text naively still took "The stop never executes" from a page whose stop executes
 * perfectly well. The gate found it only after the check was fixed to see nested elements.
 *
 * <template> is the element whose content is genuinely not in the document: inert, unrendered,
 * and absent from textContent, while remaining right there in the markup for the interaction
 * layer to promote when the reader changes a parameter. The house rule — every number
 * server-rendered at first byte — is about the TRUE state, and the true state is still a plain
 * div. The counterfactual was never owed a first-byte rendering; it is only reachable through
 * an interaction that requires script anyway. */
const LiqTag = verdict === "liq" ? "div" : "template";
const StopTag = verdict === "stop" ? "div" : "template";
const NoneTag = verdict === "wrongside" ? "div" : "template";

// Largest leverage that still leaves liquidation beyond the stop. Solved from
// liq = entry(1 ∓ 1/L)/(1 ∓ mmf), set equal to the stop.
const ratio = stop / entry;
const denom = side === "long" ? 1 - ratio * (1 - mmf) : ratio * (1 + mmf) - 1;
const rawSafe = denom > 0 ? 1 / denom : Infinity;
/* THE OTHER END OF THE SAME SOLVE, WHICH THE EM DASH BELOW DOES NOT COVER. rawSafe is the
   leverage at which liquidation EQUALS the stop, so only L below it keeps liquidation beyond.
   Math.floor respects that; Math.max(1, ...) does not. When the stop is far enough away on the
   losing side that denom exceeds 1 — for a short, any stop past about twice entry — rawSafe
   falls below 1, floor gives 0, and the clamp lifts it back to 1, a leverage strictly GREATER
   than the value solved for. In that regime no leverage satisfies the claim at all, and the
   card asserted that 1x did.

   Worked case on this repository's own margin table 3 (maxLeverage 3, so mmf = 1/6): short,
   entry 100, stop 200. ratio 2, denom 1.3333, rawSafe 0.75, safeLeverage 1. Short liquidation
   at 1x is 100 * (1 + 1/1) / (1 + 1/6) = 171.43, and for a short the adverse move is upward,
   so liquidation is reached BEFORE the 200 stop. The card read "1x / keeps liquidation beyond
   $200.00". stopVerdict classifies this as "liq", not "wrongside", so the existing guard never
   fired. */
const noSafeLeverage = Number.isFinite(rawSafe) && rawSafe < 1;
const safeLeverage = Math.max(1, Math.min(tier.maxLeverage, Math.floor(Number.isFinite(rawSafe) ? rawSafe : tier.maxLeverage)));

// The harm when liquidation lands first is PREMATURE CLOSURE, not a larger loss. At high
// leverage the margin can be smaller than the risk budget, so framing this as "you lose more"
// is wrong — the trade is simply killed at a smaller move than it was sized to survive.
const marginAtRisk = notional / Math.min(leverage, tier.maxLeverage);
const liqMove = entry > 0 ? Math.abs(r.liquidationPrice - entry) / entry : 0;

/* THE THREE PRICES AS POSITIONS, because their ORDER is the answer this page exists to give.
   Entry, stop and liquidation were three numbers in three cards, and whether the stop is reached
   before the liquidation — the one thing a reader is here to find out — had to be worked out by
   comparing them. On a scale it is the first thing seen: if the liquidation mark sits between the
   entry and the stop, the stop never executes.

   The span is the three marks plus a tenth on each side, so two prices a hair apart still
   separate, and the marks are placed as percentages that CSS positions. Nothing is drawn in an
   SVG: every part of this figure is a word or a rule. */
const scaleMarks = [
  { at: entry, label: "Entry", value: px(entry), tone: "", up: true },
  { at: stop, label: "Stop", value: px(stop), tone: "", up: false },
  { at: r.liquidationPrice, label: "Liquidation", value: px(r.liquidationPrice), tone: side === "long" ? "l" : "s", up: true },
].filter((m) => Number.isFinite(m.at) && m.at > 0);
const scaleLo0 = Math.min(...scaleMarks.map((m) => m.at));
const scaleHi0 = Math.max(...scaleMarks.map((m) => m.at));
const scalePad = (scaleHi0 - scaleLo0 || scaleHi0 || 1) * 0.12;
const scaleLo = scaleLo0 - scalePad, scaleHi = scaleHi0 + scalePad;
const scaleAt = (v: number) => ((v - scaleLo) / (scaleHi - scaleLo)) * 100;
/* Two marks closer than a tenth of the span would overlap their labels, so the second one drops
   to the lower rail. Measured in percent of the width, which is what they are positioned in. */
const scaleRows = scaleMarks
  .slice()
  .sort((m, n) => m.at - n.at)
  .map((m, i, all) => ({ ...m, up: i > 0 && scaleAt(m.at) - scaleAt(all[i - 1].at) < 18 ? !all[i - 1].up : m.up }));
const stopMove = entry > 0 ? Math.abs(stop - entry) / entry : 0;

const title = `Position size calculator with liquidation check`;
const description = `Risk-based position sizing for ${perp.symbol} perpetuals that checks the stop against the tier-correct liquidation price — because a stop beyond liquidation is not a stop.`;
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt} crumb={{ href: "/tools", label: "Tools", current: "Position size" }}>
  <div class="page-head">
    <p class="crumb"><a href="/tools">Tools</a> › Position size</p>
    <h1>Position size calculator</h1>
    <p>
      {/* THE DISTANCE, IN THE OPENING. It is the page's answer and it sat only in a card below
          the form, outside the window an extractor keeps. */}
      Risk-based sizing, checked against the price at which the position is actually closed.
      At {leverage}&times; the liquidation sits <strong>{pct(liqMove)}</strong> from the entry
      and the stop {pct(stopMove)} away, so {verdict === "liq" ? "the venue closes the position first" : verdict === "wrongside" ? "the stop is not on the losing side" : "the stop executes first"}.
      Opens on {perp.symbol} at {px(perp.markPx)}.
    </p>
    <Advisory />
  </div>

  <form method="GET" class="calc">
    <label>Coin
      <select name="symbol">{snap.perps.map((p) => <option value={p.symbol} selected={p.symbol === perp.symbol}>{p.symbol}</option>)}</select>
    </label>
    <label>Side
      <select name="side">
        <option value="long" selected={side === "long"}>Long</option>
        <option value="short" selected={side === "short"}>Short</option>
      </select>
    </label>
    <label>Account size (USD)
      <input type="number" name="account" value={account} step="any" min="0" />
    </label>
    <label>Risk per trade (%)
      <input type="number" name="risk" value={riskPct} step="any" min="0" max="100" />
    </label>
    <label>Entry price (USD)
      <input type="number" name="entry" value={entry} step="any" min="0" />
    </label>
    <label>Stop price (USD)
      <input type="number" name="stop" value={stop} step="any" min="0" />
    </label>
    <label>Leverage
      <input type="number" name="leverage" value={leverage} step="1" min="1" max={perp.maxLeverage} />
    </label>
    <button class="btn btn--primary" type="submit">Calculate</button>
  </form>

  <Figure
    title={`${perp.symbol} ${side} \u2014 where the stop sits against liquidation`}
    lead={pct(liqMove)}
    leadNote={`from entry to liquidation at ${leverage}\u00d7 \u00b7 your stop is ${pct(stopMove)} away`}
    fetchedAt={snap.fetchedAt}
    modelled>
    {/* NOT aria-hidden, AND THE GATE REFUSED THE FIRST VERSION THAT WAS. It looked decorative —
        a rule and three ticks — so it was marked hidden from assistive technology, and
        hiddenFromEveryone pointed out what that actually buried: "Liquidation $57,520.71 Stop
        $59,957.35 Entry $63,113.00" is not decoration, it is the ordered triple this page exists
        to state, and nowhere else does it appear in that order. */}
    <div class="scale">
      <span class="scale__line"></span>
      {scaleRows.map((m) => (
        <>
          <span class:list={["scale__mark", m.tone === "l" && "scale__mark--l", m.tone === "s" && "scale__mark--s"]} style={`left:${scaleAt(m.at)}%`}></span>
          <span
            class:list={["scale__tag", m.up ? "scale__tag--up" : "scale__tag--down",
              scaleAt(m.at) < 15 && "scale__tag--start", scaleAt(m.at) > 85 && "scale__tag--end"]}
            style={`left:${scaleAt(m.at)}%`}>{m.label}<b>{m.value}</b></span>
        </>
      ))}
    </div>
    <p slot="note">
      {verdict === "liq"
        ? <><b>Liquidation sits between the entry and the stop, so the stop never executes.</b> The
          position is closed by the venue first, and the loss is the margin rather than the amount
          you budgeted.</>
        : verdict === "wrongside"
          ? <>The stop is not on the losing side of the entry, so nothing modelled here can reach it.</>
          : <><b>The stop is reached first</b>, so the loss is bounded by what you budgeted. Liquidation
            lies further from the entry than the stop does, which is the whole test.</>}
      {" "}Distances are to scale; the liquidation price is the venue&rsquo;s tier-correct one.
    </p>
  </Figure>

  <div class="cards" style="margin-top:12px">
    <div class="card card--lead">
      <div class="card__label">Position size</div>
      <div class="card__value" id="out-size">{size.toFixed(4)}</div>
      <div class="card__meta">{perp.symbol} · notional <span id="out-notional">{usd(notional)}</span></div>
    </div>
    <div class="card">
      {/* THE LEVERAGE THAT WAS USED, not the one requested. margin.ts clamps the request to
          the tier maximum and reports it in effectiveLeverage; this card printed the requested
          figure beside the clamped result. On MON — tier max 5x — it read "Liquidation at 10x
          $0.01793", and $0.01793 is entry x (1 - 1/5) / (1 - 1/10): the FIVE-times price under
          a TEN-times label, on a page someone sizes a position from.

          The identical bug was fixed on /funding/[symbol] earlier today and this sibling never
          got the change — the same one-policy-two-templates shape as the /coins case guard. */}
      <div class="card__label">Liquidation at {r.effectiveLeverage}×{r.leverageClamped && <span class="card__scope">tier max</span>}</div>
      <div class:list={["card__value", alarming && "card__value--alert"]} id="out-liq">{px(r.liquidationPrice)}</div>
      <div class="card__meta" id="out-liqnote">{stopUnreachable ? `your stop is ${side === "long" ? "above" : "below"} entry` : liquidatedFirst ? "before your stop" : "beyond your stop"}</div>
    </div>
    <div class="card">
      <div class="card__label">Closed out by a move of</div>
      <div class:list={["card__value", alarming && "card__value--alert"]} id="out-move">{pct(liqMove)}</div>
      <div class="card__meta">you sized for <span id="out-stopmove">{pct(stopMove)}</span></div>
    </div>
    <div class="card">
      <div class="card__label">Max leverage for this stop</div>
      {/* A NUMBER THAT ANSWERS A QUESTION NOBODY ASKED. Solving liq = stop for L assumes the
          stop is on the losing side; when it is not, the denominator goes negative, rawSafe
          becomes Infinity and this card printed the contract's tier maximum as though it were
          a safety finding. An em dash is the honest output for a question with no answer. */}
      <div class="card__value" id="out-safe">{stopUnreachable || noSafeLeverage ? "—" : `${safeLeverage}×`}</div>
      <div class="card__meta" id="out-safenote">{stopUnreachable ? "the stop is not on the losing side" : noSafeLeverage ? "no leverage keeps liquidation beyond this stop" : `keeps liquidation beyond ${px(stop)}`}</div>
    </div>
  </div>

  {/* BOTH VERDICTS ARE RENDERED, and a data attribute chooses which is shown.
      The client used to update only this element's className, so changing an input turned the
      box amber while the sentence inside it still read "The stop is reachable" — the colour and
      the words asserting opposite things, on a page someone sizes a position from. Verified in
      the browser: a 20% stop with liquidation 5.26% away flipped the class and the "before your
      stop" note, and left the prose untouched.

      Rendering both and toggling is the fix that respects the house rule rather than working
      around it: every number is server-rendered at first byte, a crawler sees the true state,
      and the interaction layer only reveals what is already there. Every live figure inside the
      prose carries an id so the same set() that updates the cards updates the sentence. */}
  <div class:list={["verdict", alarming ? "verdict--warn" : "verdict--ok"]} id="out-verdict" data-state={verdict}>
    {/* EVERY FIGURE IN HERE CARRIES AN ID, and six of them did not.
        The cards were kept current and the sentences explaining them were left at their
        first-byte values, which is worse than either being wrong alone — the two disagree on
        the same screen. Observed in the browser on the deployed page: leverage 5 → 60 repainted
        the liquidation price and left the sentence saying "At 5× the exchange closes this
        position at $111,358.02", a price only 60× produces. The green branch was quieter and
        worse: the loss it says is bounded by "the $250.00 you budgeted" never moved when
        Account or Risk did, so the one number the card exists to promise was the stalest thing
        on the page. Enforced now by staleCalculatorFigures in scripts/checks.mjs. */}
    <LiqTag data-when="liq">
        <b>The stop never executes.</b> At <b id="v-lev1">{r.effectiveLeverage}×</b><span id="v-clamp1">{r.leverageClamped ? " — this contract's tier maximum, so the leverage you asked for cannot be opened —" : ""}</span> the exchange closes this position at
        {" "}<b id="v-liq1">{px(r.liquidationPrice)}</b> — a <b id="v-move1">{pct(liqMove)}</b> move — while your stop sits
        {" "}<span id="v-stopmove1">{pct(stopMove)}</span> away at <span id="v-stop1">{px(stop)}</span>. The trade gets <b id="v-move4">{pct(liqMove)}</b> of room
        instead of the <span id="v-stopmove4">{pct(stopMove)}</span> it was sized to survive, and the entire
        {" "}<b id="v-margin1">{usd(marginAtRisk, 2)}</b> of margin goes with it.
        That the margin happens to be <span id="v-cmp1">{marginAtRisk < riskUsd ? "smaller" : "larger"}</span> than your
        {" "}<span id="v-risk1">{usd(riskUsd, 2)}</span> budget is beside the point: the position never got to be wrong slowly.
        {/* NO FIGURE IN THIS SENTENCE, DELIBERATELY. It used to repeat safeLeverage, which the
            "Max leverage for this stop" card above already prints and already repaints — and a
            second copy of a figure inside a verdict is exactly what staleDerivedCells exists to
            refuse, because the client owns this whole sentence by textContent and a nested
            element would not survive the first keystroke. The remedy points at the card. */}
        <span id="v-safefix">{noSafeLeverage
          ? "Move the stop closer: at this distance no leverage keeps liquidation beyond it."
          : "Cut leverage to the maximum shown above, or move the stop closer."}</span>
    </LiqTag>
    <StopTag data-when="stop">
        <b>The stop is reachable.</b> Liquidation sits at <b id="v-liq2">{px(r.liquidationPrice)}</b>
        (<span id="v-move2">{pct(liqMove)}</span> away), past your stop at <span id="v-stopmove2">{pct(stopMove)}</span>, so the stop executes first and the
        loss is bounded by the <b id="v-risk2">{usd(riskUsd, 2)}</b> you budgeted. Leverage up to
        {" "}<b id="v-safe1">{safeLeverage}×</b> keeps that true.
    </StopTag>
    <NoneTag data-when="wrongside">
        <b>That is not a stop.</b> A <span id="v-side3">{side}</span> loses money when the price <span id="v-dir3">{side === "long" ? "falls" : "rises"}</span>,
        and your stop at <span id="v-stop2">{px(stop)}</span> sits <span id="v-stopmove3">{pct(stopMove)}</span>
        {" "}<span id="v-rel3">{side === "long" ? "above" : "below"}</span> entry — on the side where the trade is winning. An adverse
        move never reaches it, so nothing here bounds the loss except the exchange: liquidation at
        {" "}<b id="v-liq3">{px(r.liquidationPrice)}</b>, a <b id="v-move3">{pct(liqMove)}</b> move, taking the whole
        {" "}<b id="v-margin3">{usd(marginAtRisk, 2)}</b> of margin. The position size above is what the standard formula
        returns from the distance you gave it; it is not a risk of <span id="v-risk3">{usd(riskUsd, 2)}</span>.
        Put the stop <span id="v-put3">{side === "long" ? "below" : "above"}</span>{" "}<span id="v-entry3">{px(entry)}</span> and this page can answer the question again.
    </NoneTag>
  </div>

  <h2 class="section">Why sizing alone is not enough</h2>
  <p class="prose">
    The standard formula — <code>risk budget ÷ distance to stop</code> — sizes the position so that
    <em>if the stop fills</em>, you lose exactly what you budgeted. It says nothing about whether
    the stop is reachable. Leverage sets the liquidation price independently, and when liquidation
    falls between entry and stop the exchange closes the position first. The stop is then decoration.
  </p>
  <p class="prose">
    The check has to use the <strong>tier-correct</strong> liquidation price. At {usd(notional)}
    notional this contract sits in tier {r.tierIndex + 1}, where maintenance margin is
    {" "}{pct(mmf, 3)} — so liquidation is {pct(r.differencePct)} ({px(r.differenceAbs)}) away from what the common
    <code>entry × (1 ∓ 1/leverage)</code> formula reports.
    <a class="link" href="/funding/btc">See that gap on a live contract →</a>
  </p>
  <p class="section-note">
    Fees, slippage and funding are not deducted here, and a gap through the stop can exceed the
    budgeted loss regardless of sizing. Maintenance margin is read at the tier your notional falls
    in; a size large enough to cross a boundary moves it further.
  </p>

  <p style="margin-top:24px">
    <a class="link" href="/tools/leverage">What leverage this contract actually allows →</a>
    · <a class="link" href={`/funding/${perp.symbol.toLowerCase()}`}>{perp.symbol} detail →</a>
  </p>

  {/* A MODULE, SO IT CAN READ THE SAME RULE THE SERVER DID.
      This was a classic inline script carrying its own copy of the verdict test — `const first
      = isLong ? liq > S : liq < S` — which is how the page shipped one defect in two places at
      once. It now imports stopVerdict from public/shared.js, with the asset version forwarded
      the way interact.js forwards it, because public/ is served with max-age=14400 and a bare
      import would let a browser pair today's page with a four-hour-old module. */}
  <script is:inline type="module" define:vars={{ table, symbol: perp.symbol, dp, sharedV: ASSETS["/shared.js"] }}>
    const { stopVerdict } = await import("/shared.js" + (sharedV ? `?v=${sharedV}` : ""));
    const form = document.querySelector(".calc");
    if (form) {
      /* TWO FORMATTERS, because two kinds of number. `money` is account currency — the risk
         budget, the margin — and cents are right for those. `price` is an instrument price and
         takes the SERVER's magnitude-derived precision, or the client rewrites kBONK's correct
         $0.0022225 into $0.00 the moment any input is touched. Same server/client pair that
         rewrote 200 volume cells on a click. */
      const money = (x) => "$" + Math.abs(x).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const price = (x) => "$" + Math.abs(x).toLocaleString("en-US", { minimumFractionDigits: dp, maximumFractionDigits: dp });
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      const tiers = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound);
      const recalc = () => {
        const A = Number(form.account.value), R = Number(form.risk.value);
        const E = Number(form.entry.value), S = Number(form.stop.value), L = Number(form.leverage.value);
        const isLong = form.side.value === "long";
        if (!(A >= 0) || !(E > 0) || !(L > 0) || !(Math.abs(E - S) > 0)) return;
        const riskUsd = A * (R / 100);
        const size = riskUsd / Math.abs(E - S);
        const notional = size * E;
        let idx = 0;
        tiers.forEach((t, i) => { if (notional >= t.lowerBound) idx = i; });
        const maxLev = tiers[idx].maxLeverage;
        const mmf = 1 / (2 * maxLev);
        const eff = Math.min(L, maxLev);
        const liq = isLong ? (E * (1 - 1 / eff)) / (1 - mmf) : (E * (1 + 1 / eff)) / (1 + mmf);
        const state = stopVerdict(isLong ? "long" : "short", E, S, liq);
        const first = state === "liq";
        const wrong = state === "wrongside";
        const alarm = first || wrong;
        const ratio = S / E;
        const denom = isLong ? 1 - ratio * (1 - mmf) : ratio * (1 + mmf) - 1;
        const safe = Math.max(1, Math.min(maxLev, Math.floor(denom > 0 ? 1 / denom : maxLev)));
        set("out-size", size.toFixed(4));
        set("out-notional", "$" + Math.round(notional).toLocaleString("en-US"));
        set("out-liq", price(liq));
        set("out-liqnote", wrong ? `your stop is ${isLong ? "above" : "below"} entry` : first ? "before your stop" : "beyond your stop");
        set("out-move", ((Math.abs(liq - E) / E) * 100).toFixed(2) + "%");
        set("out-stopmove", ((Math.abs(S - E) / E) * 100).toFixed(2) + "%");
        const mv = document.getElementById("out-move");
        if (mv) mv.className = "card__value" + (alarm ? " card__value--alert" : "");
        /* THE THIRD STATE. `wrong` is denom <= 0; this is denom > 1, where the solved leverage
           is below 1 and the Math.max clamp above lifts it back up past the answer. Mirrored
           here because a card that is honest on first render and false after one keystroke is
           the same defect with a delay. */
        const noSafe = denom > 0 && 1 / denom < 1;
        set("out-safe", wrong || noSafe ? "—" : safe + "×");
        set("out-safenote", wrong ? "the stop is not on the losing side" : noSafe ? "no leverage keeps liquidation beyond this stop" : "keeps liquidation beyond " + price(S));
        set("v-safefix", noSafe
          ? "Move the stop closer: at this distance no leverage keeps liquidation beyond it."
          : "Cut leverage to the maximum shown above, or move the stop closer.");
        /* The VERDICT is a state, not a colour. Setting className alone left the sentence
           contradicting its own box; the attribute selects which server-rendered variant shows,
           and the ids below keep its figures current. */
        const verdictEl = document.getElementById("out-verdict");
        if (verdictEl) {
          verdictEl.dataset.state = state;
          /* `hidden` rather than CSS alone: a text extractor that applies no stylesheet — which
             is what an AI crawler is — would otherwise read BOTH sentences and take the first,
             so a page in the "stop" state would read as "The stop never executes". The CSS rule
             stays for the visual case; this is what makes the DOM itself honest. */
          verdictEl.className = "verdict " + (alarm ? "verdict--warn" : "verdict--ok");
          /* Promote the branch that is now true into the document, demote the other into a
             template. Done BEFORE the figures are set below, so the ids being written are the
             ones now live — a template's contents are unreachable to getElementById. */
          verdictEl.querySelectorAll("[data-when]").forEach(function (el) {
            var live = el.dataset.when === verdictEl.dataset.state;
            var isTpl = el.tagName === "TEMPLATE";
            if (live !== isTpl) return;
            var repl = document.createElement(live ? "div" : "template");
            repl.dataset.when = el.dataset.when;
            var sink = live ? repl : repl.content;
            var src = isTpl ? el.content : el;
            while (src.firstChild) sink.appendChild(src.firstChild);
            el.replaceWith(repl);
          });
        }
        const setAll = (ids, val) => ids.forEach((i) => set(i, val));
        /* EVERY id IN THE PROSE, not the six that happened to have one. See the comment on the
           verdict block: the cards moved and the sentences did not. */
        const margin = notional / eff;
        setAll(["v-liq1", "v-liq2", "v-liq3"], price(liq));
        setAll(["v-move1", "v-move2", "v-move3", "v-move4"], ((Math.abs(liq - E) / E) * 100).toFixed(2) + "%");
        setAll(["v-stopmove1", "v-stopmove2", "v-stopmove3", "v-stopmove4"], ((Math.abs(S - E) / E) * 100).toFixed(2) + "%");
        /* v-safe2 is gone: the LiqTag remedy is now a whole sentence written by v-safefix
           above, because in the no-solution regime "drop to 1x" is not a remedy. v-safe1 is
           the StopTag sentence, which is only rendered when the stop executes first — and that
           state implies the current leverage is already below rawSafe, so rawSafe exceeds 1
           there and the figure it prints cannot be the clamped one. */
        setAll(["v-safe1"], safe + "×");
        setAll(["v-stop1", "v-stop2"], price(S));
        setAll(["v-margin1", "v-margin3"], money(margin));
        setAll(["v-risk1", "v-risk2", "v-risk3"], money(riskUsd));
        set("v-lev1", eff + "×");
        set("v-clamp1", L > maxLev ? " — this contract's tier maximum, so the leverage you asked for cannot be opened —" : "");
        set("v-cmp1", margin < riskUsd ? "smaller" : "larger");
        set("v-side3", isLong ? "long" : "short");
        set("v-dir3", isLong ? "falls" : "rises");
        set("v-rel3", isLong ? "above" : "below");
        set("v-put3", isLong ? "below" : "above");
        set("v-entry3", price(E));

        const liqEl = document.getElementById("out-liq");
        if (liqEl) liqEl.className = "card__value" + (alarm ? " card__value--alert" : "");
      };
      form.addEventListener("input", recalc);
      form.addEventListener("change", (e) => { if (e.target.name === "symbol") form.submit(); else recalc(); });
    }
  </script>
  <Interests />
</Base>
