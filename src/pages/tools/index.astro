---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart } from "../../lib/hyperliquid.ts";
import { pct } from "../../lib/funding.ts";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();
const btc = snap.perps.find((p) => p.symbol === "BTC") ?? snap.perps[0];
const widest = [...snap.perps].filter((p) => p.aprSpread != null).sort((a, b) => (b.aprSpread ?? 0) - (a.aprSpread ?? 0))[0];
const hl = btc.venues.find((v) => v.venue === "HlPerp") ?? btc.venues[0];

// Only shipped tools are listed. There are no "coming soon" entries.
// Each blurb names the specific thing the common formula gets wrong, because that is the
// only reason to use this calculator over the twenty that already rank.
const tools = [
  {
    href: "/tools/position-size",
    name: "Position size",
    blurb: "Risk-based sizing that checks the stop against the tier-correct liquidation price. A stop beyond liquidation is not a stop.",
    live: `${btc.symbol} · tier-checked`,
  },
  {
    href: "/tools/leverage",
    name: "Leverage",
    blurb: "The advertised maximum applies to the smallest tier only. Shows what your notional actually allows, and where the next step falls.",
    live: `${btc.symbol} advertised ${btc.maxLeverage}×`,
  },
  {
    href: "/tools/funding-cost",
    name: "Funding cost",
    blurb: "What a position costs to hold, counting real settlements rather than reading the quoted rate as a daily number.",
    live: `${btc.symbol} ${pct(hl.apr)} APR`,
  },
  {
    href: "/tools/funding-arbitrage",
    name: "Funding arbitrage",
    blurb: "The cross-venue spread with both legs annualised on their own interval, not differenced as if the intervals matched.",
    live: widest ? `${widest.symbol} spread ${pct(widest.aprSpread ?? 0)}` : "—",
  },
];
---
<Base
  title="Funding, leverage and position size calculators"
  description="Calculators built on published perpetual-contract parameters rather than the simplified formulas in circulation: position size, leverage, funding cost and cross-venue funding arbitrage."
  fetchedAt={snap.fetchedAt}
>
  <div class="page-head">
    <h1>Perpetual futures calculators</h1>
    <p>
      Every calculator opens with a real contract at its current price, computed on the server.
      Where a formula in common circulation is wrong, the correct result is shown next to it.
      None of them require an account.
    </p>
  </div>

  <div class="cards">
    {tools.map((t) => (
      <a class="card tool" href={t.href}>
        <div class="tool__name">{t.name}</div>
        <div class="tool__blurb">{t.blurb}</div>
        <div class="tool__live num">{t.live}</div>
      </a>
    ))}
  </div>

  <p class="section-note" style="margin-top:20px">
    <a class="link" href="/methodology">How every number here is produced →</a>
  </p>

  <style>
    .cards { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
    .tool { padding: var(--inset-panel); }
    .tool__name { font-weight: 600; letter-spacing: -.01em; margin-bottom: var(--gap-pair); }
    .tool__blurb { color: var(--text-dim); font-size: 13px; margin-bottom: 12px; }
    .tool__live { font-size: 12px; color: var(--text-faint); text-align: left; margin-top: auto; }
  </style>
</Base>
