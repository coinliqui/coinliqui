---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, requestedPerp } from "../../lib/hyperliquid.ts";
import { pct, usd, VENUE_LABEL } from "../../lib/funding.ts";
import { liquidationPrice, maintenanceMarginFraction, type MarginTable } from "../../lib/margin.ts";
import tables from "../../data/margin-tables.json";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();

/* "EVERY CALCULATOR HERE OPENS ON BTC" WAS TRUE OF THREE IN FOUR. The lede was filled from one
   contract, `btc`, while the four pages it described choose their contract four ways — and
   funding arbitrage opens on the widest live spread by design. Measured on production
   16 September 2026, 10:13 UTC, in one response: the lede said "Every calculator here opens on
   BTC at $75,922, funding 10.95% a year on Hyperliquid" and the fourth card beneath it said
   "ADA spread 55.60%"; locally the same day it was TRX at 57.20%.

   So each card now carries the contract its own calculator opens on, by that calculator's rule,
   and the lede is assembled from the four of them: it can say "every" only when all four agree.
   Position size and leverage call requestedPerp() with no symbol, as their pages do. Funding cost
   and funding arbitrage choose inline in their own pages, so those two rules are mirrored here
   line for line — funding-cost.astro takes perps[0] on Hyperliquid, funding-arbitrage.astro the
   widest spread among contracts quoted on two venues or more. */
const venueOf = (p: (typeof snap.perps)[number]) => p.venues.find((v) => v.venue === "HlPerp") ?? p.venues[0];
const pinned = requestedPerp(snap.perps, null, tables as Record<string, MarginTable>);
const pinnedPerp = pinned && pinned !== "unknown" ? pinned.perp : null;
const costPerp = snap.perps[0];
const costVenue = venueOf(costPerp);
const tradable = snap.perps.filter((p) => p.venues.length >= 2);
const arbPerp = [...tradable].sort((a, b) => (b.aprSpread ?? 0) - (a.aprSpread ?? 0))[0] ?? snap.perps[0];

// Only shipped tools are listed. There are no "coming soon" entries.
// Each blurb names the specific thing the common formula gets wrong, because that is the
// only reason to use this calculator over the twenty that already rank.
// `opens` is the contract the calculator opens on; `alone` is how the lede names it when it
// differs from the others.
const tools = [
  {
    href: "/tools/position-size",
    name: "Position size",
    blurb: "Risk-based sizing that checks the stop against the tier-correct liquidation price. A stop beyond liquidation is not a stop.",
    opens: pinnedPerp,
    live: pinnedPerp ? `${pinnedPerp.symbol} · tier-checked` : "—",
    alone: pinnedPerp ? `${pinnedPerp.symbol} at ${usd(pinnedPerp.markPx)}` : "",
  },
  {
    href: "/tools/leverage",
    name: "Leverage",
    blurb: "The advertised maximum applies to the smallest tier only. Shows what your notional actually allows, and where the next step falls.",
    opens: pinnedPerp,
    live: pinnedPerp ? `${pinnedPerp.symbol} advertised ${pinnedPerp.maxLeverage}×` : "—",
    alone: pinnedPerp ? `${pinnedPerp.symbol} at ${usd(pinnedPerp.markPx)}` : "",
  },
  {
    href: "/tools/funding-cost",
    name: "Funding cost",
    blurb: "What a position costs to hold, counting real settlements rather than reading the quoted rate as a daily number.",
    opens: costPerp,
    live: `${costPerp.symbol} ${pct(costVenue.apr)} APR`,
    alone: `${costPerp.symbol} at ${usd(costPerp.markPx)}, funding ${pct(costVenue.apr)} a year on ${VENUE_LABEL[costVenue.venue]}`,
  },
  {
    href: "/tools/funding-arbitrage",
    name: "Funding arbitrage",
    blurb: "The cross-venue spread with both legs annualised on their own interval, not differenced as if the intervals matched.",
    opens: arbPerp,
    live: arbPerp.aprSpread != null ? `${arbPerp.symbol} spread ${pct(arbPerp.aprSpread)}` : arbPerp.symbol,
    alone: arbPerp.aprSpread != null ? `${arbPerp.symbol}, the widest live spread at ${pct(arbPerp.aprSpread)} a year` : arbPerp.symbol,
  },
];

/* THE PAGE MADE A CLAIM ABOUT FIGURES AND SHOWED NONE. The opening sentence was "Every
   calculator opens with a real contract at its current price, computed on the server" —
   a promise of numbers, containing no number, in the part of the document an extractor
   quotes. /tools takes 36 Applebot fetches a day, the second-largest share on the site
   after /funding/{symbol}, and what they carried away was the promise.

   THE FIGURES WERE ALREADY IN THIS FRONTMATTER, read above to fill the cards. Assembled here
   rather than in the markup because adjacent JSX expressions on separate lines emit whitespace
   text nodes. The lead is the contract most calculators open on (the first in card order on a
   tie); every calculator that opens on something else is named with its own contract. */
const bySymbol = new Map<string, typeof tools>();
for (const t of tools) if (t.opens) bySymbol.set(t.opens.symbol, [...(bySymbol.get(t.opens.symbol) ?? []), t]);
const leadGroup = [...bySymbol.values()].sort((a, b) => b.length - a.length)[0] ?? [];
const leadPerp = leadGroup[0]?.opens ?? snap.perps[0];
const leadVenue = venueOf(leadPerp);
const others = tools.filter((t) => t.opens && t.opens.symbol !== leadPerp.symbol);
// Sentence case: the list opens the sentence, so only its first name keeps its capital.
const names = (ts: typeof tools) => {
  const n = ts.map((t, i) => (i === 0 ? t.name : t.name.toLowerCase()));
  return n.length < 2 ? (n[0] ?? "") : `${n.slice(0, -1).join(", ")} and ${n[n.length - 1]}`;
};
const leadOpens = `${leadPerp.symbol} at ${usd(leadPerp.markPx)}, funding ${pct(leadVenue.apr)} a year on ${VENUE_LABEL[leadVenue.venue]}`;
const lede = others.length === 0 && leadGroup.length === tools.length
  ? `Every calculator here opens on ${leadOpens}`
  : [
      `${names(leadGroup)} ${leadGroup.length > 1 ? "open" : "opens"} on ${leadOpens}`,
      ...others.map((t) => `${t.name.toLowerCase()} opens on ${t.alone}`),
    ].join("; ");

/* THE PAGE SAID A FORMULA IN CIRCULATION IS WRONG AND NEVER SAID BY HOW MUCH.
   /tools carries 191 words of extractable text, the thinnest page on this site, and it is a
   hub — the comment above says each blurb "names the specific thing the common formula gets
   wrong, because that is the only reason to use this calculator over the twenty that already
   rank", and naming the KIND of error without its SIZE is the half that cannot be quoted or
   ranked. /tools/position-size is one of the URLs Search Console still has as Discovered,
   not indexed.

   Both figures below come from the shared implementations rather than from a second copy:
   liquidationPrice() already returns the naive price beside the correct one and the gap
   between them, and the funding factor is the venue's own settlement interval against a day.
   The cross-venue row states its mechanism and carries no number on purpose — computing a
   naive spread here would be funding-arbitrage's logic implemented twice, which is the
   drift this codebase keeps paying for. */
const picked = pinned && pinned !== "unknown" ? pinned : null;
const hl = picked ? venueOf(picked.perp) : null;
const SIZE_USD = 10_000;
const LEV = 10;
const HOLD_DAYS = 30;
const liq = picked && picked.perp.markPx > 0
  ? liquidationPrice({
      entryPrice: picked.perp.markPx,
      positionSize: SIZE_USD / picked.perp.markPx,
      leverage: LEV,
      side: "long",
      table: picked.table,
    })
  : null;
/* Reading a quoted rate as if it were daily is wrong by exactly the number of settlements in a
   day, which is the venue's interval and nothing else. Hyperliquid settles hourly, so 24x. */
const dailyFactor = hl && hl.intervalHours > 0 ? 24 / hl.intervalHours : null;
const realHold = hl ? SIZE_USD * hl.rate * (24 / hl.intervalHours) * HOLD_DAYS : null;
const naiveHold = hl ? SIZE_USD * hl.rate * HOLD_DAYS : null;

/* "FINE INSIDE THE FIRST MARGIN TIER" WAS CONTRADICTED BY THE ROW ABOVE IT. The closing note said
   the simplified forms "are fine where the interval is one day and the position is inside the
   first margin tier". That holds for the funding shortcut and never for the liquidation one:
   entry × (1 − 1/leverage) leaves out maintenance margin, and maintenanceMarginFraction() is
   1/(2 × the tier's max leverage), above zero in every tier. Measured on production 16 September
   2026, 10:13 UTC: the $10,000 BTC row is a first-tier position (40× tier, $150M boundary) and
   printed $68,329.80 against $69,194.73 — a 1.25% maintenance charge taking room from entry from
   10.00% to 8.86% — directly above the sentence saying it was fine.

   So the note now states the two conditions separately and takes the liquidation figures from
   `liq`, the result the row prints, and the largest-tier charge from the same table. It can only
   name the tier the position is actually in, and says nothing about room from entry when the
   leverage was clamped, because then the gap is not maintenance margin alone. */
const fundingNote = `Reading a quoted funding rate as a daily number is exact only on a venue that settles once a day${hl ? `, and ${VENUE_LABEL[hl.venue]} settles every ${hl.intervalHours}h` : ""}.`;
const topTier = picked ? [...picked.table.marginTiers].sort((a, b) => b.lowerBound - a.lowerBound)[0] : undefined;
const topMmf = topTier && liq && maintenanceMarginFraction(topTier.maxLeverage) > liq.maintenanceMarginFraction
  ? maintenanceMarginFraction(topTier.maxLeverage)
  : null;
const liqWhy = liq && !liq.leverageClamped
  ? `the whole reason its room from entry is ${pct(liq.distancePct)} rather than ${pct(liq.naiveDistancePct)}`
  : null;
const liqNote = liq && picked
  ? `${liq.tierIndex === 0 ? "The first margin tier" : `Margin tier ${liq.tierIndex + 1}`}, where the ${usd(SIZE_USD)} ${picked.perp.symbol} position above sits, charges ${pct(liq.maintenanceMarginFraction)}` +
    (topMmf != null
      ? `${liqWhy ? ` — ${liqWhy} —` : ","} and the tier for this contract's largest positions charges ${pct(topMmf)}.`
      : `${liqWhy ? ` — ${liqWhy}` : ""}.`)
  : "";
---
<Base
  title="Funding, leverage and position size calculators"
  description="Calculators built on published perpetual-contract parameters rather than the simplified formulas in circulation: position size, leverage, funding cost and cross-venue funding arbitrage."
  fetchedAt={snap.fetchedAt}
>
  <div class="page-head">
    <h1>Perpetual futures calculators</h1>
    <p>
      <strong>{lede}</strong>. Each is computed on the server before the page is sent — not a
      blank form waiting for numbers you have to find somewhere else first.
      Where a formula in common circulation is wrong, the correct result is shown next to it.
      None of them require an account.
    </p>
  </div>

  <div class="cards">
    {tools.map((t) => (
      <a class="card tool" href={t.href}>
        <div class="tool__name">{t.name}</div>
        <div class="tool__blurb">{t.blurb}</div>
        <div class="tool__live num">{t.live}</div>
      </a>
    ))}
  </div>

  <h2 class="section">How far the common formula is from the published one</h2>
  <p class="section-note">
    Every row is {picked?.perp.symbol ?? "BTC"} at its current mark, computed on the server from the venue's own
    published parameters. The sizes are stated so each figure can be reproduced rather than
    taken on trust.
    <a class="link" href="/learn/liquidation-price">Why the two columns differ, worked through →</a>
  </p>
  <div class="panel" style="max-width:900px">
    <table class="tbl">
      <thead><tr><th>What is being computed</th><th class="num">The formula in circulation</th><th class="num">The published parameters</th><th class="num">Gap</th></tr></thead>
      <tbody>
        {liq ? (
          <tr>
            {/* THE LEVERAGE THE CALCULATION USED, NOT THE ONE I ASKED FOR. liquidationPrice()
                clamps to the tier maximum, and labelling a clamped number with the requested
                figure has shipped here twice — the source check that names it fired on this
                table within one gate run. */}
            <td>Liquidation price, {liq.effectiveLeverage}× long on {usd(SIZE_USD)}{liq.leverageClamped ? <> — {LEV}× was requested and this contract's tier caps it</> : null}
              <div class="reason" style="margin-top:2px">entry × (1 − 1/leverage), which ignores maintenance margin</div></td>
            <td class="num">{usd(liq.naivePrice, 2)}</td>
            <td class="num">{usd(liq.liquidationPrice, 2)}</td>
            {/* ROOM FROM ENTRY, not a share of one of the two prices with the base left unstated —
                see differenceOfCorrectPct in src/lib/margin.ts. */}
            <td class="num">{pct(liq.naiveDistancePct)} → {pct(liq.distancePct)}
              <div class="reason">room from entry</div></td>
          </tr>
        ) : null}
        {hl && dailyFactor && realHold != null && naiveHold != null ? (
          <tr>
            <td>Funding on {usd(SIZE_USD)} held {HOLD_DAYS} days
              <div class="reason" style="margin-top:2px">the quoted rate read as a daily number, on a venue settling every {hl.intervalHours}h</div></td>
            <td class="num">{usd(Math.abs(naiveHold), 2)}</td>
            <td class="num">{usd(Math.abs(realHold), 2)}</td>
            <td class="num">{dailyFactor.toFixed(0)}×</td>
          </tr>
        ) : null}
        <tr>
          <td>Cross-venue funding spread
            <div class="reason" style="margin-top:2px">quoted rates differenced as though the intervals matched</div></td>
          <td class="num dim" colspan="3">
            {/* NO NUMBER HERE ON PURPOSE. A naive spread computed on this page would be
                funding-arbitrage's logic implemented a second time, and two implementations of
                one figure is the drift this codebase keeps paying for. The calculator holds it. */}
            depends on both legs — <a class="link" href="/tools/funding-arbitrage">the calculator shows both readings side by side →</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="section-note">
    None of this is a claim that other calculators are careless. {fundingNote} The liquidation
    shortcut is not exact in any tier: it leaves out maintenance margin, which every tier
    charges. {liqNote}
  </p>

  <p class="section-note" style="margin-top:20px">
    <a class="link" href="/methodology">How every number here is produced →</a>
  </p>

  <style>
    /* Defined here because it is defined per page — /status carries its own copy and this page
       had none, so `class="reason"` styled nothing and the undefined-class check said so. */

    .cards { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
    .tool { padding: var(--inset-panel); }
    .tool__name { font-weight: 600; letter-spacing: -.01em; margin-bottom: var(--gap-pair); }
    .tool__blurb { color: var(--text-dim); font-size: 13px; margin-bottom: 12px; }
    .tool__live { font-size: 12px; color: var(--text-faint); text-align: left; margin-top: auto; }
  </style>
</Base>
