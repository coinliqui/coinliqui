---
// Surface-separation variant 1: Panelled — every region is its own card on the page background.
// Review-only — robots-disallowed, absent from every sitemap, noindexed, and deleted
// once a direction is picked. Same loader, same component, same data as the real
// homepage; the ONLY difference is the variant class on the shell.
import Base from "../../layouts/Base.astro";
import HomeBody from "../../components/HomeBody.astro";
import { loadHome } from "../../lib/home-view.ts";

const { snap, flips, description } = await loadHome((Astro.locals as any)?.runtime?.env);
---

<Base title="Panelled — every region is its own card on the page background | Basis UI 1" description={description} fetchedAt={snap.fetchedAt} variant="panelled" noindex>
  <HomeBody snap={snap} flips={flips} />
</Base>
