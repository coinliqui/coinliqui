---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, findPerp } from "../../lib/hyperliquid.ts";
import { usd, pct } from "../../lib/funding.ts";
import { maintenanceMarginFraction, type MarginTable } from "../../lib/margin.ts";
import { getCandles, survivalGrid, gridLevels } from "../../lib/candles.ts";
import { CH, INK, RAMP, text, rect, timeTicks, niceTicks, fint, SANS, FS_AXIS, FS_MICRO } from "../../lib/chart.ts";
import tables from "../../data/margin-tables.json";

const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

const q = Astro.url.searchParams;
const perp = findPerp(snap.perps, q.get("symbol")) ?? snap.perps[0];
const table = (tables as Record<string, MarginTable>)[String(perp.marginTableId)];
const tier1 = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound)[0];
const mark = perp.markPx;
const mmf = maintenanceMarginFraction(tier1.maxLeverage);
const dp = mark >= 100 ? 2 : mark >= 1 ? 3 : mark >= 0.01 ? 5 : 7;
const px = (v: number) => usd(v, dp);

const HOLDS = [7, 30, 90];
const hold = HOLDS.includes(Number(q.get("hold"))) ? Number(q.get("hold")) : 30;
const mapSide: "long" | "short" = q.get("side") === "short" ? "short" : "long";
const candleSet = await getCandles(env?.SNAPSHOT, perp.symbol, import.meta.env.DEV);
const grid =
  candleSet && candleSet.d.length > hold + 12
    ? survivalGrid({ candles: candleSet.d, mmf, levels: gridLevels(tier1.maxLeverage, 12), holdDays: hold, side: mapSide, maxEntries: 90 })
    : null;

const dayLabel = (ms: number) => new Date(ms).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });

/* Built as a string: 1,000 JSX vnodes is needless Worker CPU. Presentation attributes are
   INLINE — Astro scopes `.cls{}` to `.cls[data-astro-cid-x]`, and markup injected with
   set:html never carries that attribute, so class-based styling here silently does nothing
   and SVG falls back to fill:black. That shipped once; it will not again.

   Drawn to the same scale and palette as every other chart on the site (see lib/chart.ts).
   The one deliberate difference: leverage is a CATEGORY, not a continuous axis, so its
   labels sit on the left where a row label belongs, and only price axes go on the right. */
let heatSvg = "";
const HW = CH.w, HH = 568;
const hpL = 13 * 4, hpR = 20 * 4, hpT = 32 * 4, hpB = 7 * 4;
const stripT = 16 * 4, stripH = 15 * 4;

/* SIX BUCKETS, NOT A CONTINUUM. A smooth day-to-day ramp turned 1,080 cells into vertical
   static: adjacent columns differ by a day and jump three ramp stops, so the eye reads noise
   instead of the finding. Quantising to bands the reader can name — closed the next day,
   inside a week, inside a month, never — makes the shape legible and the legend readable,
   and every exact day is still in the tooltip and the table. */
const BUCKETS: { max: number; label: string; ramp: number }[] = [
  { max: 1, label: "next day", ramp: 20 },
  { max: 2, label: "2", ramp: 17 },
  { max: 4, label: "3–4", ramp: 14 },
  { max: 7, label: "5–7", ramp: 11 },
  { max: 14, label: "8–14", ramp: 8 },
  { max: Infinity, label: `15–${hold}`, ramp: 5 },
];
const SURVIVED = "#2b323a";   // neutral, off the ramp: a different outcome, not a dimmer one
const bucketOf = (d: number) => BUCKETS.find((b) => d <= b.max)!;

if (grid && grid.entries.length > 4) {
  const pw = HW - hpL - hpR, ph = HH - hpT - hpB;
  const rows = grid.levels.length, cols = grid.entries.length;
  const rowH = ph / rows, colW = pw / cols;
  const out: string[] = [];

  out.push(rect(0, 0, HW, HH, INK.well, ` rx="${CH.radius}"`));

  // legend: one swatch per bucket, labelled underneath, then the survived key
  out.push(text(hpL, 22, "closed after", INK.faint, FS_AXIS, "start", 400, SANS));
  let lx = hpL + 76;
  for (const b of BUCKETS) {
    out.push(rect(lx, 13, 34, 11, RAMP[b.ramp], ' rx="2"'));
    out.push(text(lx + 17, 37, b.label, INK.faint, FS_MICRO, "middle"));
    lx += 39;
  }
  out.push(text(lx + 4, 22, "days", INK.faint, FS_AXIS, "start", 400, SANS));
  out.push(rect(lx + 44, 13, 14, 11, SURVIVED, ' rx="2"'));
  out.push(text(lx + 64, 22, `never closed in ${hold} days`, INK.faint, FS_AXIS, "start", 400, SANS));

  // price strip — the same entry-day closes the grid below is computed from
  const cl = grid.entries.map((c) => c[4]);
  const pmin = Math.min(...cl), pmax = Math.max(...cl);
  const sy = (v: number) => stripT + stripH - ((v - pmin) / Math.max(1e-12, pmax - pmin)) * stripH;
  const pts = cl.map((v, i) => `${(hpL + i * colW + colW / 2).toFixed(1)},${sy(v).toFixed(1)}`);
  const ax0 = (hpL + colW / 2).toFixed(1), ax1 = (hpL + (cols - 0.5) * colW).toFixed(1);
  out.push(`<path d="M${ax0},${(stripT + stripH).toFixed(1)} L${pts.join(" L")} L${ax1},${(stripT + stripH).toFixed(1)} Z" fill="${INK.acc}" fill-opacity="0.09"/>`);
  out.push(`<polyline points="${pts.join(" ")}" fill="none" stroke="${INK.up}" stroke-width="1.5" stroke-linejoin="round"/>`);
  /* Round ticks, like every other price axis here — the raw extremes of a window are not
     numbers anyone holds in their head. */
  for (const v of niceTicks(pmin, pmax, 2)) {
    out.push(text(HW - hpR + 10, Math.max(stripT + 4, Math.min(stripT + stripH + 4, sy(v) + 4)), fint(v), INK.dim, FS_AXIS));
  }
  out.push(text(hpL, stripT - 9, `${perp.symbol} close on the entry day`, INK.faint, FS_AXIS, "start", 400, SANS));

  grid.levels.forEach((lv, r) => {
    const yy = hpT + r * rowH;
    out.push(text(hpL - 10, yy + rowH / 2 + 4, `${lv.L}×`, INK.dim, FS_AXIS, "end", 500));
    lv.cells.forEach((c, ci) => {
      const surv = c.liqDay === null;
      const b = surv ? null : bucketOf(c.liqDay!);
      const tip =
        `&lt;div class=&quot;tip__h&quot;&gt;${lv.L}× ${mapSide} opened ${dayLabel(grid.entries[ci][0])}&lt;/div&gt;` +
        `&lt;div class=&quot;tip__g&quot;&gt;&lt;span&gt;Outcome&lt;/span&gt;&lt;b&gt;${surv ? `survived ${hold}d` : `closed on day ${c.liqDay}`}&lt;/b&gt;` +
        `&lt;span&gt;Entry close&lt;/span&gt;&lt;b&gt;${px(grid.entries[ci][4])}&lt;/b&gt;&lt;/div&gt;` +
        `&lt;div class=&quot;tip__f&quot;&gt;Derived from the real price path — nothing modelled&lt;/div&gt;`;
      out.push(
        `<rect x="${(hpL + ci * colW).toFixed(1)}" y="${yy.toFixed(1)}" width="${(colW + 0.4).toFixed(1)}" height="${(rowH + 0.4).toFixed(1)}" ` +
        `fill="${surv ? SURVIVED : RAMP[b!.ramp]}" data-tip="${tip}">` +
        `<title>${lv.L}× ${dayLabel(grid.entries[ci][0])}: ${surv ? `survived ${hold}d` : `closed day ${c.liqDay}`}</title></rect>`,
      );
    });
  });

  for (const { i, label } of timeTicks(grid.entries.map((c) => c[0]), 8)) {
    out.push(text(hpL + i * colW + colW / 2, HH - 9, label, INK.faint, FS_AXIS, "middle"));
  }
  heatSvg = out.join("");
}

const title = `${perp.symbol} leverage backtest: liquidated or survived`;
const description = `Which leveraged ${perp.symbol} positions were liquidated and which survived — every entry day, every leverage, held ${hold} days. Derived from real traded candles and the published margin tiers, nothing modelled.`;
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt}>
  <div class="page-head">
    <p class="crumb"><a href="/liquidations">Liquidations</a> › Survival</p>
    <h1>Leverage survival</h1>
    <p>
      Nothing here is modelled. Every cell is one checkable question about the real price path:
      a <strong>{mapSide}</strong> opened at that day's close, at that leverage, held {hold} days
      — did the rules close it, and on which day? That is what separates this from
      {" "}<a class="link" href="/liquidations">the modelled density map</a>, which answers a
      different question and needs assumptions to do it.
    </p>
  </div>

  <form method="GET" class="calc" style="margin-bottom:16px">
    <label>Coin
      <select name="symbol">{snap.perps.map((p) => <option value={p.symbol} selected={p.symbol === perp.symbol}>{p.symbol}</option>)}</select>
    </label>
    <label>Side
      <select name="side">
        <option value="long" selected={mapSide === "long"}>Long</option>
        <option value="short" selected={mapSide === "short"}>Short</option>
      </select>
    </label>
    <label>Held for
      <select name="hold">{HOLDS.map((h) => <option value={h} selected={h === hold}>{h} days</option>)}</select>
    </label>
    <button class="btn btn--primary" type="submit">Redraw the map</button>
  </form>

  {grid ? (
    <>
      <figure class="chart">
        <svg viewBox={`0 0 ${HW} ${HH}`} class="heat" role="img" data-tips style={`--heatRatio: ${HW} / ${HH}`}
             aria-label={`Survival map for ${perp.symbol}: ${grid.levels.length} leverage levels by ${grid.entries.length} entry days, ${mapSide} positions held ${hold} days.`}>
          <Fragment set:html={heatSvg} />
        </svg>
        <figcaption>
          {perp.symbol} daily candles from Hyperliquid — real traded days only; the venue's
          pre-launch backfill carries zero volume and is excluded. Entry days
          {" "}{dayLabel(grid.from)} to {dayLabel(grid.to)}, each with a complete {hold}-day
          window, so no column is flattered by having had less time to fail.
        </figcaption>
      </figure>

      <h2 class="section">The same map, counted</h2>
      <div class="panel">
        <table class="tbl">
          <thead><tr><th class="num">Leverage</th><th class="num">Entry days tested</th><th class="num">Closed within {hold}d</th><th class="num">Survived</th><th class="num">Survival rate</th><th class="num">Median days to closure</th></tr></thead>
          <tbody>
            {grid.levels.map((lv) => (
              <tr class={lv.L === tier1.maxLeverage ? "is-active" : undefined}>
                <td class="num">{lv.L}×{lv.L === tier1.maxLeverage ? " · max" : ""}</td>
                <td class="num">{lv.tested}</td>
                <td class="num">{lv.liquidated}</td>
                <td class="num">{lv.tested - lv.liquidated}</td>
                <td class="num">{((1 - lv.liquidated / Math.max(1, lv.tested)) * 100).toFixed(1)}%</td>
                <td class="num">{lv.medianDays ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <details class="src">
        <summary>The daily price series this is computed from ({grid.entries.length} rows)</summary>
        <div class="panel" style="margin-top:10px">
          <table class="tbl">
            <thead><tr><th>Entry day (UTC)</th><th class="num">Close</th><th class="num">Low</th><th class="num">High</th></tr></thead>
            <tbody>
              {grid.entries.map((c) => (
                <tr>
                  <td>{new Date(c[0]).toISOString().slice(0, 10)}</td>
                  <td class="num">{px(c[4])}</td>
                  <td class="num">{px(c[3])}</td>
                  <td class="num">{px(c[2])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </>
  ) : (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">Candle history not collected yet</p>
        <p class="empty__text">This needs {hold + 13} days of traded daily candles for {perp.symbol}. Either the series is still being collected — a twelve-hour sweep, jumped on the next tick when a series is missing entirely — or {perp.symbol} has not traded here that long, in which case a shorter hold window needs less history.</p>
      </div>
    </div>
  )}

  <p style="margin-top:24px">
    <a class="link" href="/liquidations">Modelled liquidation density →</a>
    · <a class="link" href="/tools/position-size">Size a position against a stop →</a>
  </p>

  <style>
    .heat { display: block; width: 100%; height: auto; aspect-ratio: var(--heatRatio); }
    .heat :global(rect) { shape-rendering: crispEdges; }
    .src { margin-top: 14px; }
    .src summary { font-size: 13px; color: var(--text-dim); cursor: pointer; padding: 8px 0; }
    .src summary:hover { color: var(--text); }
  </style>
</Base>
