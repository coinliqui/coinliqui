---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, requestedPerp } from "../../lib/hyperliquid.ts";
import { usd, pct, nf, axisDp } from "../../lib/funding.ts";
import { maintenanceMarginFraction, type MarginTable } from "../../lib/margin.ts";
import { getCandles, survivalGrid, gridLevels } from "../../lib/candles.ts";
import { CH, INK, RAMP, text, rect, timeTicks, niceTicks, fint, SANS, FS_AXIS, FS_MICRO } from "../../lib/chart.ts";
import tables from "../../data/margin-tables.json";

import Advisory from "../../components/Advisory.astro";
import { priceDp } from "../../lib/funding.ts";
const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

const q = Astro.url.searchParams;
/* The contract and its tier table are chosen together — see pickPerp in src/lib/hyperliquid.ts
   for why these were two lines and what the second one did when the first one won. */
/* Pinned default, and an unknown symbol answers 404 instead of substituting the default.
   See requestedPerp in src/lib/hyperliquid.ts for what each of those replaced. */
const wantedSymbol = q.get("symbol");
const picked = requestedPerp(snap.perps, wantedSymbol, tables as Record<string, MarginTable>);
if (picked === null) return coldStart();
if (picked === "unknown") return Astro.rewrite(`/404?symbol=${encodeURIComponent(wantedSymbol!)}`);
const { perp, table } = picked;
const tier1 = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound)[0];
const mark = perp.markPx;
const mmf = maintenanceMarginFraction(tier1.maxLeverage);
const dp = priceDp(mark);
const px = (v: number) => usd(v, dp);

const HOLDS = [7, 30, 90];
const hold = HOLDS.includes(Number(q.get("hold"))) ? Number(q.get("hold")) : 30;
const mapSide: "long" | "short" = q.get("side") === "short" ? "short" : "long";
const candleSet = await getCandles(env?.SNAPSHOT, perp.symbol, import.meta.env.DEV);
/* TODAY'S CANDLE IS NOT OVER, AND THIS GRID IS ABOUT COMPLETED DAYS.
   The upstream returns the day in progress as its last row — verified against
   candleSnapshot: at 08:30 UTC it hands back a candle stamped 00:00 today. Left in, it
   shifts the last entry day forward by one and, worse, the rightmost column's {hold}-day
   window ENDS on a partial low, so a position is judged survived against a day that has
   not finished happening. The page's own sentence says every column has "a complete
   {hold}-day window"; this is what makes that true rather than nearly true.
   Charts elsewhere deliberately DO show the forming bar — a price chart should — so the
   filter belongs here, at the one call that reasons about outcomes. */
const dayMs = 86_400_000;
const closedDays = (candleSet?.d ?? []).filter((c) => c[0] + dayMs <= Date.now());
/* One rule for "enough history", read by the grid and by the empty state's counts alike. */
const needDays = (h: number) => h + 13;
const grid =
  closedDays.length >= needDays(hold)
    ? survivalGrid({ candles: closedDays, mmf, levels: gridLevels(tier1.maxLeverage, 12), holdDays: hold, side: mapSide, maxEntries: 90 })
    : null;

/* THE YEAR WAS MISSING, SO EVERY RESULT ON THE PAGE WAS UNDATABLE ONCE EXTRACTED. The caption
   read "Entry days 26 Apr to 24 Jul" — fine beside a live page, useless in a search snippet or
   in anything that lifted the sentence, and every other date formatter in this repository passes
   year. */
const dayLabel = (ms: number) => new Date(ms).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

/* THE MEDIAN COLUMN PRINTED THE UPPER MIDDLE. LevelResult.medianDays in src/lib/candles.ts was
   `days[Math.floor(days.length / 2)]` (the field is now removed), the median only for an odd count; for an even
   count it is the larger of the two middle values. Measured 16 September 2026 on
   /liquidations/survival?symbol=SUI&side=long&hold=90: the 3× row said 41 while its own 48
   "closed on day N" cells have middle values 31 and 41 — a median of 36. BTC short 90 3× printed
   80 for [76, 77, 80, 81]. Every row with an even number of closures was off by half its middle gap.
   COMPUTED HERE FROM THE SAME CELLS THE HEATMAP DRAWS, so the column cannot disagree with the
   tooltips above it; a median between two whole days prints as .5 rather than being rounded to either. */
const medianClosure = (lv: { cells: { liqDay: number | null }[] }): number | null => {
  const days = lv.cells.flatMap((c) => (c.liqDay === null ? [] : [c.liqDay])).sort((a, b) => a - b);
  if (!days.length) return null;
  const m = days.length >> 1;
  return days.length % 2 ? days[m] : (days[m - 1] + days[m]) / 2;
};

/* THE EMPTY STATE PROMISED A SHORTER HOLD THAT DID NOT EXIST. It said "a shorter hold window needs
   less history" on every empty render. Measured 16 September 2026 on
   /liquidations/survival?symbol=PONS&side=long&hold=7: 7 days is the shortest hold the form offers,
   and PONS was empty at 30 and 90 as well — as was USELESS — so the advice named a control the
   reader did not have. It also could not say how much history there WAS, only how much was needed.
   NOW IT COUNTS. `stored` separates "nothing collected" from "collected, not enough"; `fits` is
   every hold this form offers that the stored series can draw, by the same needDays() rule
   that decides `grid` above, so a hold is suggested only if clicking it renders a grid. When none fits it
   says so, with how many more completed days the shortest hold needs. */
const stored = candleSet?.d?.length ?? 0;
const haveDays = closedDays.length;
const fits = HOLDS.filter((h) => haveDays >= needDays(h));
const shortest = Math.min(...HOLDS);
const dayCount = (n: number) => `${n} ${n === 1 ? "day" : "days"}`;
const holdHref = (h: number) => `/liquidations/survival?symbol=${encodeURIComponent(perp.symbol)}&side=${mapSide}&hold=${h}`;
const storedSentence =
  (haveDays === 0
    ? `No completed daily candle of ${perp.symbol} is stored yet — the day in progress counts once it closes`
    : `${haveDays} completed daily ${haveDays === 1 ? "candle" : "candles"} of ${perp.symbol} ${haveDays === 1 ? "is" : "are"} stored, the first on ${dayLabel(closedDays[0][0])}`) +
  `, and a ${hold}-day hold needs ${needDays(hold)}.`;
const shortfall = needDays(shortest) - haveDays;
const noFitSentence = `No hold this page offers fits yet: the shortest, ${shortest} days, needs ${needDays(shortest)} and is ${dayCount(shortfall)} short.`;

/* THE PAGE THAT IS ENTIRELY A RESULT OPENED WITHOUT ONE. Fetched as GPTBot, the first 700
   characters of /liquidations/survival were the honesty statement and the method — "The prices
   are real; the closing rule is a model", then four sentences about what a cell asks — and no
   outcome. The grid below it answers exactly the question a reader arrives with, per leverage,
   over ninety entry days; the opening simply never said any of it.

   IT NAMES THE TWO ENDS RATHER THAN A MIDDLE. A single representative leverage would be a
   choice this page has no basis for making, and the finding it exists to publish IS the spread
   between the ends: the highest leverage that survived every tested entry, and the one that
   failed most of them. Both are read from the same `grid` the table below renders, so the
   sentence cannot disagree with the picture underneath it.

   IT NAMES THE SPAN RATHER THAN CALLING IT "THE LAST N CLOSES", which is what this sentence
   said when it shipped this morning and was wrong by a month. survivalGrid evaluates only entry
   days with a FULL hold window ahead of them — `usable = candles.length - holdDays` — so the
   tested set ENDS `hold` days before the most recent close. At the default hold of 30, "the last
   90 daily closes" named 3 June to 30 August while the days actually tested were 3 May to 31
   July: 31 of the 90 named were never in the grid. At hold=90 the two sets do not overlap at all.
   The censoring is deliberate and candles.ts:184 explains why; the figcaption two hundred lines
   below already printed the true span from the same grid.from/grid.to. Only the lede — the one
   sentence written to be quoted away from the page — claimed the window it had not measured. */
const survivalLede = (() => {
  if (!grid || !grid.levels.length) return "";
  const tested = grid.levels[0].tested;
  const worst = [...grid.levels].sort((a, b) => b.liquidated / b.tested - a.liquidated / a.tested)[0];
  if (!tested || !worst || !worst.liquidated) return "";
  const safe = [...grid.levels].filter((l) => l.liquidated === 0).sort((a, b) => b.L - a.L)[0];
  const head = `Across ${tested} ${perp.symbol} daily closes, ${dayLabel(grid.from)} to ${dayLabel(grid.to)}, a ${hold}-day ${mapSide} at ${worst.L}× would have been closed out on ${worst.liquidated} of them, ${pct(worst.liquidated / worst.tested)}`;
  return safe ? `${head} — while ${safe.L}× survived every one.` : `${head}.`;
})();

/* Built as a string: 1,000 JSX vnodes is needless Worker CPU. Presentation attributes are
   INLINE — Astro scopes `.cls{}` to `.cls[data-astro-cid-x]`, and markup injected with
   set:html never carries that attribute, so class-based styling here silently does nothing
   and SVG falls back to fill:black. That shipped once; it will not again.

   Drawn to the same scale and palette as every other chart on the site (see lib/chart.ts).
   The one deliberate difference: leverage is a CATEGORY, not a continuous axis, so its
   labels sit on the left where a row label belongs, and only price axes go on the right. */
let heatSvg = "";
const HW = CH.w, HH = 568;
const hpL = 13 * 4, hpR = 20 * 4, hpT = 32 * 4, hpB = 7 * 4;
const stripT = 16 * 4, stripH = 15 * 4;

/* SIX BUCKETS, NOT A CONTINUUM. A smooth day-to-day ramp turned 1,080 cells into vertical
   static: adjacent columns differ by a day and jump three ramp stops, so the eye reads noise
   instead of the finding. Quantising to bands the reader can name — closed the next day,
   inside a week, inside a month, never — makes the shape legible and the legend readable,
   and every exact day is still in the tooltip and the table. */
/* BUCKETS ARE CLIPPED TO THE HOLD, and their labels are derived rather than written.
   The bands were fixed at 1 / 2 / 3-4 / 5-7 / 8-14 / 15-hold, which reads correctly at
   hold = 30 and becomes nonsense below it: at hold = 7 the last band printed "15–7", an
   inverted range for days that cannot occur, and three bands described windows entirely
   outside the hold. A legend that describes days the grid cannot contain is not a rounding
   problem — it is a legend for a different chart. */
const EDGES = [1, 2, 4, 7, 14].filter((e) => e < hold);
const BUCKETS: { max: number; label: string; ramp: number }[] = [];
{
  const RAMP = [20, 17, 14, 11, 8, 5];
  let lo = 1;
  for (const e of EDGES) {
    BUCKETS.push({
      max: e,
      label: e === 1 ? "next day" : lo === e ? `${e}` : `${lo}–${e}`,
      ramp: RAMP[BUCKETS.length],
    });
    lo = e + 1;
  }
  BUCKETS.push({
    max: Infinity,
    label: lo === hold ? `${hold}` : `${lo}–${hold}`,
    ramp: RAMP[Math.min(BUCKETS.length, RAMP.length - 1)],
  });
}
const SURVIVED = "#2b323a";   // neutral, off the ramp: a different outcome, not a dimmer one
const bucketOf = (d: number) => BUCKETS.find((b) => d <= b.max)!;

if (grid && grid.entries.length > 4) {
  const pw = HW - hpL - hpR, ph = HH - hpT - hpB;
  const rows = grid.levels.length, cols = grid.entries.length;
  const rowH = ph / rows, colW = pw / cols;
  const out: string[] = [];

  out.push(rect(0, 0, HW, HH, INK.well, ` rx="${CH.radius}"`));

  // legend: one swatch per bucket, labelled underneath, then the survived key
  out.push(text(hpL, 22, "closed after", INK.faint, FS_AXIS, "start", 400, SANS));
  let lx = hpL + 76;
  for (const b of BUCKETS) {
    out.push(rect(lx, 13, 34, 11, RAMP[b.ramp], ' rx="2"'));
    out.push(text(lx + 17, 37, b.label, INK.faint, FS_MICRO, "middle"));
    lx += 39;
  }
  out.push(text(lx + 4, 22, "days", INK.faint, FS_AXIS, "start", 400, SANS));
  out.push(rect(lx + 44, 13, 14, 11, SURVIVED, ' rx="2"'));
  out.push(text(lx + 64, 22, `never closed in ${hold} days`, INK.faint, FS_AXIS, "start", 400, SANS));

  // price strip — the same entry-day closes the grid below is computed from
  const cl = grid.entries.map((c) => c[4]);
  const pmin = Math.min(...cl), pmax = Math.max(...cl);
  const sy = (v: number) => stripT + stripH - ((v - pmin) / Math.max(1e-12, pmax - pmin)) * stripH;
  const pts = cl.map((v, i) => `${(hpL + i * colW + colW / 2).toFixed(1)},${sy(v).toFixed(1)}`);
  const ax0 = (hpL + colW / 2).toFixed(1), ax1 = (hpL + (cols - 0.5) * colW).toFixed(1);
  out.push(`<path d="M${ax0},${(stripT + stripH).toFixed(1)} L${pts.join(" L")} L${ax1},${(stripT + stripH).toFixed(1)} Z" fill="${INK.acc}" fill-opacity="0.09"/>`);
  out.push(`<polyline points="${pts.join(" ")}" fill="none" stroke="${INK.neutral}" stroke-width="1.5" stroke-linejoin="round"/>`);
  /* Round ticks, like every other price axis here — the raw extremes of a window are not
     numbers anyone holds in their head. */
  /* THE TICKS WERE ROUND AND THEIR LABELS WERE ROUNDER. Each label went through fint(), integer
     dollars, so any strip whose ticks were not whole dollars printed one integer for two prices.
     Measured 16 September 2026: /liquidations/survival?symbol=CHIP&side=long&hold=90 labelled the
     ticks at $0.05 and $0.10 "0" and "0"; ?symbol=XRP&side=long&hold=90 labelled $1.20 and $1.40
     "1" and "1". The same day's audit found it on 34 of 64 production grids (TRX, GRAM, LIT, CRV,
     LDO among them).
     /liquidations fixed the same fint() on its own axis and this strip kept it.
     THE DECIMALS NOW COME FROM THE TICKS. The floor is axisDp(), the site's one ladder for axis
     precision, and it rises until every label rounds back to the tick it marks — so a label can
     no longer state a different price than its position, and two ticks can no longer share a
     label, whatever range or price level the strip is drawn at. */
  const ticks = niceTicks(pmin, pmax, 2);
  let tickDp = axisDp(pmax);
  while (tickDp < 10 && ticks.some((v) => Math.abs(+v.toFixed(tickDp) - v) > Math.abs(v) * 1e-9)) tickDp++;
  for (const v of ticks) {
    out.push(text(HW - hpR + 10, Math.max(stripT + 4, Math.min(stripT + stripH + 4, sy(v) + 4)), tickDp === 0 ? fint(v) : nf(v, tickDp), INK.dim, FS_AXIS));
  }
  out.push(text(hpL, stripT - 9, `${perp.symbol} close on the entry day`, INK.faint, FS_AXIS, "start", 400, SANS));

  grid.levels.forEach((lv, r) => {
    const yy = hpT + r * rowH;
    out.push(text(hpL - 10, yy + rowH / 2 + 4, `${lv.L}×`, INK.dim, FS_AXIS, "end", 500));
    lv.cells.forEach((c, ci) => {
      const surv = c.liqDay === null;
      const b = surv ? null : bucketOf(c.liqDay!);
      const tip =
        `&lt;div class=&quot;tip__h&quot;&gt;${lv.L}× ${mapSide} opened ${dayLabel(grid.entries[ci][0])}&lt;/div&gt;` +
        `&lt;div class=&quot;tip__g&quot;&gt;&lt;span&gt;Outcome&lt;/span&gt;&lt;b&gt;${surv ? `survived ${hold}d` : `closed on day ${c.liqDay}`}&lt;/b&gt;` +
        `&lt;span&gt;Entry close&lt;/span&gt;&lt;b&gt;${px(grid.entries[ci][4])}&lt;/b&gt;&lt;/div&gt;` +
        `&lt;div class=&quot;tip__f&quot;&gt;Real price path, one stated closing rule&lt;/div&gt;`;
      out.push(
        `<rect x="${(hpL + ci * colW).toFixed(1)}" y="${yy.toFixed(1)}" width="${(colW + 0.4).toFixed(1)}" height="${(rowH + 0.4).toFixed(1)}" ` +
        `fill="${surv ? SURVIVED : RAMP[b!.ramp]}" data-tip="${tip}">` +
        `<title>${lv.L}× ${dayLabel(grid.entries[ci][0])}: ${surv ? `survived ${hold}d` : `closed day ${c.liqDay}`}</title></rect>`,
      );
    });
  });

  for (const { i, label } of timeTicks(grid.entries.map((c) => c[0]), 8)) {
    out.push(text(hpL + i * colW + colW / 2, HH - 9, label, INK.faint, FS_AXIS, "middle"));
  }
  heatSvg = out.join("");
}

const title = `${perp.symbol} leverage backtest: liquidated or survived`;
/* "nothing modelled" IS A CLAIM THIS PAGE RETRACTS IN ITS OWN FIRST PARAGRAPH.
   Three lines below, in bold: "The prices are real; the closing rule is a model." The rule has
   six stated assumptions and the page lists them. The retracted version survived in the meta
   description — the one string quoted without the page beside it to correct it — in the tooltip
   under every one of ~1,000 cells, and in the anchor text pointing here from the flagship and
   from the sweep. An overclaim on the single axis this site sells. */
/* NO GRID, NO RESULT TO DESCRIBE. On an empty render this string still said which positions
   "were liquidated and which survived — every entry day, every leverage", about a page with no
   entry days on it (measured 16 September 2026, ?symbol=PONS&side=long&hold=7). The assumptions
   clause stays true in both states because the assumptions table now renders in both. */
const description = grid
  ? `Which leveraged ${perp.symbol} positions were liquidated and which survived — every entry day, every leverage, held ${hold} days. The prices are real traded candles and the published margin tiers; the closing rule is a model, with its six assumptions listed on the page.`
  : `A leverage backtest for ${perp.symbol} ${mapSide}s held ${hold} days, waiting on enough traded daily candles to run. The prices will be real traded candles and the published margin tiers; the closing rule is a model, with its six assumptions listed on the page.`;

/* THE FUNDING DIRECTION WAS WRITTEN FOR LONGS AND PRINTED FOR BOTH SIDES. The assumptions table
   said "Usually too kind: a long paying funding runs out of margin sooner than this grid says"
   under a grid of shorts. Measured 16 September 2026 on
   /liquidations/survival?symbol=BTC&side=short&hold=90, whose grid is "short positions held 90
   days": the only reason given was about a long. The usual case is a direction of payment, and a
   payment has two ends — Hyperliquid's base rate is positive, so at rest longs pay and shorts
   receive, and a short grid that ignores funding is usually too HARSH, not too kind. The fees
   row's "the same sign" was inherited from the same long-only reading: fees cost both sides, so
   for a short they have the opposite sign to the funding it usually receives.
   Both sentences are chosen by `mapSide`, the value the grid itself is computed at. */
/* THE ASSUMPTIONS TABLE RENDERS WITHOUT A GRID, SO ITS SENTENCES CANNOT POINT AT ONE AS IF IT WERE
   THERE. Moving the table out of the grid branch left its section note and the funding row speaking
   in the present tense about a grid: measured 16 September 2026 on
   /liquidations/survival?symbol=PONS&side=long&hold=7, PONS short 7 and GRAM long 90 (no heat grid,
   no tables but this one), the note said "the grid is not simply optimistic or simply pessimistic —
   it is a rule applied consistently" and the funding row "sooner than the grid says". Every reference
   to the grid in this block now goes through `grid`, the same value that decides whether the heat
   grid renders, so the tense cannot outlive the grid it describes. */
const gridSays = grid ? "the grid says" : "the grid will say";
const gridIs = grid ? "the grid is" : "the grid will be";
const assumptionsNote = grid
  ? "Every one of these would move some cells. They are not all in the same direction, so the grid is not simply optimistic or simply pessimistic — it is a rule applied consistently, with these six things left out."
  : "Once there is enough history to draw the grid, every one of these will move some of its cells. They are not all in the same direction, so the grid will be neither simply optimistic nor simply pessimistic — it will be a rule applied consistently, with these six things left out.";
const fundingBends =
  mapSide === "long"
    ? { verdict: "too kind", why: `Hyperliquid's base rate has longs paying shorts, and a long paying funding runs out of margin sooner than ${gridSays}.` }
    : { verdict: "too harsh", why: `Hyperliquid's base rate has longs paying shorts, and a short receiving funding keeps margin longer than ${gridSays}. When funding turns negative the short pays instead, and ${gridIs} too kind.` };
/* "Every cell asks" ABOUT A PAGE WITH NO CELLS. The intro read the same on every render, and on an
   empty one (measured 16 September 2026, ?symbol=PONS&side=long&hold=7: 0 tables, no heat grid)
   it described cells that were not there and an assumptions list that was not rendered. The tense
   follows `grid`, and the assumptions table no longer sits inside the grid branch — it depends only
   on the hold, the side and the margin tier, all of which exist in both states. */
const cellsAsk = grid ? "Every cell asks" : "Once there is enough history, every cell of the grid will ask";
const feesVsFunding = mapSide === "long" ? "the same sign as the funding a long usually pays" : "the opposite sign to the funding a short usually receives";
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt} crumb={{ href: "/liquidations", label: "Liquidations", current: "Survival" }}>
  <div class="page-head">
    <p class="crumb"><a href="/liquidations">Liquidations</a> › Survival</p>
    <h1>{perp.symbol} leverage survival</h1>
    <p>
      {survivalLede && <><strong>{survivalLede}</strong>{" "}</>}
      <strong>The prices are real; the closing rule is a model.</strong> Both come from
      <strong>Hyperliquid</strong> — its candles, and its margin table. {cellsAsk} one
      checkable question about an observed price path — a <strong>{mapSide}</strong> opened at
      that day's close, at that leverage, held {hold} days: did the maintenance-margin threshold
      get crossed, and on which day? No price here is simulated. But deciding that a position
      <em>would have closed</em> takes assumptions, and they are listed below rather than left
      implicit. That is a smaller set than
      {" "}<a class="link" href="/liquidations">the density map</a> needs, which is the honest
      version of the claim this paragraph used to make.
    </p>
    <Advisory />
  </div>

  <form method="GET" class="calc" style="margin-bottom:16px">
    <label>Coin
      <select name="symbol">{snap.perps.map((p) => <option value={p.symbol} selected={p.symbol === perp.symbol}>{p.symbol}</option>)}</select>
    </label>
    <label>Side
      <select name="side">
        <option value="long" selected={mapSide === "long"}>Long</option>
        <option value="short" selected={mapSide === "short"}>Short</option>
      </select>
    </label>
    <label>Held for
      <select name="hold">{HOLDS.map((h) => <option value={h} selected={h === hold}>{h} days</option>)}</select>
    </label>
    {/* NOT "Redraw the map". This page draws a grid of one-day-per-leverage outcomes over real
        candles; the map is the modelled density surface on /liquidations, and borrowing its
        label here names the wrong artefact on the page the reader is looking at. "Re" only when a
        grid is on the page: an empty render (PONS long 7, 16 September 2026) has none to redraw. */}
    <button class="btn btn--primary" type="submit">{grid ? "Redraw the grid" : "Draw the grid"}</button>
  </form>

  {grid ? (
    <>
      <figure class="chart">
        <svg viewBox={`0 0 ${HW} ${HH}`} class="heat" role="img" data-tips style={`--heatRatio: ${HW} / ${HH}`}
             aria-label={`Survival map for ${perp.symbol}: ${grid.levels.length} leverage levels by ${grid.entries.length} entry days, ${mapSide} positions held ${hold} days.`}>
          <Fragment set:html={heatSvg} />
        </svg>
        <figcaption>
          {perp.symbol} daily candles from Hyperliquid — real traded days only; the venue's
          pre-launch backfill carries zero volume and is excluded. Entry days
          {" "}{dayLabel(grid.from)} to {dayLabel(grid.to)}, each with a complete {hold}-day
          window, so no column is flattered by having had less time to fail.
        </figcaption>
      </figure>

      <h2 class="section">The same map, counted</h2>
      <div class="panel">
        <table class="tbl">
          <thead><tr><th class="num">Leverage</th><th class="num">Entry days tested</th><th class="num">Closed within {hold}d</th><th class="num">Survived</th><th class="num">Survival rate</th><th class="num">Median days to closure</th></tr></thead>
          <tbody>
            {grid.levels.map((lv) => (
              <tr class={lv.L === tier1.maxLeverage ? "is-active" : undefined}>
                <td class="num">{lv.L}×{lv.L === tier1.maxLeverage ? " · max" : ""}</td>
                <td class="num">{lv.tested}</td>
                <td class="num">{lv.liquidated}</td>
                <td class="num">{lv.tested - lv.liquidated}</td>
                <td class="num">{((1 - lv.liquidated / Math.max(1, lv.tested)) * 100).toFixed(1)}%</td>
                <td class="num">{medianClosure(lv) ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <div class="empty">
      <div class="empty__body">
        {stored === 0 ? (
          <>
            {/* NOT "not collected yet". getCandles() returns null for a key never written, a series
                written empty, a KV read that threw and a missing binding alike, so a title naming one
                of those causes is false for the other three. Measured 16 September 2026 on the local
                build: ?symbol=BTC&side=long&hold=90 rendered "Candle history not collected yet" for
                BTC when the upstream read failed, beside a BTC short 90 grid of 90 entry days. The
                sentence now states only what the page knows: nothing could be read. The refresh
                claim is the worker's (worker/ingest.ts: CANDLE_REFRESH_HOURS = 12, absent symbols
                filled first) and names no tick, because one sweep of CHUNK symbols runs per tick. */}
            <p class="empty__title">No {perp.symbol} daily candles to test</p>
            <p class="empty__text">This needs {needDays(hold)} days of traded daily candles for {perp.symbol}, and none could be read. A missing series is fetched ahead of the routine refresh, which runs every twelve hours.</p>
          </>
        ) : (
          <>
            <p class="empty__title">Not enough {perp.symbol} history for a {hold}-day hold</p>
            <p class="empty__text">
              {storedSentence}
              {fits.length ? (
                <>Pick a shorter hold that fits: {fits.map((h, i) => <>{i === 0 ? "" : i === fits.length - 1 ? " or " : ", "}<a class="link" href={holdHref(h)}>{h} days</a></>)}.</>
              ) : noFitSentence}
            </p>
          </>
        )}
      </div>
    </div>
  )}

      {/* WHAT THIS PAGE USED TO SAY WAS "Nothing here is modelled", on a page whose entire
          argument is that it is more honest than the density map beside it. The prices are
          indeed real, but the closing rule is a model with at least six assumptions, and none
          of them were stated. An unstated assumption on a page selling its own rigour is worse
          than the same assumption on a page that admits it.

          The direction of each bias is given because that is the part a reader can actually
          use. The count each way depends on the side: for longs three rows read too kind and
          two too harsh; for shorts funding changes sides, so it is two and three. */}
      <h2 class="section">What the closing rule assumes</h2>
      <p class="section-note">
        {assumptionsNote}
        {/* THE SIBLING TEST, WHICH THIS PAGE NEVER POINTED AT. Both pages ask whether the model
            survives contact with a real market and neither linked the other: /liquidations/sweep
            had two inbound editorial links in the whole site and is one of the URLs Search
            Console still lists as Discovered, not indexed. The reciprocal link is on the sweep
            page too. */}
        {" "}<a class="link" href="/liquidations/sweep">The same model against a real crash, February 2026 →</a>
      </p>
      <div class="panel">
        <table class="tbl">
          <thead><tr><th>Assumption</th><th>What is left out</th><th>Which way it bends the answer</th></tr></thead>
          <tbody>
            <tr>
              <td><strong>No funding</strong></td>
              <td class="reason">A leveraged position pays or receives funding every settlement. Over a {hold}-day hold that is {hold * 24} payments on this venue, and it moves margin, not price.</td>
              <td class="reason">Usually <strong>{fundingBends.verdict}</strong>: {fundingBends.why}</td>
            </tr>
            <tr>
              <td><strong>No fees</strong></td>
              <td class="reason">Opening and closing both cost. Small beside funding over {hold} days, and {feesVsFunding}.</td>
              <td class="reason">Too kind, slightly.</td>
            </tr>
            <tr>
              <td><strong>Isolated margin</strong></td>
              <td class="reason">Each position is assumed to stand on its own margin, with no account balance behind it and no top-ups.</td>
              <td class="reason"><strong>Too harsh</strong> for anyone trading cross-margin or adding margin — those positions survive longer.</td>
            </tr>
            <tr>
              <td><strong>Traded price, not mark price</strong></td>
              <td class="reason">Exchanges liquidate against a mark or index price, which is smoothed. This tests the candle's own low and high.</td>
              <td class="reason"><strong>Too harsh</strong>: a thin wick can cross this threshold without moving the mark that far.</td>
            </tr>
            <tr>
              <td><strong>Hyperliquid's tier 1</strong></td>
              <td class="reason">{pct(mmf, 3)}, from the first tier of <strong>Hyperliquid's</strong> margin table for {perp.symbol} — this page names the venue because a maintenance margin is venue-specific and "the venue's table" left a reader to guess which. Real tiers step up with position size; only the first is used.</td>
              <td class="reason">Too kind at large size, exact at small size.</td>
            </tr>
            <tr>
              <td><strong>Daily candles</strong></td>
              <td class="reason">The check is one low and one high per day, so the day a position closes is known and the hour is not.</td>
              <td class="reason">Neither — it limits resolution, not direction.</td>
            </tr>
          </tbody>
        </table>
      </div>

  {grid && (
      <details class="src">
        {/* THE ENTRY DAYS, NOT EVERY CANDLE CONSULTED. Each cell walks forward up to {hold}
            further days looking for the crossing, so the outcome of the last entry depends on
            candles this table does not show. Saying "the series this is computed from" over a
            90-row table was an overclaim on a page that shows its data precisely so a reader
            can redo the work — with only these rows, the right-hand columns cannot be redone. */}
        <summary>The {grid.entries.length} entry days ({hold} further days are read past the last one)</summary>
        <div class="panel" style="margin-top:10px">
          <table class="tbl">
            <thead><tr><th>Entry day (UTC)</th><th class="num">Close</th><th class="num">Low</th><th class="num">High</th></tr></thead>
            <tbody>
              {grid.entries.map((c) => (
                <tr>
                  <td>{new Date(c[0]).toISOString().slice(0, 10)}</td>
                  <td class="num">{px(c[4])}</td>
                  <td class="num">{px(c[3])}</td>
                  <td class="num">{px(c[2])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
  )}

  <p style="margin-top:24px">
    <a class="link" href="/liquidations">Modelled liquidation density →</a>
    · <a class="link" href="/tools/position-size">Size a position against a stop →</a>
  </p>

  <style>
    .heat { display: block; width: 100%; height: auto; aspect-ratio: var(--heatRatio); }
    .heat :global(rect) { shape-rendering: crispEdges; }
    .src { margin-top: var(--gap-cluster); }
    /* Astro scopes styles per page, so a rule defined on another page never reaches this one.
       The pre-push check caught this the moment the assumptions table was added. */
    .tbl td { vertical-align: top; }
    .src summary { font-size: 13px; color: var(--text-dim); cursor: pointer; padding: 8px 0; }
    .src summary:hover { color: var(--text); }
  </style>
</Base>
