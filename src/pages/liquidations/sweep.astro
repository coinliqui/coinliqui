---
import Base from "../../layouts/Base.astro";
import { usd, pct } from "../../lib/funding.ts";
import { buildLiqMap, PROFILES } from "../../lib/liqmap.ts";
import { paintHeatMap } from "../../lib/heatmap.ts";
import { RAMP, CH, compact } from "../../lib/chart.ts";
import { aggregate } from "../../lib/series.ts";
import type { Candle } from "../../lib/candles.ts";
import frozen from "../../data/sweep-2026-02.json";

import Advisory from "../../components/Advisory.astro";
/* =========================================================================================
   THE DEMONSTRATION CASE.

   The map on /liquidations is a model, and a model is only worth drawing if you can point at
   a moment and say: here is the claim it makes, and here is the price doing it. This page is
   that moment. The window was not chosen from memory — it is the largest modelled sweep in
   the whole hourly series, found by running the model forward over every hour and ranking.

   The claim is narrow on purpose. Price traded through where the model places levels. It is
   NOT a claim about how much was liquidated: no venue publishes that, and this site has
   already established why any number offered for it is wrong by an unknown factor.
   ========================================================================================= */

const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const fmtT = (t: number) => {
  const d = new Date(t);
  return `${d.getUTCDate()} ${MON[d.getUTCMonth()]}, ${String(d.getUTCHours()).padStart(2, "0")}:00`;
};

const hourly = (frozen.candles as number[][]) as Candle[];
const mmf = 1 / (2 * frozen.maxLeverage);
const profile = PROFILES.find((p) => p.key === Astro.url.searchParams.get("profile")) ?? PROFILES[1];

const FACTOR = 2;                                   // 2-hour bars: 138 columns, candles still candles
const series = aggregate(hourly, FACTOR);
const DISPLAY_FROM = Date.parse("2026-02-01T00:00:00Z");
const DISPLAY_TO = Date.parse("2026-02-12T12:00:00Z");
const start = series.findIndex((c) => c[0] >= DISPLAY_FROM);
const end = series.findIndex((c) => c[0] >= DISPLAY_TO);
const cols = (end < 0 ? series.length : end) - start;
const POSITION_LIFE_DAYS = 14;
const ageBars = (POSITION_LIFE_DAYS * 24) / FACTOR;

const map = buildLiqMap({
  candles: series, start, cols, mmf, maxLeverage: frozen.maxLeverage,
  oiNotional: frozen.oiNotional, profile, rows: 150, ageBars, minSpan: 0.16,
});
const WICK_AT = Date.parse("2026-02-06T00:00:00Z");
/* aggregate() chunks backwards from the end, so a 2-hour bar does not necessarily start on an
   even hour. The bar to point at is the one whose window CONTAINS the wick, found by index —
   comparing timestamps matched nothing and silently dropped the highlight. */
const wickIdx = (() => {
  let k = 0;
  for (let i = 0; i < map.candles.length; i++) if (map.candles[i][0] <= WICK_AT) k = i;
  return k;
})();
const wickBarT = map.candles[wickIdx]?.[0] ?? WICK_AT;
const paint = paintHeatMap(map, { mark: { t: wickBarT, label: `${fmtT(wickBarT)} — low $60,000` } });
const stepMs = FACTOR * 3_600_000;

// The five bars that cleared the most modelled notional, largest first.
const peaks = map.swept
  .map((v, i) => ({ v, i, t: map.candles[i][0], c: map.candles[i] }))
  .sort((a, b) => b.v - a.v)
  .slice(0, 6);
const sweptTotal = map.swept.reduce((a, b) => a + b, 0);

// Observed facts about the window, computed from the frozen candles — nothing modelled here.
const hourAt = (iso: string) => hourly.find((c) => c[0] === Date.parse(iso))!;
/* The event runs 5 Feb 00:00 to 6 Feb 06:00 — the slide and the wick that ends it. Fixing the
   window at the calendar day would put the $60,000 print, which is the whole story, outside it. */
const EVENT_FROM = Date.parse("2026-02-05T00:00:00Z"), EVENT_TO = Date.parse("2026-02-06T06:00:00Z");
const event = hourly.filter((c) => c[0] >= EVENT_FROM && c[0] <= EVENT_TO);
const priorVol = hourly.filter((c) => c[0] < EVENT_FROM).map((c) => c[5]).sort((a, b) => a - b);
const medVol = priorVol[Math.floor(priorVol.length / 2)];
const dayOpen = event[0][1];
const dayLow = Math.min(...event.map((c) => c[3]));
const wick = hourAt("2026-02-06T00:00:00Z");
const biggestHour = event.reduce((a, b) => (b[5] > a[5] ? b : a));
/* THE FALL IS COUNTED IN WHOLE HOURLY BARS, READ OFF THE SAME TABLE THE PRICES COME FROM.
   The page said "twenty-three hours". Its $73,139 is the OPEN of the 5 Feb 00:00 bar and its
   $60,000 is the low inside the 6 Feb 00:00 bar, so the hourly table the reader can check puts
   the fall at 24 hours or more and under 25 (measured 16 September 2026). Twenty-three counted
   from 5 Feb 01:00, the last bar whose range still held $73,139, which is not the price the
   sentence quotes — and the chart's two-hour bar stamped "5 Feb, 23:00 — low $60,000" made the
   same wrong count look confirmed. The span is now the low's index in `event`, the table the
   prices are read from, so the number and the prices cannot come from different bars again. */
const lowAt = event.findIndex((c) => c[3] === dayLow);
const fallUnderHours = lowAt + 1;
const slideHours = event.indexOf(wick);
/* "PEAK DRAWDOWN" IS MEASURED FROM THE RUNNING PEAK, NOT FROM THE WINDOW'S OPEN. The strip
   printed (low / open - 1) = -18.0% under that label; the highest price before the low was
   the $73,310 high at 5 Feb 01:00, which makes it -18.2% (measured 16 September 2026). Inside a
   bar the order of high and low is unknown, so the peak a bar's low can fall from is that bar's
   open or any EARLIER bar's high — never its own high, which may have printed after the low.
   Because the peak can be an open, the strip names which one it is: it said "from the … high"
   unconditionally, true for this data only because the peak happens to be a high. */
let runHigh = -Infinity, drawdown = 0, drawdownFrom = dayOpen, drawdownFromKind = "open";
for (const c of event) {
  const fromOpen = c[1] > runHigh;
  const peak = fromOpen ? c[1] : runHigh;
  if (c[3] / peak - 1 < drawdown) { drawdown = c[3] / peak - 1; drawdownFrom = peak; drawdownFromKind = fromOpen ? "open" : "high"; }
  runHigh = Math.max(runHigh, c[2]);
}
/* The strip's dates are read off the window, not typed: "5–6 Feb" was a literal beside numbers
   computed from `event`, so moving EVENT_FROM/EVENT_TO would have moved the numbers and left the
   dates behind. */
const dayRange = (a: number, b: number) => {
  const x = new Date(a), y = new Date(b);
  const [dx, mx, dy, my] = [x.getUTCDate(), x.getUTCMonth(), y.getUTCDate(), y.getUTCMonth()];
  if (mx !== my) return `${dx} ${MON[mx]} – ${dy} ${MON[my]}`;
  return dx === dy ? `${dx} ${MON[mx]}` : `${dx}–${dy} ${MON[mx]}`;
};
const eventDays = dayRange(event[0][0], event[event.length - 1][0]);
/* THE SAME DATES IN PROSE, READ OFF THE SAME WINDOW. The strip labels were derived from `event`
   while the opening sentence and the meta description still typed "5–6 February 2026" beside them
   (verifier, 16 September 2026) — correct today and unable to follow the window if it moved. */
const eventDate = `${eventDays} ${new Date(event[event.length - 1][0]).getUTCFullYear()}`;
/* The comparison is total-to-total, over the SAME span. Multiplying a one-hour median by
   thirty-one fixes the units and not the statistic: prior hourly volume is right-skewed
   (mean/median 1.87), so that denominator is too small and the ratio comes out ~1.8x too
   big. The honest denominator is the median of every prior thirty-one-hour total. */
const eventVol = event.reduce((s, c) => s + c[5], 0);
const priorBars = hourly.filter((c) => c[0] < EVENT_FROM).map((c) => c[5]);
const rolling: number[] = [];
for (let i = 0; i + event.length <= priorBars.length; i++) {
  rolling.push(priorBars.slice(i, i + event.length).reduce((a, b) => a + b, 0));
}
rolling.sort((a, b) => a - b);
const typicalOverSameSpan = rolling.length ? rolling[Math.floor(rolling.length / 2)] : medVol * event.length;

const px = (v: number) => usd(v, 0);
const btc = (v: number) => Math.round(v).toLocaleString("en-US");
const fetched = new Date(frozen.fetchedAt).toISOString().slice(0, 10);
// One string, not "{price} {kind}" in the markup: Astro dropped the space between the two
// expressions and shipped "$73,310high" (rendered 16 September 2026).
const drawdownLabel = `peak drawdown, from the ${px(drawdownFrom)} ${drawdownFromKind}, ${eventDays}`;

/* CUT MID-WORD, INSIDE THE PART THAT MATTERS. At 82 characters with the brand suffix this
   rendered as "...liquidation model vs real ca" in a result — the comparison being made is the
   whole point of the page and it broke inside the last word of it. Measured across every title
   on the site: eight of ten over-long templates lose only the suffix, and this was one of the
   two that lost meaning. Date, subject and the comparison all survive now.
   The h1 is unchanged; this is the <title> only. */
const title = "5 February 2026 BTC crash: model vs real candles";
const description =
  `BTC fell from ${px(dayOpen)} to a ${px(dayLow)} wick in under ${fallUnderHours} hours on ${eventDate}. Here is the modelled liquidation field for that window, with the price path drawn over it, so you can watch price run into the bands and clear them.`;
---

{/* NO fetchedAt. It fed nothing but dateModified here — `frozen` already suppresses the pill —
    and what it fed was the February capture date, while the sitemap published the commit date
    for the same URL. dateModified describes the document, and this document changes when the
    prose around the frozen dataset does. The capture date is stated in the page's own text. */}
<Base title={title} description={description} frozen crumb={{ href: "/liquidations", label: "Liquidations", current: "The 5 February sweep" }}>
  <div class="page-head">
    <p class="crumb"><a href="/liquidations">Liquidations</a> › The 5 February sweep</p>
    <h1>The 5 February 2026 BTC sweep: price ran into the bands and cleared them</h1>
    <p>
      A liquidation map is a model, and a model that is never tested is decoration. On
      <strong>{eventDate}</strong> Bitcoin fell from {px(dayOpen)} to a {px(dayLow)} wick in
      {/* THE FALL AND THE WINDOW ARE TWO SPANS, AND THE SENTENCE NAMES BOTH. The fall runs from
          the window's first open to the bar holding the low (see `fallUnderHours`); the volume
          ratio compares every bar of the window with the median total over the same number of
          bars, so it is attached to the window by name, not to the fall. Both numbers are read
          from the series. */}
      under {fallUnderHours} hours, on {(eventVol / typicalOverSameSpan).toFixed(0)}× the volume this {event.length}-hour window normally carries. Below is the modelled field
      for that window with the observed price drawn over it. Watch the bright bands under the price
      end where the candles reach them.
    </p>
    <Advisory />
  </div>

  <div class="reads">
    <div><b>{px(dayOpen)} → {px(dayLow)}</b><span>observed, {eventDays}</span></div>
    <div><b>{(drawdown * 100).toFixed(1)}%</b><span>{drawdownLabel}</span></div>
    <div><b>{(biggestHour[5] / medVol).toFixed(0)}×</b><span>the busiest hour against the prior median</span></div>
    <div><b>{compact(sweptTotal)}</b><span>modelled notional price traded through</span></div>
  </div>

  <div class="chart" style={`margin-top:18px; --mapRatio: ${CH.w} / 576`}>
    <Fragment set:html={paint.svg.replace("<svg ",
      `<svg data-heat="1" data-ramp="${RAMP.join(",")}" data-scale="${paint.scale}" data-gamma="${paint.gamma}" ` +
      `data-plot="${paint.plot.join(",")}" data-prange="${map.loPrice},${map.hiPrice}" data-axx="${paint.axisX}" ` +
      `data-taxis="${map.candles[0][0]},${stepMs}" data-taxisy="${paint.timeAxisY}" data-rows="${map.rows}" data-cols="${map.cols}" `)} />
  </div>

  <div class="scalebar">
    <Fragment set:html={paint.legend} />
    <p class="scalebar__note">
      1–12 February 2026, two-hour bars. Brighter is more modelled notional standing at that price
      at that moment; the most crowded spot holds {compact(map.peak)}. A band ends one of two ways: price trades
      through it, which is why the picture goes dark behind the candles, or the positions behind
      it age past the {POSITION_LIFE_DAYS}-day position life and it fades out in four steps.
    </p>
  </div>

  <h2 class="section">What the picture actually claims</h2>
  <div class="verdict">
    <div>
      <b>Price traded through where the model places levels.</b> That claim is checkable: the
      candles are Hyperliquid's own, the level arithmetic is on the published margin tiers, and
      both are printed below. <b>The claim is not</b> that {compact(sweptTotal)} of positions were
      liquidated. No venue publishes a complete liquidation feed — Binance throttles to one event
      per symbol per second, and Hyperliquid's block data carries no liquidation-typed action at
      all, which <a class="link" href="/methodology/liquidations">we checked directly</a>. What is
      modelled is where the levels were. What is observed is that price went there.
    </div>
  </div>

  <h2 class="section">The six bars that cleared the most</h2>
  <p class="section-note">
    Ranked by modelled notional whose level the bar's high or low crossed. This is model output
    against observed price — the price column is fact, the notional column is not.
    {/* THESE ARE TWO-HOUR BARS, and the table below this one is HOURLY. Both stamp their rows
        the same way, so "5 Feb, 19:00" appears in both with different OHLC and nothing said
        which is which. The width was stated for the chart and in the assumptions table, and
        not here, where the ambiguity actually lands. Verified against the frozen data: this
        row's o/h/l/c/v is exactly the 2-hour aggregate of 19:00 and 20:00. */}
    <strong>Each row is a two-hour bar</strong> — stamped with the hour it opens. The hourly
    candles are in the table below, so the same timestamp appears in both with different highs
    and lows.
  </p>
  <div class="panel">
    <table class="tbl">
      <thead>
        <tr><th>2h bar, opens (UTC)</th><th class="num">Open</th><th class="num">High</th><th class="num">Low</th><th class="num">Close</th><th class="num">Volume</th><th class="num">Modelled notional cleared</th></tr>
      </thead>
      <tbody>
        {peaks.map((p) => (
          <tr class={p.i === wickIdx ? "is-active" : undefined}>
            <td>{fmtT(p.t)}</td>
            <td class="num">{px(p.c[1])}</td>
            <td class="num">{px(p.c[2])}</td>
            <td class="num">{px(p.c[3])}</td>
            <td class="num">{px(p.c[4])}</td>
            <td class="num">{btc(p.c[5])} BTC</td>
            <td class="num">{compact(p.v)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section">The hour itself</h2>
  {/* THIRTY WAS THE GAP BETWEEN THE FIRST AND LAST STAMPS, NOT THE WINDOW. The intro calls the
      same window 31 hours and the table below has 31 hourly rows (measured 16 September 2026).
      Nor does the slide fill the window: 24 bars fall into the wick and six recover after it.
      Both counts are now indices into `event`. */}
  <p class="prose">
    The slide across the first {slideHours} hours of this {event.length}-hour window is the setup; the payoff is a single bar. At
    <strong>{fmtT(wick[0])} UTC</strong> BTC opened at {px(wick[1])}, printed a low of
    <strong>{px(wick[3])}</strong>, and closed back at {px(wick[4])} — a
    {(((wick[1] - wick[3]) / wick[1]) * 100).toFixed(1)}% excursion recovered inside sixty minutes,
    on {btc(wick[5])} BTC of volume against a prior hourly median of {btc(medVol)}. A wick with
    no close behind it is the shape a forced-seller cascade leaves: the sells are not discretionary,
    so they take whatever bid is there, and the price snaps back once they stop. The model puts a
    dense band exactly in the path of that wick, and afterwards the band is gone.
  </p>

  <h2 class="section">How this window was chosen</h2>
  <p class="prose">
    Not from memory. The model was run forward over the full hourly series Hyperliquid publishes
    for BTC, accumulating the modelled notional each bar's range crossed, and the windows were
    ranked. By 24-hour total, 5 February 2026 comes first by a wide margin, and it is also the
    largest volume spike anywhere in the series. The next two candidates were rises rather than
    falls — the same mechanism on the short side, with less force behind it. Any of them could
    have been drawn; this one shows the most. The {hourly.length.toLocaleString("en-US")} bars
    needed to redraw it are frozen in this repository.
  </p>

  <h2 class="section">Inputs, frozen</h2>
  <div class="panel" style="max-width:900px">
    <table class="tbl">
      <thead><tr><th>Input</th><th>Value</th><th class="num">Observed?</th></tr></thead>
      <tbody>
        <tr><td>Candles</td><td>{hourly.length} hourly bars, {new Date(frozen.from).toISOString().slice(0, 10)} to {new Date(frozen.to).toISOString().slice(0, 10)}, from <code>{frozen.source}</code>, fetched {fetched}</td><td class="num">observed</td></tr>
        <tr><td>Drawn window</td><td>1–12 February 2026, aggregated to {FACTOR}-hour bars ({map.cols} columns)</td><td class="num">observed</td></tr>
        <tr><td>Positions open before the chart starts</td><td>{map.warmBars} bars — {(map.warmBars * FACTOR / 24).toFixed(0)} days — of positions built up off-screen before the first drawn column{map.warmBars >= ageBars ? "" : ", short of the assumed lifetime"}</td><td class="num">assumed</td></tr>
        <tr><td>Maintenance margin</td><td>{pct(mmf, 3)}, from Hyperliquid's tier 1 at {frozen.maxLeverage}× max leverage</td><td class="num">observed</td></tr>
        <tr class="is-active"><td>Modelled open positions</td><td>{usd(frozen.oiNotional)} — open interest when this file was frozen on {fetched}. Historical open interest is not published, so this sets the model's <em>scale</em>, not its shape.</td><td class="num">assumed</td></tr>
        <tr><td>Leverage mix</td><td><strong>{profile.label}</strong> — {profile.note}</td><td class="num">assumed</td></tr>
        <tr><td>Drawn price range</td><td>{px(map.loPrice)} – {px(map.hiPrice)}, set by {map.spanRule === "traded" ? "the traded range" : "the ±8% minimum, the traded range being narrower"}. {pct(map.clipped)} of modelled notional liquidates outside it.</td><td class="num">observed</td></tr>
      </tbody>
    </table>
  </div>

  <form method="GET" class="calc" style="margin-top:16px">
    <label>Assumed leverage mix
      <select name="profile">{PROFILES.map((p) => <option value={p.key} selected={p.key === profile.key}>{p.label}</option>)}</select>
    </label>
    <button class="btn btn--primary" type="submit">Redraw the map</button>
  </form>
  <p class="section-note">
    Change it and the bands move. That is the point of printing the assumption rather than hiding
    it behind a "Model 1 / Model 2 / Model 3" tab strip.
    {/* The other half of the same question — this page tests the model against one crash, the
        survival grid tests it against every entry day. Neither linked the other. */}
    {" "}<a class="link" href="/liquidations/survival">The same rule across every entry day, not one event →</a>
  </p>

  <h2 class="section">Every hour of the event, as traded</h2>
  {/* "The chart above is drawn from these" was false by about nine to one. This table is 31
      hourly rows covering the event itself; the chart spans 1-12 February — 288 hourly candles
      aggregated to two-hour bars. The table is a SLICE of what the chart is drawn from, which
      is a useful thing to publish and a different claim to make. */}
  <p class="section-note">
    Hyperliquid's own candles from 5 February 00:00 to 6 February 06:00 UTC, unmodified — the
    event itself, hour by hour. The chart above covers a wider window (1–12 February, in
    two-hour bars), so these rows are the part of its input that matters most rather than all
    of it.
  </p>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Hour (UTC)</th><th class="num">Open</th><th class="num">High</th><th class="num">Low</th><th class="num">Close</th><th class="num">Volume (BTC)</th><th class="num">vs prior hourly median</th></tr></thead>
      <tbody>
        {event.map((c) => (
          <tr class={c[5] > medVol * 10 ? "is-active" : undefined}>
            <td>{fmtT(c[0])}</td>
            <td class="num">{px(c[1])}</td>
            <td class="num">{px(c[2])}</td>
            <td class="num">{px(c[3])}</td>
            <td class="num">{px(c[4])}</td>
            <td class="num">{btc(c[5])}</td>
            <td class="num">{(c[5] / medVol).toFixed(1)}×</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p style="margin-top:24px">
    <a class="link" href="/liquidations">The live liquidation map →</a>
    · <a class="link" href="/liquidations/survival">Leverage survival — real candles, one stated rule →</a>
    · <a class="link" href="/funding/btc">BTC funding and price →</a>
  </p>

  <style>
    .chart :global(svg[data-heat]) { aspect-ratio: var(--mapRatio); }
    .scalebar { display: flex; align-items: flex-start; gap: 24px; flex-wrap: wrap; margin: var(--gap-cluster) 0 0; }
    .scalebar__note { flex: 1 1 320px; margin: 0; font-size: 12.5px; color: var(--text-faint); max-width: 62ch; line-height: 1.55; }
    .reads { display: flex; flex-wrap: wrap; gap: 12px 44px; margin: 16px 0 0; }
    .reads b { display: block; font-size: 21px; font-weight: 650; letter-spacing: -.012em; font-variant-numeric: tabular-nums; }
    .reads span { font-size: 12.5px; color: var(--text-faint); }
  </style>
</Base>
