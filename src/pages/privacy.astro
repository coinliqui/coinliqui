---
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import { PINNED_KEY, IDENTITY, GA_ENABLED } from "../lib/site.ts";

/**
 * AN ORDINARY PRIVACY POLICY. Deliberately short, deliberately unremarkable.
 *
 * This page used to be an argument. It led with "there are no accounts and none are planned",
 * claimed zero analytics, zero third-party scripts and zero off-origin requests, and spent
 * three paragraphs on a Cloudflare beacon that the CSP was blocking. That was a position, and
 * positions belong on pages that are selling something.
 *
 * The site now runs Google Analytics 4 on purpose. So this is a compliance page: what is
 * collected, what cookies exist, what is not taken. No claims that need defending, no
 * paragraph asking the reader to open a network tab and check us.
 *
 * Two of the old sentences were about to become false rather than merely promotional, and
 * that is why this could not just be trimmed: "no analytics run" is now wrong, and "no
 * accounts, and none are planned" is wrong about the plan.
 *
 * GA_ENABLED gates the analytics section against the measurement ID actually being set, so
 * the page describes what the site does rather than what it is configured to do one day.
 * A page claiming to run analytics that are not running is the same class of untruth as the
 * one this replaced, pointed the other way.
 */
const title = "Privacy";
/* GATED ON THE SAME FLAG AS THE BODY. The description asserted "Google Analytics for traffic
   measurement, two cookies" while the body, correctly gated, said "No analytics are running on
   this site at present" — the page contradicting itself in the one line search engines quote.
   Written the moment the body was gated and the head was not, which is why both read from
   GA_ENABLED now rather than from what the site is configured to do one day. */
const description = GA_ENABLED
  ? "What Coinliqui collects: Google Analytics for traffic measurement, cookies, and no payment or personal information."
  : "What Coinliqui collects: no analytics at present, one preference cookie, and no payment or personal information.";
const updated = "17 August 2026";
---

<Base title={title} description={description}>
  <div class="page-head">
    <h1>Privacy</h1>
    <p>What this site collects, and what it does not. Last updated {updated}.</p>
  </div>

  <h2 class="section">What we do not take</h2>
  <p class="prose">
    No payment details — nothing on this site is for sale and there is no checkout. No personal
    information: no name, email address, password, wallet connection or exchange API key is
    asked for anywhere. There are no accounts today, so there is nothing to register for and
    nothing to sign into. If that changes, this page changes with it.
  </p>

  {GA_ENABLED ? (
    <>
      <h2 class="section">Analytics</h2>
      <p class="prose">
        This site uses <strong>Google Analytics 4</strong> to measure traffic. It records which
        pages are viewed and in what order, roughly where in the world the request came from,
        the device and browser, and how you arrived — a search result, a link, or directly.
        Google processes this on our behalf and may transfer it outside your country, including
        to the United States. It is used to understand which pages are worth writing and
        nothing else: no profiles are built, nothing is sold, and no data is shared with
        advertisers.
      </p>
      <p class="prose">
        You can stop it with any content blocker, with Google's own
        {" "}<a class="link" href="https://tools.google.com/dlpage/gaoptout" rel="nofollow noopener">opt-out add-on</a>,
        or by blocking cookies for this site. Every page works identically either way.
      </p>
    </>
  ) : (
    <>
      <h2 class="section">Analytics</h2>
      <p class="prose">No analytics are running on this site at present.</p>
    </>
  )}

  <h2 class="section">Cookies and local storage</h2>
  <div class="panel" style="max-width:860px">
    <table class="tbl">
      <thead><tr><th>Name</th><th>Kind</th><th>Purpose</th><th>Expires</th></tr></thead>
      <tbody>
        {GA_ENABLED && (
          <tr>
            <td><code>_ga</code>, <code>_ga_*</code></td>
            <td>Cookie</td>
            <td>Google Analytics — tells one browser apart from another so a visit is not counted twice</td>
            <td>2 years</td>
          </tr>
        )}
        <tr>
          <td><code>rail</code></td>
          <td>Cookie</td>
          <td>Whether you collapsed the sidebar. Two possible values; not an identifier</td>
          <td>1 year</td>
        </tr>
        <tr>
          <td><code>{PINNED_KEY}</code></td>
          <td>Local storage</td>
          <td>The coins you pinned on <a href="/watchlist">your watchlist</a>. Never sent anywhere</td>
          <td>Until you clear it</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="section-note" style="margin-top:10px">
    Clearing your browser data removes all of them and the site behaves the same without them.
  </p>

  <h2 class="section">The calculators</h2>
  <p class="prose">
    The <a href="/tools">calculators</a> compute in the page and store nothing. Their forms
    submit as <code>GET</code>, so the values you enter appear in the page's own URL — which is
    what makes a result shareable, and also means those numbers reach ordinary web-server
    request logs. Nothing links them to you, but if you would rather a real account balance did
    not appear in a log line, use a representative figure.
  </p>

  <h2 class="section">Hosting</h2>
  <p class="prose">
    This site runs on Cloudflare, which processes the requests needed to serve a page and keeps
    aggregate traffic metrics, as any web host does.
  </p>

  <h2 class="section">Contact</h2>
  <p class="prose">
    Questions about any of this, including a request to delete data associated with your
    visits: <!--email_off--><a class="link" href={`mailto:${IDENTITY.contact}`}>{IDENTITY.contact}</a><!--email_on-->.
  </p>

  <Related items={[
    { href: "/about", label: "About", note: "Who operates this site and what it is for." },
    { href: "/data-sources", label: "Data sources", note: "Every endpoint behind every number here." },
    { href: "/methodology", label: "Methodology", note: "How the numbers are produced." },
    { href: "/watchlist", label: "Watchlist", note: "The one feature that stores anything, and it stores it in your browser." },
  ]} />

  <style>
    h2.section { margin-top: 32px; }
  </style>
</Base>
