---
import Base from "../layouts/Base.astro";
import { getSnapshot, coldStart } from "../lib/hyperliquid.ts";
import { pct, usd } from "../lib/funding.ts";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();
const rows = [...snap.perps].sort((a, b) => b.oiNotional - a.oiNotional);
const total = rows.reduce((s, p) => s + p.oiNotional, 0);
---
<Base title="Crypto perpetual open interest" description="Open interest across covered perpetual contracts, with turnover — 24h volume as a multiple of open interest — which says how fast the positioning is churning." fetchedAt={snap.fetchedAt}>
  <h1 style="margin:0 0 6px;font-size:26px;letter-spacing:-.02em">Open interest</h1>
  <p style="margin:0 0 20px;max-width:74ch"><strong class="num">{usd(total)}</strong> across {rows.length} contracts. The turnover column is 24h volume divided by open interest: a high number means the position base is churning rather than accumulating.</p>
  <table class="tbl">
    <thead><tr><th>Symbol</th><th class="num">Open interest</th><th class="num">24h volume</th><th class="num">Turnover</th><th class="num">Max leverage</th></tr></thead>
    <tbody>
      {rows.map((p) => (
        <tr>
          <td><a href={`/funding/${p.symbol.toLowerCase()}`}>{p.symbol}</a></td>
          <td class="num">{usd(p.oiNotional)}</td>
          <td class="num">{usd(p.dayNtlVlm)}</td>
          <td class="num">{p.oiNotional > 0 ? (p.dayNtlVlm / p.oiNotional).toFixed(2) + "×" : "—"}</td>
          <td class="num">{p.maxLeverage}×</td>
        </tr>
      ))}
    </tbody>
  </table>
  <style>
  </style>
</Base>
