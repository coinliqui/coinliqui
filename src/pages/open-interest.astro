---
import Base from "../layouts/Base.astro";
import { getSnapshot, coldStart } from "../lib/hyperliquid.ts";
import { pct, signedPct, usd } from "../lib/funding.ts";
import Figure from "../components/Figure.astro";
import More from "../components/More.astro";
import Overview from "../components/Overview.astro";
import { extremeBy } from "../lib/extreme.ts";
import { readOiHistory, oiChange, readOiSeries } from "../lib/oi-history.ts";
import { shortDate, plural } from "../../public/shared.js";
import { capOf } from "../lib/margin.ts";
import { compact } from "../lib/chart.ts";
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();
const rows = [...snap.perps].sort((a, b) => b.oiNotional - a.oiNotional);
const total = rows.reduce((s, p) => s + p.oiNotional, 0);

/* CONCENTRATION IS THE QUESTION THIS PAGE COULD NOT ANSWER AT A GLANCE. A sorted table says BTC
   is first; it does not say that the top eight are most of the book, which is the fact a reader
   is actually after and the one that changes what open interest means. Ten ranked bars answer it
   in one look, and the share each carries is printed beside it so the picture is a second reading
   of a number rather than the only place it appears.

   HTML, NOT AN SVG: this figure is nine parts label and value to one part geometry, and text in a
   viewBox scales with the figure, cannot be selected and cannot be extracted. See `.bars`. */
/* THE MOVE, WHICH THIS PAGE COULD NOT SHOW UNTIL THE WORKER STARTED KEEPING IT. Open interest
   was a level here and never a change, because nothing stored yesterday — see
   migrations/0003_oi_snapshot.sql. The state matters as much as the number: for the first day
   after that table exists there is no comparison to make, and the page says so rather than
   printing a change of zero it cannot support. */
/* THE WINDOW IS PRINTED FROM THE ROWS THAT WERE READ, NOT FROM THE NUMBER THAT WAS ASKED FOR.
   Found on 16 September 2026 at https://coinliqui.com/open-interest: the opening said "Over the
   last 24 hours that book shrank 4.21%" and the column was headed "24h", and the dash legend added
   the same day said "no stored reading from 24 hours ago" — all printing `hours`, the 24 passed in.
   The reader never takes a reading from 24 hours ago. It takes each contract's newest reading
   from a band 24 to 27 hours before `now` (oi-history.ts, "TAKEN FROM A BAND"), and that file
   says the caller prints `since`. A move over 26 hours labelled 24 is the label-versus-expression
   defect oi-history.ts was written to prevent, reintroduced one call site later.

   So the hours, the band and the instant are constants HERE, passed to the reader rather than
   left to its defaults, and every window below is arithmetic on those three and on `since`, the
   reading actually used. Nothing on this page prints a duration it did not subtract. */
/* THE WINDOW IS THE READER'S. A change over 24 hours is the one figure every aggregator prints; over a
   week or two it is the build-up a chat answer cannot quote, because nobody published it. The store
   keeps 720 hours, so 14 days is the longest window whose baseline band is always inside it. */
const OI_WINDOWS = [
  { key: "24h", hours: 24, label: "24 hours" },
  { key: "7d", hours: 168, label: "7 days" },
  { key: "14d", hours: 336, label: "14 days" },
] as const;
const oiWin = OI_WINDOWS.find((w) => w.key === Astro.url.searchParams.get("w")) ?? OI_WINDOWS[0];
const OI_HOURS = oiWin.hours;
const OI_BAND_HOURS = 3;
const HOUR_MS = 3_600_000;
const oiNow = Date.now();
const oiDb = (Astro.locals as any)?.runtime?.env?.DB;
const oiHist = await readOiHistory(oiDb, oiNow, OI_HOURS, OI_BAND_HOURS);
/* NARROWED ONCE, HERE, RATHER THAN IN THE TEMPLATE. The warming block below narrows `oiHist` for
   everything after it as far as TypeScript is concerned, so the table's own `status === "ready"`
   test became a comparison between two types with no overlap and the column stopped typechecking.
   One const holds the ready shape or null, and the template asks a plain question. */
const oiReady = oiHist.status === "ready" ? oiHist : null;
/* ONE READING TIME OR SEVERAL, AND THE SENTENCE HAS TO KNOW WHICH. The worker writes every covered
   contract in one batch per hourly tick (worker/ingest.ts), so normally every baseline is the same
   row time and "since 12:00 UTC" is exact. It is not guaranteed: a contract missing from the newest
   tick inside the band — below the coverage floor for that hour — takes an older one. The ready
   result carries only the newest time, so the same reader is asked once more for a band of zero
   width ending at `since`. `since + hours - hours` is integer milliseconds, so the cutoff lands on
   `since` exactly, and a contract found there was read at `since`. Every measured contract found
   there: one time is printed. Any missing: the span they were all drawn from is printed instead,
   which is true whichever contracts took the older rows. */
const oiAtSince = oiReady ? await readOiHistory(oiDb, oiReady.since + OI_HOURS * HOUR_MS, OI_HOURS, 0) : null;
/* THE BOOK OVER 30 DAYS, from today's covered contracts only, so the line moves with open interest and
   not with contracts entering or leaving coverage. A contract without a reading in every bucket is left
   out and the share of today's book the line covers is printed, rather than summing a set that changes
   along the line. The chart carries levels and dates, not a change figure: the change is the table's,
   from hourly readings, and a second change from bucket averages would disagree with it. */
/* Eight-hour steps: ninety points over thirty days reads the same at 180px tall as one hundred and
   eighty, at half the bytes — the line at four hours put the page 377 bytes over its budget. */
const BOOK_STEP_H = 8;
const oiSeries = await readOiSeries(oiDb, oiNow, 30, BOOK_STEP_H);
const book = (() => {
  if (!oiSeries) return null;
  const n = oiSeries.buckets.length;
  /* A contract counts if it has a reading in nine steps of ten. A step where any counted contract has
     none is not summed — it is a GAP in the line, drawn as one, rather than a dip: the store holds two
     empty 4-hour steps (28–29 September 2026, a collection outage) and an every-step rule left no
     contract at all, so the first deploy drew nothing. */
  const full = rows.filter((p) => { const v = oiSeries.bySymbol.get(p.symbol); return v && v.filter((x) => Number.isFinite(x)).length >= n * 0.9; });
  if (full.length < 2) return null;
  const pts = oiSeries.buckets.map((t, i) => {
    const vs = full.map((p) => oiSeries.bySymbol.get(p.symbol)![i]);
    return [t, vs.every((x) => Number.isFinite(x)) ? vs.reduce((a, b) => a + b, 0) : NaN] as const;
  });
  const vals = pts.map(([, v]) => v).filter(Number.isFinite);
  if (vals.length < 2) return null;
  const lo = Math.min(...vals), hi = Math.max(...vals);
  const pad = (hi - lo) * 0.08 || hi * 0.02;
  const y0 = lo - pad, y1 = hi + pad;
  const t0 = pts[0][0], t1 = pts[pts.length - 1][0];
  const X = (t: number) => ((t - t0) / Math.max(1, t1 - t0)) * 1000;
  const Y = (v: number) => 200 - ((v - y0) / (y1 - y0)) * 200;
  /* Runs of drawn steps, each its own segment, so a gap is visibly a gap. */
  const runs: (readonly [number, number])[][] = [];
  for (const pt of pts) {
    if (!Number.isFinite(pt[1])) { if (runs.length && runs[runs.length - 1].length) runs.push([]); continue; }
    if (!runs.length) runs.push([]);
    runs[runs.length - 1].push(pt as readonly [number, number]);
  }
  const segs = runs.filter((r) => r.length > 0);
  /* Whole units of a 1000×200 box: a tenth of a unit is invisible at any width this draws at, and the
     decimals were most of the page's 851 bytes over budget. The line alone — an area fill under it
     repeated every coordinate. */
  const line = segs.map((r) => r.map(([t, v], k) => `${k ? "L" : "M"}${Math.round(X(t))},${Math.round(Y(v))}`).join("")).join("");
  const gaps = pts.filter(([, v]) => !Number.isFinite(v)).length;
  const winX = X(Math.max(t0, oiNow - OI_HOURS * HOUR_MS));
  return {
    line, winX, gaps,
    hi, lo, hiPct: (Y(hi) / 200) * 100, loPct: (Y(lo) / 200) * 100,
    from: t0, to: t1, count: full.length,
    share: full.reduce((a, p) => a + p.oiNotional, 0) / Math.max(1, total),
  };
})();
const bandTo = oiNow - OI_HOURS * HOUR_MS;
const bandFrom = bandTo - OI_BAND_HOURS * HOUR_MS;

/* MINUTE PRECISION, ROUNDED THE WAY EACH CLAIM NEEDS. "No reading between A and B" is only true if
   the printed span lies inside the band searched, so it rounds inward; "readings taken between A
   and B" is only true if the printed span covers them, so it rounds outward. */
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const two = (n: number) => String(n).padStart(2, "0");
const hm = (d: Date) => `${two(d.getUTCHours())}:${two(d.getUTCMinutes())}`;
const dayOf = (d: Date) => `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}`;
const minute = (t: number, up: boolean) => new Date((up ? Math.ceil : Math.floor)(t / 60_000) * 60_000);
const utcSpan = (from: number, to: number, outward: boolean) => {
  const a = minute(from, !outward);
  const b = minute(to, outward);
  return dayOf(a) === dayOf(b)
    ? `between ${hm(a)} and ${hm(b)} UTC on ${dayOf(b)}`
    : `between ${hm(a)} UTC on ${dayOf(a)} and ${hm(b)} UTC on ${dayOf(b)}`;
};
/* The band the reader searched, as a span no reading was found in. */
const oiBandSpan = utcSpan(bandFrom, bandTo, false);

/* THE WARMING STATE HAS TWO CAUSES AND THEY ARE OPPOSITE FACTS. readOiHistory returns "warming"
   both when the record is younger than a day and when it is older but holds no usable row inside
   the band — a worker outage over those hours of yesterday. Simulated on 16 September 2026 against
   http://localhost:4322/open-interest with a stand-in database whose oldest reading was 200 hours
   old and none sat in the band: the opening said the series "does not reach back far enough" and
   the paragraph below it said the site "has 200 hours of it so far, so there is nothing to
   subtract from" — both false, and each contradicting the other. The two are told apart by the
   reader's own arithmetic, not by a second guess: it returns the short-record state only while the
   oldest row is newer than the cutoff, so `covered < hours` is that state and nothing else. */
const oiGap = oiHist.status === "warming" && oiHist.covered >= oiHist.hours;
/* THREE STATES, NOT TWO, AND PRODUCTION FOUND THE THIRD WITHIN THE HOUR. The table is created
   empty, so between the migration and the worker's first hourly write there are ZERO readings —
   and this line said the site "has less than an hour of it", which implies some. None and
   nearly-none are different facts, which is the distinction this whole page is about. */
const oiHeldHours = oiHist.status === "warming" ? Math.floor(oiHist.covered) : 0;
const oiHeldSpan = `${oiHeldHours} hour${oiHeldHours === 1 ? "" : "s"}`;
const oiHeld = oiHist.status !== "warming"
  ? ""
  : oiHist.covered <= 0
    ? "no readings"
    : oiHist.covered < 1
      ? "less than an hour of it"
      : `${oiHeldSpan} of it`;

const stripVol = rows.reduce((t, p) => t + (Number.isFinite(p.dayNtlVlm) ? p.dayNtlVlm : 0), 0);
const stripTurn = total > 0 ? stripVol / total : NaN;

const topOi = rows.slice(0, 10);
const topShare = total > 0 ? topOi.reduce((s, p) => s + p.oiNotional, 0) / total : 0;
const maxOi = topOi.length ? topOi[0].oiNotional : 1;
/* NO WEEK LINE BESIDE EACH BAR, MEASURED (15 October 2026). Ten 7-day lines from the book series,
   with the hub's 7-day change beside each, shipped as f3ef4f9 and put this page 481 bytes over its
   9,000 wire budget on the deploy's own check. Re-encoded at the cheapest that still reads as a
   line — daily points, relative moves, no per-line label — they still cost 215 bytes against a
   page that sits at 8,650–8,900 on data alone. The budget is not raised (verify-live.mjs), so the
   lines would have to displace something on the page, and nothing here is worth less. The weekly
   change per contract is one click away at ?w=7d. */

/* ========================================================================================
   IS THE BOOK GROWING — the half of this page's question that was only ever in a column.

   Read cold, the top of this page said what open interest IS and never whether it was building
   or unwinding, which is the thing a reader came for: a level with no direction cannot be acted
   on. The per-contract change has been in the table since the worker started storing hourly
   readings; this lifts it to the book.

   THE DENOMINATOR IS THE COMPARABLE SET, NOT THE WHOLE BOOK, and saying so is the point. A
   contract listed since the stored reading has no earlier value, so including its current open
   interest in the numerator while it cannot appear in the baseline would print growth that is
   really coverage — the exact numerator/denominator mismatch the flip-scale note on the home
   page records this codebase shipping once already. Both sums run over the same contracts and
   the count of them is printed beside the change. */
/* THE LEFT-OUT CONTRACTS ARE NAMED, AND THE DASH THAT MARKS THEM IS EXPLAINED. Measured on
   16 September 2026 at https://coinliqui.com/open-interest (data 13:12 UTC): the opening said the
   book "shrank 4.21%, measured across the 49 contracts that have a reading that old", the table
   had 50 rows, and the one without a reading — USELESS, $7.67M, the last row — carried a bare
   "—" in the Change column with nothing anywhere on the page saying what a dash meant. The count
   was right; the reader had to find the fiftieth contract by subtraction and guess that the dash
   was it.

   ONE PREDICATE NOW DECIDES ALL THREE. The count used to come from a filter written here and the
   dash from a separate oiChange() call in the table — the same test spelled twice, which agrees
   only until one spelling is edited. `changeOf` is the only place a contract is judged
   measurable: the number in the sentence, the names after it, the dashes in the column and the
   legend above the table are all read off its result, so none of them can describe a different
   set from the others. Up to five are named; beyond that the sentence counts them, because a
   worker outage that leaves thirty contracts without a reading would otherwise turn the opening
   into a roll-call. */
const changeOf = (p: (typeof rows)[number]) => (oiReady ? oiChange(oiReady, p.symbol, p.oiNotional) : null);
const moved = rows.map((p) => ({ p, d: changeOf(p) }))
  .filter((x): x is { p: typeof x.p; d: number } => x.d != null);
const unmeasured = oiReady ? rows.filter((p) => changeOf(p) == null) : [];
const nowSum = moved.reduce((t, x) => t + x.p.oiNotional, 0);
const thenSum = moved.reduce((t, x) => t + (oiReady?.change.get(x.p.symbol) ?? 0), 0);
const bookChange = moved.length > 0 && thenSum > 0 ? nowSum / thenSum - 1 : null;
/* THE RACE IS JUDGED AT THE PRECISION IT IS PRINTED AT. extremeBy's default tolerance is 1e-9 and
   the column prints two decimals of a percent, so two contracts a millionth apart were a unique
   winner to the sentence and a tie to the reader. Simulated on 16 September 2026 against
   http://localhost:4322/open-interest with ETH set to ARB − 1e-6: the opening said "It built
   fastest on ARB, up 63.34%" beside an ETH row that also read +63.34%. The measure is now the
   printed figure itself — the sign the column prints and the digits pct() prints — so two rows
   that read the same are the same to extremeBy, whatever pct() is later changed to print. */
const shownChange = (d: number) => (d < 0 ? -1 : 1) * parseFloat(pct(Math.abs(d)));
const builder = extremeBy(moved, (x) => shownChange(x.d), "max");
const unwinder = extremeBy(moved, (x) => shownChange(x.d), "min");
/* A SUPERLATIVE NEEDS A FIELD. "Built fastest" over a set of one names a winner of no race. */
/* EACH SIDE STANDS ON ITS OWN. The unwind clause used to be gated on the build clause, so a day on
   which every measured contract shrank — simulated on 16 September 2026 against
   http://localhost:4322/open-interest with a stand-in record in which all 50 fell and ZEC fell
   furthest, 50.00%, the book "shrank 7.85%" — named nothing at all, although one contract had
   plainly unwound fastest. Now each is judged on its own field and its own sign, and the template
   joins whichever exist. */
const fastestBuild = builder.kind === "unique" && builder.of > 1 && builder.value > 0 ? builder : null;
const fastestUnwind = unwinder.kind === "unique" && unwinder.of > 1 && unwinder.value < 0 ? unwinder : null;
/* THE VERB IS JUDGED AT THE PRECISION THE FIGURE IS PRINTED AT, like the race above. Simulated on
   16 September 2026 against http://localhost:4322/open-interest with a stand-in record in which
   BTC alone moved +0.001% and the other 49 not at all: the opening said "that book grew 0.00%" — a
   direction the printed figure does not show. The printed figure decides: zero at print precision
   is said as flat, at that same figure, and only a figure that reads non-zero gets a direction. */
const bookShown = bookChange != null ? pct(Math.abs(bookChange)) : "";
const bookVerb = bookChange == null ? "" : parseFloat(bookShown) === 0 ? "was flat at" : bookChange > 0 ? "grew" : "shrank";

const oneTick = oiReady != null && moved.length > 0 && oiAtSince?.status === "ready"
  && moved.every((x) => oiAtSince.change.has(x.p.symbol));
const sinceAt = oiReady ? minute(oiReady.since, false) : null;
/* A snapshot older than its own baseline has no duration to print (the smoke fixture's KV is one),
   so the time stands alone rather than a negative number of hours. */
const oiSpanHours = oneTick && oiReady && snap.fetchedAt > oiReady.since ? (snap.fetchedAt - oiReady.since) / HOUR_MS : null;
const oiWindowLead = !oiReady || !sinceAt
  ? ""
  : oneTick
    ? `${oiSpanHours != null ? `Over the ${oiSpanHours >= 48 ? `${(oiSpanHours / 24).toFixed(1)} days` : `${oiSpanHours.toFixed(1)} hours`} since` : "Since"} the stored reading at ${hm(sinceAt)} UTC on ${dayOf(sinceAt)},`
    : `Against stored readings taken ${utcSpan(bandFrom, oiReady.since, true)},`;
/* The column's scope in the same shapes, short: one reading time; the span the measured contracts
   were drawn from; or, when no contract on the page was measured, the band searched — "since" a
   reading that no row used would be a label over a column of dashes. */
const MON3 = (d: Date) => MONTHS[d.getUTCMonth()].slice(0, 3);
const shortSpan = (a: Date, b: Date) =>
  `${a.getUTCDate()} ${MON3(a)} ${hm(a)}–${dayOf(a) === dayOf(b) ? "" : `${b.getUTCDate()} ${MON3(b)} `}${hm(b)} UTC`;
const oiColScope = !oiReady || !sinceAt
  ? ""
  : oneTick
    ? `since ${sinceAt.getUTCDate()} ${MON3(sinceAt)} ${hm(sinceAt)} UTC`
    : moved.length > 0
      ? `since ${shortSpan(minute(bandFrom, false), minute(oiReady.since, true))}`
      : `vs ${shortSpan(minute(bandFrom, true), minute(bandTo, false))}`;

const NAMED_AT_MOST = 5;
const andList = (xs: string[]) => new Intl.ListFormat("en", { style: "long", type: "conjunction" }).format(xs);
const contractCount = (n: number) => `${n} contract${n === 1 ? "" : "s"}`;
const unmeasuredNames = unmeasured.length > 0 && unmeasured.length <= NAMED_AT_MOST
  ? andList(unmeasured.map((p) => p.symbol))
  : null;
/* ONE MEASURED CONTRACT IS NAMED, NOT COUNTED. Simulated on 16 September 2026 against
   http://localhost:4322/open-interest with a stand-in record holding a reading for BTC only: the opening said
   "measured across the 1 contract that has one", and a page of fifty rows would have said "all 1
   contract" had it held one. A book change drawn from a single contract is that contract's change,
   and the sentence says whose. */
const unmeasuredTail = unmeasured.length === 0
  ? ""
  : unmeasuredNames
    ? `${unmeasuredNames} ${unmeasured.length === 1 ? "has" : "have"} none.`
    : `the other ${unmeasured.length} have none.`;
const measuredAcross = moved.length === 1
  ? unmeasured.length === 0
    ? `measured on ${moved[0].p.symbol}, the only contract here.`
    : `measured on ${moved[0].p.symbol} alone, the only contract that has one; ${unmeasuredTail}`
  : unmeasured.length === 0
    ? `measured across all ${contractCount(moved.length)}.`
    : `measured across the ${contractCount(moved.length)} that have one; ${unmeasuredTail}`;
/* "50 OF THE 50" IS A COUNT READ ALOUD, NOT A SENTENCE. Simulated on 16 September 2026 with readings
   in the band for no contract on the page, the legend ended "— 50 of the 50 here". All of them is
   said as all of them. */
const dashWho = unmeasuredNames ?? (unmeasured.length === rows.length ? `all ${rows.length}` : `${unmeasured.length} of the ${rows.length}`);

/* THE FOUR WAYS THERE IS NO CHANGE TO STATE, EACH WITH ITS OWN REASON. The sentence used to give
   the warming reason ("does not reach back far enough") in every state without a figure — and on
   16 September 2026 http://localhost:4322/open-interest, which has no database binding and so
   reads as no-store, printed it over a record that had not been read at all. Not read, too short,
   long but empty where it matters, and read but matching no contract here are different facts;
   the state readOiHistory returned, and `oiGap` above, decide which one is printed. */
const noChangeReason = oiHist.status === "no-store"
  ? "How much of it is new is not answerable on this render: the hourly record it would be compared against could not be read."
  : oiHist.status === "warming"
    ? oiGap
      ? `How much of it is new is not answerable on this render: the hourly record reaches back ${oiHeldSpan} but holds no usable reading ${oiBandSpan} to compare against.`
      : "How much of it is new is not yet answerable: the hourly series does not reach back far enough to compare."
    : `How much of it is new is not answerable on this render: ${rows.length === 1 ? `${rows[0].symbol} has no` : `none of the ${rows.length} contracts has a`} usable stored reading ${oiBandSpan} to compare against.`;
---
<Base title="Hyperliquid perpetual open interest" description="Hyperliquid open interest and 24-hour volume for BTC, ETH, SOL and every other perpetual covered here, with turnover — volume as a multiple of open interest — which says how fast positioning is churning." fetchedAt={snap.fetchedAt}>
  <div class="page-head">
    <h1>Hyperliquid open interest</h1>
    {/* THE SCOPE WAS THE WHOLE STORY AND THE PAGE NEVER SAID IT. This is one venue's book,
        and it was titled "Open interest" — the market's. Measured on 2026-08-18 against the
        two other venues this site already names on every funding page: Hyperliquid held
        $2.68B of BTC open interest, Binance $6.83B, Bybit $3.91B. The unqualified figure was
        20% of what a reader cross-checking against an aggregator would expect, which reads as
        a broken number rather than a narrower one. Naming the venue costs a word and turns a
        wrong-looking figure into a precise one. */}
    <Overview>
      Hyperliquid holds <b>{usd(total)} across {rows.length} coins</b>, {pct(topShare)} of it in the
      ten largest contracts.
      {bookChange != null && <>{" "}{oiWindowLead} that book <b>{bookVerb} {bookShown}</b>, {measuredAcross}</>}
      {fastestBuild && <>{" "}It built fastest on <b>{fastestBuild.item.p.symbol}</b>, up {pct(fastestBuild.item.d)}</>}
      {fastestUnwind && <>{fastestBuild ? ", and" : " It"} unwound fastest on <b>{fastestUnwind.item.p.symbol}</b>, down {pct(Math.abs(fastestUnwind.item.d))}</>}
      {(fastestBuild || fastestUnwind) && "."}
      {bookChange == null && <>{" "}{noChangeReason}</>}
    </Overview>
    <p>
      {/* THE CONCENTRATION GOES FIRST, and the gate is why. Placed a paragraph lower it fell
          outside the 700 characters leadReachesTheOpening measures, because the scope caveat
          above it is long — correctly long, it is the page's most important sentence. Two
          important sentences compete for one window, so the one an extractor would QUOTE goes
          first and the one it must not omit follows immediately. */}
      Every figure here is <strong>Hyperliquid's book alone</strong>, not the market's.
    </p>
    <More label="Why this page covers one venue only">
    <p>
      It is
      the venue this site collects from directly, and the only one whose open interest it
      collects, so it cannot say how this book compares with the rest of the market; a total that
      adds other venues' books is larger by construction.
      {/* "$6.83B ON BINANCE AND $3.91B ON BYBIT" HAD NO SOURCE THIS SITE COULD NAME. /data-sources says
          no request is ever made to either venue, and /learn/open-interest removed the same figures on
          16 September 2026 for that reason, leaving this file and /about to fix "their own" — which
          nobody did (production, 17 September 2026, still printed here). One page knew; its siblings
          did not. The sentence now says what collection allows, which no typed figure can outdate. */}
      Binance and Bybit publish funding rates that Hyperliquid redistributes, which is why
      {" "}<a class="link" href="/funding">funding</a> compares three venues and this page
      cannot. <a class="link" href="/data-sources">What is collected, and what is not →</a>
    </p>
    </More>
  </div>

  {/* THE WINDOW SWITCH: links, so each window is a URL a reader can send, under the same canonical. */}
  <nav class="oiwin" aria-label="Change window">
    <span class="oiwin__label">Change over</span>
    {OI_WINDOWS.map((w) => (
      <a class:list={["oiwin__opt", w === oiWin && "is-on"]} href={w.key === "24h" ? "/open-interest" : `/open-interest?w=${w.key}`} aria-current={w === oiWin ? "true" : undefined}>{w.label}</a>
    ))}
  </nav>

  {book && (
    <figure class="oibook">
      <figcaption class="oibook__cap">
        <b>The book over 30 days</b> — {book.count} of today's {rows.length} contracts, those with a reading in at least
        nine {BOOK_STEP_H}-hour steps in ten ({pct(book.share)} of today's open interest).{book.gaps > 0 && <> The line breaks where the store holds no reading for one of them ({plural(book.gaps, "step", "steps")}).</>} Shaded: the {oiWin.label} the change below is taken over.
      </figcaption>
      <div class="oibook__plot">
        <svg viewBox="0 0 1000 200" preserveAspectRatio="none" role="img" aria-label={`Open interest of ${book.count} contracts from ${shortDate(book.from)} to ${shortDate(book.to)}, between ${compact(book.lo)} and ${compact(book.hi)}`}>
          <rect x={book.winX} y="0" width={1000 - book.winX} height="200" fill="currentColor" opacity="0.07" />
          <path d={book.line} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
        </svg>
        <span class="oibook__y" style={`top:${book.hiPct.toFixed(1)}%`}>{compact(book.hi)}</span>
        <span class="oibook__y" style={`top:${book.loPct.toFixed(1)}%`}>{compact(book.lo)}</span>
      </div>
      <div class="oibook__x"><span>{shortDate(book.from)}</span><span>{shortDate(book.to)}</span></div>
    </figure>
  )}

  <p class="section-note" style="margin:0 0 20px;max-width:74ch">Across the book, 24-hour volume of {usd(stripVol)} is {Number.isFinite(stripTurn) ? `${stripTurn.toFixed(2)}\u00d7` : "\u2014"} the open interest.</p>
  <More label="What the turnover column means">
    <p class="section-note" style="margin:0;max-width:74ch">The turnover column is that ratio per contract: a high number means the position base is churning rather than accumulating. <a class="link" href="/learn/open-interest">What open interest does and does not tell you →</a></p>
  </More>
  {oiHist.status === "warming" && (
    <p class="clock" style="margin:0 0 12px">
      {oiGap
        ? <>The change column is absent because no usable stored reading falls {oiBandSpan}, the window a change is taken from. This site keeps open interest hourly and its record reaches back <b>{oiHeldSpan}</b>, but has nothing in that window to subtract from</>
        : <>The change column appears once there is a stored reading {oiHist.hours} hours old to compare against. This site keeps open interest hourly and has <b>{oiHeld}</b> so far, so there is nothing to subtract from</>}
      {" "}&mdash; which is a different statement from a change of zero, and the reason the column is
      absent rather than empty.
    </p>
  )}

  {topOi.length > 1 && (
    <Figure
      title={`Hyperliquid open interest, ${rows.length} coins`}
      lead={pct(topShare)}
      leadNote={`of the ${usd(total)} book sits in the ten largest contracts`}
      fetchedAt={snap.fetchedAt}>
      <div class="bars">
        {topOi.map((p) => (
          <>
            <span class="bars__label"><a href={`/funding/${p.symbol.toLowerCase()}`}>{p.symbol}</a></span>
            <span class="bars__track"><span class="bars__fill" style={`width:${Math.max(2, (p.oiNotional / maxOi) * 100)}%`}></span></span>
            <span class="bars__value">{usd(p.oiNotional)} <span class="faint">{pct(p.oiNotional / total)}</span></span>
          </>
        ))}
      </div>
      <More slot="note" label="How the bars are scaled">
        <p>
          Open interest is one venue&rsquo;s book, not the market&rsquo;s: these are Hyperliquid&rsquo;s
          positions only. Bars are scaled to the largest, {usd(maxOi)}, and the percentage beside each
          is its share of the whole book.
        </p>
      </More>
    </Figure>
  )}

  {oiReady && unmeasured.length > 0 && (
    <p class="section-note" style="margin:0 0 12px">
      A dash in the Change column is a contract with no usable stored reading {oiBandSpan}, the window each change is taken from &mdash; {dashWho} here. That is an absence, not a change of zero{bookChange != null ? `, so ${unmeasured.length === 1 ? "it is" : "they are"} left out of the book's change above` : ""}.
    </p>
  )}
  <div class="panel"><table class="tbl oitbl" data-sortable>
    <thead><tr><th>Coin</th><th class="num">Open interest <span class="thscope">Hyperliquid</span></th>{oiReady && <th class="num">Change <span class="thscope">{oiColScope}</span></th>}<th class="num">24h volume <span class="thscope">Hyperliquid</span></th><th class="num">Turnover (24h volume ÷ OI)</th><th class="num">Max leverage</th></tr></thead>
    <tbody>
      {rows.map((p) => (
        <tr>
          <td><a href={`/funding/${p.symbol.toLowerCase()}`}>{p.symbol}</a></td>
          <td>{usd(p.oiNotional)}</td>
          {oiReady && (() => {
            const d = changeOf(p);
            /* AN ABSENCE, NOT A ZERO. A contract listed since the stored reading has no history,
               and printing 0.00% for it would claim it had not moved. The legend above the table
               says so in words; the title repeats it where a sorted table has put the dash. */
            return d === null
              ? <td><span class="faint" title={`No usable stored reading ${oiBandSpan}`}>—</span></td>
              /* NEUTRAL, AND THE GATE WAS RIGHT TO REFUSE THE FIRST VERSION. It used the funding
                 pair, and colourLegend pointed out that this page never says what amber and cyan
                 encode — because they encode who PAYS whom, and a book growing is not a payment.
                 This site keeps exactly two colour languages and both are spoken for: amber and
                 cyan are the funding direction, green and red are the candles'. A third quantity
                 does not get to borrow one; the sign carries the sign. */
              : <td>{signedPct(d)}</td>;
          })()}
          <td>{usd(p.dayNtlVlm)}</td>
          <td>{p.oiNotional > 0 ? (p.dayNtlVlm / p.oiNotional).toFixed(2) + "×" : "—"}</td>
          <td>{capOf(p)}×</td>
        </tr>
      ))}
    </tbody>
  </table></div>
  {/* GLOBAL, NOT SCOPED: scoping stamped a data-astro-cid on 549 elements, 13 KB raw, which is where
      the book line's bytes were found instead of in a raised budget. Every class here is prefixed
      oiwin/oibook and used nowhere else. */}
  <style is:global>
    /* Every column after the coin is a figure: one rule here instead of class="num" on 280 cells. */
    .oitbl td + td { font-family: var(--mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
    .oiwin { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 0 0 16px; }
  .oiwin__label { font-size: var(--fs-sm); color: var(--text-dim); margin-right: 4px; }
  .oiwin__opt { padding: 6px 12px; border-radius: 999px; font-size: var(--fs-sm); color: var(--text-dim); text-decoration: none; border: 1px solid var(--border-soft); }
  .oiwin__opt.is-on { color: var(--text); background: var(--surface-3); border-color: var(--border); }
  .oibook { margin: 0 0 20px; }
  .oibook__cap { font-size: var(--fs-sm); color: var(--text-dim); margin: 0 0 8px; max-width: 74ch; line-height: 1.5; }
  .oibook__plot { position: relative; height: 180px; color: var(--text-dim); background: var(--surface-1); border-radius: 12px; overflow: hidden; }
  .oibook__plot svg { display: block; width: 100%; height: 100%; }
  .oibook__y { position: absolute; left: 10px; transform: translateY(-50%); font: 11.5px var(--mono); color: var(--text-dim); background: var(--surface-1); padding: 0 4px; }
  .oibook__x { display: flex; justify-content: space-between; font: 11.5px var(--mono); color: var(--text-faint); margin-top: 4px; }
</style>
</Base>
