---
import Base from "../layouts/Base.astro";
import { IDENTITY } from "../lib/site.ts";
import { getSnapshot } from "../lib/hyperliquid.ts";
import { reachRows } from "../lib/corroboration.ts";
import { EXPECTED_WORKER_BUILD } from "../lib/version.ts";
import { VENUE_LABEL, type Venue } from "../lib/funding.ts";
/* The Worker owns the endpoint list, the key name and the label rule. This page reads them
   rather than restating them — src/pages/[key].txt.ts already imports from the same module. */
import { ENDPOINTS, STATE_KEY, endpointLabel } from "../../worker/indexnow.ts";

// Deliberately NOT guarded with coldStart(): this is the page you open to find out why
// everything else is returning 503, so it has to render when the snapshot store is empty.
// robots.txt disallows it — it is operational, not editorial, and changes every 5 minutes.
const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
const reach = reachRows(await env?.SNAPSHOT?.get("identity:reach", "json").catch(() => null), Date.now());

/* =========================================================================================
   THE ANNOUNCEMENT CHANNEL.

   IndexNow is this site's only account-free route into the indexes that are not Google —
   Bing, and therefore DuckDuckGo, Yahoo and Ecosia, plus Yandex, Seznam and Naver. It runs
   from the ingest Worker and it fails silently by design: nothing a reader sees depends on
   it, so a refusal is logged and the run continues.

   MEASURED 27 AUGUST 2026, and this section exists because of how it was measured. The two
   Microsoft-run endpoints had refused the Worker TWENTY-ONE consecutive times and were sitting
   in a capped twelve-hour backoff owing 58 URLs each — the 49 liquidation maps that shipped
   that morning and the five /learn explainers from the cycle before. Every surface on this
   site was green. The only way to find out was to read the KV value by hand.

   The refusal itself is understood and is not a defect here: the same payload, same key, same
   minute, returns 200 from a laptop and 429 from the Worker, because both endpoints throttle
   Cloudflare's shared Workers egress. See the backoff field in worker/indexnow.ts. What was
   missing was any way to know it was happening, or to notice the day it stops being that.
   ========================================================================================= */
const announce = await (async () => {
  try {
    const st = (await env?.SNAPSHOT?.get(STATE_KEY, "json")) as
      { known?: string[]; pending?: Record<string, string[]>; backoff?: Record<string, { fails: number; nextAt: number }>; sentAt?: number } | null;
    if (!st || !Array.isArray(st.known)) return null;
    return {
      known: st.known.length,
      sentAt: st.sentAt ?? null,
      rows: ENDPOINTS.map((e) => {
        const name = endpointLabel(e);
        return { name, owed: st.pending?.[name]?.length ?? 0, fails: st.backoff?.[name]?.fails ?? 0, nextAt: st.backoff?.[name]?.nextAt ?? null };
      }),
    };
  } catch { return null; }
})();
/* A backlog is normal for one pass. A backlog with consecutive failures behind it is an
   endpoint that has stopped accepting, and that is the thing worth a colour. */
const announceBad = (announce?.rows ?? []).filter((r) => r.fails > 0);

interface Check { at: number; source: string; status: number; ms: number; ok: number; note: string | null }
let checks: Check[] = [];
let storeError: string | null = null;
try {
  const db = env?.DB;
  if (db) {
    /* SCOPED TO THE FIVE-MINUTE INGEST. The minute tick now records its own failures under
       source='minute', and mixing the two cadences in one "last 24 runs" figure would make
       both unreadable — twelve five-minute runs and twelve minute failures is not a rate of
       anything. They are counted separately below. */
    const { results } = await db.prepare("SELECT at, source, status, ms, ok, note FROM upstream_check WHERE source <> 'minute' ORDER BY at DESC LIMIT 24").all();
    checks = (results ?? []) as Check[];
  } else {
    storeError = "No D1 binding in this environment.";
  }
} catch (e) {
  storeError = e instanceof Error ? e.message : String(e);
}

const now = Date.now();
const ageMin = snap.fetchedAt ? Math.round((now - snap.fetchedAt) / 60000) : null;
// Cron runs every 5 minutes. Three consecutive misses is the point at which this is a
// fault rather than a slow tick.
const STALE_MIN = 15;
const stale = ageMin === null || ageMin > STALE_MIN;

/* THE ONE-MINUTE PATH. Sixty minutes is the window the "updates every minute" claim is about.
 *
 * This card read `count(*)` and called the answer "failed", under a comment that said the
 * writer "only writes a row when it FAILS". That was true when the card was written (ba7ca32)
 * and stopped being true in a LATER commit (62e4922) that made minute() record every tick with
 * ok=1 or ok=0 — a change made precisely so a tick that never runs becomes visible, since a
 * tick that never runs cannot report that it failed.
 *
 * The reader was not updated with the writer, so the healthiest possible hour rendered as the
 * worst possible reading. Measured against production D1 the moment this was found: 60 rows
 * recorded, 7 with ok=0, and this page printing "60 failed" in the alert colour. The health
 * page was the least healthy thing on the site.
 *
 * Both numbers are read now, and the count is used for what it is worth — COVERAGE. Sixty
 * ticks with none failing is clean; forty ticks with none failing is twenty ticks that never
 * ran, which the old schema could not express and the old card would have called clean. */
const MINUTE_EXPECTED = 60;
let minuteRuns: number | null = null;
let minuteFails = 0;
let minuteSpotFails = 0;
let minuteLiveFails = 0;
try {
  const db = (Astro.locals as any)?.runtime?.env?.DB;
  if (db) {
    /* ONE LEG NOW, WHERE THERE WERE TWO. The minute tick used to fetch Coinbase spot as well as
       Hyperliquid mark/funding and write ok=0 if either failed — which mattered, because over
       303 measured ticks all 49 failures were `coinbase 429` and the Hyperliquid leg failed
       zero times, so an undifferentiated "9 failed" invited readers to distrust the headline
       numbers over a rate limit on a different upstream. The Coinbase leg was removed on
       19 August 2026 (see src/lib/coins.ts), so the split no longer has two sides.
       spotError is still SELECTed because rows written before that date still carry it and the
       last-hour window will keep reaching them for an hour after each deploy; it is reported
       only when non-zero, and will simply stop appearing. */
    const r = await db.prepare(
      `SELECT count(*) n,
              sum(CASE WHEN ok = 0 THEN 1 ELSE 0 END) bad,
              sum(CASE WHEN json_extract(note,'$.spotError') IS NOT NULL THEN 1 ELSE 0 END) spot,
              sum(CASE WHEN json_extract(note,'$.liveError') IS NOT NULL THEN 1 ELSE 0 END) live
         FROM upstream_check WHERE source = 'minute' AND at > ?1`,
    ).bind(Date.now() - 3_600_000).first();
    minuteRuns = Number(r?.n ?? 0);
    minuteFails = Number(r?.bad ?? 0);
    minuteSpotFails = Number(r?.spot ?? 0);
    minuteLiveFails = Number(r?.live ?? 0);
  }
} catch { /* the page must render with no store — that is when it is read */ }
const minuteWhere = minuteFails === 0 ? ""
  : minuteSpotFails === 0 ? " · Hyperliquid mark and funding"
  : ` · ${minuteLiveFails} Hyperliquid, ${minuteSpotFails} from the withdrawn spot leg`;
/* Under 90% of the expected ticks is the same fault as a failing one and is reported as one. */
const minuteMissing = minuteRuns !== null && minuteRuns < MINUTE_EXPECTED * 0.9;
const minuteBad = minuteRuns === null || minuteRuns === 0 || minuteFails > 0 || minuteMissing;

const latest = checks[0];
/* The refusal reason travels in the run's note, which is JSON. Parsed defensively: this page
   must render even when the store is empty, which is exactly when someone opens it. */
const latestNote = (() => {
  try { return latest?.note ? String(JSON.parse(latest.note).error ?? "") : ""; } catch { return ""; }
})();
const latestRefused = latestNote.startsWith("refused:");
const latestVenues: Record<string, number> = (() => {
  try { return latest?.note ? (JSON.parse(latest.note).venues ?? {}) : {}; } catch { return {}; }
})();
const fails = checks.filter((c) => !c.ok).length;

/* Is the deployed worker the one this build expects? A hand-pasted bundle can be older than
   the site with nothing anywhere to say so. */
let workerBuild: string | null = null;
try {
  const v = (await env?.SNAPSHOT?.get("worker:build", "json")) as { build?: string } | null;
  workerBuild = v?.build ?? null;
} catch { /* leave null */ }
const workerDrift = workerBuild !== null && workerBuild !== EXPECTED_WORKER_BUILD;

/* THE WORDS THIS PAGE PRINTS WHEN THE STORE IS MISSING, NAMED ONCE. The D1 row below tells a
   reader what a missing binding looks like, and it can only stay true if it quotes the same
   strings the cards and the run-log panel actually render.

   AN UNREADABLE LOG WAS PRINTED AS AN EMPTY ONE. Measured 16 September 2026 on
   http://localhost:4322/status, where D1 answers "no such table: upstream_check": Recent runs
   said "Run log unreadable", and three screens up the Last ingest card said "no runs recorded",
   Failures in last 24 runs said "0 runs recorded", and Per-venue coverage printed 0 for all three
   venues under "A count at zero here is that failure" — a store that could not be read, shown as
   a worker that wrote nothing. Every figure drawn from the run log now reads storeError before it
   reads a count, and says UNREADABLE when there is no count to give. The card labels live here
   too, so the D1 row names the cards it describes by the words they are headed with. */
const UNREADABLE = "unreadable";
const RUN_LOG_UNREADABLE = "Run log unreadable";
const CARD = { last: "Last ingest", minute: "Minute tick, last hour", fails: "Failures in last 24 runs" };
const VENUE_HEAD = "Per-venue coverage, last run";
const RUNS_HEAD = "Recent runs";
const NO_COUNT = "—";
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

/* THE INTRO AND ROW 1 CONTRADICTED EACH OTHER, AND ROW 2 POINTED AT THE WRONG TABLE.
   Measured 16 September 2026 on https://coinliqui.com/status: the intro said these were "the
   three things that can be wrong while every page still renders correctly … fails quietly
   rather than loudly", and the SNAPSHOT row directly under it said pages "would serve 503"
   — deliberately loud. The DB row said "no funding history accrues and this table stays
   empty": this table has fixed rows and cannot empty, and funding_snapshot is written by the
   ingest worker through its OWN binding (worker/ingest.ts), so a missing binding on the site
   stops nothing accruing. What it does do is make the run log and the minute-tick count
   unreadable here, and /open-interest unable to compare against its hourly record
   (readOiHistory → "no-store").
   So each row carries whether it fails loudly, and the intro counts from the rows instead of
   asserting one property of all of them. A row added or re-described cannot leave the intro
   behind. */
const bindings = [
  {
    name: "SNAPSHOT", kind: "KV", present: Boolean(env?.SNAPSHOT), loud: true,
    means: "Pages would serve 503 rather than fall back to the upstream API — deliberately, so a missing binding cannot hide behind a working-looking site.",
  },
  {
    name: "DB", kind: "D1", present: Boolean(env?.DB), loud: false,
    means: `Pages still render, and the ingest worker still writes through its own binding, but nothing on the site can read what it wrote: the “${CARD.last}”, “${CARD.minute}” and “${CARD.fails}” cards above say “${UNREADABLE}”, “${VENUE_HEAD}” prints “${NO_COUNT}” for every venue, “${RUNS_HEAD}” below says “${RUN_LOG_UNREADABLE}”, and /open-interest cannot say how much of its open interest is new.`,
  },
];
/* The worker-version row is rendered separately below, hence the +1, and it is a quiet one:
   a bundle behind the repository leaves every page rendering whatever it last wrote. */
const checkRows = bindings.length + 1;
const loudChecks = bindings.filter((b) => b.loud);
const quietChecks = checkRows - loudChecks.length;
const WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const word = (n: number) => WORDS[n] ?? String(n);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/* "SO THEY ARE CHECKED HERE" READ AS IF ONLY THE QUIET ONES WERE. The first version of this
   intro (16 September 2026) said the other two fail quietly "so they are checked here", directly
   above a table that checks all three, SNAPSHOT included. Every row is checked; the sentence now
   says so first, and the loud/quiet split is a description of the rows, not the reason for them. */
const allChecked = checkRows === 1 ? "checked here" : checkRows === 2 ? "both checked here" : "all checked here";
const bindingsIntro = [
  `${cap(word(checkRows))} deploy step${checkRows === 1 ? "" : "s"} the build cannot see, ${allChecked}.`,
  loudChecks.length > 0
    ? `A missing ${loudChecks.map((b) => `${b.kind} binding ${b.name}`).join(" or ")} fails loudly, on purpose: pages answer 503.`
    : "",
  quietChecks > 0
    ? `${loudChecks.length > 0 ? `The other ${word(quietChecks)}` : cap(word(quietChecks))} ${quietChecks === 1 ? "fails" : "fail"} quietly: every page still renders.`
    : "",
].filter(Boolean).join(" ");

/* Per-venue counts exist only for a run that was read. */
const venueNote = latest ? ""
  : storeError ? "The run log could not be read, so there is no last run to count."
  : "No run is recorded yet, so there is nothing to count.";

/* SERIES COVERAGE — the layer this page used to say nothing about.
 *
 * Everything above answers "is ingest running". None of it answers "does every published
 * contract actually have the data its page draws", and those came apart in exactly the way
 * that is hardest to notice: /funding/uni was live and indexed with no daily candles at all,
 * while this page reported green on every check it had.
 *
 * Each sweep records the symbols it has written in its own meta record, so the comparison is
 * three KV reads rather than one per contract.
 */
/* THE TABLE IS HEADED "Series coverage" AND LISTED THREE OF THE FOUR SERIES. m15 drives every
   15m and 30m chart on sixty pages and was not on it, so a stalled 15-minute sweep was invisible
   on the one page whose whole job is making staleness visible — found on 24 August when 45 chart
   renders breached the freshness ceiling while this table showed three green rows. */
const SERIES = [
  { key: "m15", label: "15-minute candles", gate: "2 h", drives: "the 15m and 30m charts" },
  { key: "hourly", label: "Hourly candles", gate: "2 h", drives: "the liquidation map and the 1H/4H charts" },
  { key: "candles", label: "Daily candles", gate: "12 h", drives: "the 1D/1W charts and leverage survival" },
  { key: "funding", label: "Funding history", gate: "6 h", drives: "the funding band under every price chart" },
];
const covered = snap.perps.map((p) => p.symbol);
const series = await Promise.all(
  SERIES.map(async (s) => {
    let have: string[] = [];
    let at = 0;
    /* "Missing" means no data at all. A symbol the last cycle walked past keeps its old data and
       is not missing — it is stale, which the row could not say until the sweep recorded it. */
    let skipped: string[] = [];
    try {
      const m = (await env?.SNAPSHOT?.get(`${s.key}:meta`, "json")) as { h?: string[]; u?: number; skip?: string[] } | null;
      have = m?.h ?? [];
      at = m?.u ?? 0;
      skipped = m?.skip ?? [];
    } catch { /* leave empty — reported as unknown, not as healthy */ }
    const set = new Set(have);
    const missing = covered.filter((c) => !set.has(c));
    /* Only the ones still published: a symbol skipped just before it left coverage is not a gap
       in anything a reader can reach. */
    const stale = skipped.filter((c) => covered.includes(c) && set.has(c));
    return { ...s, at, missing, stale, known: have.length > 0 };
  }),
);
const seriesGap = series.some((s) => s.known && (s.missing.length > 0 || s.stale.length > 0));
const utc = (ms: number) => new Date(ms).toISOString().slice(0, 16).replace("T", " ") + " UTC";
---

{/* noindex, NOT a robots.txt Disallow. This page is linked from /about and /data-sources, and
    a Disallow'd URL can still be indexed from inbound links with no snippet — the crawler is
    never allowed to fetch it and see a directive. noindex only works on a crawlable page. */}
<Base title="Status" description="Ingest health: snapshot age, upstream status codes and per-venue coverage." noindex>
  <div class="page-head">
    <h1>Status</h1>
    <p>
      Ingest health. This page reads the ingest run log in D1 directly and renders even when the snapshot
      store is empty. The weekly <a class="link" href="/status/indexation">indexation report</a> is
      built by the same worker.
    </p>
  </div>

  <div class="cards">
    <div class="card">
      <div class="card__label">Snapshot age</div>
      <div class:list={["card__value", stale && "is-bad"]}>{ageMin === null ? "—" : ageMin === 0 ? "under 1 min" : `${ageMin} min`}</div>
      <div class="card__meta">{snap.fetchedAt ? utc(snap.fetchedAt) : "never written"}</div>
    </div>
    <div class="card">
      <div class="card__label">Snapshot store</div>
      <div class="card__value" style="font-size:20px">{snap.available ? "readable" : "empty"}</div>
      <div class="card__meta">{snap.perps.length} contracts cached</div>
    </div>
    <div class="card">
      <div class="card__label">{CARD.last}</div>
      {/* A REFUSAL IS NOT "no response". The ingest now declines to overwrite a healthy
          snapshot with a degenerate one — an upstream that answers 200 with an empty universe,
          or with forty-nine of fifty contracts missing. That run is recorded as failed with
          status 200, because the upstream DID answer; saying "no response" would describe the
          wrong problem to whoever is reading this page at the time. */}
      <div class:list={["card__value", ((latest && !latest.ok) || storeError) && "is-bad"]} style="font-size:20px">{latest ? (latest.ok ? "ok" : latestRefused ? "refused" : `failed (${latest.status || "no response"})`) : storeError ? UNREADABLE : "—"}</div>
      <div class="card__meta">{latest ? (latestRefused ? latestNote : `${latest.ms} ms · ${utc(latest.at)}`) : storeError ? "the run log could not be read" : "no runs recorded"}</div>
    </div>
    <div class="card">
      <div class="card__label">{CARD.minute}</div>
      <div class:list={["card__value", minuteBad && "is-bad"]}>{
        minuteRuns === null ? UNREADABLE
        : minuteRuns === 0 ? "no ticks recorded"
        : minuteFails > 0 ? `${minuteFails} failed of ${minuteRuns}`
        : minuteMissing ? `only ${minuteRuns} of ${MINUTE_EXPECTED} ran`
        : `clean · ${minuteRuns} of ${MINUTE_EXPECTED}`
      }</div>
      <div class="card__meta">Hyperliquid mark and funding · every tick records, so one that never ran shows here{minuteWhere}</div>
    </div>
    <div class="card">
      <div class="card__label">{CARD.fails}</div>
      <div class:list={["card__value", (fails > 0 || storeError) && "is-bad"]}>{checks.length ? fails : storeError ? UNREADABLE : "—"}</div>
      <div class="card__meta">{storeError ? "the run log could not be read" : `${plural(checks.length, "run", "runs")} recorded`}</div>
    </div>
  </div>

  <h2 class="section">Bindings and worker version</h2>
  <p class="section-note">
    {bindingsIntro}
  </p>
  <div class="panel" style="max-width:760px">
    <table class="tbl">
      <thead><tr><th>Check</th><th>State</th><th>What a wrong value means</th></tr></thead>
      <tbody>
        {bindings.map((b) => (
          <tr class={b.present ? undefined : "is-active"}>
            <td>{b.kind} binding <code>{b.name}</code></td>
            <td class:list={[b.present ? "is-ok" : "is-bad"]} style="font-weight:600">{b.present ? "attached" : "MISSING"}</td>
            <td class="reason">{b.means}</td>
          </tr>
        ))}
        <tr class={workerDrift ? "is-active" : undefined}>
          <td>Ingest worker version</td>
          <td class:list={[workerBuild === null ? "dim" : workerDrift ? "is-bad" : "is-ok"]} style="font-weight:600">
            {workerBuild === null ? "not reported yet" : workerDrift ? "STALE" : "current"}
          </td>
          <td class="reason">
            Deployed <code>{workerBuild ?? "—"}</code>, site expects <code>{EXPECTED_WORKER_BUILD}</code>.
            The bundle is pasted into the dashboard by hand, so it can sit behind this repository
            with nothing to say so — whatever the newer worker was meant to write is simply absent.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {stale && (
    <div class="verdict verdict--warn">
      <div>
        <b>The snapshot is stale.</b> It was last written
        {ageMin === null ? " never" : ` ${ageMin} minutes ago`}, against a 5-minute cron. Pages are
        still serving — they read the last good value and never call upstream — but every figure on
        the site is now as old as the timestamp says. Check the cron trigger and the runs below.
      </div>
    </div>
  )}

  {/* THE ONE CLAIM ON THIS SITE THAT POINTS SOMEWHERE WE DO NOT CONTROL, and the only one whose
      failure is invisible from here. It published a 404 on every page for days. The worker checks
      it daily; this row is where a probe that has stopped, or is being refused, becomes visible —
      without it, "no link" and "the check is broken" look identical to a reader and to us. */}
  <h2 class="section">External corroboration</h2>
  <p class="section-note">
    What a signed-out reader gets when they follow the one external link this site would publish
    about itself. It is published only while this says <b>published</b>: a link that does not
    resolve is worse corroboration than none, and nothing here has to be edited either way.
  </p>
  <div class="panel" style="max-width:860px">
    <table class="tbl">
      <thead><tr><th>URL</th><th>State</th><th>Last anonymous GET</th></tr></thead>
      <tbody>
        {reach.map((r) => (
          <tr class={r.state === "published" ? undefined : "is-active"}>
            <td><code>{r.url}</code></td>
            <td class:list={[r.state === "published" ? "is-ok" : "is-bad"]} style="font-weight:600">{r.state}</td>
            <td class="reason">{r.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section">Series coverage</h2>
  <p class="section-note">
    A published contract with no series behind it renders a page-shaped hole: the chart panel is
    simply absent, every other figure is fine, and nothing above this line would notice. The
    counts are against the {covered.length} contracts currently published.
  </p>
  <div class="panel" style="max-width:860px">
    <table class="tbl">
      <thead><tr><th>Series</th><th class="num">Covered</th><th>Refresh interval</th><th>Missing or stale</th></tr></thead>
      <tbody>
        {series.map((s) => (
          <tr class={s.known && (s.missing.length || s.stale.length) ? "is-active" : undefined}>
            <td>{s.label}<div class="reason" style="margin-top:2px">drives {s.drives}</div></td>
            <td class:list={["num", s.known ? (s.missing.length || s.stale.length ? "is-bad" : "is-ok") : "dim"]} style="font-weight:600">
              {s.known ? `${covered.length - s.missing.length} / ${covered.length}` : "—"}
            </td>
            <td>{s.gate}{s.at ? <div class="reason" style="margin-top:2px">last full refresh {utc(s.at)}</div> : null}</td>
            <td class="reason">
              {!s.known ? "unknown — no refresh has recorded coverage yet" : (
                <>
                  {s.missing.length ? <>missing: {s.missing.join(", ")}</> : null}
                  {s.missing.length && s.stale.length ? <br /> : null}
                  {/* THE ROW SAID "none" WHILE TWO STORES WERE THREE HOURS OLD. `u` above stamps
                      when the cursor reached the end of the list, not when every symbol was
                      written, so a symbol whose fetch threw keeps its old data and is not
                      missing. The sweep records what it walked past; this is where it lands. */}
                  {s.stale.length ? <>the last full cycle walked past <b>{s.stale.join(", ")}</b> without writing — their data is older than the interval, not absent</> : null}
                  {!s.missing.length && !s.stale.length ? "none" : null}
                </>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {seriesGap && (
    <div class="verdict verdict--warn">
      <div>
        <b>A published contract is missing a series.</b> This is normal for a few minutes after a
        contract crosses the coverage floor — a missing series is filled on the next five-minute
        tick rather than waiting for the refresh interval. If a name is still listed here after fifteen
        minutes, the fetch for it is failing rather than pending.
      </div>
    </div>
  )}

  <h2 class="section">{VENUE_HEAD}</h2>
  <p class="section-note">
    A venue silently dropping out of the upstream response looks like success: the run still writes
    rows, just fewer. A count at zero here is that failure.{venueNote ? ` ${venueNote}` : ""}
  </p>
  <div class="panel" style="max-width:520px">
    <table class="tbl">
      <thead><tr><th>Venue</th><th class="num">Rows last run</th></tr></thead>
      <tbody>
        {/* THE SPACE WAS IN THE SOURCE AND NOT IN THE PAGE. `{VENUE_LABEL[v]} <code>` renders as
            `Hyperliquid<code>HlPerp</code>`: Astro drops whitespace-only text between an expression
            and an element. Measured 16 September 2026 on https://coinliqui.com/status — all three
            cells read "HyperliquidHlPerp", "BinanceBinPerp", "BybitBybitPerp" as text, with 0px
            between name and pill. The space now lives inside the expression's own string, where
            no whitespace rule can reach it. The refusal warning below had the same gap. */}
        {(["HlPerp", "BinPerp", "BybitPerp"] as Venue[]).map((v) => (
          <tr>
            <td>{`${VENUE_LABEL[v]} `}<code>{v}</code></td>
            <td class:list={["num", latest ? !latestVenues[v] && "is-bad" : "dim"]}>{latest ? latestVenues[v] ?? 0 : NO_COUNT}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section">{RUNS_HEAD}</h2>
  {storeError ? (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">{RUN_LOG_UNREADABLE}</p>
        <p class="empty__text">{storeError}</p>
      </div>
    </div>
  ) : checks.length === 0 ? (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">No runs recorded yet</p>
        <p class="empty__text">The ingest worker has not completed a run against this database. Trigger one manually at the worker's <code>/ingest</code> route.</p>
      </div>
    </div>
  ) : (
    <div class="panel">
      <table class="tbl">
        <thead><tr><th>When</th><th>Source</th><th class="num">Status</th><th class="num">ms</th><th class="num">Result</th></tr></thead>
        <tbody>
          {checks.map((c) => (
            <tr>
              <td class="num" style="text-align:left">{utc(c.at)}</td>
              <td>{c.source}</td>
              <td class="num">{c.status || "—"}</td>
              <td class="num">{c.ms}</td>
              <td class:list={["num", !c.ok && "is-bad"]}>{c.ok ? "ok" : "failed"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {/* IS THE ONLY CONTACT ROUTE STILL MACHINE-READABLE?

      Cloudflare's Email Address Obfuscation rewrites every mailto: it finds in HTML on the way
      out of the edge, after this code has run and with no way for it to intervene. It did
      exactly that once: the href became a /cdn-cgi/l/email-protection# URL that 404s and the
      text became the literal string "[email protected]". Humans with JavaScript never notice.
      Crawlers and answer engines see nonsense — and they are the audience the address exists
      for, on the pages written to establish that this site is reachable.

      <!--email_off--> is the documented opt-out and every other mailto on the site is wrapped
      in it. That workaround is what is holding, and it is one deletion away from not holding,
      because this project's Cloudflare grant cannot read zone settings to find out whether the
      feature is even on. Verified by API on 18 August 2026: the token is Workers-scoped and
      returns 9109 Unauthorized for zone settings, so the state of that switch is unknowable
      from here.

      So the state is measured instead of assumed. The address below is deliberately NOT wrapped.
      If the edge is rewriting, this one link is mangled and everything else on the site still
      works — and scripts/verify-live.mjs reads this page and says so. */}
  <h2 class="section">Announcement channel</h2>
  <p class="section-note" style="max-width:88ch">
    IndexNow is the only route from this site into the indexes that are not Google, and it needs
    no account. A URL is announced once, when it first appears — never on a price change. The
    Worker submits to all five endpoints rather than trusting the aggregator's fan-out, so a
    backlog against one of them is that endpoint's refusal rather than a site fault. Consecutive
    failures against the two Microsoft-run endpoints mean the shared Cloudflare egress is being
    throttled; the fix is <code>npm run indexnow:drain</code>, which sends the same backlog from
    somewhere else.
  </p>
  {announce ? (
    <>
      <div class="panel" style="max-width:760px">
        <table class="tbl">
          <thead><tr><th>Endpoint</th><th class="num">URLs owed</th><th class="num">Consecutive refusals</th><th>Next attempt</th></tr></thead>
          <tbody>
            {announce.rows.map((r) => (
              <tr class={r.fails > 0 ? "is-active" : undefined}>
                <td>{r.name}</td>
                <td class:list={["num", r.owed ? "is-bad" : "is-ok"]} style="font-weight:600">{r.owed || "0"}</td>
                <td class:list={["num", r.fails ? "is-bad" : "dim"]}>{r.fails || "—"}</td>
                <td class="reason">{r.nextAt && r.nextAt > now ? <>held until {utc(r.nextAt)}</> : "next pass"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="datanote-status">
        {announce.known === 1 ? "1 URL" : `${announce.known} URLs`} recorded as published.
        {" "}{announce.sentAt
          ? <>Last accepted by any endpoint <b>{utc(announce.sentAt)}</b>.</>
          : <><b>Nothing has ever been accepted by any endpoint</b> — the recorded set is a baseline, not a receipt.</>}
      </p>
      {announceBad.length > 0 && (
        <div class="verdict verdict--warn">
          <div>
            <b>{announceBad.length === 1 ? "1 endpoint is" : `${announceBad.length} endpoints are`} refusing.</b>{" "}{announceBad.map((r) => `${r.name} (${r.fails}x, ${r.owed} owed)`).join(", ")}.
            The retry rate decays from five minutes to a twelve-hour cap, so a URL owed here is
            not lost — it is waiting. What it is not is announced.
          </div>
        </div>
      )}
    </>
  ) : (
    <p class="datanote-status">No announcer state readable — either the Worker has never run against this store, or the KV binding is missing.</p>
  )}

  <h2 class="section">Contact route</h2>
  <p class="prose">
    The published address is
    {" "}<!--email_off--><a class="link" href={`mailto:${IDENTITY.contact}`}>{IDENTITY.contact}</a><!--email_on-->,
    protected from edge rewriting. Directly below is the same address deliberately left
    unprotected, as a live test of whether the rewriting is switched on at all:
    {" "}<a class="link" id="contact-probe" href={`mailto:${IDENTITY.contact}`}>{IDENTITY.contact}</a>.
    If those two differ, the edge is rewriting and the protection on every other page is what is
    keeping the site reachable.
  </p>

  <style>
    /* THE ONE PAGE ALLOWED A HEALTH COLOUR.
       Red and green mean the direction of a funding payment everywhere else on this site, and
       this page was borrowing .pays-l / .pays-s to mean "broken" and "fine" — the same two
       hues doing a second job. It is defensible only because /status renders no funding rate
       at all, so there is nothing here to confuse; but borrowing the class was still wrong,
       because the next person to read .pays-l would learn the wrong rule from it. These are
       named for what they mean, defined once, and used for every health signal on the page. */
    .is-bad { color: #ef6b5e; }
    .is-ok  { color: #58c48c; }
    .tbl code { font-size: 12px; }
    .datanote-status { margin: 12px 0 0; font-size: var(--fs-sm); color: var(--text-faint); max-width: 80ch; }
    .datanote-status b { color: var(--text-dim); font-weight: 600; font-variant-numeric: tabular-nums; }
  </style>
</Base>
