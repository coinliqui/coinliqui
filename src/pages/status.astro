---
import Base from "../layouts/Base.astro";
import { IDENTITY } from "../lib/site.ts";
import { getSnapshot } from "../lib/hyperliquid.ts";
import { EXPECTED_WORKER_BUILD } from "../lib/version.ts";
import { VENUE_LABEL, type Venue } from "../lib/funding.ts";

// Deliberately NOT guarded with coldStart(): this is the page you open to find out why
// everything else is returning 503, so it has to render when the snapshot store is empty.
// robots.txt disallows it — it is operational, not editorial, and changes every 5 minutes.
const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);

interface Check { at: number; source: string; status: number; ms: number; ok: number; note: string | null }
let checks: Check[] = [];
let storeError: string | null = null;
try {
  const db = env?.DB;
  if (db) {
    /* SCOPED TO THE FIVE-MINUTE INGEST. The minute tick now records its own failures under
       source='minute', and mixing the two cadences in one "last 24 runs" figure would make
       both unreadable — twelve five-minute runs and twelve minute failures is not a rate of
       anything. They are counted separately below. */
    const { results } = await db.prepare("SELECT at, source, status, ms, ok, note FROM upstream_check WHERE source <> 'minute' ORDER BY at DESC LIMIT 24").all();
    checks = (results ?? []) as Check[];
  } else {
    storeError = "No D1 binding in this environment.";
  }
} catch (e) {
  storeError = e instanceof Error ? e.message : String(e);
}

const now = Date.now();
const ageMin = snap.fetchedAt ? Math.round((now - snap.fetchedAt) / 60000) : null;
// Cron runs every 5 minutes. Three consecutive misses is the point at which this is a
// fault rather than a slow tick.
const STALE_MIN = 15;
const stale = ageMin === null || ageMin > STALE_MIN;

/* THE ONE-MINUTE PATH. Sixty minutes is the window the "updates every minute" claim is about.
 *
 * This card read `count(*)` and called the answer "failed", under a comment that said the
 * writer "only writes a row when it FAILS". That was true when the card was written (ba7ca32)
 * and stopped being true in a LATER commit (62e4922) that made minute() record every tick with
 * ok=1 or ok=0 — a change made precisely so a tick that never runs becomes visible, since a
 * tick that never runs cannot report that it failed.
 *
 * The reader was not updated with the writer, so the healthiest possible hour rendered as the
 * worst possible reading. Measured against production D1 the moment this was found: 60 rows
 * recorded, 7 with ok=0, and this page printing "60 failed" in the alert colour. The health
 * page was the least healthy thing on the site.
 *
 * Both numbers are read now, and the count is used for what it is worth — COVERAGE. Sixty
 * ticks with none failing is clean; forty ticks with none failing is twenty ticks that never
 * ran, which the old schema could not express and the old card would have called clean. */
const MINUTE_EXPECTED = 60;
let minuteRuns: number | null = null;
let minuteFails = 0;
let minuteSpotFails = 0;
let minuteLiveFails = 0;
try {
  const db = (Astro.locals as any)?.runtime?.env?.DB;
  if (db) {
    /* WHICH LEG, because the tick has two and they carry two different promises. It fetches
       Coinbase spot AND Hyperliquid mark/funding, and writes ok=0 if EITHER fails — so a card
       reading "9 failed" over a meta reading "spot and live mark" invites the reader to
       distrust the site's headline numbers for a rate limit on a different upstream entirely.
       Measured over 303 ticks: 49 failures, all of them `coinbase 429`, and the Hyperliquid
       leg zero. The reader's actual question is which one, so the card answers it. */
    const r = await db.prepare(
      `SELECT count(*) n,
              sum(CASE WHEN ok = 0 THEN 1 ELSE 0 END) bad,
              sum(CASE WHEN json_extract(note,'$.spotError') IS NOT NULL THEN 1 ELSE 0 END) spot,
              sum(CASE WHEN json_extract(note,'$.liveError') IS NOT NULL THEN 1 ELSE 0 END) live
         FROM upstream_check WHERE source = 'minute' AND at > ?1`,
    ).bind(Date.now() - 3_600_000).first();
    minuteRuns = Number(r?.n ?? 0);
    minuteFails = Number(r?.bad ?? 0);
    minuteSpotFails = Number(r?.spot ?? 0);
    minuteLiveFails = Number(r?.live ?? 0);
  }
} catch { /* the page must render with no store — that is when it is read */ }
const minuteWhere = minuteFails === 0 ? ""
  : minuteLiveFails === 0 ? " · all in the Coinbase spot leg; mark and funding unaffected"
  : minuteSpotFails === 0 ? " · all in the Hyperliquid leg (mark and funding)"
  : ` · ${minuteLiveFails} Hyperliquid, ${minuteSpotFails} Coinbase spot`;
/* Under 90% of the expected ticks is the same fault as a failing one and is reported as one. */
const minuteMissing = minuteRuns !== null && minuteRuns < MINUTE_EXPECTED * 0.9;
const minuteBad = minuteRuns === null || minuteRuns === 0 || minuteFails > 0 || minuteMissing;

const latest = checks[0];
/* The refusal reason travels in the run's note, which is JSON. Parsed defensively: this page
   must render even when the store is empty, which is exactly when someone opens it. */
const latestNote = (() => {
  try { return latest?.note ? String(JSON.parse(latest.note).error ?? "") : ""; } catch { return ""; }
})();
const latestRefused = latestNote.startsWith("refused:");
const latestVenues: Record<string, number> = (() => {
  try { return latest?.note ? (JSON.parse(latest.note).venues ?? {}) : {}; } catch { return {}; }
})();
const fails = checks.filter((c) => !c.ok).length;

/* Is the deployed worker the one this build expects? A hand-pasted bundle can be older than
   the site with nothing anywhere to say so. */
let workerBuild: string | null = null;
try {
  const v = (await env?.SNAPSHOT?.get("worker:build", "json")) as { build?: string } | null;
  workerBuild = v?.build ?? null;
} catch { /* leave null */ }
const workerDrift = workerBuild !== null && workerBuild !== EXPECTED_WORKER_BUILD;
const bindings = [
  { name: "SNAPSHOT", kind: "KV", present: Boolean(env?.SNAPSHOT) },
  { name: "DB", kind: "D1", present: Boolean(env?.DB) },
];

/* SERIES COVERAGE — the layer this page used to say nothing about.
 *
 * Everything above answers "is ingest running". None of it answers "does every published
 * contract actually have the data its page draws", and those came apart in exactly the way
 * that is hardest to notice: /funding/uni was live and indexed with no daily candles at all,
 * while this page reported green on every check it had.
 *
 * Each sweep records the symbols it has written in its own meta record, so the comparison is
 * three KV reads rather than one per contract.
 */
const SERIES = [
  { key: "hourly", label: "Hourly candles", gate: "2 h", drives: "the liquidation map and the 1H/4H charts" },
  { key: "candles", label: "Daily candles", gate: "12 h", drives: "the 1D/1W charts and leverage survival" },
  { key: "funding", label: "Funding history", gate: "6 h", drives: "the funding band under every price chart" },
];
const covered = snap.perps.map((p) => p.symbol);
const series = await Promise.all(
  SERIES.map(async (s) => {
    let have: string[] = [];
    let at = 0;
    try {
      const m = (await env?.SNAPSHOT?.get(`${s.key}:meta`, "json")) as { h?: string[]; u?: number } | null;
      have = m?.h ?? [];
      at = m?.u ?? 0;
    } catch { /* leave empty — reported as unknown, not as healthy */ }
    const set = new Set(have);
    const missing = covered.filter((c) => !set.has(c));
    return { ...s, at, missing, known: have.length > 0 };
  }),
);
const seriesGap = series.some((s) => s.known && s.missing.length > 0);
const utc = (ms: number) => new Date(ms).toISOString().slice(0, 16).replace("T", " ") + " UTC";
---

{/* noindex, NOT a robots.txt Disallow. This page is linked from /about and /data-sources, and
    a Disallow'd URL can still be indexed from inbound links with no snippet — the crawler is
    never allowed to fetch it and see a directive. noindex only works on a crawlable page. */}
<Base title="Status" description="Ingest health: snapshot age, upstream status codes and per-venue coverage." noindex>
  <div class="page-head">
    <h1>Status</h1>
    <p>
      Ingest health. This page reads the ingest run log in D1 directly and renders even when the snapshot
      store is empty. The weekly <a class="link" href="/status/indexation">indexation report</a> is
      built by the same worker.
    </p>
  </div>

  <div class="cards">
    <div class="card">
      <div class="card__label">Snapshot age</div>
      <div class:list={["card__value", stale && "is-bad"]}>{ageMin === null ? "—" : ageMin === 0 ? "under 1 min" : `${ageMin} min`}</div>
      <div class="card__meta">{snap.fetchedAt ? utc(snap.fetchedAt) : "never written"}</div>
    </div>
    <div class="card">
      <div class="card__label">Snapshot store</div>
      <div class="card__value" style="font-size:20px">{snap.available ? "readable" : "empty"}</div>
      <div class="card__meta">{snap.perps.length} contracts cached</div>
    </div>
    <div class="card">
      <div class="card__label">Last ingest</div>
      {/* A REFUSAL IS NOT "no response". The ingest now declines to overwrite a healthy
          snapshot with a degenerate one — an upstream that answers 200 with an empty universe,
          or with forty-nine of fifty contracts missing. That run is recorded as failed with
          status 200, because the upstream DID answer; saying "no response" would describe the
          wrong problem to whoever is reading this page at the time. */}
      <div class:list={["card__value", latest && !latest.ok && "is-bad"]} style="font-size:20px">{latest ? (latest.ok ? "ok" : latestRefused ? "refused" : `failed (${latest.status || "no response"})`) : "—"}</div>
      <div class="card__meta">{latest ? (latestRefused ? latestNote : `${latest.ms} ms · ${utc(latest.at)}`) : "no runs recorded"}</div>
    </div>
    <div class="card">
      <div class="card__label">Minute tick, last hour</div>
      <div class:list={["card__value", minuteBad && "is-bad"]}>{
        minuteRuns === null ? "no store"
        : minuteRuns === 0 ? "no ticks recorded"
        : minuteFails > 0 ? `${minuteFails} failed of ${minuteRuns}`
        : minuteMissing ? `only ${minuteRuns} of ${MINUTE_EXPECTED} ran`
        : `clean · ${minuteRuns} of ${MINUTE_EXPECTED}`
      }</div>
      <div class="card__meta">Coinbase spot and Hyperliquid mark · every tick records, so one that never ran shows here{minuteWhere}</div>
    </div>
    <div class="card">
      <div class="card__label">Failures in last 24 runs</div>
      <div class:list={["card__value", fails > 0 && "is-bad"]}>{checks.length ? fails : "—"}</div>
      <div class="card__meta">{checks.length} runs recorded</div>
    </div>
  </div>

  <h2 class="section">Bindings and worker version</h2>
  <p class="section-note">
    The three things that can be wrong while every page still renders correctly. Each is a
    deploy step that fails quietly rather than loudly, so it is checked here instead.
  </p>
  <div class="panel" style="max-width:760px">
    <table class="tbl">
      <thead><tr><th>Check</th><th>State</th><th>What a wrong value means</th></tr></thead>
      <tbody>
        {bindings.map((b) => (
          <tr class={b.present ? undefined : "is-active"}>
            <td>{b.kind} binding <code>{b.name}</code></td>
            <td class:list={[b.present ? "is-ok" : "is-bad"]} style="font-weight:600">{b.present ? "attached" : "MISSING"}</td>
            <td class="reason">
              {b.name === "SNAPSHOT"
                ? "Pages would serve 503 rather than fall back to the upstream API — deliberately, so a missing binding cannot hide behind a working-looking site."
                : "Pages still render, but no funding history accrues and this table stays empty. Nothing else shows it."}
            </td>
          </tr>
        ))}
        <tr class={workerDrift ? "is-active" : undefined}>
          <td>Ingest worker version</td>
          <td class:list={[workerBuild === null ? "dim" : workerDrift ? "is-bad" : "is-ok"]} style="font-weight:600">
            {workerBuild === null ? "not reported yet" : workerDrift ? "STALE" : "current"}
          </td>
          <td class="reason">
            Deployed <code>{workerBuild ?? "—"}</code>, site expects <code>{EXPECTED_WORKER_BUILD}</code>.
            The bundle is pasted into the dashboard by hand, so it can sit behind this repository
            with nothing to say so — whatever the newer worker was meant to write is simply absent.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {stale && (
    <div class="verdict verdict--warn">
      <div>
        <b>The snapshot is stale.</b> It was last written
        {ageMin === null ? " never" : ` ${ageMin} minutes ago`}, against a 5-minute cron. Pages are
        still serving — they read the last good value and never call upstream — but every figure on
        the site is now as old as the timestamp says. Check the cron trigger and the runs below.
      </div>
    </div>
  )}

  <h2 class="section">Series coverage</h2>
  <p class="section-note">
    A published contract with no series behind it renders a page-shaped hole: the chart panel is
    simply absent, every other figure is fine, and nothing above this line would notice. The
    counts are against the {covered.length} contracts currently published.
  </p>
  <div class="panel" style="max-width:860px">
    <table class="tbl">
      <thead><tr><th>Series</th><th class="num">Covered</th><th>Refresh interval</th><th>Missing</th></tr></thead>
      <tbody>
        {series.map((s) => (
          <tr class={s.known && s.missing.length ? "is-active" : undefined}>
            <td>{s.label}<div class="reason" style="margin-top:2px">drives {s.drives}</div></td>
            <td class:list={["num", s.known ? (s.missing.length ? "is-bad" : "is-ok") : "dim"]} style="font-weight:600">
              {s.known ? `${covered.length - s.missing.length} / ${covered.length}` : "—"}
            </td>
            <td>{s.gate}{s.at ? <div class="reason" style="margin-top:2px">last full refresh {utc(s.at)}</div> : null}</td>
            <td class="reason">{!s.known ? "unknown — no refresh has recorded coverage yet" : s.missing.length ? s.missing.join(", ") : "none"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {seriesGap && (
    <div class="verdict verdict--warn">
      <div>
        <b>A published contract is missing a series.</b> This is normal for a few minutes after a
        contract crosses the coverage floor — a missing series is filled on the next five-minute
        tick rather than waiting for the refresh interval. If a name is still listed here after fifteen
        minutes, the fetch for it is failing rather than pending.
      </div>
    </div>
  )}

  <h2 class="section">Per-venue coverage, last run</h2>
  <p class="section-note">
    A venue silently dropping out of the upstream response looks like success: the run still writes
    rows, just fewer. A count at zero here is that failure.
  </p>
  <div class="panel" style="max-width:520px">
    <table class="tbl">
      <thead><tr><th>Venue</th><th class="num">Rows last run</th></tr></thead>
      <tbody>
        {(["HlPerp", "BinPerp", "BybitPerp"] as Venue[]).map((v) => (
          <tr>
            <td>{VENUE_LABEL[v]} <code>{v}</code></td>
            <td class:list={["num", !latestVenues[v] && "is-bad"]}>{latestVenues[v] ?? 0}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section">Recent runs</h2>
  {storeError ? (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">Run log unreadable</p>
        <p class="empty__text">{storeError}</p>
      </div>
    </div>
  ) : checks.length === 0 ? (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">No runs recorded yet</p>
        <p class="empty__text">The ingest worker has not completed a run against this database. Trigger one manually at the worker's <code>/ingest</code> route.</p>
      </div>
    </div>
  ) : (
    <div class="panel">
      <table class="tbl">
        <thead><tr><th>When</th><th>Source</th><th class="num">Status</th><th class="num">ms</th><th class="num">Result</th></tr></thead>
        <tbody>
          {checks.map((c) => (
            <tr>
              <td class="num" style="text-align:left">{utc(c.at)}</td>
              <td>{c.source}</td>
              <td class="num">{c.status || "—"}</td>
              <td class="num">{c.ms}</td>
              <td class:list={["num", !c.ok && "is-bad"]}>{c.ok ? "ok" : "failed"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {/* IS THE ONLY CONTACT ROUTE STILL MACHINE-READABLE?

      Cloudflare's Email Address Obfuscation rewrites every mailto: it finds in HTML on the way
      out of the edge, after this code has run and with no way for it to intervene. It did
      exactly that once: the href became a /cdn-cgi/l/email-protection# URL that 404s and the
      text became the literal string "[email protected]". Humans with JavaScript never notice.
      Crawlers and answer engines see nonsense — and they are the audience the address exists
      for, on the pages written to establish that this site is reachable.

      <!--email_off--> is the documented opt-out and every other mailto on the site is wrapped
      in it. That workaround is what is holding, and it is one deletion away from not holding,
      because this project's Cloudflare grant cannot read zone settings to find out whether the
      feature is even on. Verified by API on 18 August 2026: the token is Workers-scoped and
      returns 9109 Unauthorized for zone settings, so the state of that switch is unknowable
      from here.

      So the state is measured instead of assumed. The address below is deliberately NOT wrapped.
      If the edge is rewriting, this one link is mangled and everything else on the site still
      works — and scripts/verify-live.mjs reads this page and says so. */}
  <h2 class="section">Contact route</h2>
  <p class="prose">
    The published address is
    {" "}<!--email_off--><a class="link" href={`mailto:${IDENTITY.contact}`}>{IDENTITY.contact}</a><!--email_on-->,
    protected from edge rewriting. Directly below is the same address deliberately left
    unprotected, as a live test of whether the rewriting is switched on at all:
    {" "}<a class="link" id="contact-probe" href={`mailto:${IDENTITY.contact}`}>{IDENTITY.contact}</a>.
    If those two differ, the edge is rewriting and the protection on every other page is what is
    keeping the site reachable.
  </p>

  <style>
    /* THE ONE PAGE ALLOWED A HEALTH COLOUR.
       Red and green mean the direction of a funding payment everywhere else on this site, and
       this page was borrowing .pays-l / .pays-s to mean "broken" and "fine" — the same two
       hues doing a second job. It is defensible only because /status renders no funding rate
       at all, so there is nothing here to confuse; but borrowing the class was still wrong,
       because the next person to read .pays-l would learn the wrong rule from it. These are
       named for what they mean, defined once, and used for every health signal on the page. */
    .is-bad { color: #ef6b5e; }
    .is-ok  { color: #58c48c; }
    .reason { color: var(--text-dim); white-space: normal; }
    .tbl code { font-size: 12px; }
  </style>
</Base>
