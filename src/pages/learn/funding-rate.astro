---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import Figure from "../../components/Figure.astro";
import { getSnapshot, coldStart } from "../../lib/hyperliquid.ts";
import { VENUE_LABEL, pct, usd, carryCost, rawRate, settlementsPerYear } from "../../lib/funding.ts";

/**
 * THE FUNDING-RATE EXPLAINER.
 *
 * WHY THIS ONE FIRST. Search Console for the week to 22 August 2026: the funding cluster is
 * this domain's largest measured demand by a distance — "btc funding rate", "eth funding
 * rate", "sol funding rate", "bitcoin perpetual funding rate", "btc usdt funding rate 8h",
 * "funding rate history hyperliquid", "btc aggregated funding rate chart" — 392 impressions
 * across the contract template alone. The site answered every one of those with a table and
 * none of them with a sentence.
 *
 * THE FIGURES ARE LIVE ON PURPOSE, and it is the only structural advantage this page has. An
 * explanation of what a funding rate costs, written with today's rate in it and the arithmetic
 * carried out on that rate, is a document nobody with a static article can publish. Everything
 * printed here is server-rendered from the same snapshot the market pages read; if the store
 * is cold the page returns 503 rather than explaining arithmetic over blanks.
 *
 * WHAT IS DELIBERATELY NOT CLAIMED. The venue-side formula — the premium and interest
 * components, the clamps each venue applies — is described in general terms and attributed to
 * the venues' own documentation rather than reproduced as though we had verified it. What this
 * page asserts without hedging is only what this site measures itself: the intervals, the
 * rates, and the annualisation.
 */
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

const perps = [...snap.perps].sort((a, b) => b.oiNotional - a.oiNotional);
const btc = perps.find((p) => p.symbol === "BTC") ?? perps[0];
const btcVenues = btc?.venues ?? [];
const hl = btcVenues.find((v) => v.venue === "HlPerp") ?? btcVenues[0];

/* The worked example. A round notional and a round holding period, so a reader can scale it in
   their head; the rate is whatever the market is doing at the moment the page is served. */
const EXAMPLE_NOTIONAL = 10_000;
const EXAMPLE_DAYS = 30;

/* ONE BTC COST, ON A VENUE THE TABLE NEVER NAMED. This was a single row, "BTC funding,
   annualised, right now", fed by `btc.hlApr` — Hyperliquid's rate — with "A long pays" beneath
   it, and nothing in the section said Hyperliquid. Measured on production at 10:18 UTC on
   16 September 2026: the venue table directly above printed BTC at 2.42% on Binance, 10.95% on
   Hyperliquid and 5.18% on Bybit, and this one printed 10.95% as BTC funding and $90.00 as what
   a long pays. That is the highest of the three, unlabelled, under the one section heading that
   promises what a position costs; the same arithmetic on Binance's rate was about $20, 4.5×
   less. On a page whose whole lesson is that venues quote different rates for the same coin at
   the same moment, one venue's figure had become the coin's.

   So the cost is now computed for EVERY venue the comparison table renders, from the same
   `btcVenues` entries, and each row's name comes from its own `venue` field. A figure cannot sit
   under another venue's name or under none, and a venue missing from the snapshot simply has no
   row. Direction is per row too: venues can disagree in sign, and "a long pays" over a negative
   rate would be a sentence its own number contradicts.

   EACH COST IS COMPUTED FROM THE RATE AS PRINTED, not from the stored one, because the note
   invites the reader to repeat the arithmetic on every row. Hyperliquid's 10.95% is usually
   exact, which is why the single-row version never showed it; the other venues are not. Measured
   on the local render the same day, Bybit printed 5.20% beside $42.71, while $10,000 × 5.20% ×
   (30 ÷ 365) is $42.74 — the cost had come from 5.196%. Parsing the printed percentage makes the
   row reproduce by construction, at a price of at most 0.005 points of rate, about 4 cents on
   this position. */
const costRows = btcVenues
  .filter((v) => Number.isFinite(v.apr))
  .map((v) => {
    const shown = pct(v.apr);
    const cost = carryCost(EXAMPLE_NOTIONAL, Number(shown.slice(0, -1)) / 100, EXAMPLE_DAYS);
    return { venue: v.venue, label: VENUE_LABEL[v.venue], shown, cost, verb: cost >= 0 ? "pays" : "receives" };
  });
/* The worked arithmetic is shown for one named row — Hyperliquid's where it exists, because the
   callout at the top quotes that venue — and signed, so the product printed is the product of
   the factors printed beside it. */
const worked = costRows.find((r) => r.venue === "HlPerp") ?? costRows[0];
const workedResult = worked ? `${worked.cost < 0 ? "-" : ""}${usd(Math.abs(worked.cost), 2)}` : "";
/* The spread between venues, worded by the signs actually present: both pay, both receive, or
   one pays while the other is paid. Absent when there is nothing to compare. */
const byCost = [...costRows].sort((a, b) => a.cost - b.cost);
const lowCost = byCost[0];
const highCost = byCost[byCost.length - 1];
const costSpread = byCost.length < 2 || lowCost.cost === highCost.cost
  ? ""
  : lowCost.cost >= 0
    ? `Same coin, same moment, same position: a long pays ${usd(lowCost.cost, 2)} on ${lowCost.label} and ${usd(highCost.cost, 2)} on ${highCost.label}.`
    : highCost.cost <= 0
      ? `Same coin, same moment, same position: a long receives ${usd(-highCost.cost, 2)} on ${highCost.label} and ${usd(-lowCost.cost, 2)} on ${lowCost.label}.`
      : `Same coin, same moment, same position: a long pays ${usd(highCost.cost, 2)} on ${highCost.label} and is paid ${usd(-lowCost.cost, 2)} on ${lowCost.label}.`;

/* ONE QUOTED RATE, THREE VENUES, THREE COMPLETELY DIFFERENT COSTS — which is this page's whole
   lesson and the reason the rest of the site annualises anything at all. A reader who has seen
   "0.01%" on two exchanges assumes they are comparable; they are only comparable once you know
   how often each of them charges it.

   The rate here is FIXED at 0.01% on purpose. Every other figure on this site is live, and this
   one must not be: the point is what the interval does when the rate is held still, and a live
   rate would move both variables at once and teach nothing. The intervals are real, taken from
   the venues the page already names. */
const LESSON_RATE = 0.0001;
const cadence = [...btcVenues]
  .filter((v) => Number.isFinite(v.intervalHours) && v.intervalHours > 0)
  .sort((a, b) => a.intervalHours - b.intervalHours)
  .map((v) => ({
    label: VENUE_LABEL[v.venue],
    hours: v.intervalHours,
    perDay: 24 / v.intervalHours,
    apr: LESSON_RATE * (8760 / v.intervalHours),
  }));
const cadenceMax = Math.max(...cadence.map((c) => c.apr), 1e-9);

/* Widest absolute annualised rates on the book. NOT the widest venue spreads — that is the
   arbitrage table on /funding — but the contracts where simply holding a position costs or
   pays the most, which is what this page is about. */
/* A LIST CUT AT TWELVE WAS CHOOSING AMONG EQUAL RATES BY OPEN INTEREST. This was the first twelve
   contracts by absolute Hyperliquid rate, introduced as "the 12 covered contracts with the largest
   annualised rates on Hyperliquid" under "Where funding is most expensive right now". Measured on
   the local render at 11:07 UTC on 16 September 2026: four rows were genuinely larger (XLM -31.73%
   down to ADA -22.02%) and the other eight — BTC, ETH, HYPE, ZEC, XRP, LIT, NEAR, PUMP — all printed
   exactly 10.95%, the value most of the book sits on (/funding counted 38 of 50 at 11:05). The sort
   is stable over a list already ordered by open interest, so those eight were the largest books
   among thirty-odd identical rates, and the heading offered Hyperliquid's base rate as the most
   expensive reading on the venue.

   SO THE CUT MAY NOT SPLIT A TIE. When the rate in twelfth place is shared by a contract below the
   cut, every contract on that rate leaves the table and is counted in the prose instead, so each
   listed row is further from zero than every contract left out. Equal means equal AS PRINTED: two
   rates that both read 10.95% are the same rate to the reader whatever their fifth decimal. The
   count, the sign and whether the shared value is the base rate are all read from the book, so the
   sentence follows the book when it moves; the base rate is only named when the value matches
   0.0000125 an hour, the constant /funding and the home page test against in the same way. At
   11:10 the section listed five contracts and counted 37 of 50 on 10.95%; /funding rendered in the
   same second showed the same five beyond 10.95% and the same 37. */
const EXTREMES_MAX = 12;
const HL_BASE_APR = 0.0000125 * 8760;
const magShown = (p: { hlApr: number }) => pct(Math.abs(p.hlApr));
const ranked = [...perps]
  .filter((p) => Number.isFinite(p.hlApr))
  .sort((a, b) => Math.abs(b.hlApr) - Math.abs(a.hlApr));
const tieEdge = ranked.length > EXTREMES_MAX && magShown(ranked[EXTREMES_MAX]) === magShown(ranked[EXTREMES_MAX - 1])
  ? magShown(ranked[EXTREMES_MAX])
  : null;
const extremes = ranked.slice(0, EXTREMES_MAX).filter((p) => tieEdge === null || magShown(p) !== tieEdge);
const tied = tieEdge === null ? [] : ranked.filter((p) => magShown(p) === tieEdge);
const tiedLongsPay = tied.filter((p) => p.hlApr >= 0).length;
const tiedRate = tiedLongsPay === tied.length ? tieEdge : tiedLongsPay === 0 ? `-${tieEdge}` : `${tieEdge} one way or the other`;
const tiedIsBase = tied.length > 0 && tied.every((p) => Math.abs(p.hlApr - HL_BASE_APR) < 1e-9);
const tiedSentence = tied.length === 0
  ? ""
  : tiedIsBase
    ? `${tied.length} of the ${ranked.length} covered contracts sit at exactly ${tiedRate}, Hyperliquid’s base rate: a venue constant rather than a view about any of them, so they are counted here rather than listed.`
    : `${tied.length} of the ${ranked.length} covered contracts sit at exactly ${tiedRate}; a shared rate ranks none of them above the others, so they are counted here rather than listed.`;
const extremesLead = tieEdge === null
  ? `The ${extremes.length} covered contracts with the largest annualised rates on Hyperliquid, in either direction.`
  : extremes.length === 0
    ? `No covered contract carries an annualised rate on Hyperliquid further from zero than ${tieEdge}. ${tiedSentence}`
    : `The ${extremes.length === 1 ? "one covered contract" : `${extremes.length} covered contracts`} whose annualised rate on Hyperliquid is further from zero than ${tieEdge}, in either direction. ${tiedSentence}`;

/* THE DEFINITION WAS ABSTRACT ON A SITE HOLDING FIFTY LIVE ANSWERS TO IT. /learn/open-interest
   puts the live total inside its definition — "a book with $9.85B of open interest has $9.85B of
   long exposure facing $9.85B of short" — and reads better for it, because the reader sees the
   abstraction and an instance of it in one breath. This page, on the same live store, opened
   with no figure at all. Same treatment, from `hl`, which was already read above.

   THE DIRECTION IS COMPUTED, NOT ASSUMED. A funding rate is signed and this one goes negative;
   printing "longs pay shorts" over a negative rate would be a sentence the number contradicts.
   THE VENUE IS READ, NOT TYPED, for the same reason: `hl` falls back to the first venue when BTC
   has no Hyperliquid entry, and a literal "On Hyperliquid" would then name a venue whose rate it
   is not printing. */
const liveRate = hl && Number.isFinite(hl.apr)
  ? `On ${VENUE_LABEL[hl.venue]} right now it runs ${pct(Math.abs(hl.apr))} a year on ${btc.symbol}, ${hl.apr >= 0 ? "longs paying shorts" : "shorts paying longs"}.`
  : "";

const title = "Funding rate explained: who pays, how it is calculated, what it costs";
const description =
  "A perpetual funding rate is a payment between longs and shorts, not a fee to the exchange. " +
  "What it is, why two venues quoting different intervals cannot be compared until both are " +
  "annualised, and what a position costs to hold at today's rates.";
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt}>
  <div class="page-head">
    <h1>What a funding rate is</h1>
  </div>

  {cadence.length > 1 && (
    <Figure
      title="The same quoted rate, on three settlement intervals"
      lead={pct(cadence[0].apr)}
      leadNote={`what 0.01% a settlement is worth per year on ${cadence[0].label}, against ${pct(cadence[cadence.length - 1].apr)} on ${cadence[cadence.length - 1].label}`}>
      <div class="bars">
        {cadence.map((c) => (
          <>
            <span class="bars__label">{c.label}</span>
            <span class="bars__track"><span class="bars__fill bars__fill--l" style={`width:${Math.max(3, (c.apr / cadenceMax) * 100)}%`}></span></span>
            <span class="bars__value">{pct(c.apr)}{" "}<span class="faint">every {c.hours}h</span></span>
          </>
        ))}
      </div>
      <p slot="note">
        Every bar is the identical quoted rate — 0.01% per settlement — and nothing else differs
        but how often it is charged. {cadence[0].label} settles {Math.round(cadence[0].perDay)} times
        a day, so the same number costs {(cadenceMax / cadence[cadence.length - 1].apr).toFixed(0)}&times;
        more over a year than it does on {cadence[cadence.length - 1].label}. This is why every rate
        on this site is annualised before it is compared, and why a screenshot of two exchanges
        side by side usually is not a comparison at all.
      </p>
    </Figure>
  )}

  <p class="callout">
    A funding rate is a recurring payment between the two sides of a perpetual futures
    contract. {liveRate && <><strong>{liveRate}</strong>{" "}</>}When it is positive, everyone holding a long position pays everyone holding a
    short; when it is negative, shorts pay longs. The venue is not a party to it and takes
    none of it — it only moves the money.
  </p>

  <h2 class="section">Why perpetuals need one at all</h2>
  <p class="prose">
    An ordinary futures contract has an expiry date. On that date it settles against the spot
    price, and because everyone knows this in advance, the contract's price is pulled towards
    spot as the date approaches. Convergence is a consequence of settlement.
  </p>
  <p class="prose">
    A perpetual never expires, so that mechanism does not exist. Left alone, the contract could
    trade at any distance from the underlying asset indefinitely. Funding is the replacement:
    when the contract trades above spot, longs pay shorts, which makes holding a long more
    expensive and holding a short more attractive, until the gap closes. It is a tether made of
    money rather than of time.
  </p>

  <h2 class="section">Reading the sign</h2>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Rate</th><th>Direction</th><th>Usually means</th></tr></thead>
      <tbody>
        <tr>
          <td>Positive</td>
          <td>Longs pay shorts</td>
          <td>The perpetual is trading above spot. More capital wants leveraged long exposure than short.</td>
        </tr>
        <tr>
          <td>Negative</td>
          <td>Shorts pay longs</td>
          <td>The perpetual is trading below spot — usually a crowded short, sometimes a spot bid the derivatives book has not followed.</td>
        </tr>
        <tr>
          <td>Near zero</td>
          <td>Almost nothing changes hands</td>
          <td>The two sides are balanced. This is the resting state, not the exception.</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="section-note" style="margin-top:10px">
    The sign is a fact about positioning, not a forecast. It says what traders have already
    done, and crowded positioning resolves in both directions.
  </p>

  <h2 class="section">How a venue arrives at the number</h2>
  <p class="prose">
    Each venue computes its own rate and publishes its own method; the shapes are similar and
    the details are not interchangeable. Broadly, a venue measures how far its contract is
    trading from an index of spot prices — the <em>premium</em> — adds a small fixed interest
    component, and clamps the result so a single dislocated minute cannot produce an enormous
    payment. What the clamps are, and how the premium is sampled, differs by venue and is
    stated in each venue's own documentation. The endpoints this site reads, and what each one
    returns, are listed on <a class="link" href="/data-sources">Data sources</a>.
  </p>
  <p class="prose">
    Two things are worth carrying away from that. First, the rate is a measurement of a price
    gap, so it moves with positioning rather than being set by anyone. Second, because each
    venue measures its own book against its own index, three venues can honestly report three
    different rates for the same coin at the same instant — which is the gap the
    {" "}<a class="link" href="/tools/funding-arbitrage">carry calculator</a> quantifies.
  </p>

  <h2 class="section">The comparison trap</h2>
  <p class="prose">
    This is the error that makes most published funding numbers unusable, and it is not subtle
    once seen. A venue quotes the rate it will charge <strong>per settlement</strong>, and
    settlements are not the same length everywhere. Hyperliquid settles hourly. Binance and
    Bybit settle on an eight-hour cycle. So an eight-hour rate of 0.01% and an hourly rate of
    0.01% differ by a factor of eight in what they actually cost, and the two numbers look
    identical.
  </p>
  <p class="prose">
    The fix is to annualise: multiply the quoted rate by the number of settlements in a year.
    That is {settlementsPerYear(1).toLocaleString("en-US")} for an hourly contract and
    {" "}{settlementsPerYear(8).toLocaleString("en-US")} for an eight-hour one. Simple, not
    compounded — compounding a rate that is re-measured every settlement would turn a
    measurement into a forecast. Here is the same contract, today, before and after:
  </p>
  {btc && btcVenues.length > 0 && (
    <div class="panel">
      <table class="tbl">
        {/* THE ANSWER SECOND, NOT LAST. Read left to right this table was the arithmetic — quoted rate,
            interval, settlements, result — and at 375px the result was the column fully off screen:
            measured 16 September 2026, Venue, Quoted rate and Interval filled the panel, Settlements
            per year was 22% visible and Annualised 0%. The section exists to show that the annualised
            figures compare and the quoted ones do not, so the comparable column sits beside the venue
            and the inputs follow it; the multiplication is stated in the sentence above the table. */}
        <thead><tr><th>Venue</th><th class="num">Annualised</th><th class="num">Quoted rate</th><th class="num">Interval</th><th class="num">Settlements per year</th></tr></thead>
        <tbody>
          {btcVenues.map((v) => (
            <tr>
              <td>{VENUE_LABEL[v.venue]}</td>
              <td class="num">{pct(v.apr)}</td>
              <td class="num">{rawRate(v.rate, v)}</td>
              <td class="num">{v.intervalHours}h</td>
              <td class="num">{Math.round(settlementsPerYear(v.intervalHours)).toLocaleString("en-US")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="section-note" style="margin-top:10px">
    {btc ? `${btc.symbol} · rendered by the server from the snapshot stamped at the top of this page.` : "Rendered by the server."}
    {" "}<a class="link" href="/funding">The same normalisation for every covered contract →</a>
  </p>

  <h2 class="section">What it costs to hold a position</h2>
  {btc && (
    <>
      <p class="prose">
        Funding is charged on the <strong>notional</strong> value of the position, not on the
        margin posted against it. A position of {usd(EXAMPLE_NOTIONAL)} pays the same funding
        whether it was opened with {usd(EXAMPLE_NOTIONAL)} of collateral or with a tenth of
        that at ten times leverage — which is why leverage multiplies the cost relative to the
        capital at risk without changing the cost itself.
      </p>
      {worked && (
        <>
          <p class="prose">
            Take a {usd(EXAMPLE_NOTIONAL)} {btc.symbol} long and hold it for {EXAMPLE_DAYS} days at
            each venue's rate from the table above:
          </p>
          <div class="panel">
            <table class="tbl">
              <thead><tr><th>Venue</th><th class="num">Annualised</th><th class="num">Long, {EXAMPLE_DAYS} days</th></tr></thead>
              <tbody>
                {costRows.map((r) => (
                  <tr>
                    <td>{r.label}</td>
                    <td class="num">{r.shown}</td>
                    <td class="num">{r.verb}{" "}<strong set:text={usd(Math.abs(r.cost), 2)} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="section-note" style="margin-top:10px">
            On {worked.label}: {usd(EXAMPLE_NOTIONAL)} × {worked.shown} × ({EXAMPLE_DAYS} ÷ 365) = {workedResult}, and
            the same arithmetic on every row.{costSpread && <>{" "}{costSpread}</>} The rates are today's and will
            not be tomorrow's, so each figure is what the position would cost if its rate stayed
            here — an arithmetic result, not a projection.
            {" "}<a class="link" href="/tools/funding-cost">Run it on your own numbers →</a>
          </p>
        </>
      )}
    </>
  )}

  <h2 class="section">What a large funding rate does not tell you</h2>
  <p class="prose">
    A high positive rate is regularly reported as a signal that a reversal is due. It is not
    one, and the reason is mechanical: the rate is a measurement of a price gap that already
    exists. It tells you leveraged longs are crowded and are paying for the privilege. Crowded
    positioning does unwind, and it also persists for weeks in a strong trend while shorts pay
    the whole way. The rate is a cost, and treating a cost as a direction is the most common
    way this number is misused.
  </p>
  <p class="prose">
    What it does tell you precisely is the price of carry: how much a position bleeds or earns
    per day for holding, before any move in the underlying. That is a real, computable number,
    and it is the one this site publishes.
  </p>

  {hl && (
    <>
      <h2 class="section">Where funding is most expensive right now</h2>
      {/* "BOTH COLUMNS" DESCRIBED A TABLE THIS PAGE NO LONGER DRAWS. The sentence ended "the same
          warning about direction applies to both columns"; measured on production on 16 September
          2026, the table under it has four columns (Coin, Annualised, Who pays, Open interest) and
          ONE list of both signs sorted by size — 6 negative rows then 6 positive — so there were
          no two direction columns for a reader to find. The warning now names what it applies to,
          a rate pointing either way, which stays true whatever mix of signs the list holds, and
          the rates are scoped to Hyperliquid: every figure here is `hlApr`, and the column beside
          it already said so for open interest while the rate itself named no venue. */}
      <p class="prose">
        {extremesLead} A large negative figure is not a bargain — it is a crowded short
        paying to stay short. The warning above holds whichever way a rate points: it is the
        cost of holding a position, not a call on where the price goes next.
      </p>
      {extremes.length > 0 && <div class="panel">
        <table class="tbl">
          <thead><tr><th>Coin</th><th class="num">Annualised <span class="thscope">Hyperliquid</span></th><th>Who pays</th><th class="num">Open interest <span class="thscope">Hyperliquid</span></th></tr></thead>
          <tbody>
            {extremes.map((p) => (
              <tr>
                <td><a href={`/funding/${p.symbol.toLowerCase()}`}>{p.symbol}</a></td>
                <td class="num">{pct(p.hlApr)}</td>
                <td>{p.hlApr >= 0 ? "Longs pay shorts" : "Shorts pay longs"}</td>
                <td class="num">{usd(p.oiNotional)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>}
    </>
  )}

  <Related
    title="Where to go next"
    items={[
      { href: "/funding", label: "Funding, all venues", note: "Every covered contract, three venues, normalised to the same unit." },
      { href: "/tools/funding-cost", label: "Funding cost calculator", note: "What a position of your size costs to hold for your holding period." },
      { href: "/tools/funding-arbitrage", label: "Cross-venue carry", note: "What the spread between two venues would pay, with the costs that eat it." },
      { href: "/learn/open-interest", label: "Open interest, explained", note: "The other half of the positioning picture, and what it does and does not say." },
      { href: "/methodology", label: "Methodology", note: "The annualisation, worked through on today's real rates." },
      { href: "/learn", label: "All explainers", note: "Funding, liquidation maps, liquidation price and open interest." },
    ]}
  />

  <style>
    h2.section { margin-top: 32px; }
  </style>
</Base>
