---
import Base from "../../layouts/Base.astro";

/**
 * The weekly indexation report, as produced by the ingest Worker.
 *
 * There is no GitHub Action and no committed markdown file: the Worker that already runs
 * every five minutes builds the report across a few Monday ticks and writes it to KV, and
 * this page renders whatever is there. One fewer credential, one fewer dependency, and the
 * report is a URL rather than a file someone has to go and find in a repository.
 *
 * Under /status, so robots.txt's existing `Disallow: /status` covers it by prefix — it is
 * operational, not editorial.
 */
const env = (Astro.locals as any)?.runtime?.env;
let doc: { week: string; at: number; tookMs: number; md: string } | null = null;
let progress: { week: string; phase: string; i: number } | null = null;
let err: string | null = null;
try {
  doc = (await env?.SNAPSHOT?.get("report:latest", "json")) as typeof doc;
  progress = (await env?.SNAPSHOT?.get("report:state", "json")) as typeof progress;
} catch (e) {
  err = e instanceof Error ? e.message : String(e);
}

/* A very small markdown renderer — headings, tables, lists, bold, code. The report is mostly
   tables, and a <pre> block of pipe characters is not a readable instrument. Anything it does
   not recognise falls through as a paragraph rather than being dropped. */
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inline = (s: string) =>
  esc(s)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\*([^*]+)\*/g, "<em>$1</em>");

function render(md: string): string {
  const out: string[] = [];
  const lines = md.split("\n");
  let i = 0;
  while (i < lines.length) {
    const l = lines[i];
    if (/^\|/.test(l) && /^\|[\s:|-]+\|$/.test(lines[i + 1] ?? "")) {
      const cells = (r: string) => r.replace(/^\||\|$/g, "").split("|").map((c) => c.trim());
      const head = cells(l);
      const align = cells(lines[i + 1]).map((c) => (c.endsWith(":") ? " class=\"num\"" : ""));
      i += 2;
      const body: string[] = [];
      while (i < lines.length && /^\|/.test(lines[i])) {
        body.push("<tr>" + cells(lines[i]).map((c, n) => `<td${align[n] ?? ""}>${inline(c)}</td>`).join("") + "</tr>");
        i++;
      }
      out.push(
        `<div class="panel" style="margin:10px 0 18px"><table class="tbl"><thead><tr>` +
          head.map((c, n) => `<th${align[n] ?? ""}>${inline(c)}</th>`).join("") +
          `</tr></thead><tbody>${body.join("")}</tbody></table></div>`,
      );
      continue;
    }
    if (/^#{1,3}\s/.test(l)) {
      const d = l.match(/^#+/)![0].length;
      out.push(d === 1 ? "" : `<h${d} class="section">${inline(l.replace(/^#+\s*/, ""))}</h${d}>`);
    } else if (/^\s*[-\d]/.test(l) && /^\s*(-|\d+\.)\s/.test(l)) {
      out.push(`<p class="li">${inline(l.replace(/^\s*(-|\d+\.)\s/, "· "))}</p>`);
    } else if (l.trim()) {
      out.push(`<p class="prose">${inline(l)}</p>`);
    }
    i++;
  }
  return out.join("\n");
}

const utc = (ms: number) => new Date(ms).toISOString().slice(0, 16).replace("T", " ") + " UTC";
---

<Base
  title="Indexation report"
  description="Per-template indexed share, search position and crawler fetches, produced weekly by the ingest worker."
  noindex crumb={{ href: "/status", label: "Status", current: "Indexation" }}>
  <div class="page-head">
    <p class="crumb"><a href="/status">Status</a> › Indexation</p>
    <h1>Indexation report</h1>
    <p>
      Built by the ingest Worker across a few ticks each Monday and stored in KV — no CI, no
      committed file, no extra credential. Search Console lags about two days, so a Monday run
      covers the whole of the previous week.
    </p>
  </div>

  {progress && (
    <div class="verdict verdict--ok">
      <div>
        <b>A run is in progress</b> for {progress.week} — currently in the <code>{progress.phase}</code>
        {" "}phase. A full report is roughly 140 subrequests against a 50-per-invocation ceiling, so it
        walks itself across consecutive five-minute ticks, twenty URLs at a time.
      </div>
    </div>
  )}

  {err && <div class="verdict verdict--warn"><div><b>Snapshot store unreadable.</b> <code>{err}</code></div></div>}

  {doc ? (
    <>
      <p class="section-note">
        {doc.week} · generated {utc(doc.at)} · {Math.round(doc.tookMs / 60000)} min from first tick to last
      </p>
      <div class="report" set:html={render(doc.md)} />
    </>
  ) : !progress && (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">No report yet</p>
        <p class="empty__text">
          The first one is produced on the next Monday after 07:00 UTC. Sections that need a
          credential say so in the report itself and explain how to enable them, rather than being
          quietly absent — the coverage section needs nothing and always runs.
        </p>
      </div>
    </div>
  )}

  <style>
    .report :global(h2) { margin-top: 28px; }
    .report :global(h3) { margin-top: 20px; font-size: 14px; }
    .report :global(.prose) { margin: var(--gap-pair) 0; }
    .report :global(.li) { margin: 4px 0 4px 4px; color: var(--text-dim); max-width: 86ch; }
    .report :global(code) { font-size: 12px; }
  </style>
</Base>
