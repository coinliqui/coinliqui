---
import Base from "../../layouts/Base.astro";
import { getSnapshot, coldStart, findPerp, getLive } from "../../lib/hyperliquid.ts";
import { VENUE_LABEL, pct, usd, rawRate, carryCost, settlementsPerYear, nextSettlement, paysClass, paysLabel, type Venue } from "../../lib/funding.ts";
import { liquidationPrice, type MarginTable, roomVerdict } from "../../lib/margin.ts";
import { getCandles, getM15, getHourly, getFunding } from "../../lib/candles.ts";
import { TIMEFRAMES, DEFAULT_TF, MIN_CHART_BARS, aggregate, buildPriceChart, buildFundingChart, shortDate, CHART_H } from "../../lib/series.ts";
import { CH } from "../../lib/chart.ts";
import tables from "../../data/margin-tables.json";
import { COINS, isLive } from "../../lib/coins.ts";
import { liqMapHref } from "../../lib/routes.ts";
import { qty } from "../../lib/funding.ts";
import { freshness, ageWords, minutesSince } from "../../lib/freshness.ts";
import Overview from "../../components/Overview.astro";
import Figure from "../../components/Figure.astro";
import { extremeBy, standing } from "../../lib/extreme.ts";

import { priceDp, changeWords } from "../../lib/funding.ts";
const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
if (!snap.available) return coldStart();

const wanted = Astro.params.symbol ?? "";
const p = findPerp(snap.perps, wanted);

/* ONE URL PER CONTRACT, whatever case it is asked for.
   Hyperliquid names some contracts kPEPE and kBONK. Matching case-insensitively means
   /funding/KPEPE and /funding/kPEPE both resolve — and, because the canonical tag is built
   from the REQUESTED path, each would declare itself canonical. That is the same
   duplicate-content split the trailing-slash redirect exists to prevent, so it gets the same
   answer: everything that is not the lower-case form is a 301 to it. */
if (p && wanted !== p.symbol.toLowerCase()) {
  return new Response(null, {
    status: 301,
    headers: { location: `/funding/${p.symbol.toLowerCase()}`, "cache-control": "public, max-age=86400" },
  });
}
/* Conditional emission: no entity page below the coverage floor. A thin page is worse than
   none — but an EMPTY 404 body is worse still. A bare `new Response(null, {status: 404})` was
   handed to Astro's stock not-found page: unbranded, no navigation, no explanation, on a URL
   like /funding/crv that a real reader types. Rewritten to the site's own 404, which reads the
   requested symbol back off the request and says why it is not published. */
/* A CONTRACT THAT LEFT COVERAGE IS NOT A URL THAT NEVER EXISTED, and both answered 404. The
   worker records what left and when; this is the only place that knows which question is being
   asked, so the status is decided here. /retired sets 410 — 404.astro cannot, because Astro
   reserves that route and the adapter forces its status. */
if (!p) {
  const retiredAt = await (async () => {
    try {
      const m = ((await env?.SNAPSHOT?.get("published:retired", "json")) ?? null) as Record<string, number> | null;
      if (!m) return null;
      const hit = Object.entries(m).find(([sym]) => sym.toLowerCase() === wanted.toLowerCase());
      return hit && typeof hit[1] === "number" ? hit[1] : null;
    } catch { return null; }
  })();
  return retiredAt
    ? Astro.rewrite(`/retired?symbol=${encodeURIComponent(wanted)}&at=${retiredAt}`)
    : Astro.rewrite(`/404?symbol=${encodeURIComponent(wanted)}`);
}

/* THE SAME RULE AS THE COVERAGE FLOOR, for the same reason. A contract whose tier table is not
   in the committed file cannot have a liquidation price, a maintenance margin or a tier ladder —
   which is most of this page — and the unguarded lookup used to hand `undefined` to tierFor(),
   answering 500 on an indexed URL. Not the sibling pages' fallback either: this page is ABOUT
   this symbol, so quietly rendering a different contract under its heading would be the kBONK
   defect again. See pickPerp in src/lib/hyperliquid.ts. */
const table = (tables as Record<string, MarginTable>)[String(p.marginTableId)];
if (!table) return Astro.rewrite(`/404?symbol=${encodeURIComponent(wanted)}`);
/* If this contract also has a published coin page, the two should know about each other. */
const coin = COINS.find((c) => c.symbol === p.symbol && isLive(c));
const ORDER: Venue[] = ["HlPerp", "BinPerp", "BybitPerp"];
const by = new Map(p.venues.map((v) => [v.venue, v]));
const hl = by.get("HlPerp");
const carry7d = hl ? carryCost(10_000, hl.apr, 7) : NaN;
/* THE LIQUIDATION EXAMPLE WAS DRAWN AT AN ENTRY THE PAGE NEVER PRINTED. It took p.markPx, the
   five-minute snapshot's mark, while the hero shows the one-minute live mark and repaints it every
   pull. Measured 16 September 2026 on https://coinliqui.com/funding/useless (stamped 13:07 UTC):
   "$0.19039 — 20.00% below entry … 10.00% below at $0.21419" works back to an entry of $0.23799,
   and the page showed a mark of $0.23774 and an oracle of $0.23784 — no figure a reader could
   reproduce the dollars from. /funding/trx the same: $0.33471 implied against a $0.33461 mark.
   Now the example is drawn at the mark the hero rendered, and the sentence PRINTS that entry with
   the time it was read. The hero keeps moving after load; the sentence names its own inputs, so a
   repaint cannot make it wrong — it stays a statement about the minute it names. */
const live = await getLive(env?.SNAPSHOT);
const liveMark = live?.mark?.[p.symbol];
const markNow = typeof liveMark === "number" && Number.isFinite(liveMark) ? liveMark : p.markPx;
const markAt = markNow === liveMark && live && Number.isFinite(live.at) ? live.at : snap.fetchedAt;
/* A STAMP NAMES ITS DAY WHEN IT IS NOT TODAY'S. "the Hyperliquid mark at 15:16 UTC" is exact on a
   live key written a minute ago and ambiguous on one the worker last wrote yesterday — the fallback
   to the snapshot, or a candle store two sweeps behind. The date is added only when it differs from
   the render's, so the ordinary sentence stays short and the stale one cannot pass for today's. */
const utcStamp = (t: number) => {
  const iso = new Date(t).toISOString();
  return iso.slice(0, 10) === new Date().toISOString().slice(0, 10)
    ? `${iso.slice(11, 16)} UTC`
    : `${iso.slice(0, 16).replace("T", " ")} UTC`;
};
const liq = liquidationPrice({ entryPrice: markNow, positionSize: 1, leverage: 10, side: "long", table });
/* Not `new Date(hl.nextFundingTime)`. That field sits in the PAST on every Hyperliquid
   contract — see nextSettlement() in src/lib/funding.ts — so this card announced a settlement
   that had already happened, on all 50 contract pages, every hour of every day. */
const nextSettleAt = hl ? nextSettlement(hl.nextFundingTime, hl.intervalHours) : null;

/* =========================================================================================
   THE ANSWER, IN ONE SENTENCE, AT THE TOP — because this template is what the AI assistants
   actually fetch, and it was not leading with the thing it is named after.

   MEASURED 31 August 2026 over 23.5 hours of verified Cloudflare bot traffic: ChatGPT-User
   made 392 verified fetches of this site and 275 of them — 70% — landed on
   /funding/{symbol}, across 36 different contracts. Not the hub, not the homepage: the long
   tail of individual coins. Somebody asks an assistant what a coin's funding rate is, and the
   assistant comes here.

   WHAT IT FOUND WHEN IT ARRIVED. The first 900 characters of this page, tags stripped, read:
   price, twelve-month change, period high, period low, period volume, oracle index, open
   interest, max leverage, then a paragraph about where each of those comes from. The funding
   rate — the first noun in this page's own <title> — was not in them. An extractor will still
   find it further down; one that truncates answers with the price instead.

   SO THIS IS A SENTENCE, NOT A FIGURE. Everything in it is already on the page; what it adds
   is that the number, its unit, its venue, its settlement interval and the time it was read
   sit in one liftable clause. That is the shape a citation takes.

   ANNUALISED, AND IT SAYS SO. The venues quote a rate per settlement and settle on different
   intervals — hourly on Hyperliquid, four or eight hours elsewhere — so the quoted numbers are
   not comparable and the annualised ones are. Stating the APR without saying it is an APR
   would be the same trap the whole site exists to point out.
   ========================================================================================= */
const quotable = (() => {
  const live = ORDER.map((v) => ({ v, f: by.get(v) })).filter((x) => x.f && Number.isFinite(x.f.apr));
  if (!live.length) return null;
  const lead = live[0];
  const rest = live.slice(1);
  /* ASSEMBLED HERE, NOT IN THE MARKUP. Adjacent JSX expressions on separate lines render a
     whitespace text node between them, so a version built out of {…} fragments produced
     "settlement , against" and "(8h) ." — a stray space before a comma, in the one sentence on
     this page written to be quoted verbatim. The markup below splits the string only where an
     element is genuinely needed, and those splits sit on one line. */
  const head = `${p.symbol} funding on ${VENUE_LABEL[lead.v]} is ${pct(lead.f!.apr)} a year`;
  const interval = Number.isFinite(lead.f!.intervalHours) ? ` at its ${lead.f!.intervalHours}-hour settlement` : "";
  const others = rest.length
    ? `, against ${rest.map((x) => `${pct(x.f!.apr)} on ${VENUE_LABEL[x.v]}${Number.isFinite(x.f!.intervalHours) ? ` (${x.f!.intervalHours}h)` : ""}`).join(" and ")}`
    : "";
  return {
    head,
    tail: `${interval}${others}. Annualised, because the venues settle on different intervals and their quoted rates are not comparable until they are. Read at `,
    stamp: `${new Date(snap.fetchedAt).toISOString().slice(0, 16).replace("T", " ")} UTC`,
    iso: new Date(snap.fetchedAt).toISOString(),
  };
})();
const nextFunding = nextSettleAt ? new Date(nextSettleAt) : null;

const dp = priceDp(p.markPx);
const px = (v: number) => usd(v, dp);

/* ---------------------------------------------------------------------------------------
   THE CHART

   Timeframe switching is a GET form of submit buttons, not links. Crawlers do not submit
   forms, so one contract stays exactly one URL — no ?tf= variants discovered, no crawl
   budget split four ways, nothing to consolidate with canonicals afterwards. Without JS the
   buttons submit and the server renders that timeframe; with JS the click is intercepted,
   the pre-rendered panel swaps in instantly and the URL is cleaned.
   --------------------------------------------------------------------------------------- */
const tfKey = TIMEFRAMES.some((t) => t.key === Astro.url.searchParams.get("tf")) ? Astro.url.searchParams.get("tf")! : DEFAULT_TF;
const [dayset, hourset, m15set, funding] = await Promise.all([
  getCandles(env?.SNAPSHOT, p.symbol, import.meta.env.DEV),
  getHourly(env?.SNAPSHOT, p.symbol, import.meta.env.DEV),
  getM15(env?.SNAPSHOT, p.symbol, import.meta.env.DEV),
  getFunding(env?.SNAPSHOT, p.symbol, import.meta.env.DEV),
]);
/* HOW FAR THE STORED FUNDING SERIES ACTUALLY GOES, read from the series rather than from
   whichever bar of the current panel happens to carry the first funding value. */
const fundingSeriesFrom = funding && funding.length ? Math.min(...funding.map((f) => f[0])) : null;

/* ========================================================================================
   WHAT THIS CONTRACT'S FUNDING IS DOING — the page's own subject, stated before its price.

   WHAT THE READER WALK FOUND. This template is the most-fetched on the site and the one an
   assistant lands on for "BTC funding rate". Read cold at 375px, the largest thing on it by a
   wide margin was $75,892.00, under it the 24-hour change, then period high, period low, period
   volume, oracle index, open interest and max leverage — seven figures, none of them funding.
   The rate itself was a clause inside a five-line paragraph that never said WHO PAYS, and the
   section that does say it sat at y=1996, two and a half screens down.

   THE MAGNITUDE NOW CARRIES ITS OWN CONTEXT. "10.95% a year" is a readout: nobody can judge it
   without remembering the last month. standing() ranks it against the hourly series this page
   has ALREADY loaded to draw the band under the candles — no extra read, no new store — so the
   sentence can say whether this is a normal reading for this contract or an unusual one. The
   series length is printed with it, because a percentile over eleven readings is not a month.

   AND THE COMPARISON IS TIE-AWARE. Three venues can and do publish identical rates; naming a
   "dearest" out of a tie is the defect src/lib/extreme.ts exists to make unspellable. */
const venueRates = ORDER.map((v) => ({ v, f: by.get(v) })).filter((x) => x.f && Number.isFinite(x.f.apr));
const dearestVenue = extremeBy(venueRates, (x) => x.f!.apr, "max");
const cheapestVenue = extremeBy(venueRates, (x) => x.f!.apr, "min");
/* THE RANGE ACROSS VENUES, WORDED FROM WHAT THE RATES ACTUALLY DO — not from whether the top is tied.
   The first version printed "All 2 venues publish the same annualised rate right now" whenever the
   HIGHEST rate was tied: on /funding/zec, 16 September 2026, Hyperliquid and Bybit shared 10.95% while
   Binance sat at −11.85% and the page's own spread card read 22.80%. A tie at the top is not
   agreement, and when the tie was at the bottom the sentence vanished. Confirmed three votes to none.
   So: every venue equal → say so, with the real count; otherwise state the range from the lowest to
   the highest, naming a venue only where that end is unique. */
const venueSpan = (() => {
  if (venueRates.length < 2 || dearestVenue.kind === "none" || cheapestVenue.kind === "none") return null;
  if (Math.abs(dearestVenue.value - cheapestVenue.value) <= 1e-9) return { kind: "same" as const, n: venueRates.length };
  const name = (e: typeof dearestVenue) =>
    e.kind === "unique" ? `on ${VENUE_LABEL[e.item.v]}` : e.kind === "tied" ? `on ${e.items.map((x) => VENUE_LABEL[x.v]).join(" and ")}` : "";
  return { kind: "range" as const, lo: cheapestVenue.value, hi: dearestVenue.value, loOn: name(cheapestVenue), hiOn: name(dearestVenue) };
})();
/* The last 30 days of hourly readings, which is the window a trader holds in mind. Short series
   are reported at their real length rather than padded to look like a month. */
const HIST_WINDOW_MS = 30 * 86_400_000;
const recentFunding = (funding ?? [])
  .filter((f) => f[0] >= Date.now() - HIST_WINDOW_MS && Number.isFinite(f[1]))
  .map((f) => f[1] * 8760);
const hlStanding = hl && Number.isFinite(hl.apr) ? standing(recentFunding, hl.apr) : null;
const histDays = recentFunding.length ? Math.max(1, Math.round(recentFunding.length / 24)) : 0;
/* THE WORDING OF THE COMPARISON, DECIDED HERE RATHER THAN IN THE MARKUP — a `<=` inside a JSX
   ternary is read by the Astro compiler as the start of a tag (astro(1002)), so comparisons live in
   the frontmatter.

   THREE COUNTS, NOT A RANK, AND THE RANK IS WHAT SHIPPED WRONG. This sentence used to pick between
   "higher than all but N", "lower than all but N" and "above X%", all computed from readings
   strictly below. On /funding/btc it printed "above 28.57% of the 714 hourly readings" for a rate
   that EQUALLED roughly two-thirds of them — the month's usual reading presented as sitting in its
   lower third. Confirmed three votes to none by the claim-vs-table audit on 16 September. A rank is
   the wrong summary of a series that mostly rests on one value; the counts are the summary, they
   need no percentile literacy, and they add up to the total a reader can check.

   THE ORDER FOLLOWS WHAT IS TRUE. When the rate is the month's most common reading that is the
   fact worth leading with; when nothing was higher, or nothing lower, that is. Otherwise the three
   counts are stated plainly. */
const nf0 = (n: number) => n.toLocaleString("en-US");
/* THE PLURAL FOLLOWS THE COUNT. histDays is round(readings / 24), so a contract with 24–35 hourly
   readings — past the floor of 24 below — rendered "the last 1 days". */
const lastDays = histDays === 1 ? "the last day" : `the last ${histDays} days`;
const standingWords = hlStanding && hlStanding.of >= 24
  ? hlStanding.equal > hlStanding.below && hlStanding.equal > hlStanding.above
    ? `It has been exactly this on ${nf0(hlStanding.equal)} of the ${nf0(hlStanding.of)} hourly readings of ${lastDays} — higher on ${nf0(hlStanding.above)}, lower on ${nf0(hlStanding.below)}.`
    : hlStanding.above === 0
      ? `No hourly reading in ${lastDays} was higher: it was lower on ${nf0(hlStanding.below)} of ${nf0(hlStanding.of)} and the same on ${nf0(hlStanding.equal)}.`
      : hlStanding.below === 0
        ? `No hourly reading in ${lastDays} was lower: it was higher on ${nf0(hlStanding.above)} of ${nf0(hlStanding.of)} and the same on ${nf0(hlStanding.equal)}.`
        : `Over ${lastDays} it was lower on ${nf0(hlStanding.below)} of ${nf0(hlStanding.of)} hourly readings, the same on ${nf0(hlStanding.equal)} and higher on ${nf0(hlStanding.above)}.`
  : null;
/* THE HERO NUMBER ON THIS TEMPLATE IS A PERPETUAL MARK, AND IT SAID SO NOWHERE.
   Fifty pages, the site's highest-traffic template, and the biggest figure on each was
   p.markPx with nothing beside it naming what it is — while the sibling coin page put the
   SAME figure under an explicit "Perpetual mark" label and led with spot instead. A reader
   arriving from a price search had no way to tell the two apart, and they differ by the
   basis. So this page now names its own number, and where a coin page exists it shows that
   page's number too, labelled, with the gap between them — the mirror image of what the coin
   page already does. */
/* THE SPOT COMPARISON AND THE BASIS ARE GONE FROM THIS PAGE TOO.
   The long note that stood here explained how to keep a subtraction on one clock: mark from the
   one-minute `live` key rather than the five-minute snapshot, because the SIGN of a basis is its
   meaning and a stale numerator inverts rather than blurs it. That reasoning was right and it no
   longer has anything to operate on — the spot half came from Coinbase, whose Market Data Terms
   (https://www.coinbase.com/legal/market_data) were read in full on 19 August 2026 and forbid
   displaying the data or anything derived from it.
   See the header of src/lib/coins.ts.

   What survives from that work is the reason to prefer live.mark over the snapshot, which is the
   same reason the coin pages do: the headline price and the funding beside it should be read off
   one tick. `live` and `markNow` are read near the top now, because the margin-tier example is
   drawn at the same mark — see the note at `liq`. */
const fresh = freshness(live?.at, snap.fetchedAt,
  "Mark price and funding update every minute.", "Mark price and funding");

/* ONE PANEL IS BUILT, NOT SIX.
 *
 * Every timeframe used to be rendered into the HTML so that switching was a CSS class toggle
 * with no request. Measured, that cost 50,454 bytes on the wire of a 70,845-byte page — 71% of
 * the document — on all fifty contract pages, which are the entire indexed surface.
 *
 * And it was not buying the no-JS path, which is the reason it looked untouchable. The buttons
 * are form submits: without JavaScript they navigate to ?tf=4h and the server renders that
 * timeframe, with the canonical still pointing at the bare URL. What the extra panels bought was
 * INSTANT switching for a reader already on the page. Page weight is a ranking input; instant
 * switching is a convenience. So the panels are fetched on demand now, and prefetched on hover
 * so the convenience survives anyway.
 *
 * Availability is decided WITHOUT building a chart — a base series either has enough candles or
 * it does not, and asking that question costs a length check rather than an SVG. That matters:
 * the button bar must still offer every timeframe that has data, and it would be a poor trade to
 * build six charts just to find out which six buttons to draw. */
const baseFor = (tf: (typeof TIMEFRAMES)[number]) =>
  (tf.base === "m15" ? m15set?.d : tf.base === "hour" ? hourset?.d : dayset?.d);
/* AVAILABILITY IS TESTED ON WHAT WILL BE DRAWN, not on the series it is drawn from. See
   MIN_CHART_BARS in src/lib/series.ts for the defect this replaced. */
const barsFor = (tf: (typeof TIMEFRAMES)[number]) => {
  const b = baseFor(tf);
  return b ? aggregate(b, tf.factor).slice(-tf.bars).length : 0;
};
const offered = TIMEFRAMES.filter((tf) => barsFor(tf) >= MIN_CHART_BARS);

/* ONLY OFFER TIMEFRAMES THAT EXIST.
   The two candle series are collected on separate cadences, so a contract that has just
   entered coverage can hold hourly bars and no daily ones for a while. Previously the bar
   rendered all four buttons regardless: pressing one that had no data selected it, showed no
   panel at all, and dropped every hero figure to "—". A control for something that is not
   there is worse than its absence — so the bar lists what exists, an unavailable request
   falls back instead of emptying the page, and the gap is stated rather than left to be
   inferred from a missing button. */
const activeTf = offered.find((tf) => tf.key === tfKey) ?? offered[0];
/* The candle store stamps its own write time; the page can therefore say how old the period
   figures are instead of borrowing the snapshot's age, which is a different clock entirely. */
const candleWrittenAt = activeTf
  ? ((activeTf.base === "m15" ? m15set?.u : activeTf.base === "hour" ? hourset?.u : dayset?.u) ?? null)
  : null;
/* THE CANDLE CLOCK TRAVELS WITH THE TIMEFRAME, AND IT IS A TIME, NOT AN AGE. The clause was plain
   text in p.clock — on http://localhost:4322/funding/trx, 16 September 2026, served on 1D: "collected
   every 12 hours and last written 0 min ago" — and the timeframe switch in public/interact.js
   carries only [data-tfstat] text from the fetched render (the name-paired copy into data-v* slots,
   then apply()). So pressing 1H brought the hourly period change, high, low and volume under a
   sentence still naming the daily series' 12-hour cadence and its write, while the ?tf=1h render of
   the same page names a 2-hour one. And the age was server text that never ticks, beside a snapshot
   age that does (data-fresh), so the two drift apart for as long as the tab stays open. Both halves
   are now [data-tfstat] elements, carried by name with the figures they describe, and the write is
   printed as the minute it happened: a stamp stays true after load, which an un-ticked age cannot.
   Both render in every charted state, even with no stamp, because a fetched render that lacks a
   named stat leaves the previous timeframe's text standing. Checked in the browser the same day:
   1D reads "every 12 hours", pressing 1H turns it to "every 2 hours", pressing 1D turns it back. */
const candleCadence = activeTf && activeTf.base !== "day" ? "every 2 hours" : "every 12 hours";
const candleWritten = candleWrittenAt ? utcStamp(candleWrittenAt) : "an unrecorded time";
const activeChart = activeTf
  ? buildPriceChart(aggregate(baseFor(activeTf)!, activeTf.factor).slice(-activeTf.bars), funding, activeTf, "candle", { band: false })
  : null;
const active = activeTf && activeChart ? { tf: activeTf, chart: activeChart } : null;

/* THE HERO CHANGE NOW NAMES BOTH ENDS, AND THE FIRST END IS THE FIRST BAR'S OPEN.
   It printed chart.change — last candle close over FIRST CLOSE — beside the live mark, with nothing
   saying so. Measured 16 September 2026 on https://coinliqui.com/funding/useless (stamped 13:07
   UTC): "$0.23774 ▼ 15.68% over 9 daily bars". 15.68% is exactly $0.24021 ÷ $0.28489, a candle
   written 191 minutes earlier against the first bar's close; the mark beside it gives −16.55%
   against that close and −21.66% against the first open ($0.30348). Two faults: the pairing with a
   price the figure was not measured to, and "over 9 bars" measuring only eight of them.

   WHY NOT MEASURE IT TO THE MARK. The mark repaints every minute and the change would have to
   repaint with it; the overlay can (data-repaint="chgmark"), but its base is a fixed data-prev,
   and a timeframe switch in public/interact.js carries only the TEXT of a data-tfstat element —
   so after one switch the next pull would recompute against the previous timeframe's base. So
   the figure is measured candle to candle, from the first open to the last close, and both prices
   are printed in the span beside it. Nothing repaints either end, the switch carries the words
   with the number, and the reader can check it without the table — which holds only the last 200
   rows, so on /funding/trx (220 daily bars) the first open is not in it at all. */
const periodMove = (() => {
  const pts = active?.chart.points;
  if (!pts || !pts.length) return null;
  const open = pts[0][2], close = pts[pts.length - 1][5];
  return Number.isFinite(open) && open > 0 && Number.isFinite(close) ? { open, close, change: close / open - 1 } : null;
})();
/* THE NO-CHART FALLBACK, ON THE SAME CLOCK AS THE PRICE BESIDE IT. p.change24h is the SNAPSHOT
   mark over prevDayPx; the hero prints the live mark. With no chart there is no timeframe switch,
   so here the change can be measured to the mark and repaint with it. */
const change24Now = p.prevDayPx > 0 ? markNow / p.prevDayPx - 1 : NaN;

/* THE FUNDING FIGURE, ON ITS OWN AND ABOVE THE PRICE — see buildFundingChart in
   src/lib/series.ts for what it replaces and why. Pinned to the daily series over 90 days rather
   than following the timeframe switcher: the switcher exists for the price chart, one funding
   picture per offered timeframe would put eight more SVGs on the heaviest template on the site
   for a question nobody asks eight ways, and ninety daily means is the window in which a funding
   regime is legible at all. */
const FUND_DAYS = 90;
const dayTf = TIMEFRAMES.find((t) => t.key === "1d")!;
const fundChart = dayset?.d && dayset.d.length >= MIN_CHART_BARS
  ? buildFundingChart(dayset.d.slice(-FUND_DAYS), funding, dayTf)
  : null;
/* THE DAY COUNT TAKES ITS NOUN FROM THE COUNT, as the band note below learned to. fundChart.bars is
   the number of days CARRYING funding, not the window: buildFundingChart keeps a figure whose
   coverage clears 6% of at least MIN_CHART_BARS days, so a contract with 6–16 daily bars and one day
   of stored funding draws exactly one point — and the lead note read "1 days drawn" above a note
   saying "Over these 1 days the rate ran from X to X". Read from the code on 16 September 2026: none
   of the 45 local contract pages rendered at 15:26–15:35 UTC sits there (77 or 90 days each), which
   is why it is decided here once rather than left to be met. */
const fundDays = fundChart ? `${fundChart.bars} ${fundChart.bars === 1 ? "day" : "days"}` : "";
const hasChart = Boolean(active);
/* WHETHER THE PRICE CHART DREW A FUNDING BAND, read off the chart's own aria-label — which
   buildPriceChart words from the same fundOn that decides the drawing — rather than restated here
   from the band:false above plus a copy of its coverage threshold. See the legend. */
const bandDrawn = Boolean(active?.chart.svg.includes('aria-label="Price, volume and funding history"'));
const fundedBars = active ? active.chart.points.filter((q) => Number.isFinite(q[7])).length : 0;
const missingTf = TIMEFRAMES.filter((tf) => !offered.some((o) => o.key === tf.key)).map((tf) => tf.label);
/* A CHAIN OF TERNARIES ENDING IN "weekly bars" IS A DEFAULT THAT LIES. Adding 12H and 1M made
   it say "over 90 weekly bars" on the 12-hour panel — rendered, on the live page, because a
   fall-through default answers confidently for any key it has never heard of. A lookup with an
   explicit fallback to the timeframe's own label cannot invent a unit it was not given. */
/* The fallback is honest and still terse: with no daily series the page falls to 15m, and the hero
   read "over 300 15m bars, $76,796.00 open to $75,684.00 close" (http://localhost:4322/funding/btc,
   16 September 2026). The two intraday keys now carry words like the rest. */
const SPAN: Record<string, string> = {
  "15m": "15-minute bars", "30m": "30-minute bars",
  "1h": "hourly bars", "4h": "4-hour bars", "12h": "12-hour bars",
  "1d": "daily bars", "1w": "weekly bars", "1m": "monthly bars",
};
const span = (k: string) => SPAN[k] ?? `${(TIMEFRAMES.find((t) => t.key === k)?.label ?? k)} bars`;

/* THE TOKEN-QUANTITY RULE WAS IMPLEMENTED INLINE HERE — a third copy, and the one interact.js
   was swept against by the gate. It is qty() in public/shared.js now, the same function the
   browser calls, and the call sites below name it directly rather than aliasing it: an alias
   is a second name for one thing, which is the smaller version of the problem this fixed. */
/* STATS NO LONGER TRAVEL AS PRE-COMPUTED ATTRIBUTES. They used to be emitted as data-v1h,
   data-v4h … on every stat element, one value per timeframe, so a switch could rewrite them
   without a request. With one panel in the page there is nothing to precompute from — the
   fetched document carries its own stats, and interact.js lifts them from there. Keeping the
   attributes would mean building all six charts again, which is the cost this change removes. */
const stat = (_fn: (c: { tf: (typeof TIMEFRAMES)[number]; chart: NonNullable<typeof activeChart> }) => string) => ({});

const rows = active ? active.chart.points.slice(-200) : [];
const title = `${p.symbol} funding rate, perpetual price and margin tiers`;
/* THE DESCRIPTION NAMED THREE VENUES ON PAGES THAT RENDER ONE. HYPE and PURR trade on
   Hyperliquid alone, PUMP and CASHCAT on two — and all four told a search result they compared
   "Hyperliquid, Binance and Bybit annualised side by side". A meta description is the one piece
   of copy quoted without the page beside it to correct it, so it now names the venues this
   contract actually has. The timeframe range is derived too: it said "1H to 1W" while the bar
   offers 1H to 1M. */
const venueNames = p.venues.filter((v) => Number.isFinite(v.apr)).map((v) => VENUE_LABEL[v.venue as Venue] ?? v.venue);
const venuePhrase = venueNames.length > 1
  ? `funding across ${venueNames.slice(0, -1).join(", ")} and ${venueNames[venueNames.length - 1]} annualised side by side`
  : `funding on ${venueNames[0] ?? "its venue"}, annualised`;
const tfSpan = offered.length ? `${offered[0].label} to ${offered[offered.length - 1].label}` : "several timeframes";
/* THE ONE FIGURE ONLY THIS PAGE HAS SAT PAST THE TRUNCATION. Measured on 20 August: the fifty
   contract descriptions run 190–230 characters and a result snippet shows roughly 155, so the
   open-interest number — the only part of the sentence that is specific to this contract and to
   today — was cut off every time, leaving fifty snippets that differed only by a ticker. Moved
   to the front. The sentence is still longer than the snippet; that is fine, because what gets
   dropped now is the generic tail rather than the distinguishing number. */
const description = `What a ${p.symbol} perpetual costs to hold, against ${usd(p.oiNotional)} of open interest: ${venuePhrase}, the price chart from ${tfSpan}, and the published margin tiers.`;
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt} crumb={{ href: "/funding", label: "Funding", current: p.symbol }}>
  <div class="page-head">
    <p class="crumb"><a href="/funding">Funding</a> › {p.symbol}</p>
    <h1>{p.symbol} perpetual</h1>
    {/* DIRECTION, MAGNITUDE, CONTEXT, COST — then the price. The extractor gate at
        scripts/verify-live.mjs asks this URL's first 700 characters for the word funding, a rate
        as a percentage, the venue it belongs to and a UTC timestamp; all four are below. */}
    {hl && Number.isFinite(hl.apr) && (
      <Overview>
        {/* THE WORD "FUNDING" IS IN THE SENTENCE ON PURPOSE. The extractor gate asks this URL's
            opening for it, and the first draft passed only because the breadcrumb above says
            "Funding › BTC" — a check satisfied by chrome rather than by the answer is a check
            that will pass the day the answer stops containing what it is about. It is also the
            query this template is named after, so it belongs in the claim either way. */}
        On {VENUE_LABEL["HlPerp"]}, <b>{p.symbol} funding is {pct(Math.abs(hl.apr))} a year</b>{Number.isFinite(hl.intervalHours) ? (hl.intervalHours === 1 ? ", settled hourly" : `, settled every ${hl.intervalHours} hours`) : ""}, and <b>{paysLabel(hl.apr)}</b>.
        {standingWords && <>{" "}{standingWords}</>}
        {/* EVERY SPACE AFTER AN EXPRESSION IS A {" "}. Inside a fragment in an expression the compiler
            drops a whitespace-only run between an expression and the next node, so these read
            "long costs$21.00" and "from 5.76%on Binance to 10.95%on Hyperliquid" (measured 16 September
            2026 on http://localhost:4322/funding/btc). A literal cannot be dropped. */}
        {Number.isFinite(carry7d) && <>{" "}Holding $10,000 long {carry7d < 0 ? "pays you" : "costs"}{" "}<b>{usd(Math.abs(carry7d), 2)}</b> a week at this rate.</>}
        {venueSpan?.kind === "range" && <>{" "}Across venues it runs from {pct(venueSpan.lo)}{" "}{venueSpan.loOn} to{" "}{pct(venueSpan.hi)}{" "}{venueSpan.hiOn}, annualised so the different settlement intervals are comparable.</>}
        {venueSpan?.kind === "same" && <>{" "}All {venueSpan.n} venues publish the same annualised rate right now.</>}
        {" "}Read at <time datetime={new Date(snap.fetchedAt).toISOString()}>{new Date(snap.fetchedAt).toISOString().slice(0, 16).replace("T", " ")} UTC</time>.
      </Overview>
    )}
    {quotable && !(hl && Number.isFinite(hl.apr)) && (
      <p class="answer">
        {/* ONE LINE, because adjacent expressions on separate lines render a space between
            them — see the note where this string is assembled. */}
        <strong>{quotable.head}</strong>{quotable.tail}<time datetime={quotable.iso}>{quotable.stamp}</time>{"."}
      </p>
    )}
  </div>

  {/* THE LEAD IS UNSIGNED, WITH THE DIRECTION IN WORDS UNDER IT — the same convention the
      sentence above uses. Signed here and unsigned there, the page read "TRUMP funding is 40.35%
      a year … shorts pay longs" above a figure headed "−40.35%": one fact stated twice in two
      notations, which invites a reader to look for the disagreement between them. The minus sign
      is a convention they have to have been taught; "shorts pay longs" is not. */}
  {fundChart && (
    <Figure
      title={`${p.symbol} funding on Hyperliquid, annualised`}
      lead={hl && Number.isFinite(hl.apr) ? pct(Math.abs(hl.apr)) : undefined}
      leadNote={hl && Number.isFinite(hl.apr)
        ? `${paysLabel(hl.apr)} right now \u00b7 ${fundDays} drawn`
        : `${fundDays} drawn`}
      fetchedAt={snap.fetchedAt}>
      <Fragment set:html={fundChart.svg} />
      <p slot="note">
        Amber above the line is <b>longs paying shorts</b>, cyan below is <b>shorts paying longs</b>;
        the line itself is zero, where neither side pays. Each point is the mean of one day, from
        Hyperliquid's own hourly settlements.{fundChart.bars === 1
          ? <>{" "}On the 1 day drawn the rate was <b>{pct(fundChart.hi)}</b> a year.</>
          : <>{" "}Over these {fundChart.bars} days the rate ran from <b>{pct(fundChart.lo)}</b> to <b>{pct(fundChart.hi)}</b> a year.</>}
        {/* THE CLIP IS DESCRIBED ONLY WHEN IT CLIPPED. On a young contract the 96th percentile and the
            maximum are the same reading, and the note printed "±100.45%, the 96th percentile rather
            than the maximum" beside "ran from … to 100.45%" — found on /funding/useless by the
            audit's completeness critic. */}
        {fundChart.clipped > 0
          ? <>{" "}The axis is drawn to &plusmn;{pct(fundChart.max)}, the 96th percentile rather than
            the extreme, because one spike otherwise flattens the whole shape onto the line &mdash;
            {" "}<b>{fundChart.clipped}</b>{fundChart.clipped === 1 ? " day sits beyond it and is" : " days sit beyond it and are"} drawn at the edge.</>
          : <>{" "}The axis is drawn to &plusmn;{pct(fundChart.max)}, which reaches every day shown.</>}
      </p>
    </Figure>
  )}

  {/* THE LABEL NAMES THE PRICE FROM ABOVE IT, NOT FROM THE END OF THE PERIOD PHRASE. It closed the
      span as "· Hyperliquid perpetual mark", straight after the candle close the period phrase now
      prints. Measured 16 September 2026 at 375×812 on http://localhost:4322/funding/pons (mark
      $0.57919): the span broke as "over 17 daily bars, $0.33777 open to $0.57893" / "close ·
      Hyperliquid perpetual mark" — the $0.57893 CANDLE close read as the mark, and minutes earlier
      the break fell before the "·" so the second line opened on the separator. Where it broke
      followed the price digits, so no nbsp or display rule placed it for every price. Out of the
      span there is no separator to strand and no price for the label to sit beside but the one it
      names — the label-above-value form the Period high/low row under it already uses. */}
  <div class="hero__label">Hyperliquid perpetual mark</div>
  <div class="hero">
    <span class="hero__price" data-repaint="mark" data-sym={p.symbol} data-dp={dp}>{px(markNow)}</span>
    {/* THE FALLBACK BRANCH HAD NO FINITENESS GUARD, and it is the branch that only runs on a
        contract with no chart yet — i.e. one that just entered coverage, which is exactly when
        change24h is most likely to be absent. Every sibling figure on this page guards; this one
        rendered "▼ NaN%". Uses changeWords() from public/shared.js now, which returns the em
        dash for a non-number like every other cell does. See `periodMove` for what the charted
        branch measures and why it is not the live mark. */}
    <span class="hero__chg" data-tfstat="change" data-group="px"
          data-repaint={active ? undefined : "chgmark"} data-sym={active ? undefined : p.symbol} data-prev={active ? undefined : p.prevDayPx}>
      {active ? changeWords(periodMove?.change ?? NaN) : changeWords(change24Now)}
    </span>
    {/* Each price is bound to its noun with a no-break space, so a wrap cannot leave "close" alone
        on a line under a number it belongs to. textContent keeps U+00A0 through a timeframe switch. */}
    <span class="hero__span"><span data-tfstat="bars" data-group="px">{active
        ? `over ${active.chart.bars} ${span(active.tf.key)}${periodMove ? `, ${px(periodMove.open)} open to ${px(periodMove.close)} close` : ""}`
        : "24-hour change"}</span></span>
  </div>

  <div class="hero__meta">
    <div>Period high<b data-tfstat="high" data-group="px" {...stat((c) => px(c.chart!.high))}>{active ? px(active.chart.high) : "—"}</b></div>
    <div>Period low<b data-tfstat="low" data-group="px" {...stat((c) => px(c.chart!.low))}>{active ? px(active.chart.low) : "—"}</b></div>
    <div>Period volume<b data-tfstat="volume" data-group="px" {...stat((c) => qty(c.chart!.volume) + " " + p.symbol)}>{active ? qty(active.chart.volume) + " " + p.symbol : "—"}</b></div>
    <div>Oracle index <span class="scope">Hyperliquid</span><b>{p.oraclePx > 0 ? px(p.oraclePx) : "—"}</b></div>
    <div>Open interest <span class="scope">Hyperliquid</span><b>{usd(p.oiNotional)}</b></div>
    <div>Max leverage<b>{p.maxLeverage}×</b></div>
  </div>
  {/* THREE CLOCKS, NOT TWO. This sentence put "open interest, volume and the period figures"
      on one clock — the five-minute snapshot. Open interest and 24-hour volume do come from
      there. The PERIOD figures do not: Period high, low and volume are read off active.chart,
      which is built from the candle store, and that store is swept every 2 hours for the
      hourly series and every 12 for the daily one. So a page could say "taken 2 min ago" over
      a period high that was hours old. The figures were right; the sentence explaining where
      they came from was not, on the template whose whole argument is that it names its
      sources. Each clock now states its own cadence. */}
  {/* IT NAMED A FIGURE THIS PAGE DOES NOT SHOW. "Open interest and 24-hour volume come from the
      snapshot" was copied from the coin template, which prints a 24-hour volume; this block prints
      Period volume, a candle sum the next sentence rightly credits to the candle series. Measured
      16 September 2026 on https://coinliqui.com/funding/trx: six figures (period high, low and
      volume, oracle index, open interest, max leverage), no 24-hour volume anywhere in the HTML.
      The snapshot sentence now lists the three block figures that do come from the snapshot, and
      the candle sentence adds the period change beside the hero, which was read from there all
      along and not credited. */}
  {/* WITH NO CHART THERE IS NO "CHART BEHIND" AND NO CADENCE TO VOUCH FOR. The chartless branch
      said the period figures "are read from the candle series behind the chart, collected every 12
      hours" above three dashes and no chart — measured 16 September 2026 on
      http://localhost:4322/funding/mon, where `offered` is empty. It now says why the figures are
      dashes: no timeframe reaches MIN_CHART_BARS, which is the very condition that empties `offered`,
      so the words and the dashes are decided by one test. See `candleCadence` for the charted branch. */}
  <p class="clock">
    {fresh.note} The oracle index, open interest and max leverage come from the
    snapshot taken <b><time data-fresh={snap.fetchedAt} data-clock="snapAt">{ageWords(minutesSince(snap.fetchedAt))}</time></b>.
    {active
      ? <>The period change, high, low and volume are read from the candle series behind the chart, collected <span data-tfstat="cadence" data-group="px">{candleCadence}</span> and last written at <b data-tfstat="written" data-group="px">{candleWritten}</b>;</>
      : <>The period high, low and volume come from the candle series, which has not yet given this page enough bars to chart;</>}
    {" "}margin tiers are published by the venue and change only when it changes them.
  </p>

  {hasChart ? (
    <>
      <form method="GET" class="tfbar" data-tfgroup="px">
        <div class="tf" role="group" aria-label="Chart timeframe">
          {offered.map((tf) => (
            <button type="submit" name="tf" value={tf.key} data-tf={tf.key} aria-pressed={tf.key === active!.tf.key}>{tf.label}</button>
          ))}
        </div>
        <span class="tfbar__note">
          Real traded candles only — Hyperliquid's pre-launch backfill carries zero volume and is excluded.
          {missingTf.length > 0 && (
            <> {missingTf.join(" and ")}{" "}{missingTf.length === 1 ? "is" : "are"} not offered: there is not
            yet enough history to draw {missingTf.length === 1 ? "it" : "them"} — fewer than {MIN_CHART_BARS} bars
            at that size. Either this contract entered coverage recently or it has not existed long enough,
            and the series behind it is still filling.</>
          )}
        </span>
      </form>

      {[active!].map(({ tf, chart }) => (
        <div data-tfpanel={tf.key} data-group="px" data-on="" class="chart chart--price"
             style={`--chartRatio: ${CH.w} / ${CHART_H}`}>
          <Fragment set:html={chart.svg.replace("<svg ",
            `<svg data-xhair="pts-${tf.key}" data-feed="mark" data-plot="${chart.plot.join(",")}" data-prange="${chart.range[0]},${chart.range[1]}" ` +
            `data-axx="${chart.axisX}" data-slot="${chart.slot.toFixed(2)}" data-taxisy="${CHART_H - 27}" data-unit="${p.symbol}" data-dp="${chart.dp}" data-intraday="${tf.hours < 24 ? 1 : 0}" `)} />
          <script type="application/json" id={`pts-${tf.key}`} set:html={JSON.stringify(chart.points)} />
        </div>
      ))}

      <p class="legend">
        <b>Candles</b> are green for up and red for down. The up candles are <b>hollow</b>, which is
        the older convention and the one that matters here: simulated for protanopia the two candle
        colours separate by very little, so the body carries the direction when the hue cannot.
        {/* THE LEGEND DESCRIBED A BAND THIS CHART NO LONGER DRAWS. The price chart is built with
            band:false since funding got its own figure above, and the legend went on explaining "the
            band under the volume histogram", its shading and its scale — measured 16 September 2026
            on http://localhost:4322/funding/trx?tf=1w: the svg labelled "Price and volume history",
            no polygon or polyline in it, and the legend reading "1 bar exceeds it and is drawn at the
            edge" about a band that is not there. The branch now follows the chart's own label, which
            series.ts derives from the same fundOn that decides whether the band is drawn, so the
            words cannot outlive the picture in either direction. */}
        {bandDrawn ? (
          <> The band under the volume histogram is a different language and a different pair —
          <b class="pays-l">amber where longs pay shorts</b> and <b class="pays-s">cyan where shorts
          pay longs</b>, deliberately not the candle colours, so one screen never says two things with
          one pair. It sits on the same time axis as the price, and it is the reason this chart is not
          the one everybody else draws.</>
        ) : (
          <> Funding is not drawn on this chart{fundChart ? " — it has its own figure above, on the daily series" : ""}.{fundedBars > 0
            ? " Hovering a candle reads that bar's funding, and the table below carries it as a column."
            : " No bar in this window has a funding reading."}</>
        )}
        {/* "THIS SERIES REACHES BACK TO X" WAS A CLAIM ABOUT THE STORE AND X CAME FROM THE WINDOW.
            chart.fundingFrom is candles[cov[0]][T] — the first bar OF THE PANEL BEING DRAWN that
            carries funding — which is the right value for placing the shading and the wrong one
            for stating how far the series goes. On any window funding covers completely, cov[0]
            is 0, so the 15m panel said the series reached back two days while the store holds it
            from 18 May. Two facts, one date, and the sentence claimed the one it did not have.
            The depth now comes from the stored series; the shading is described in words, so it
            needs no second date to be wrong with. */}
        {fundingSeriesFrom && (bandDrawn
          ? <> Hyperliquid publishes its own funding hourly; the stored series begins {shortDate(fundingSeriesFrom)},
            and where a window reaches back further than that the band is shaded to mark the part
            with no funding to show.</>
          : <> Hyperliquid publishes its own funding hourly; the stored series begins {shortDate(fundingSeriesFrom)},
            and a bar older than that has no funding reading.</>)}
        {/* THE VERBS FOLLOW THE COUNT TOO. Only the noun did: "1 bar exceed it and are drawn at the
            edge", measured 16 September 2026 on https://coinliqui.com/funding/useless?tf=4h. The
            clause is now one expression per count, so noun and verbs cannot be chosen apart. */}
        {bandDrawn && active!.chart.fundingClipped > 0 && (
          <> The band is scaled to ±{(active!.chart.fundingMax * 100).toFixed(0)}% APR, the 96th percentile —
          {" "}{active!.chart.fundingClipped === 1 ? "1 bar exceeds it and is" : `${active!.chart.fundingClipped} bars exceed it and are`} drawn at the edge; hover reads the true figure.</>
        )}
      </p>

      {/* The rows are rebuilt from the panel's own pts-* JSON when the timeframe is switched
          client-side, so the table reads the same array the chart was drawn from.

          "Can never disagree" is what this comment used to say, and it was false: the rebuild
          formats those numbers with its own implementation, and the client's K-scale branch
          used one decimal where `compact` below uses two. Every volume cell was rewritten from
          23.37K to 23.4K on a click that changed nothing else. Sharing the DATA is not the same
          as sharing the FORMATTING, and only the first was ever true here. The two formatters
          are now swept against each other by scripts/checks.mjs on every push. */}
      {/* data-dp is the PAGE's precision, not the chart's. chart.dp is chosen for axis labels,
          where four significant digits is plenty; the table prints the same figures the server
          rendered, and on a sub-cent contract that is seven decimals. Using the chart's value
          silently rounded kPEPE's rows from $0.0029000 to $0.0029 on a client-side switch. */}
      <details class="src" data-tftable data-group="px" data-unit={p.symbol} data-dp={dp}>
        <summary><span data-tflabel>{active!.tf.label}</span> bars as a table (<span data-tfcount>{rows.length}</span> rows, open · high · low · close · volume · funding)</summary>
        <div class="panel" style="margin-top:10px">
          <table class="tbl">
            <thead><tr><th>Time (UTC)</th><th class="num">Open</th><th class="num">High</th><th class="num">Low</th><th class="num">Close</th><th class="num">Volume ({p.symbol})</th><th class="num">Funding APR</th></tr></thead>
            <tbody>
              {rows.map((q) => (
                <tr>
                  <td>{new Date(q[1]).toISOString().slice(0, 16).replace("T", " ")}</td>
                  <td class="num">{px(q[2])}</td>
                  <td class="num">{px(q[3])}</td>
                  <td class="num">{px(q[4])}</td>
                  <td class="num">{px(q[5])}</td>
                  <td class="num">{qty(q[6])}</td>
                  <td class:list={["num", Number.isFinite(q[7]) ? paysClass(q[7]) : "faint"]}>{Number.isFinite(q[7]) ? pct(q[7]) : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </>
  ) : (
    <div class="empty">
      <div class="empty__body">
        <p class="empty__title">Candles not collected yet</p>
        <p class="empty__text">A contract that has just entered coverage is fetched within five minutes, rather than waiting hours for the ordinary refresh, so this fills in shortly. Everything below is unaffected — funding, venue comparison and margin tiers all come from the snapshot, not from the stored candles.</p>
      </div>
    </div>
  )}

  <h2 class="section">Funding</h2>
  <div class="cards">
    <div class="card">
      <div class="card__label">Hyperliquid funding</div>
      <div class:list={["card__value", hl && paysClass(hl.apr)]}>{hl ? pct(hl.apr) : "—"}</div>
      <div class="card__meta">{hl ? paysLabel(hl.apr) : "—"}</div>
    </div>
    <div class="card">
      <div class="card__label">Spread between venues</div>
      {/* max-min over the venue cells below, so it must be recomputed from the SAME numbers
          after a live pull — otherwise the card describes a set the table no longer shows. */}
      <div class="card__value" data-repaint={p.aprSpread != null ? "spread" : undefined} data-sym={p.symbol}>{p.aprSpread != null ? pct(p.aprSpread) : "—"}</div>
      <div class="card__meta">annualised difference</div>
    </div>
    <div class="card">
      <div class="card__label">Cost to hold $10,000 long</div>
      <div class="card__value">{Number.isFinite(carry7d) ? usd(Math.abs(carry7d), 2) : "—"}</div>
      <div class="card__meta">over 7 days at the current rate{hl ? ` · ${hl.apr >= 0 ? "you pay" : "you receive"}` : ""}</div>
    </div>
    <div class="card">
      <div class="card__label">Next settlement</div>
      <div class="card__value" style="font-size:20px">{nextFunding ? nextFunding.toISOString().slice(11, 16) : "—"}</div>
      <div class="card__meta">{nextFunding ? "UTC · Hyperliquid, hourly" : "—"}</div>
    </div>
  </div>

  <h2 class="section">Funding by venue</h2>
  {/* THE CALCULATOR FOR THE THING THESE FIFTY PAGES ARE ABOUT, AND NOT ONE OF THEM LINKED TO IT.
      Measured across the live surface on 20 August: /tools/funding-cost had exactly one inbound
      link in the whole site — the tools hub — while its three siblings had two or three, and the
      tool itself already links back to this page. So the reciprocal half of an existing pattern
      was missing, on the fifty pages where it is most useful: the card above prices one size over
      one period, and the calculator is where a reader changes both. It carries ?symbol= for the
      same reason /liquidations?symbol= does — arriving on the contract you were already reading
      is the difference between a link and a detour. */}
  <p class="section-note">
    The quoted column is what each venue publishes. Those numbers are not comparable to each other; the annualised column is.
    {/* THE PAGE ASSUMES THE READER KNOWS WHAT THE COLUMN IS. Fifty pages carry this sentence and
        none of them says what a funding rate IS — the reader who does not know is offered two
        calculators and a table, which answer a question they have not got to yet. */}
    {" "}<a class="link" href="/learn/funding-rate">What a funding rate is, and who pays it →</a>
    {/* SEPARATED, BECAUSE TWO OFFERS RAN TOGETHER AS ONE. At 375px both links wrap and the pair
        reads as a single run of blue with an arrow in the middle. The dot is the separator this
        site already uses between distinct items. */}
    {" "}<a class="link" href={`/tools/funding-cost?symbol=${p.symbol}`}>Cost of holding {p.symbol}, at your size and horizon →</a>
    {/* A second question arising from the same table, not a second link for its own sake: the
        annualised column is what makes venues comparable, and whether the difference between
        them is worth anything is the next thing a reader asks. ONLY WHERE THERE IS A SPREAD: on a
        contract only Hyperliquid quotes, the table shows dashes and the spread card a dash, and the
        link offered to trade "the spread between them" (/funding/purr, 16 September 2026). */}
    {venueRates.length > 1 && <> · <a class="link" href={`/tools/funding-arbitrage?symbol=${p.symbol}`}>Whether the spread between them is worth trading →</a></>}
  </p>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Venue</th><th class="num">Quoted rate</th><th class="num">Interval</th><th class="num">Settlements / yr</th><th class="num">Annualised</th></tr></thead>
      <tbody>
        {/* Every cell is guarded on the INTERVAL being a real number, not just on the venue
            being present. Nineteen contracts in the upstream universe publish a Binance rate
            with no fundingIntervalHours, and an unguarded row rendered "undefinedh" and "NaN"
            — and, because NaN >= 0 is false, tinted the annualised cell green, which on this
            site is a claim that shorts are paying. None of the published contracts hits this
            today; that is not a reason to render it wrong when one does. */}
        {ORDER.map((v) => {
          const f = by.get(v);
          const iv = f && Number.isFinite(f.intervalHours) ? f.intervalHours : null;
          const dash = <span class="faint">—</span>;
          return (
            <tr>
              <td>{VENUE_LABEL[v]}</td>
              <td class="num">{f ? rawRate(f.rate, f) : dash}</td>
              <td class="num">{iv ? `${iv}h` : dash}</td>
              <td class="num">{iv ? Math.round(settlementsPerYear(iv)).toLocaleString("en-US") : dash}</td>
              <td class:list={["num", f && Number.isFinite(f.apr) && paysClass(f.apr)]} style="font-weight:600"
                  data-repaint={f ? "apr" : undefined} data-sym={p.symbol} data-venue={v}>{f ? pct(f.apr) : "—"}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <h2 class="section">Margin tiers</h2>
  {/* THE LABEL MUST BE THE LEVERAGE THAT WAS ACTUALLY USED. This asked margin.ts for 10× and
      printed "At 10× long" — but margin.ts clamps the request to the tier maximum and says so
      in `leverageClamped`, which nothing here read. On the twenty contracts whose tier caps at
      3× or 5×, the sentence claimed 10× while the number beneath it was the 5× (or 3×)
      liquidation price, directly contradicting the Max leverage column in the table below it.
      A reader sizing a position took away that a 10× long survives an 11% adverse move on a
      contract where 10× cannot be opened at all.

      THE GAP WAS PRINTED AS DOLLARS-AND-CENTS. The liquidation price uses px(), which picks
      2–7 decimals from the magnitude; the difference beside it used usd(…, 2). On any contract
      under about $0.25 the gap rounded to "$0.00 away" — a sentence whose entire purpose is to
      quantify the error in the common formula, quantifying it as nothing, on fourteen pages.
      Worst case was 8.9% of the price displayed as zero. Both now use px(), and the relative
      figure leads, because a percentage survives every price magnitude. */}
  <p class="section-note">
    {/* THE ENTRY IS PRINTED, WITH THE MINUTE IT WAS READ — see the note at `liq`. */}
    Maintenance margin is half the initial margin at the tier's max leverage. At {liq.effectiveLeverage}× long
    with 1 {p.symbol} entered at <strong style="color:var(--text)">{px(markNow)}</strong>, the Hyperliquid mark at <time datetime={new Date(markAt).toISOString()}>{utcStamp(markAt)}</time>{liq.leverageClamped
      ? <> — {liq.effectiveLeverage}× being this contract's tier maximum, so 10× cannot be opened on it at all — </>
      : ", "}the tier-correct liquidation price is <strong style="color:var(--text)">{px(liq.liquidationPrice)}</strong> —
    {/* ROOM FROM ENTRY, ON ONE BASE FOR BOTH PRICES. This said "1.25% ($864.93) away from what the
        common formula returns" with the percentage taken on the correct price, not the formula's —
        see differenceOfCorrectPct in src/lib/margin.ts. */}
    <strong style="color:var(--text)">{pct(liq.distancePct)}</strong> below entry, where the common
    {" "}<code>entry × (1 − 1/leverage)</code> formula puts it {pct(liq.naiveDistancePct)} below at
    {" "}{px(liq.naivePrice)}{liq.leverageClamped ? <> for the 10× that was asked for</> : null} —
    {" "}{roomVerdict(liq) === "less" ? <>{px(liq.differenceAbs)} of room that is not there.</>
      : roomVerdict(liq) === "more-capped" ? <>{px(liq.differenceAbs)} more room than the formula shows, because the tier caps the leverage at {liq.effectiveLeverage}×.</>
      : roomVerdict(liq) === "more" ? <>{px(liq.differenceAbs)} more room than the formula shows.</>
      : <>the same room the formula shows.</>}
    {/* THE SAME DEFECT AS THE SIBLING BLOCK, ONE LEVEL UP. Measured on the live surface after the
        contract pages were cross-linked: /tools/funding-cost went to 51 inbound editorial links
        and the other three calculators sat at 2, 2 and 3 — /tools/leverage and
        /tools/funding-arbitrage reachable only from the tools hub and from each other.
        /tools/position-size is one of the URLs Search Console still has as Discovered, not
        indexed. Both links below belong to THIS section rather than being distributed for
        volume: the paragraph states a tier-correct liquidation price and the gap against the
        common formula, which is precisely what one calculator sizes against and the other
        explains. */}
    {" "}<a class="link" href={`/tools/position-size?symbol=${p.symbol}`}>Size a position against this liquidation price →</a> ·
    {" "}<a class="link" href={`/tools/leverage?symbol=${p.symbol}`}>What {p.symbol} allows at your notional →</a> ·
    {/* THE THIRD LINK IS THE SAME QUESTION AT PORTFOLIO SCALE. This paragraph gives ONE
        liquidation price — a 10x long at the current mark. The map gives the whole field:
        every leverage, both sides, and which of those levels price has already traded
        through. Until 27 August 2026 there was nowhere to send a reader for it, because the
        contract's map had no address of its own. */}
    {" "}<a class="link" href={liqMapHref(p.symbol)}>Every {p.symbol} liquidation level, mapped →</a>
  </p>
  <div class="panel" style="max-width:620px">
    <table class="tbl">
      <thead><tr><th>Tier</th><th class="num">Notional from</th><th class="num">Max leverage</th><th class="num">Maintenance margin</th></tr></thead>
      <tbody>
        {table.marginTiers.map((t, i) => (
          <tr>
            <td>{i + 1}</td>
            <td class="num">{usd(t.lowerBound)}</td>
            <td class="num">{t.maxLeverage}×</td>
            <td class="num">{pct(1 / (2 * t.maxLeverage), 3)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="banner">
    <div>
      <div class="banner__title">Where these levels sit across the modelled positions</div>
      <div class="banner__sub">The modelled liquidation density for {p.symbol}, built from these same tiers, over the real candles.</div>
    </div>
    <a class="btn btn--primary" href={`/liquidations?symbol=${p.symbol}`}>Open the map</a>
  </div>

  <h2 class="section">Funding rates for other coins</h2>
  {/* EVERY SIBLING, BECAUSE slice(0, 24) OFF A VOLUME-ORDERED LIST IS THE SAME 24 ON ALL FIFTY
      PAGES. The comment this replaces reasoned correctly — "a fifty-page template where every
      page links to ten of its siblings leaves most of the set two or three hops from anywhere,
      which is the shape that gets a template crawled slowly" — and then took a window off the
      TOP of the order, so the top 24 collected a link from all fifty pages and the bottom 25
      collected none.

      Measured on the live surface, 24 August, inbound editorial links per contract page:

          indexed pages     (39)   median 50
          NOT indexed pages (10)   median  3

      Eight of the ten Google has not indexed sit at 2–4 inbound links. Of the 24 pages with
      four or fewer, a third are unindexed; of the 25 with more, a twelfth. Links are not
      sufficient — /funding/zro and /funding/vvv have 50 apiece and are still queued — but this
      is the one lever here that is cheap, safe and pointed at exactly the pages that need it.

      Every other contract now, not a window: the heading says "other coins" and the list is
      finally that. Editorial links per page go from ~38 to ~63, and a ticker chip is about
      sixty bytes. */}
  <p class="related">
    {snap.perps.filter((x) => x.symbol !== p.symbol).map((x) => (
      <a class="chip-link" href={`/funding/${x.symbol.toLowerCase()}`}>{x.symbol}</a>
    ))}
    <a class="chip-link" href="/funding">All {snap.perps.length} →</a>
    {/* "spot" WAS THIS CHIP'S LABEL, pointing at a page that now explicitly refuses to show one. */}
    {coin && <a class="chip-link" href={`/coins/${coin.slug}`}>{coin.name} price →</a>}
  </p>

  {/* NO define:vars HERE. Astro implements it by stamping the variable onto every element
      the scoped stylesheet touches — on this page that was 1,736 style="--chartRatio: …"
      attributes, about 55 KB of the raw HTML, restating one constant. The variable is set
      once, on the chart panel that actually reads it. */}
  <style>
    /* Not .lede: that name means the 21px intro on the homepage. This is a plain paragraph
       that happens to be first — the weight is on the figure inside it, not on the block. */
    .answer { margin: var(--gap-block) 0 0; max-width: 78ch; color: var(--text-dim); }
    .answer strong { color: var(--text); }
    .hero__span { font-size: var(--fs-sm); color: var(--text-faint); }
    .hero__label { font-size: var(--fs-sm); color: var(--text-faint); margin-top: var(--gap-block); }
    /* Inline, not the layout's inline-block: these carry phrases, and at 375px an inline-block
       "over 220 daily bars, $0.27758 open to $0.33500 close" broke out as its own box. The fade
       still runs. */
    .hero__span [data-tfstat], .clock [data-tfstat] { display: inline; }
    .tfbar { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin: var(--inset-panel) 0 var(--gap-block); }
    .tfbar__note { font-size: var(--fs-xs); color: var(--text-faint); }
    /* The box is reserved from the viewBox ratio before paint, so switching timeframe or
       loading the script cannot move a single pixel of the page. */
    .chart--price :global(svg) { aspect-ratio: var(--chartRatio); }
    .legend { max-width: 88ch; line-height: 1.6; margin-top: 12px; }
    .src { margin-top: 12px; }
    .src summary { font-size: var(--fs-sm); color: var(--text-dim); cursor: pointer; padding: 8px 0; }
    .src summary:hover { color: var(--text); }
    /* .related and .chip-link moved to the layout stylesheet — two consumers now. */
    @media (max-width: 700px) { .hero__meta { gap: var(--gap-cluster) 20px; } }
  </style>
</Base>
