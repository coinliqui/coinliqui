---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site.ts";
import { getSnapshot, coldStart } from "../lib/hyperliquid.ts";
import { pct, usd, paysClass, paysArrow, paysLabel, LEGEND, LEGEND_PAYS, VENUE_LABEL, type Venue } from "../lib/funding.ts";
import { readFlips, describeCoverage } from "../lib/flips.ts";

const env = (Astro.locals as any)?.runtime?.env;
const snap = await getSnapshot(env?.SNAPSHOT, import.meta.env.DEV);
// Cold store: 503 + Retry-After rather than a page rendered from nothing.
if (!snap.available) return coldStart();
const flips = await readFlips(env?.DB, 24);

// Empty-state figures are computed on the server so the panel paints complete at first
// byte — the progress bar never animates in from zero.
const utc = (ms: number) => new Date(ms).toISOString().slice(0, 16).replace("T", " ") + " UTC";
const coveredH = flips.status === "warming" ? Math.floor(flips.hours) : 24;
const flipProgress = Math.min(100, Math.round((coveredH / 24) * 100));

const byApr = [...snap.perps].filter((p) => Number.isFinite(p.hlApr)).sort((a, b) => b.hlApr - a.hlApr);
const richest = byApr[0];
const cheapest = byApr[byApr.length - 1];
const widest = [...snap.perps].filter((p) => p.aprSpread != null).sort((a, b) => (b.aprSpread ?? 0) - (a.aprSpread ?? 0))[0];
const totalOi = snap.perps.reduce((s, p) => s + (Number.isFinite(p.oiNotional) ? p.oiNotional : 0), 0);
const totalVol = snap.perps.reduce((s, p) => s + (Number.isFinite(p.dayNtlVlm) ? p.dayNtlVlm : 0), 0);
const btc = snap.perps.find((p) => p.symbol === "BTC");
const maxOi = Math.max(...snap.perps.map((p) => p.oiNotional || 0), 1);
const top = snap.perps.slice(0, 15);
const stamp = new Date(snap.fetchedAt).toISOString().slice(0, 16).replace("T", " ") + " UTC";

// The dated sentence is the most citable element on the site. Numbers are set in the
// text colour at medium weight; the prose around them is dim — so it reads as a sentence,
// not as a wall of bold.
const parts: [string, boolean][] = [
  ["Open interest across ", false], [String(snap.perps.length), true],
  [" coins is ", false], [usd(totalOi), true],
  [", on ", false], [usd(totalVol), true],
  /* "MOST EXPENSIVE" NEEDS A VENUE, because it is computed over one. hlApr is Hyperliquid's
     rate; unqualified, the sentence reads as a claim about funding everywhere, and /funding at
     the same moment can show a larger number for the SAME coin on another venue — measured:
     the homepage said FARTCOIN 66.70% while Bybit's rate for FARTCOIN was 80.35%. Two
     superlatives for one word, on a site whose whole premise is that venues differ. Naming the
     venue costs three words and makes the sentence true; the card beside it already covers the
     cross-venue question. */
  [" of 24-hour volume. Hyperliquid funding is most expensive on ", false], [richest?.symbol ?? "—", true],
  [" at ", false], [richest ? pct(richest.hlApr) : "—", true],
  [" a year. The widest spread between venues is ", false], [widest?.symbol ?? "—", true],
  [", ", false], [widest?.aprSpread != null ? pct(widest.aprSpread) : "—", true], [".", false],
];

const title = `${SITE.name} — crypto funding rates and open interest`;
const description =
  "Funding rates across Hyperliquid, Binance and Bybit, annualised so they are comparable — with open interest, the funding sign flips of the last 24 hours, and a modelled liquidation map.";
---

<Base title={title} titleMode="exact" description={description} fetchedAt={snap.fetchedAt}>
  <div class="page-head">
      <p class="crumb">{stamp}</p>
      <h1 class="lede">{parts.map(([t, n]) => (n ? <b>{t}</b> : <span>{t}</span>))}</h1>
      <p>Venues settle funding on different intervals, so their quoted rates are not comparable. Every rate here is annualised. <a class="link" href="/methodology">How it is computed →</a></p>
    </div>

    <div class="cards">
      <a class="card" href="/funding">
        <div class="card__label">Widest venue spread</div>
        <div class="card__value">{widest?.aprSpread != null ? pct(widest.aprSpread) : "—"}</div>
        {/* "ACROSS THREE VENUES" WAS A CONSTANT DESCRIBING A VARIABLE. The spread is max-min
            over whatever venues publish a rate for that coin, and four of the forty-nine
            published contracts have fewer than three — HYPE and PURR trade on Hyperliquid
            alone. The sentence was true of the coin that happened to be widest today and
            would have been silently false the day a two-venue coin took the top. */}
        <div class="card__meta">{widest?.symbol ?? "—"} · across {widest ? widest.venues.filter((v) => Number.isFinite(v.apr)).length : 0} venues</div>
      </a>
      <a class="card" href={richest ? `/funding/${richest.symbol.toLowerCase()}` : "/funding"}>
        <div class="card__label">Most expensive funding <span class="card__scope">Hyperliquid</span></div>
        <div class:list={["card__value", richest && paysClass(richest.hlApr)]}>{richest ? pct(richest.hlApr) : "—"}</div>
        <div class="card__meta">{richest?.symbol ?? "—"} · {richest ? paysLabel(richest.hlApr) : ""}</div>
      </a>
      <a class="card" href={cheapest ? `/funding/${cheapest.symbol.toLowerCase()}` : "/funding"}>
        <div class="card__label">Most negative funding <span class="card__scope">Hyperliquid</span></div>
        <div class:list={["card__value", cheapest && paysClass(cheapest.hlApr)]}>{cheapest ? pct(cheapest.hlApr) : "—"}</div>
        <div class="card__meta">{cheapest?.symbol ?? "—"} · {cheapest ? paysLabel(cheapest.hlApr) : ""}</div>
      </a>
      <a class="card" href="/open-interest">
        <div class="card__label">Open interest</div>
        <div class="card__value">{usd(totalOi)}</div>
        <div class="card__meta">{snap.perps.length} coins{btc ? ` · BTC ${usd(btc.markPx, 0)}` : ""}</div>
      </a>
    </div>

    <div class="banner">
      <div>
        <div class="banner__title">Where the levels are, and which ones price already took</div>
        <div class="banner__sub">A modelled liquidation density map with every assumption printed on the page, over the real candles.</div>
      </div>
      <a class="btn btn--primary" href="/liquidations">Open the map</a>
    </div>

    <h2 class="section">Funding sign flips</h2>
    {/* THE SENTENCE PROMISED THE SET AND THE TABLE SHOWED A SAMPLE.
        "…in the last 24 hours" sat above 25 rows while 104 contracts had flipped in that
        window — measured against production D1 — with no count, no "most recent", no footer
        and no link. The next element after </table> was the following <h2>, so nothing on the
        page suggested there was more. Saying the total costs one number and turns a silent
        truncation into a fact the reader can act on. */}
    <p class="section-note">
      The side paying to hold the position reversed, in the last 24 hours.
      {flips.status === "ready" && flips.total > flips.rows.length
        ? ` ${flips.total} contracts flipped; the ${flips.rows.length} most recent are shown.`
        : flips.status === "ready" ? ` ${flips.total} contract${flips.total === 1 ? "" : "s"} flipped.` : ""}
    </p>
    {flips.status === "ready" && flips.rows.length > 0 ? (
      <>
      <div class="panel">
        <table class="tbl">
          {/* "NOW (APR)" WAS NEVER NOW. That column printed the rate captured at the instant the
              flip was observed — a D1 row frozen up to 24 hours earlier — while every other
              funding figure on this page comes from the current snapshot. Two representations
              of one truth, and the header asserted they were the same.
              Worse, it was coloured with paysClass, so on a contract whose direction had since
              reversed the red/green said the opposite of the truth — and red and green on this
              site mean the direction of a funding payment and nothing else.
              Now it says "After", which is what it holds, and the CURRENT rate sits beside it
              from the same snapshot the rest of the page uses. The colour moved to the current
              value, which is the only one it can honestly describe. */}
          {/* "FLIPPED AT" CLAIMED A PRECISION THE SAMPLING NEVER HAD.
              A flip is found by comparing a contract's two consecutive snapshots, so the
              timestamp is when the reversal was FIRST SEEN, not when it happened — the same
              thing only when the samples are adjacent. Against production D1: of the 104
              contracts that flipped in a trailing 24 h, 21 were detected across a gap wider
              than 15 minutes and the widest was 890 minutes. The column printed "09:12 UTC"
              for an event that may have occurred any time in the previous fourteen hours.
              "Detected" is what the number is, and rows whose window was wide now say so. */}
          <thead><tr><th>Coin</th><th>Venue</th><th class="num">Was (APR)</th><th class="num">After the flip</th><th class="num">Now (APR)</th><th class="num">Detected (UTC)</th></tr></thead>
          <tbody>
            {flips.rows.map((f) => (
              <tr>
                <td class="sym"><a href={`/funding/${f.symbol.toLowerCase()}`}>{f.symbol}</a></td>
                <td class="dim">{VENUE_LABEL[f.venue as Venue] ?? f.venue}</td>
                <td class="num dim">{pct(f.prevApr)}</td>
                <td class="num dim">{pct(f.apr)}</td>
                {(() => {
                  /* Joined to the SAME snapshot every other number on this page reads, so the
                     two can no longer disagree. A contract that has left coverage since the
                     flip has no current rate; it prints an em-dash rather than borrowing the
                     historical one. */
                  const live = snap.perps.find((p) => p.symbol === f.symbol)?.venues.find((v) => v.venue === f.venue)?.apr;
                  return Number.isFinite(live)
                    ? <td class:list={["num", paysClass(live!)]}>{pct(live!)}</td>
                    : <td class="num dim" title="no longer published at this venue">—</td>;
                })()}
                {/* WIDE means "wider than three scheduled ticks" — 15 min against a 5-minute
                    ingest. Below that the sample is adjacent enough that the detection time
                    IS the event time to the precision printed; above it, it is a deadline. */}
                <td class="num faint">{
                  f.gapMin > 15
                    ? <>by {new Date(f.at).toISOString().slice(11, 16)}<span class="dim">{" · within "}{f.gapMin >= 120 ? `${(f.gapMin / 60).toFixed(1)} h` : `${f.gapMin} min`}</span></>
                    : <>{new Date(f.at).toISOString().slice(11, 16)} UTC</>
                }</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="section-note" style="margin-top:10px">
        A flip is found by comparing a contract's consecutive snapshots, so the time is when the
        reversal was first seen rather than when it occurred. Where the two samples were more than
        15 minutes apart the row gives the window instead of a minute.
        <a class="link" href="/data-sources">How often each figure is refreshed →</a>
      </p>
      </>
    ) : flips.status === "warming" ? (
      <div class="empty">
        <div class="empty__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.25" /><path d="M10 5.5v4.7l3 2" /></svg>
        </div>
        <div class="empty__body">
          <p class="empty__title">Collecting funding history</p>
          <p class="empty__text">
            A flip needs two readings to compare, so this feed reports nothing until the window
            covers a full 24 hours. That way an empty list means <em>no coin flipped</em>,
            rather than <em>we have not been watching long enough to say</em>.
          </p>
          {/* A 0% bar reads as "nothing is happening". Before the first snapshot there is
              genuinely no progress to draw, so the sentence below carries the state instead. */}
          {flips.since > 0 && (
            <div class="empty__track" role="progressbar" aria-valuenow={flipProgress} aria-valuemin="0" aria-valuemax="100" aria-label="Funding history collected">
              <div class="empty__fill" style={`width:${flipProgress}%`}></div>
            </div>
          )}
          <p class="empty__meta">
            {flips.since > 0 ? (
              <><b>{coveredH}</b> of 24 hours collected · started <b>{utc(flips.since)}</b> · first flips appear after <b>{utc(flips.since + 86_400_000)}</b></>
            ) : (
              <>Snapshots are taken every <b>5 minutes</b>. The first flip can be reported <b>24 hours</b> after the first snapshot lands.</>
            )}
          </p>
        </div>
      </div>
    ) : flips.status === "ready" ? (
      <div class="empty">
        <div class="empty__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.25" /><path d="m6.8 10.2 2.2 2.2 4.2-4.6" /></svg>
        </div>
        <div class="empty__body">
          <p class="empty__title">No flips in the last 24 hours</p>
          <p class="empty__text">
            Every coin kept the same side paying across all three venues for the full window.
            This is a result, not a gap — the feed is live and has the history to say so.
          </p>
          <p class="empty__meta">Window <b>{utc(Date.now() - 86_400_000)}</b> → <b>{utc(Date.now())}</b></p>
        </div>
      </div>
    ) : (
      <div class="empty">
        <div class="empty__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 6.5v4" /><path d="M10 13.4h.01" /><circle cx="10" cy="10" r="7.25" /></svg>
        </div>
        <div class="empty__body">
          <p class="empty__title">Flip feed unavailable here</p>
          <p class="empty__text">{describeCoverage(flips)}</p>
          <p class="empty__meta">Every other figure on this page is live and unaffected.</p>
        </div>
      </div>
    )}

    <h2 class="section">Funding rates by coin</h2>
    <p class="legend">{LEGEND} — {LEGEND_PAYS}. Every other figure is neutral.</p>
    <div class="panel">
      <table class="tbl">
        <thead>
          <tr><th>Coin</th><th class="num">Hyperliquid funding APR</th><th class="num">Venue spread (APR)</th><th class="num">Open interest</th><th class="num">24h volume</th></tr>
        </thead>
        <tbody>
          {top.map((p) => (
            <tr>
              <td class="sym"><a href={`/funding/${p.symbol.toLowerCase()}`}>{p.symbol}</a></td>
              <td class:list={["num", paysClass(p.hlApr)]}>{paysArrow(p.hlApr)} {pct(p.hlApr)}</td>
              <td class="num">{p.aprSpread != null ? pct(p.aprSpread) : <span class="faint">—</span>}</td>
              <td class="num">
                <span class="magnitude">
                  <span class="magnitude__track"><span class="magnitude__fill" style={`width:${Math.max(3, Math.round((p.oiNotional / maxOi) * 100))}%`}></span></span>
                  <span>{usd(p.oiNotional)}</span>
                </span>
              </td>
              <td class="num">{usd(p.dayNtlVlm)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="section-note" style="margin-top:12px">
      <a class="link" href="/funding">All {snap.perps.length} coins with per-venue detail →</a>
      · {snap.eligibleCount} of {snap.universeCount} coins clear the $5M open-interest floor
    </p>

    <style>
      .lede { font-size: 21px; line-height: 1.5; font-weight: 400; letter-spacing: -.012em; color: var(--text-dim); margin: 0 0 var(--gap-block); max-width: 90ch; }
      .lede b { font-weight: 550; color: var(--text); font-variant-numeric: tabular-nums; }
    </style>
</Base>
