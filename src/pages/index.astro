---
import Base from "../layouts/Base.astro";
import HomeBody from "../components/HomeBody.astro";
import { loadHome } from "../lib/home-view.ts";

const { snap, flips, title, description } = await loadHome((Astro.locals as any)?.runtime?.env);
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt}>
  <HomeBody snap={snap} flips={flips} />
</Base>
