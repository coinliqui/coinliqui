---
import Base from "../layouts/Base.astro";
import Related from "../components/Related.astro";
import { SITE, IDENTITY, STORE_NS } from "../lib/site.ts";
import { getSnapshot, OI_NOTIONAL_FLOOR } from "../lib/hyperliquid.ts";
import { usd } from "../lib/funding.ts";

/**
 * THE IDENTITY PAGE, and it exists for a specific reason.
 *
 * Asked "coinliqui.com", Google's assistant answered that it "is not a known, authoritative or
 * operating cryptocurrency service" and is "most likely a typo, or a malicious or fraudulent
 * (scam) platform imitating well-known brands", and offered Liqui (liqui.io) as the real thing
 * the reader must have meant.
 *
 * That was a reasonable inference from what this site published. A crypto domain a model has
 * never seen. A name one edit from a defunct exchange. An Organization block with a name and a
 * URL and nothing else. No about page, no operator, no contact, no launch date, and nowhere on
 * seventy-one URLs a sentence saying "this is not an exchange".
 *
 * So this page does not argue. It makes the structural case, which is the only one worth
 * making: THERE IS NO MECHANISM HERE TO TAKE ANYTHING FROM ANYONE. No account, no deposit, no
 * wallet connection, nothing to sign. Everything asserted here is either checkable on this
 * site or checkable against the upstream APIs named on /data-sources.
 *
 * (This used to end "…and the /privacy guarantees behind that are enforced by a
 * Content-Security-Policy the reader can check in their own network tab". That was an argument
 * about analytics, which this site now runs deliberately, and it was never the load-bearing
 * half: what answers "is this a scam" is having no mechanism to take money.)
 */
const snap = await getSnapshot((Astro.locals as any)?.runtime?.env?.SNAPSHOT, import.meta.env.DEV);

const title = "About Coinliqui — who runs it, what it is, and what it is not";
const description =
  "Coinliqui is a free, independent, read-only reference site for crypto derivatives data. " +
  "It is not an exchange, broker, wallet or custodian: there are no accounts, no deposits and " +
  "no wallet connection, and it is not affiliated with Liqui or any other trading venue.";
---

<Base title={title} description={description} fetchedAt={snap.fetchedAt} namesFounder>
  <div class="page-head">
    <h1>About {SITE.name}</h1>
    <p>{IDENTITY.summary}</p>
  </div>

  <div class="verdict verdict--warn">
    <div>
      <b>{SITE.name} is not an exchange, and cannot be.</b> {IDENTITY.notThis} That is not a
      promise about our intentions — it is a statement about what this software does. There is
      no login form to find, because there is no login.
    </div>
  </div>

  <h2 class="section">What it is</h2>
  <p class="prose">
    A reference site for the derivatives side of crypto markets, published as ordinary web pages.
    It reads public exchange APIs, normalises what they return, and shows the result with the
    working shown. Today that covers <a class="link" href="/funding">{snap.perps.length} perpetual
    contracts</a>, their funding rates across venues and their open interest; a
    {" "}<a class="link" href="/liquidations">modelled liquidation map</a> with every assumption
    printed on the page; <a class="link" href="/coins">spot prices</a> and the basis between spot
    and the perpetual; a <a class="link" href="/unlocks">register of on-chain vesting contracts</a>
    {" "}read directly from Ethereum; and four <a class="link" href="/tools">calculators</a>.
  </p>
  <p class="prose">
    It is free, it carries no advertising, and it sells nothing. There is no paid tier, no token,
    no waitlist and no referral programme.
  </p>

  <h2 class="section">What it is not</h2>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Not this</th><th>What that means here</th></tr></thead>
      <tbody>
        <tr>
          <td><strong>Not an exchange or broker</strong></td>
          <td class="reason">You cannot trade here. There is no order form, no matching engine and no counterparty. Every price on this site is a reading of somebody else's market, attributed on <a class="link" href="/data-sources">data sources</a>.</td>
        </tr>
        <tr>
          <td><strong>Not a wallet or custodian</strong></td>
          <td class="reason">There is no wallet connect, no <code>eth_requestAccounts</code>, no signature request and no address field. The site never holds, moves or asks for funds.</td>
        </tr>
        <tr>
          <td><strong>No accounts</strong></td>
          <td class="reason">No sign-up, no login, no password, no email capture. The one thing stored on your device is a cookie named <code>rail</code> recording whether you collapsed the sidebar, plus a <code>{STORE_NS}.pinned</code> list of coins you pinned, held in your own browser and never sent anywhere.</td>
        </tr>
        <tr>
          <td><strong>No financial advice</strong></td>
          <td class="reason">Nothing here is a recommendation, a signal or a forecast. The liquidation map is explicitly a model, labelled as such on the page and explained in <a class="link" href="/methodology">methodology</a>; no figure on this site is a prediction of a price.</td>
        </tr>
        <tr>
          <td><strong>No token, no fundraising</strong></td>
          <td class="reason">There is no Coinliqui token, no presale, no airdrop and no investment of any kind. Anyone offering you one is not us.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 class="section">The name, and who we are not affiliated with</h2>
  <p class="prose">
    <strong>Coinliqui</strong> is <em>coin</em> + <em>liqui</em>dation — the site was built around
    the liquidation map and the funding rates that drive it. The resemblance to
    {" "}<strong>Liqui</strong>, a cryptocurrency exchange that ceased operating in 2018, is
    coincidental and unwanted.
  </p>
  <div class="verdict verdict--ok">
    <div>
      <b>No affiliation.</b> {SITE.name} has no connection, past or present, to
      {" "}{IDENTITY.notAffiliated.join(", ")}. We do not operate under any other name, we have no
      other domain, and we will never contact you asking for funds, keys, a seed phrase or a
      wallet signature. <strong>coinliqui.com is the only domain we publish.</strong> If you have
      been sent somewhere else using this name, it is not us — and there is nothing on this site
      that could have sent you.
    </div>
  </div>

  <h2 class="section">How to check any of this yourself</h2>
  <p class="prose">
    The point of this site is that its numbers are checkable, so its claims about itself should
    be too. Each of these is something you can verify in a browser without taking our word for it.
  </p>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Claim</th><th>How you check it</th></tr></thead>
      <tbody>
        {/* TWO ROWS REMOVED, not reworded. They read "it makes no off-origin requests" and
            "its one third-party script tag never loads", and both stopped being true when this
            site started running Google Analytics on purpose. A checkable-claims table whose
            claims fail the check is worse than no table — this one exists precisely to be
            audited by a reader. What is collected is now stated plainly on /privacy instead,
            where a policy belongs, rather than argued for here. */}
        <tr>
          <td>No account is ever required</td>
          <td class="reason">Every page, number and calculator works without signing in, because there is nothing to sign into. No email, password, wallet connection or exchange key is asked for anywhere on the site.</td>
        </tr>
        <tr>
          <td>The numbers come from where we say</td>
          <td class="reason">Every endpoint is named on <a class="link" href="/data-sources">data sources</a>, and they are public APIs — you can call the same ones and compare.</td>
        </tr>
        <tr>
          <td>The data is actually fresh</td>
          <td class="reason"><a class="link" href="/status">Status</a> reports the ingest log directly, including failures, and renders even when the data store is empty.</td>
        </tr>
        <tr>
          <td>The on-chain figures are real</td>
          <td class="reason">Every contract on <a class="link" href="/unlocks">the vesting register</a> is listed with its address and the getters used. Point any Ethereum RPC endpoint at them and you will get the same values.</td>
        </tr>
      </tbody>
    </table>
  </div>

  {/* THIS SECTION USED TO ARGUE THAT A NAME WAS UNNECESSARY. IT NOW HAS ONE.
      The argument was written when there was no name to give, and it went further than it
      needed to: it did not merely decline to name a person, it argued that declining was
      BETTER. Read by a sceptic, a four-day-old anonymous crypto site explaining why anonymity
      is superior is indistinguishable from the rhetoric of the thing it is trying not to be —
      a rhetorical own-goal independent of whether the underlying choice was right.

      Google's guidance asks "Is it self-evident to your visitors who authored your content?"
      and gives equal weight to "How": "It's helpful to readers to know how a piece of content
      was produced." Both are now answered rather than one being offered in place of the other.
      The checkability argument stays, because it is the strongest thing this site has and it is
      genuinely rarer than a byline — but it stands BESIDE the name now, not instead of it.

      So this section answers the four questions an answer engine actually needs — what it is,
      who is accountable and reachable, how the numbers are made, and what it structurally
      cannot do — with an entity rather than an individual. */}
  {/* A LIMITATION IS A STRONGER SIGNAL THAN AN ASSURANCE, because it is the one kind of
      statement a site has no incentive to invent. Every row here was a real defect on this
      site, found and fixed — the page called Hyperliquid's book "the market's" open interest,
      and described three venues as if all three were read directly. A reader who checks these
      finds them true and finds them inconvenient, which is the point. */}
  <h2 class="section">What this site does not have, and will not claim</h2>
  <div class="panel">
    <table class="tbl">
      <thead><tr><th>Limit</th><th>What that means, precisely</th></tr></thead>
      <tbody>
        <tr>
          <td>Two of the three venues are read second-hand</td>
          <td class="reason">
            Only Hyperliquid is queried directly. The Binance and Bybit funding rates arrive
            because Hyperliquid republishes them in its <code>predictedFundings</code> feed, so
            this site compares three venues' rates through one venue's endpoint. That is a
            normalisation of a republished figure, not three independent connections.
            {" "}<a class="link" href="/data-sources">Data sources</a> names the endpoint behind
            every number, this one included.
          </td>
        </tr>
        <tr>
          <td>Open interest is one venue's book</td>
          <td class="reason">
            Every open-interest figure here is Hyperliquid's alone, and is labelled as such
            wherever it appears. It is not the market's open interest and this site does not
            know the market's open interest. Measured against the three venues named above,
            Hyperliquid was about a fifth of their combined total.
          </td>
        </tr>
        <tr>
          <td>No liquidation totals</td>
          <td class="reason">
            The public feed throttles to one event per symbol per second, so any total computed
            from it undercounts by an unknown amount during exactly the cascades that make the
            number interesting. Other sites publish one anyway.
            {" "}<a class="link" href="/methodology/liquidations">Why this one does not</a>.
          </td>
        </tr>
        <tr>
          <td>Coverage is deliberately narrow</td>
          <td class="reason">
            A contract gets a page only once it holds {usd(OI_NOTIONAL_FLOOR)} of open interest.
            {" "}{snap.eligibleCount} of {snap.universeCount} clear that floor today and
            {" "}{snap.perps.length} are published. Publishing the rest would mean hundreds of
            pages with nothing behind them.
          </td>
        </tr>
        <tr>
          <td>The ingest fails, and says so</td>
          <td class="reason">
            No claim of perfection: <a class="link" href="/status">Status</a> renders the real
            success rate from the run log, failures included, and the freshness indicator on
            every page reports the age of the slowest store behind it rather than the newest.
            A status page that has only ever been green is evidence of nothing.
          </td>
        </tr>
        <tr>
          <td>History starts at launch</td>
          <td class="reason">
            Funding history cannot be backfilled from these endpoints, so it accrues from
            {" "}{new Date(IDENTITY.launched).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}
            {" "}forward. Where a window is not yet covered the page says so instead of showing
            a shorter window as if it were the one asked for.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {/* PROVENANCE IS THE ONE THING A FIVE-DAY-OLD DOMAIN CANNOT FAKE, and it is the answer to
      the only reasonable objection a sceptical reader has left: that everything above is just
      words on a page written by whoever owns the page. A commit history is not. */}
  <h2 class="section">The site's own history, which you can read</h2>
  <p class="prose">
    Every claim above is a statement this site makes about itself, and there is no reason to
    take any of them on trust. The source is public at
    {" "}<a class="link" href={IDENTITY.sameAs[0]} rel="noopener">github.com/coinliqui/coinliqui</a>
    {" "}— the same code that renders these pages, with the commit history behind it. It records
    when each of the limitations above was found and what was changed, which is a different kind
    of evidence from a page asserting that it is careful.
  </p>
  <p class="prose">
    Publishing began on
    {" "}<time datetime={IDENTITY.launched}>{new Date(IDENTITY.launched).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time>.
    That is recent, and no amount of writing changes it — a site with a short history is exactly
    what a short history looks like. What can be checked instead is whether the history that
    exists is real and consistent: the commits, the dated figures on every page, and
    {" "}<a class="link" href="/status/indexation">the indexation report</a>, which publishes how
    much of this site search engines have actually accepted, including the parts they have not.
  </p>

  <h2 class="section">Who is accountable, and how to reach us</h2>
  {/* THE NAME IS BACK, AND THE THING THAT CAUSED THE HARM IS STILL GONE.
      What drew the spam was a personal address in machine-readable commit metadata, harvested
      by everything that reads a public repository and unwithdrawable once out. A name on a page
      is a different object entirely: it is the accountability an anonymous clone will not
      offer, and it is the one claim here that a reader can hold someone to.
      So the name is published and the personal address is not — not here, not in the JSON-LD,
      not in git author fields. Both halves are enforced by a check rather than by memory. */}
  <p class="prose">
    {IDENTITY.founder ? (
      <>
        {SITE.name} is a project, not a company: one independent publication with one contact
        address, funded by nobody and selling nothing, founded and run by
        {" "}<strong>{IDENTITY.founder.name}</strong>. It has been publishing since
      </>
    ) : (
      <>
        {SITE.name} is a project, not a company and not a person's blog: one independent publication
        with one contact address, funded by nobody and selling nothing. It has been publishing since
      </>
    )}
    {" "}{new Date(IDENTITY.launched).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}.
    Coverage grows deliberately slowly: a contract gets a page once it holds
    {" "}{usd(OI_NOTIONAL_FLOOR)} of open interest, and pages are added at a few a week rather
    than generated in bulk.
  </p>
  <p class="prose">
    <strong>Every figure on this site names its source and its age.</strong> A name tells you
    who to hold responsible; this tells you what to check, so you do not have to take either on
    trust.
    {" "}<a class="link" href="/data-sources">Data sources</a> lists every upstream endpoint
    behind every number with its refresh cadence and what is deliberately absent;
    {" "}<a class="link" href="/methodology">Methodology</a> shows the arithmetic, including the
    normalisation that makes venues comparable at all;
    {" "}<a class="link" href="/methodology/liquidations">why no liquidation totals are
    published</a> is the clearest case of the site declining to print a number it cannot stand
    behind; and <a class="link" href="/status">Status</a> reports the ingest's real success rate,
    failures included, rendered from the run log rather than asserted.
  </p>
  <p class="prose">
    <strong>The pages are generated, and that is stated rather than hidden.</strong> Numbers,
    charts and tables are produced by scheduled code from the endpoints named on
    {" "}<a class="link" href="/data-sources">Data sources</a>; the explanatory prose is written.
    Nothing here is a model output, a forecast or a signal — where a figure is modelled rather
    than measured, the page says so and lists the assumptions.
  </p>
  <p class="prose">
    Corrections are welcome and acted on — if a number here disagrees with the venue it came
    from, that is a bug and we want to know. Write to
    {" "}{/* CLOUDFLARE WAS EATING THE ONLY CONTACT ADDRESS ON THE SITE.
        Email Address Obfuscation rewrites any mailto: it finds in HTML as it leaves the edge —
        after this code has run, with no way for it to intervene. Live, before this: the href
        became /cdn-cgi/l/email-protection#58303d3434371... which returns 404, and the visible
        text became the literal string "[email protected]". So the address was unreachable by
        click and read as nonsense to every crawler and answer engine — on the pages built to
        establish that a real person operates this site, which is the whole reason the address
        was published.

        <!--email_off--> is Cloudflare's own documented opt-out and needs no dashboard access,
        which matters because this project's grant cannot even READ zone settings. Emitted via
        Fragment set:html so the comments survive verbatim; the anchor stays ordinary Astro
        markup so its scoped class still applies.

        The plain-text surfaces were never affected — /llms.txt and /.well-known/security.txt
        are not HTML, so the rewriter left them alone, and the JSON-LD was fine for the same
        reason. Only the two human-readable pages were broken. */}
      <!--email_off--><a class="link" href={`mailto:${IDENTITY.contact}`}>{IDENTITY.contact}</a><!--email_on-->. Security
    reports have their own route at <a class="link" href="/.well-known/security.txt">/.well-known/security.txt</a>.
  </p>

  <Related items={[
    { href: "/data-sources", label: "Data sources", note: "Every upstream endpoint behind every number, and what is deliberately absent." },
    { href: "/privacy", label: "Privacy", note: "What is stored on your device, and what is not collected." },
    { href: "/methodology", label: "Methodology", note: "What is done to the numbers once they arrive." },
    { href: "/status", label: "Status", note: "Whether the ingest actually ran, and what it saw." },
  ]} />

  <style>
    .reason { color: var(--text-dim); white-space: normal; }
    .tbl td { vertical-align: top; }
    h2.section { margin-top: var(--gap-region); }
  </style>
</Base>
