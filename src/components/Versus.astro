---
/* =========================================================================================
   ONE CONTRACT AGAINST ANOTHER, the comparison a price page leaves to the reader and a chat
   answer cannot give without two lookups and a subtraction. Written once for /coins/{coin} and
   /funding/{symbol}; the rows come from versusRows in src/lib/series.ts.
   ========================================================================================= */
import { signedPct } from "../lib/funding.ts";
import { utcStamp } from "../lib/freshness.ts";
import type { VersusRow } from "../lib/series.ts";

interface Props {
  symbol: string;
  refSymbol: string;
  /** where the reference contract's own page is, or null */
  refHref: string | null;
  rows: VersusRow[];
  /** when both marks were read */
  at: number;
}
const { symbol, refSymbol, refHref, rows, at } = Astro.props;
const points = (d: number) => {
  const p = (d * 100).toFixed(2);
  return Number(p) === 0 ? "level" : `${d > 0 ? "+" : "−"}${Math.abs(Number(p)).toFixed(2)} pts`;
};
const froms = rows.filter((r) => r.from != null).map((r) => utcStamp(r.from!, 0));
/* THE TABLE'S RESULT IN WORDS, decided from the same rows at the printed precision. It replaced a
   note that was the same sentence on every page (19 October 2026); which windows a coin led and
   trailed in is the thing the table is read for. */
const gap = (r: VersusRow) => Number(((r.own - r.ref) * 100).toFixed(2));
const led = rows.filter((r) => gap(r) > 0), trailed = rows.filter((r) => gap(r) < 0);
const names = (rs: VersusRow[]) => rs.map((r) => r.label).join(rs.length === 2 ? " and " : ", ").replace(/, ([^,]*)$/, " and $1");
const widest = [...rows].sort((a, b) => Math.abs(gap(b)) - Math.abs(gap(a)))[0];
const verdict = !rows.length ? null
  : led.length === rows.length ? `${symbol} has outrun ${refSymbol} over ${rows.length === 1 ? "the day" : `all ${rows.length} windows`}, by the most over ${widest.label}: ${points(widest.own - widest.ref)}.`
  : trailed.length === rows.length ? `${symbol} has trailed ${refSymbol} over ${rows.length === 1 ? "the day" : `all ${rows.length} windows`}, by the most over ${widest.label}: ${points(widest.own - widest.ref)}.`
  : led.length && trailed.length ? `${symbol} led ${refSymbol} over ${names(led)} and trailed it over ${names(trailed)}.`
  : `${symbol} and ${refSymbol} moved level over ${names(rows.filter((r) => gap(r) === 0))}${led.length ? `, and ${symbol} led over ${names(led)}` : trailed.length ? `, and ${symbol} trailed over ${names(trailed)}` : ""}.`;
---
{rows.length > 0 && (
  <>
    <h2 class="section">Against {refHref ? <a class="link" href={refHref}>{refSymbol}</a> : refSymbol}</h2>
    <p class="section-note">
      {verdict}{" "}Marks read together at {utcStamp(at, 0)}{froms.length > 0 && <>; longer windows from the same daily close in both</>}.
    </p>
    <div class="panel"><table class="tbl">
      <thead><tr><th>Over</th><th class="num">{symbol}</th><th class="num">{refSymbol}</th><th class="num">Difference</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr><td>{r.label}</td><td class="num">{signedPct(r.own)}</td><td class="num">{signedPct(r.ref)}</td><td class="num">{points(r.own - r.ref)}</td></tr>
        ))}
      </tbody>
    </table></div>
  </>
)}
