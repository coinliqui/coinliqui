---
/* =========================================================================================
   "SEE MORE": THE EXPLANATION SHIPS IN THE FIRST RESPONSE, FOLDED BY MARKUP.

   The product rule (15 October 2026): a reader sees the picture, the figures and a short
   conclusion first; method, assumptions and text written for search go underneath, collapsed.
   And the collapsed text must be IN THE HTML at first byte — a native <details>, closed by
   default, with nothing fetched on open. A block that loads on click is invisible to a crawler,
   an extractor and anyone without JavaScript, and it breaks this site's first-byte rule.

   scripts/checks.mjs collapsedTextShipped() asserts it on every rendered route: every
   details.more carries its text, and nothing inside it waits for a request.
   ========================================================================================= */
interface Props {
  /** what the block holds, said plainly: "How this is modelled", not "Details" */
  label: string;
  /** open by default, for the rare block that is the answer rather than the method */
  open?: boolean;
  /** an anchor other pages link to; a link to it lands on the summary line */
  id?: string;
}
const { label, open = false, id } = Astro.props;
---
<details class="more" data-more open={open} id={id}>
  <summary class="more__sum"><span class="more__label">{label}</span><span class="more__hint" aria-hidden="true"></span></summary>
  <div class="more__body"><slot /></div>
</details>

<style>
  /* A FOLD HAS TO LOOK LIKE ONE. The first version drew the hint in the faint text colour at 13px
     on the far right of a near-black border, and on 15 October 2026 the owner looked at a page
     carrying six of them and said there were none. The hint is now the accent, a pill with a
     chevron, and the whole bar lifts on hover — still one line, still under the content it serves. */
  .more { margin: var(--gap-block) 0; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-1); }
  .more__sum { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px 12px 16px; font-weight: 600; border-radius: 12px; }
  .more__sum:hover { background: var(--surface-2); }
  .more__label { min-width: 0; }
  .more__sum::-webkit-details-marker { display: none; }
  .more__sum:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* The hint is drawn by CSS so the closed and open words are never both in the text. */
  .more__hint::after {
    content: "See more \2193"; display: inline-block; padding: 4px 12px; border-radius: 999px;
    font-size: 13px; font-weight: 600; white-space: nowrap;
    color: var(--accent); border: 1px solid var(--accent);
  }
  .more[open] .more__hint::after { content: "Hide \2191"; color: var(--text-dim); border-color: var(--border); }
  .more__body { padding: 0 16px 16px; }
  .more__body > :first-child { margin-top: 0; }
</style>
