          <a class="chip-link" href={viewHref(liqMapHref(x.symbol), win)}>{x.symbol}</a>
        ))}
        <a class="chip-link" href={viewHref("/liquidations", win)}>All {mapSiblings.length + 1} →</a>
        <a class="chip-link" href={`/funding/${perp.symbol.toLowerCase()}`}>{perp.symbol} funding →</a>
      </p>
    </>
  )}

