---
/* =========================================================================================
   THE LIQUIDATION MAP, ONCE, FOR EVERY CONTRACT THAT HAS ONE.

   WHY IT IS A COMPONENT AND NOT A PAGE. This markup rendered fifty different pages and
   published all fifty at one URL. `/liquidations?symbol=ETH` produced a full ETH page —
   its own <title>, its own <h1>, its own chart, its own numbers — and then, because
   Base builds the canonical tag from the PATHNAME alone, told every crawler that the page
   it had just read was `/liquidations`. Forty-nine renderings that a search engine could
   not reach, could not link to, and was explicitly instructed to discard.

   The demand for them is measured rather than assumed. Search Console for the week to
   22 August 2026: `liquidations` drew 70 impressions from ONE indexed page, against 392
   from the twenty-five `/funding/{symbol}` pages that have impressions — 70 per page
   versus 16. The query log is coin-named throughout: "btc liquidation map" (8), "btc
   liquidation heatmap", "btc liquidation heat map", "bitcoin liquidation map", "btc
   liquidation chart", "btc liquidation heatmap all exchanges". Those are queries for a
   URL per coin, answered by a site that had one.

   So the body moved here and both routes render it: `/liquidations` for the pinned default
   and `/liquidations/{symbol}` for the rest. ONE implementation, because the alternative —
   copying 280 lines into a second file — is how the two sitemap lists in src/lib/routes.ts
   came to disagree about 22 URLs.
   ========================================================================================= */
import { usd, pct } from "../lib/funding.ts";
import { maintenanceMarginFraction, nextTierBoundary, corridorAt, type MarginTable } from "../lib/margin.ts";
import { T, O, H, L, C, type Candle, type getHourly } from "../lib/candles.ts";
import { buildLiqMap, PROFILES, mixUsed, profilesCoincide, MAP_WINDOWS, DEFAULT_WINDOW, resolveWindow, canDrawMap, mapDrawable, type MapWindow } from "../lib/liqmap.ts";
import { paintHeatMap } from "../lib/heatmap.ts";
import { RAMP, CH, INK, MONO, FS_AXIS, compact, niceTicks } from "../lib/chart.ts";
import { aggregate, shortDate } from "../lib/series.ts";
import type { Perp, Snapshot } from "../lib/hyperliquid.ts";
import { liqMapHref } from "../lib/routes.ts";
import tables from "../data/margin-tables.json";

import Advisory from "./Advisory.astro";
import Overview from "./Overview.astro";
import { extremeBy } from "../lib/extreme.ts";
import { priceDp, axisDp as axisDpOf } from "../lib/funding.ts";

interface Props {
  perp: Perp;
  table: MarginTable;
  snap: Snapshot;
  /* The form's controls, read from whichever route is rendering. `symbol` is deliberately
     NOT read here: the contract is decided by the route and passed in, so a stray
     ?symbol= on a per-coin URL cannot make the page disagree with its own address. */
  params: URLSearchParams;
  /* The VISIBLE trail. Base's `crumb` prop emits the BreadcrumbList; this renders the two
     lines a reader can actually see, and the gate compares them — markup may not claim a
     position in a hierarchy that the page does not show. Absent on /liquidations, which is
     the top of its own section and has nothing to point up at. */
  crumb?: { href: string; label: string; current: string };
  /* THE CHIP STRIP IS FOR THE PER-CONTRACT PAGES AND OFF ON THE HUB. /liquidations already
     carries the full index table — every contract, with its mark, open interest, cap and
     corridor — so fifty chips underneath it would be fifty second links to fifty URLs the
     page has already linked, adding no reachability and a wall of noise. The strip earns its
     place on the per-symbol pages, where it is the only path to a sibling. */
  siblings?: boolean;
  /* THE HOURLY SERIES, READ ONCE BY THE ROUTE. The route needs it before this renders — its meta
     description says whether there is a map — so it is passed in rather than read a second time
     from the store on the same request. */
  hourly: Awaited<ReturnType<typeof getHourly>>;
}
const { perp, table, snap, params: q, crumb, siblings = true, hourly } = Astro.props;

/* =========================================================================================
   EVERY OTHER CONTRACT'S MAP, AS CHIPS, AND THE MEASUREMENT BEHIND IT.

   Internal link graph of the live site, 133 URLs, contextual links inside <main> only:

       /funding/{symbol}      n=51   median 53 inbound
       /coins/{coin}          n=11   median 11
       /liquidations/{symbol} n=52   median  2      <- this template, shipped that morning
       /tools/{tool}          n= 5   median  3

   Two. One from the hub, one from the contract's own funding page. Meanwhile this site has
   already run the experiment and written the result down — see the note above the same chip
   strip in src/pages/funding/[symbol].astro, measured 24 August 2026:

       indexed contract pages     (39)   median 50 inbound
       NOT indexed                (10)   median  3
       eight of the ten Google has not indexed sit at 2-4 inbound links

   Every one of the forty-nine new map pages sat at 2, which is inside that band. Links are
   not sufficient — /funding/zro and /funding/vvv carry 50 apiece and are still queued — but
   it is the one lever here that is cheap, safe, and pointed at exactly the pages that need
   it. This takes the template from 2 inbound to about 50, and from 21 outbound internal
   links to about 69, which is the same shape as the template that outperforms it tenfold.

   FILTERED BY TIER TABLE, like the index on /liquidations. A contract with no committed
   margin table has no maintenance margin, no corridor and no liquidation price, so its map
   answers 404 — and a chip strip is exactly where fifty links to a 404 would go unnoticed.
   ========================================================================================= */
const TABLES = tables as Record<string, unknown>;
const mapSiblings = snap.perps.filter(
  (x) => x.symbol !== perp.symbol && Object.prototype.hasOwnProperty.call(TABLES, String(x.marginTableId)),
);
const tiers = [...table.marginTiers].sort((a, b) => a.lowerBound - b.lowerBound);
const tier1 = tiers[0];
const mark = perp.markPx;
/* DISTANCE FROM THE MARK THIS PAGE NAMES, computed here and nowhere else. The map's clusters carry
   `fromClose` — measured from the last drawn candle, the only price buildLiqMap is given — and every
   place on this page that says "from the mark" means the live mark printed beside it. See the note
   on Cluster in src/lib/liqmap.ts for the 8.90%-vs-8.68% it replaces. */
const fromMark = (price: number) => (price - mark) / mark;
/* ONE MINUS SIGN ON THE PAGE. The distance column printed toFixed's ASCII hyphen ("-6.58%") beside
   columns printing U+2212 ("−2.04%"), and "+0.00%" or "-0.00%" for a cluster that rounds to the mark.
   The sign is taken from the PRINTED digits, so a figure that rounds to zero carries none. */
const signedFromMark = (price: number) => {
  const printed = (Math.abs(fromMark(price)) * 100).toFixed(2);
  const sign = Number(printed) === 0 ? "" : fromMark(price) > 0 ? "+" : "−";
  return `${sign}${printed}%`;
};

const mmf = maintenanceMarginFraction(tier1.maxLeverage);
const nextTier = nextTierBoundary(table, tier1.lowerBound);

const dp = priceDp(mark);
const px = (v: number) => usd(v, dp);
const axisDp = axisDpOf(mark);
const axisPx = (v: number) => usd(v, axisDp);

/* MODEL INPUTS. Chosen by the reader, printed beside the picture, applied here. The windows and
   their draw test live in src/lib/liqmap.ts beside the profiles, because the route's <head> reads
   them too — see MAP_WINDOWS there. */
const WINDOWS = MAP_WINDOWS;
const DEFAULT_WIN = DEFAULT_WINDOW;
const DEFAULT_PROFILE = PROFILES[1];
const win = resolveWindow(q);
const profile = PROFILES.find((p) => p.key === q.get("profile")) ?? DEFAULT_PROFILE;
/* THE VIEW AS A QUERY STRING, built from the RESOLVED inputs rather than copied from the URL, so
   an unknown ?win=99 — which the two lines above replace with the default — is not carried onward
   as though it had been honoured. Defaults are left out, so the default view links bare. */
const viewHref = (path: string, w: MapWindow) => {
  const v = new URLSearchParams();
  if (profile !== DEFAULT_PROFILE) v.set("profile", profile.key);
  if (w !== DEFAULT_WIN) v.set("win", String(w.days));
  const s = v.toString();
  return s ? `${path}?${s}` : path;
};
/** Position life: how long a modelled position stays open before it is assumed closed. */
const POSITION_LIFE_DAYS = 14;
const ageBars = Math.round((POSITION_LIFE_DAYS * 24) / win.factor);

/* ONE TEST FOR "THIS WINDOW CAN BE DRAWN", used for the map, for the empty state's account of
   which windows could be, and for the route's meta description. The empty state said "Hourly
   candles not collected yet" and "not enough price history for a map" on
   https://coinliqui.com/liquidations/useless?profile=conservative&win=30 (16 September 2026) while
   the 7-day map of the same contract rendered — the candles were there, only too few for 30 days.
   Copies of the threshold would let those sentences drift from it, so there is one, canDrawMap. */
const drawableWins = WINDOWS.filter((w) => mapDrawable(hourly?.d, w));
const series: Candle[] = hourly ? aggregate(hourly.d, win.factor) : [];
const start = series.length - win.cols;
const map =
  canDrawMap(series, win)
    ? buildLiqMap({
        candles: series, start, cols: win.cols, mmf, maxLeverage: tier1.maxLeverage,
        oiNotional: perp.oiNotional, profile, rows: 150, ageBars, minSpan: 0.16,
      })
    : null;
const paint = map ? paintHeatMap(map, { live: { px: mark, at: snap.fetchedAt } }) : null;
const warmBars = map ? map.warmBars : 0;
const stepMs = win.factor * 3_600_000;
const totalClustered = map ? map.clusters.reduce((s, c) => s + c.notional, 0) : 0;
/* THE HEAVIEST CLUSTER STILL STANDING, NOT map.peak, and not a first element either.
   `peak` is the largest cell in the WHOLE grid, every column included, so it can be a level price
   cleared a fortnight ago — "still standing" over it would be a label asserting what the expression
   does not compute. `clusters` is accumulated only where a level still carries notional at the
   right-hand edge, which is the honest set. And the superlative over it goes through extremeBy like
   every other one on the site: clusters are sums of continuous notional and have never tied, but
   "has never" is not "cannot", which is the whole argument of src/lib/extreme.ts. */
const heaviest = map ? extremeBy(map.clusters, (c) => c.notional, "max") : ({ kind: "none" } as const);
/* The same renormalised mix the model uses, so the table below and the picture above cannot
   describe two different weight vectors. See mixUsed() in src/lib/liqmap.ts. */
const mix = mixUsed(profile, tier1.maxLeverage);

/* =========================================================================================
   WHEN THE PROFILE SWITCH CANNOT CHANGE THE PICTURE, THE PAGE SAYS SO INSTEAD OF INVITING IT.

   Measured 16 September 2026 on https://coinliqui.com/liquidations/useless?profile=aggressive&win=7
   and its ?profile=conservative twin: row 3 read "Aggressive — Most size at high leverage" above a
   weight table of one row, 2× at 100.00% ($7.66M), and both renders printed the same $0.26055 /
   $81K top cluster, the same $135K cleared and the same 54.69% outside the range — under "Change
   the leverage mix in the form above and the bands move" and "Every other profile is one form
   submission away". A 3× cap leaves the profiles one rung, and renormalising any weights over one
   rung gives 100% there. /liquidations/pons and /liquidations/vvv did the same.

   `coincide` comes from profilesCoincide(), which compares the vectors mixUsed() hands the model,
   so these sentences change exactly when the picture stops being able to. And "the form above"
   was wrong on every contract: the form moved below the map in an earlier cycle.

   ROW 3 ON A CAPPED CONTRACT that still differs by profile keeps the profile's description but
   says which ladder it describes — at a 5× cap Conservative rescales to 58% at 5×, which "most
   size at low leverage" does not describe without the qualifier.
   ========================================================================================= */
const cap = tier1.maxLeverage;
const coincide = profilesCoincide(cap);
const joinWith = (xs: string[], last: string) =>
  xs.length > 1 ? `${xs.slice(0, -1).join(", ")} ${last} ${xs[xs.length - 1]}` : xs.join("");
const rungList = joinWith(mix.map(({ L }) => `${L}×`), "and");
const ladderLeft = mix.length === 0
  ? "no rung of the profile ladder"
  : `only the ${rungList} rung${mix.length === 1 ? "" : "s"} of the profile ladder`;
const sameForAll = mix.length === 0
  ? "no profile places anything"
  : mix.length === 1
    ? `every profile puts all of its weight at ${rungList}`
    : "every profile rescales to the same shares";
const droppedRungs = profile.weights.filter(([L]) => L > cap).map(([L]) => `${L}×`);
const ladderTop = Math.max(...profile.weights.map(([L]) => L));
/* ROW 3 LEADS WITH THE SHARES THE MODEL USES WHEN A CAP RESCALES THEM. Measured 16 September 2026
   on /liquidations/xmr?profile=conservative&win=30 (5× cap, rendered from this code before the
   change): the row opened "Conservative — Most size at low leverage" and qualified it a sentence
   later, above a table that put 58.18% at 5×, the highest rung in play. The shares come from `mix`,
   the vector the table and the model read, printed with the same pct(), so the row cannot name a
   shape the table beneath it does not show; the profile's own sentence follows, labelled as the
   shape written for the full ladder. */
const rescaledShares = joinWith(mix.map(({ L, share }) => `${pct(share)} at ${L}×`), "and");
const noteAsClause = profile.note.charAt(0).toLowerCase() + profile.note.slice(1);
/* IT TESTED ONE SIDE AGAINST ONE BOUND. The map places BOTH a long and a short level at every
   leverage — buildLiqMap iterates [[longLiq, true], [shortLiq, false]] — and this filter checked
   only the long level against only the lower bound. The axis is not symmetric about the mark: it
   is the traded range plus headroom, so after a hard fall loPrice sits far below and hiPrice
   close above, and a 3x SHORT level can be off the top of the picture while the 3x long level is
   still on it. The sentence beneath says which leverages "fall off the picture"; it was naming
   the ones that fall off the bottom. Row 8's clipped figure was always the honest aggregate —
   it counts both halves — so this list was the only place the asymmetry showed. */
const offAxis = profile.weights.filter(([L]) => {
  if (L > tier1.maxLeverage || !map) return false;
  const { longLiq, shortLiq } = corridorAt(mark, L, mmf);
  return longLiq < map.loPrice || shortLiq > map.hiPrice;
});
const sweptTotal = map ? map.swept.reduce((a, b) => a + b, 0) : 0;

/* =========================================================================================
   THE BARS THAT DID THE CLEARING, from an array the page already computed and threw away.

   `map.swept` carries the modelled notional price traded through PER DRAWN COLUMN, and until
   now the page reduced it to one total and discarded the shape. The shape is the more
   interesting half: a reader who opens a liquidation map is asking when the levels went, and
   the answer is in five bars out of a hundred and eighty.

   WHY IT IS WORTH THE ROWS. Measured 27 August 2026 against the site's own templates, by
   5-gram overlap between two sibling pages: /funding/{symbol} 10% shared and 3,187 words,
   /coins/{coin} 68% and 545 words, and this template 66% and 1,206. Search Console for the
   same week: the funding template drew 392 impressions across the 25 pages that have any,
   sixteen per page; the coins template drew 8 across 5, under two. Overlap is not blocking
   indexation here — coins is indexed at the same 82% as funding — but the template that is
   mostly its own words outperforms the two that are mostly shared boilerplate by ten times
   per page, and this one shipped into the second group.

   So the fix is more of what only this contract can say, not more words. Every column of this
   table is specific to one contract's own price path, and half of it — the bar, its range,
   its date — is OBSERVED rather than modelled, which is the distinction the rest of the page
   is built around. The notional is the model's; the candle is Hyperliquid's.
   ========================================================================================= */
const clearingBars = map
  ? map.swept
      .map((n, i) => ({ n, c: map.candles[i] }))
      .filter((x) => x.n > 0 && x.c)
      .sort((a, b) => b.n - a.n)
  : [];
/* THE COUNT, THE PLURAL AND THE SUPERLATIVE ARE ALL READ FROM THE ROWS. Measured 16 September 2026
   on https://coinliqui.com/liquidations/paxg?profile=balanced&win=7: "These are the 1 bars of this
   window in which the model says the most notional was traded through — 100.00% of everything
   cleared in 7 days, in 1 bars out of 168. The largest was 14 Sep 2026…" over a one-row table. A
   quiet contract on a short window clears in a single bar, and the sentence was written for six.

   So: bars tied with the sixth are kept rather than cut by sort order; "the most" is said only
   when some clearing bar is left out, and "any" when all of them are listed; "the largest" goes
   through extremeBy at the precision the Share column prints (hundredths of a percent), so two rows
   that read the same cannot have one of them named the winner; and a set of one gets no
   superlative at all. */
const TOP_BARS = 6;
const barCut = clearingBars.length > TOP_BARS ? clearingBars[TOP_BARS - 1].n : -Infinity;
const sweptBars = clearingBars.filter((x, i) => i < TOP_BARS || Math.abs(x.n - barCut) <= 1e-9);
const allClearingShown = sweptBars.length === clearingBars.length;
const barShare = (n: number) => n / Math.max(1, sweptTotal);
/* Keyed on the digits pct() prints — the same toFixed(2) — so "tie" means "the column reads the same". */
const largestBar = extremeBy(sweptBars, (b) => Math.round(Number((barShare(b.n) * 100).toFixed(2)) * 100), "max");
const isLargestBar = (b: (typeof sweptBars)[number]) =>
  largestBar.kind === "unique" ? largestBar.item === b : largestBar.kind === "tied" ? largestBar.items.includes(b) : false;
const barWord = (n: number) => `${n} bar${n === 1 ? "" : "s"}`;
const barWhen = (b: (typeof sweptBars)[number]) => `${shortDate(b.c[T])} ${new Date(b.c[T]).toISOString().slice(11, 16)} UTC`;
const oneBar = sweptBars.length === 1 && allClearingShown;
const shownCleared = sweptBars.reduce((a, b) => a + b.n, 0);

/* --- corridor ladder: derived, not modelled --- */
const CHART_FRACTIONS = [1, 0.75, 0.6, 0.5, 0.4, 0.3, 0.25];
const rung = (L: number) => corridorAt(mark, L, mmf);
const rungs = [...new Set(CHART_FRACTIONS.map((f) => Math.max(2, Math.round(tier1.maxLeverage * f))))]
  .filter((l) => l <= tier1.maxLeverage && l >= 2)
  .sort((a, b) => b - a)
  .map(rung);
const CW = 1000, CHT = 440, cpL = 20, cpR = 96, cpT = 20, cpB = 62;
const cPlotW = CW - cpL - cpR, cPlotH = CHT - cpT - cpB;
const cLo = Math.min(...rungs.map((r) => r.longLiq)), cHi = Math.max(...rungs.map((r) => r.shortLiq));
const cGap = (cHi - cLo) * 0.06;
const yMin = cLo - cGap, yMax = cHi + cGap;
const cy = (p: number) => cpT + ((yMax - p) / (yMax - yMin)) * cPlotH;
const groupW = Math.min(cPlotW, rungs.length * 132);
const groupX = cpL + (cPlotW - groupW) / 2;
const colW2 = groupW / rungs.length;
const cx = (i: number) => groupX + (i + 0.5) * colW2;
const barW = Math.min(72, colW2 * 0.58);
// round tick values here too — one scale for every chart on the site
const gridPrices = niceTicks(yMin, yMax, 5);

/* =========================================================================================
   THE EMPTY STATE DESCRIBES THE PAGE IT IS ON.

   Measured 16 September 2026 on https://coinliqui.com/liquidations/useless?profile=conservative&win=30
   (and /liquidations/pons?profile=balanced&win=30): no heatmap, no assumptions table, no weight
   table — yet "the way the assumptions below describe", "labelled as one inside the picture" and
   "USELESS is the one drawn above". The method paragraph was also wrong WITH a map: it sits after
   the assumptions table, so "below" pointed at the corridor section, which says "No assumptions
   here". Both states now get their own sentence, and the profile and window controls say when they
   cannot change this page — an offered input that silently does nothing is a claim too.

   AND "NO SERIES" IS NOT "TOO LITTLE HISTORY". `hourly` is null for a key never written, a series
   written empty, a KV read that threw and a failed upstream fetch alike (getHourly in
   src/lib/candles.ts). Measured 16 September 2026 on
   http://localhost:4322/liquidations/paxg?profile=balanced&win=7: two loads out of three read nothing
   and said "PAXG has no map in any window yet" and "This contract has not accumulated enough price
   history"; the next load drew the full 7-day map. So the no-series branch, here, in the overview and
   in the empty state, says only that nothing could be read, which is true of all four causes; the
   history-is-short sentences run only when a series was read. The <head> makes the same split
   through mapState in src/lib/liqmap.ts.
   ========================================================================================= */
const dayWord = (w: MapWindow) => `${w.days}-day`;
const drawableList = joinWith(drawableWins.map((w) => w.label), "or");
const formNote: string | null = (() => {
  if (map) return coincide ? `On ${perp.symbol} the leverage mix changes nothing: its ${cap}× cap leaves ${ladderLeft}. It still applies if you switch coin.` : null;
  if (!hourly) return `With no hourly history for ${perp.symbol} read, no window draws a map here, so neither the leverage mix nor the window changes anything drawn on this page. Both still apply if you switch coin.`;
  if (!drawableWins.length) return `${perp.symbol} has no map in any window yet, so neither the leverage mix nor the window changes this page. Both still apply if you switch coin.`;
  return coincide
    ? `${perp.symbol} has no ${dayWord(win)} map, and its ${cap}× cap leaves ${ladderLeft}, so the leverage mix changes nothing on this page. Set the window to ${drawableList} to draw the map; the mix still applies if you switch coin.`
    : `${perp.symbol} has no ${dayWord(win)} map, so the leverage mix changes nothing on this page until the window is set to ${drawableList}. Both still apply if you switch coin.`;
})();
---
  <div class="page-head">
    {crumb && <p class="crumb"><a href={crumb.href}>{crumb.label}</a> › {crumb.current}</p>}
    {/* THE TITLE NAMED THE COIN AND THE HEADING DID NOT. <title> is "BTC liquidation heatmap
        (modelled)" while the h1 said "Liquidation map" for every contract — /coins/{coin} and
        /funding/{symbol} both name theirs, and a heading that is constant across fifty distinct
        renderings tells a reader and an extractor less than the tab does. */}
    <h1>{perp.symbol} liquidation map</h1>
    {/* THE SITUATION, BEFORE THE METHOD AND BEFORE THE PICTURE. Walked cold at 375px, this page
        opened with twenty lines of prose and two dropdowns, and the map it exists for was
        entirely below the fold — the worst two-second reading on the site. The facts were all
        in that paragraph; they are now a sentence a reader can take away without interpreting
        an image, and the paragraph follows as the method it always was.

        WHICH SIDE, IN WORDS. "8.55% above the mark" only says who is in trouble if you already
        know that a level above the mark is where shorts get closed. The cluster carries its own
        side and the table below already prints it; saying it here costs three words. */}
    <Overview modelled={true}>
      <b>{perp.symbol} trades at {axisPx(mark)}</b> against {usd(perp.oiNotional)} of open
      interest on Hyperliquid.
      {map && heaviest.kind === "unique" && <>{" "}The heaviest modelled cluster still standing sits <b>{pct(Math.abs(fromMark(heaviest.item.price)))}{" "}
          {heaviest.item.price < mark ? "below" : "above"}</b> it, at <b>{axisPx(heaviest.item.price)}</b>,
          holding {compact(heaviest.item.notional)} &mdash; the level where{" "}
          <b>{heaviest.item.side === "long" ? "longs" : "shorts"} get closed</b>.</>}
      {map && heaviest.kind === "tied" && <>{" "}The heaviest modelled clusters still standing, {heaviest.items.length} of them at
          {" "}{compact(heaviest.value)} each, sit at {heaviest.items.map((c) => axisPx(c.price)).join(", ")}.</>}
      {map && <>{" "}Over {win.label} price traded {axisPx(map.tradedLo)}&ndash;{axisPx(map.tradedHi)} and
          cleared {compact(sweptTotal)} of modelled notional on the way.</>}
      {!map && !hourly && <>{" "}This page could read no hourly price history for the contract, so it draws no map.</>}
      {!map && hourly && !drawableWins.length && <>{" "}This contract has not accumulated enough price history for a map to be drawn from it yet.</>}
      {!map && drawableWins.length > 0 && <>{" "}There is not enough price history for a {dayWord(win)} map yet; over {drawableList} there is.</>}
    </Overview>
    <Advisory />
  </div>

  {map && paint ? (
    <>
      <div class="chart" style={`--mapRatio: ${CH.w} / 576`}>
        <Fragment set:html={paint.svg.replace("<svg ",
          `<svg data-heat="1" data-ramp="${RAMP.join(",")}" data-scale="${paint.scale}" data-gamma="${paint.gamma}" ` +
          `data-plot="${paint.plot.join(",")}" data-prange="${map.loPrice},${map.hiPrice}" data-axx="${paint.axisX}" ` +
          `data-taxis="${map.candles[0][0]},${stepMs}" data-taxisy="${paint.timeAxisY}" data-rows="${map.rows}" data-cols="${map.cols}" data-dp="${axisDp}" `)} />
      </div>

      <div class="scalebar">
        <Fragment set:html={paint.legend} />
        <p class="scalebar__note">
          Modelled notional standing at a price, at a moment. Colour tops out at the busiest 0.5% of the
          cells that carry anything
          so one dominant cluster cannot drag everything else to the floor; the most crowded spot holds
          {" "}{compact(map.peak)}. A band ends where price trades through it — drawn in white,
          both as scars on the field and as the strip beneath — or fades out in four steps as the
          positions behind it age past the {POSITION_LIFE_DAYS}-day position life. Hover any point for
          the value band it sits in.
        </p>
      </div>

          <p class="datanote">
