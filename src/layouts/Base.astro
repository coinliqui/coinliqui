---
import { SITE, NAV, FOOTER_LINKS, origin } from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
  fetchedAt?: number;
  /**
   * Keep the page out of the index while still letting crawlers read and follow it.
   * Deliberately NOT robots.txt Disallow: a disallowed URL can still be indexed from
   * inbound links, with no snippet, because the crawler is never allowed to fetch the
   * page and see the directive. noindex only works if the page is crawlable.
   */
  noindex?: boolean;
}
const { title, description, fetchedAt, noindex } = Astro.props;
const path = Astro.url.pathname;
// Canonical origin comes from the build-time SITE_URL via Astro.site — never a literal,
// and never the request host, which may be a *.pages.dev preview.
const base = origin(Astro.site);
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));

// Rail state is decided on the SERVER from a cookie: no flash, no layout shift, and a
// crawler (which sends no cookie) always receives the expanded rail with visible labels.
const collapsed = Astro.cookies.get("rail")?.value === "0";
const ageMin = fetchedAt ? Math.max(0, Math.round((Date.now() - fetchedAt) / 60000)) : null;

// WebSite carries name/url/alternateName only. SearchAction is deliberately absent —
// Google removed the sitelinks searchbox on 2024-11-21 and no other consumer parses it.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: SITE.name, alternateName: `${SITE.name} — ${SITE.tagline}`, url: base },
    { "@type": "Organization", name: SITE.name, url: base },
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={new URL(path, base).href} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      /* ==========================================================================
         DESIGN TOKENS
         Application-shell feel: neutral dark greys, quiet steps, rounded geometry,
         one restrained accent. Chrome is spacious; data grids are dense.
         ========================================================================== */
      :root {
        /* surfaces — three quiet steps, never pure black (YouTube/Drive/Gemini dark) */
        --bg:        #16181b;
        --surface-1: #1c1f23;   /* rail, topbar */
        --surface-2: #212529;   /* cards, panels */
        --surface-3: #2a2f35;   /* hover, inputs, chips */
        --border:    #2e343b;
        --border-soft: #262b31;

        /* text */
        --text:  #e6e8ec;
        --text-dim:   #9aa1ab;
        --text-faint: #6c737d;

        /* one accent — active nav, links, primary action. Nowhere else. */
        --accent:       #8ab4f8;
        --accent-fill:  rgba(138,180,248,.15);
        --on-accent:    #17191c;

        /* semantic — direction of funding payment ONLY */
        --pays-l: #ef6b5e;   /* longs pay shorts */
        --pays-s: #58c48c;   /* shorts pay longs */

        /* radius */
        --r-sm: 8px; --r-md: 12px; --r-pill: 999px;

        /* shell metrics — comfortable, reference-set sized */
        --rail-w: 260px; --rail-w-collapsed: 72px; --topbar-h: 60px; --tabbar-h: 58px;

        /* type scale — one number leads, everything else defers to it */
        --fs-hero: 46px; --fs-xl: 28px; --fs-lg: 19px; --fs-md: 15px;
        --fs-base: 14px; --fs-sm: 13px; --fs-xs: 11.5px;
        --ease: cubic-bezier(.22,.61,.36,1);

        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --mono: ui-monospace, "SF Mono", Menlo, monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg); color: var(--text);
        font: 14px/1.55 var(--sans);
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      }
      a { color: inherit; }
      ::selection { background: var(--accent-fill); }

      /* Monospace appears ONLY inside numeric cells, for figure alignment — never as a
         design language. Widths are reserved so live updates cannot shift layout. */
      .num { font-family: var(--mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
      .pays-l { color: var(--pays-l); }
      .pays-s { color: var(--pays-s); }
      .dim { color: var(--text-dim); }
      .faint { color: var(--text-faint); }

      /* ==========================================================================
         SHELL
         ========================================================================== */
      .app { display: grid; grid-template-columns: var(--rail-w) minmax(0,1fr); min-height: 100vh; }
      .app.is-collapsed { grid-template-columns: var(--rail-w-collapsed) minmax(0,1fr); }

      /* --- rail: comfortable rows, soft pill active state (Drive / Gemini) --- */
      /* Chrome is ambient: the rail carries no fill and no border, sitting directly on
         the page background. Only the content region is a surface. */
      .rail { background: transparent; position: sticky; top: 0; height: 100vh; overflow-y: auto; overflow-x: hidden; padding-bottom: 24px; }
      .rail__top { display: flex; align-items: center; gap: 4px; height: var(--topbar-h); padding: 0 12px; }
      .icon-btn {
        width: 40px; height: 40px; flex: 0 0 40px; display: grid; place-items: center;
        background: none; border: 0; border-radius: var(--r-pill); color: var(--text-dim); cursor: pointer;
      }
      .icon-btn:hover { background: var(--surface-3); color: var(--text); }
      /* Wordmark only — no mark, no tile. The name is the identity. */
      .brand { display: flex; align-items: center; padding: 0 8px; text-decoration: none; font-size: 16px; font-weight: 600; letter-spacing: -.01em; }

      .nav-group { padding: 6px 12px 0; }
      .nav-group__title { font-size: 12px; font-weight: 500; color: var(--text-faint); padding: 10px 16px 4px; }
      .nav-item {
        display: flex; align-items: center; gap: 16px; height: 44px; padding: 0 16px;
        border-radius: var(--r-pill); color: var(--text-dim); text-decoration: none;
        font-size: 14px; font-weight: 500; white-space: nowrap;
      }
      a.nav-item:hover { background: var(--surface-3); color: var(--text); }
      a.nav-item[aria-current="page"] { background: var(--accent-fill); color: var(--accent); }
      a.nav-item[aria-current="page"] .nav-item__icon { color: var(--accent); }
      /* unbuilt: a span, never an anchor — creates no URL and cannot be clicked */
      span.nav-item { color: var(--text-faint); opacity: .72; cursor: default; }
      .nav-item__icon { flex: 0 0 20px; color: var(--text-faint); }
      a.nav-item:hover .nav-item__icon { color: var(--text-dim); }
      .nav-item__soon {
        margin-left: auto; font-size: 11px; font-weight: 500; color: var(--text-faint);
        background: var(--surface-3); border-radius: 6px; padding: 2px 7px;
      }

      /* Collapsed hides labels only; anchors, hrefs and text nodes are untouched.
         1px clip, never off-screen positioning (a named spam-policy example). */
      .vh,
      .is-collapsed .nav-item__label,
      .is-collapsed .nav-item__soon,
      .is-collapsed .nav-group__title,
      .is-collapsed .brand span {
        position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
        border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
      }
      .is-collapsed .nav-item { justify-content: center; padding: 0; width: 48px; margin: 0 auto; }
      /* With labels and the "soon" chip hidden, opacity is the only remaining signal that
         an entry is unbuilt — so it carries more of the weight than in the expanded rail. */
      .is-collapsed span.nav-item { opacity: .34; }
      .is-collapsed .nav-group__title { display: block; height: 8px; }
      /* With the wordmark clipped there is nothing left to show, so the anchor must not
         hold width either — the collapsed rail top is the toggle alone, as in Drive. */
      .is-collapsed .brand { padding: 0; }

      /* --- topbar: search pill + freshness, balanced --- */
      .topbar {
        display: flex; align-items: center; gap: 16px; height: var(--topbar-h); padding: 0 24px;
        background: var(--bg); position: sticky; top: 0; z-index: 5;
      }
      .search { flex: 1 1 auto; max-width: 560px; position: relative; display: flex; align-items: center; }
      .search svg { position: absolute; left: 16px; color: var(--text-faint); pointer-events: none; }
      .search input {
        width: 100%; height: 44px; padding: 0 18px 0 46px; font: 14px var(--sans); color: var(--text);
        background: var(--surface-2); border: 1px solid transparent; border-radius: var(--r-pill);
      }
      .search input::placeholder { color: var(--text-faint); }
      .search input:hover { background: var(--surface-3); }
      .search input:focus { outline: 0; background: var(--surface-3); border-color: var(--accent); }
      /* --- topbar end cluster ---------------------------------------------------
         The right corner is a control cluster, the way YouTube, Drive and Gemini
         anchor theirs: a fixed 40px control height, 8px gaps, right-aligned, with
         its right padding equal to the topbar's. Freshness + account, both real
         controls — the account entry is a plain anchor to a page that exists, not
         a modal trigger and not a disabled teaser.
         ------------------------------------------------------------------------- */
      .topbar__end { margin-left: auto; display: flex; align-items: center; gap: 8px; flex: 0 0 auto; height: 40px; }
      .freshness {
        display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px;
        font-size: 13px; color: var(--text-dim); white-space: nowrap;
        background: var(--surface-2); border: 1px solid var(--border-soft);
        border-radius: var(--r-pill);
      }
      .freshness svg { color: var(--text-faint); flex: 0 0 15px; }
      .freshness time { color: var(--text); font-variant-numeric: tabular-nums; }
      /* A person icon pointing at a page that says there are no accounts would be its own
         small lie. Shield, because the page is about what is not collected. */
      /* The primary action. Accent fill, not a ghost outline — this is the one place on
         the page allowed to look like a button you are meant to press. It goes to a real
         working feature, not a signup. */
      .cta { flex: 0 0 auto; height: 40px; border-radius: var(--r-pill); padding: 0 18px; white-space: nowrap; }
      .cta svg { flex: 0 0 17px; }

      /* The one surface on the page: a single large rounded card holding all content.
         The topbar keeps a fill matching the page background so scrolled content cannot
         run under it — visually no fill, functionally still an occluder. */
      .page {
        background: var(--surface-1); border: 1px solid var(--border-soft);
        border-radius: var(--r-md); margin: 0 24px 24px; padding: 24px;
        max-width: 1320px; min-height: calc(100vh - var(--topbar-h) - 24px);
      }

      /* --- page header: spacious chrome --- */
      .page-head { margin: 8px 0 24px; }
      .page-head h1 { font-size: 22px; font-weight: 600; letter-spacing: -.015em; margin: 0 0 6px; }
      .page-head p { margin: 0; color: var(--text-dim); max-width: 76ch; }
      .crumb { font-size: 13px; color: var(--text-faint); margin: 0 0 8px; }
      .crumb a { text-decoration: none; }
      .crumb a:hover { color: var(--text); }

      h2.section { font-size: 16px; font-weight: 600; letter-spacing: -.01em; margin: 32px 0 4px; }
      .section-note { font-size: 13px; color: var(--text-faint); margin: 0 0 12px; max-width: 80ch; }
      .prose { max-width: 72ch; color: var(--text-dim); }
      .prose strong { color: var(--text); font-weight: 600; }
      .prose a, .link { color: var(--accent); }
      code { background: var(--surface-2); border-radius: 5px; padding: 1px 6px; font: 12.5px var(--mono); }

      /* --- cards --- */
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px,1fr)); gap: 12px; }
      .card {
        background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md);
        padding: 16px 18px; text-decoration: none; display: block;
      }
      a.card:hover { background: var(--surface-3); }
      .card { display: flex; flex-direction: column; }
      .card__label { font-size: 13px; color: var(--text-dim); margin-bottom: 8px; min-height: 20px; }
      /* The VALUE is the live part, so its line box is fixed — that is what must never
         shift. Label and meta are static copy and may wrap freely; clipping them to a
         fixed height (as an earlier pass did) truncates real text for no benefit. */
      .card__value { font-size: 26px; font-weight: 600; letter-spacing: -.02em; line-height: 32px; height: 32px; font-variant-numeric: tabular-nums; }
      .card__meta { font-size: 13px; color: var(--text-faint); margin-top: 6px; margin-bottom: 0; min-height: 20px; }
      .card__label + .card__value { margin-top: auto; }

      /* --- buttons --- */
      .btn {
        display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px;
        border-radius: var(--r-sm); font: 500 14px var(--sans); text-decoration: none;
        background: var(--surface-3); color: var(--text); border: 1px solid var(--border);
      }
      .btn:hover { border-color: var(--text-faint); }
      /* display:inline-flex on .btn outranks the UA rule for [hidden], so a hidden button
         would still render. Any element carrying the attribute must stay hidden. */
      [hidden] { display: none !important; }
      .btn--primary { background: var(--accent); color: var(--on-accent); border-color: transparent; font-weight: 600; }
      .btn--primary:hover { filter: brightness(1.08); }

      .banner {
        display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
        background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md);
        padding: 16px 18px; margin: 12px 0 8px;
      }
      .banner__title { font-weight: 600; }
      .banner__sub { font-size: 13px; color: var(--text-dim); }
      .banner .btn { margin-left: auto; }

      /* --- calculator form: shared by every /tools page --------------------------
         One control class across all five calculators, so a tool never invents its
         own field geometry. Result cards reuse .card; the lead card is the correct
         answer and carries the accent, the naive one sits beside it dimmed.
         --------------------------------------------------------------------------- */
      .calc {
        display: flex; flex-wrap: wrap; gap: 14px; align-items: end;
        background: var(--surface-2); border: 1px solid var(--border-soft);
        border-radius: var(--r-md); padding: 18px;
      }
      .calc label { display: grid; gap: 6px; font-size: 13px; color: var(--text-dim); }
      .calc input, .calc select {
        height: 40px; min-width: 148px; padding: 0 12px; font: 14px var(--sans); color: var(--text);
        background: var(--surface-3); border: 1px solid var(--border); border-radius: var(--r-sm);
        font-variant-numeric: tabular-nums;
      }
      .calc input:focus, .calc select:focus { outline: 0; border-color: var(--accent); }
      .card--lead { border-color: var(--accent); }
      .card--lead .card__value { color: var(--accent); }
      .tbl .is-active { background: var(--surface-3); }
      /* A verdict line: the sentence that says which of the two answers you should act on. */
      .verdict {
        display: flex; gap: 12px; align-items: flex-start; max-width: 760px; margin: 16px 0 0;
        padding: 14px 16px; border-radius: var(--r-md);
        background: var(--surface-2); border: 1px solid var(--border-soft);
      }
      .verdict--warn { border-left: 3px solid var(--pays-l); }
      .verdict--ok { border-left: 3px solid var(--accent); }
      .verdict b { font-weight: 600; }

      .chip { display: inline-block; font-size: 12px; color: var(--text-dim); background: var(--surface-3); border-radius: 6px; padding: 2px 8px; }

      /* ==========================================================================
         DATA GRID — deliberately denser than the chrome around it
         ========================================================================== */
      .panel { background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md); overflow: hidden; }

      /* --- empty state -----------------------------------------------------------
         Sits on the spacious side of the split, like Drive's empty-folder state:
         a quiet icon tile, a title, one sentence, and — where the wait is finite —
         what is being collected and when it resolves. An empty state that explains
         itself is a trust statement; three dim paragraphs are an unfinished page.
         --------------------------------------------------------------------------- */
      .empty {
        display: flex; gap: 16px; align-items: flex-start; max-width: 760px; padding: 22px;
        background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md);
      }
      .empty__icon {
        flex: 0 0 40px; width: 40px; height: 40px; display: grid; place-items: center;
        border-radius: var(--r-pill); background: var(--surface-3); color: var(--text-dim);
      }
      .empty__body { min-width: 0; }
      .empty__title { font-size: 15px; font-weight: 600; margin: 2px 0 6px; }
      .empty__text { color: var(--text-dim); margin: 0; max-width: 64ch; }
      .empty__meta { margin: 14px 0 0; font-size: 13px; color: var(--text-faint); }
      .empty__meta b { color: var(--text); font-weight: 500; font-variant-numeric: tabular-nums; }
      /* Progress is server-computed and written inline, so it paints at first byte
         and never animates into place. */
      .empty__track { height: 4px; border-radius: 2px; background: var(--surface-3); margin: 14px 0 0; overflow: hidden; }
      .empty__fill { height: 100%; background: var(--accent); border-radius: 2px; }
      table.tbl { border-collapse: collapse; width: 100%; font-size: 13px; }
      .tbl th {
        font-size: 12px; font-weight: 500; color: var(--text-faint); text-align: left;
        padding: 10px 14px; background: var(--surface-3); border-bottom: 1px solid var(--border-soft); white-space: nowrap;
      }
      .tbl td { padding: 7px 14px; border-bottom: 1px solid var(--border-soft); }
      .tbl tbody tr:last-child td { border-bottom: 0; }
      .tbl th.num, .tbl td.num { text-align: right; }
      .tbl tbody tr:hover { background: var(--surface-3); }
      .tbl tbody tr.is-active:hover { background: #333941; }
      .tbl td a { text-decoration: none; font-weight: 500; }
      .tbl td a:hover { color: var(--accent); }
      .tbl .sym { font-weight: 600; }

      /* quiet in-row magnitude — CSS only, no charting dependency */
      .magnitude { display: flex; align-items: center; gap: 10px; justify-content: flex-end; }
      .magnitude__track { flex: 0 0 56px; height: 4px; border-radius: 2px; background: var(--surface-3); overflow: hidden; }
      .magnitude__fill { display: block; height: 100%; border-radius: 2px; background: var(--text-faint); }

      .legend { font-size: 12.5px; color: var(--text-faint); margin: 0 0 10px; }
      .legend b { font-weight: 500; }

      footer { margin-top: 40px; padding: 20px 0 0; color: var(--text-faint); font-size: 13px; }
      footer nav { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 12px; }
      footer a { text-decoration: none; }
      footer a:hover { color: var(--text); }

      /* ==========================================================================
         INTERACTION LAYER
         Everything here is presentation. No value on the page comes from JS.
         ========================================================================== */

      /* --- tooltip: one element, reused by every chart --- */
      .tip {
        position: fixed; top: 0; left: 0; z-index: 60; pointer-events: none;
        min-width: 168px; padding: 11px 13px;
        background: color-mix(in srgb, var(--surface-2) 92%, black);
        border: 1px solid var(--border); border-radius: var(--r-md);
        box-shadow: 0 10px 30px rgba(0,0,0,.5), 0 2px 6px rgba(0,0,0,.4);
        font-size: var(--fs-sm); color: var(--text); line-height: 1.45;
        opacity: 0; transition: opacity .12s var(--ease);
        font-variant-numeric: tabular-nums;
      }
      .tip[data-on] { opacity: 1; }
      .tip__h { font-size: var(--fs-xs); color: var(--text-faint); margin-bottom: 7px; }
      .tip__g { display: grid; grid-template-columns: auto auto; gap: 3px 18px; }
      .tip__g span { color: var(--text-dim); }
      .tip__g b { font-weight: 600; text-align: right; }
      .tip__f { margin-top: 7px; padding-top: 7px; border-top: 1px solid var(--border-soft); font-size: var(--fs-xs); color: var(--text-faint); }

      /* --- crosshair ---
         The furniture itself is styled INLINE inside the generated SVG (see chart.ts) —
         a class here would not reach it. All that belongs in this stylesheet is the
         cursor, the touch behaviour, and the fade, which apply to the host element. */
      svg[data-xhair], svg[data-heat] { cursor: crosshair; touch-action: none; }
      svg[data-xhair] [data-xh="g"], svg[data-heat] [data-xh="g"] { transition: opacity .13s var(--ease); }
      svg[data-xhair] [data-ax], svg[data-heat] [data-ax] { transition: opacity .16s var(--ease); }
      /* On a touch screen the chart has to be pannable, so the browser keeps the gesture and
         a tap — not a drag — is what places the readout. */
      @media (pointer: coarse) { svg[data-xhair], svg[data-heat] { touch-action: pan-x pan-y; } }

      /* --- the chart well sits inside the card, one step darker ---
         No line-height:0 and no overflow:hidden here: the well's rounded corner is drawn by
         the SVG's own background rect, and a figure.chart with a caption inside must keep
         normal line spacing. Collapsing it stacked caption lines on top of each other. */
      .chart { position: relative; margin: 0; }
      /* A 1260-wide chart squeezed into 336px is 158px tall: one pixel per heatmap row and
         a candle narrower than its own wick. Below the breakpoint the chart keeps a legible
         size and the container scrolls instead. */
      @media (max-width: 760px) {
        .chart {
          overflow-x: auto; overscroll-behavior-x: contain;
          /* Both edges fade: the chart opens scrolled to the newest bars, so there is more of
             it to the LEFT, and a right-only cue would point the wrong way. */
          -webkit-mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent);
                  mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent);
        }
        /* 720px put the axis type at 6.3 CSS px. 1140 keeps it at ~10px, which is the whole
           point of scrolling rather than scaling. */
        .chart > svg, .chart > figure > svg, figure.chart > svg { min-width: 1140px; }
      }
      .chart > svg, .chart > figure > svg, .chart__scroll > svg { display: block; width: 100%; height: auto; }
      figure.chart > figcaption { font-size: 13px; color: var(--text-faint); margin-top: 10px; max-width: 84ch; line-height: 1.55; }

      /* --- table rows respond, and the magnitude bar responds with them --- */
      .tbl tbody tr { transition: background .12s var(--ease); }
      .tbl tbody tr:hover .magnitude__fill { background: var(--accent); }
      .tbl tbody tr:hover .magnitude__track { background: var(--surface-1); }
      .magnitude__fill { transition: background .14s var(--ease), width .3s var(--ease); }

      /* --- timeframe group: the active control has depth, the rest are quiet --- */
      .tf { display: inline-flex; gap: 2px; padding: 3px; background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-pill); }
      .tf button {
        appearance: none; border: 0; background: none; cursor: pointer;
        font: 600 var(--fs-sm)/1 var(--sans); color: var(--text-dim);
        padding: 8px 15px; border-radius: var(--r-pill);
        transition: background .16s var(--ease), color .16s var(--ease), box-shadow .16s var(--ease);
      }
      .tf button:hover { color: var(--text); background: var(--surface-3); }
      .tf button[aria-pressed="true"] {
        background: var(--accent-fill); color: var(--accent);
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
      }

      /* --- timeframe panels: cross-fade rather than snap --- */
      [data-tfpanel] { display: none; }
      [data-tfpanel][data-on] { display: block; animation: tfin .22s var(--ease); }
      @keyframes tfin { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
      [data-tfstat][data-swap] { opacity: 0; transform: translateY(-3px); }
      [data-tfstat] { transition: opacity .11s var(--ease), transform .11s var(--ease); display: inline-block; }

      /* --- hero figure: the one number a page is about --- */
      .hero { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin: 2px 0 4px; }
      .hero__price { font-size: var(--fs-hero); font-weight: 650; letter-spacing: -.032em; line-height: 1.05; font-variant-numeric: tabular-nums; }
      .hero__chg { font-size: var(--fs-lg); font-weight: 600; color: var(--text-dim); font-variant-numeric: tabular-nums; }
      .hero__meta { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 10px; font-size: var(--fs-sm); color: var(--text-faint); }
      .hero__meta b { display: block; color: var(--text); font-weight: 600; font-size: var(--fs-md); font-variant-numeric: tabular-nums; margin-top: 2px; }

      @media (prefers-reduced-motion: reduce) {
        * { animation-duration: .01ms !important; transition-duration: .01ms !important; }
      }

      /* --- mobile: same anchors, re-laid-out. Never a second DOM copy. --- */
      .tabbar { display: none; }
      @media (max-width: 900px) {
        .app, .app.is-collapsed { grid-template-columns: minmax(0,1fr); }
        .rail { display: none; }
        .topbar { padding: 0 16px; }
        .page { margin: 0 12px 12px; padding: 16px 14px calc(var(--tabbar-h) + 24px); min-height: 0; }
        /* Narrow viewports drop the relative timestamp and keep the clock, so the
           cluster stays two even 40px controls instead of one wide pill + one round. */
        .freshness { padding: 0; width: 40px; justify-content: center; gap: 0; }
        .freshness span { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        .cta { padding: 0; width: 40px; justify-content: center; }
        .cta__label { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        .tabbar {
          display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
          position: fixed; inset-inline: 0; bottom: 0; height: var(--tabbar-h); z-index: 20;
          background: var(--surface-1); border-top: 1px solid var(--border-soft);
        }
        .tabbar a { display: grid; place-items: center; gap: 3px; text-decoration: none; color: var(--text-faint); font-size: 11px; }
        .tabbar a[aria-current="page"] { color: var(--accent); }
      }
    </style>
  </head>
  <body>
    <div class:list={["app", { "is-collapsed": collapsed }]}>
      <!-- ONE nav element. The mobile bar below reuses these same anchors via CSS. -->
      <nav class="rail" aria-label="Main">
        <div class="rail__top">
          <form method="POST" action="/rail" style="display:contents">
            <button class="icon-btn" type="submit" name="collapsed" value={collapsed ? "0" : "1"}
                    aria-label={collapsed ? "Expand navigation" : "Collapse navigation"}>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
            </button>
          </form>
          <a class="brand" href="/"><span>{SITE.name}</span></a>
        </div>

        {NAV.map((group) => (
          <div class="nav-group">
            <div class="nav-group__title">{group.title}</div>
            {group.items.map((item) =>
              item.href ? (
                <a class="nav-item" href={item.href} title={item.label} aria-current={isActive(item.href) ? "page" : undefined}>
                  <svg class="nav-item__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
                  <span class="nav-item__label">{item.label}</span>
                </a>
              ) : (
                <span class="nav-item" title={`${item.label} — not built yet`}>
                  <svg class="nav-item__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
                  <span class="nav-item__label">{item.label}</span>
                  <span class="nav-item__soon">soon</span>
                </span>
              ),
            )}
          </div>
        ))}
      </nav>

      <div class="col">
        <header class="topbar">
          <div class="search">
            <label class="vh" for="q">Search</label>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="5.5" /><path d="m13 13 4 4" /></svg>
            <input id="q" type="search" autocomplete="off" placeholder="Search token, chain, unlock, protocol" />
            <div class="search__results" id="qr"></div>
          </div>
          <div class="topbar__end">
            {ageMin !== null && (
              <div class="freshness">
                {/* A clock, not a status dot. The dot here was green — the one colour the
                    site's own legend reserves for "shorts pay longs" — so it was making a
                    semantic claim it did not mean. */}
                <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.25" /><path d="M10 6v4.2l2.6 1.8" /></svg>
                <span>Updated <time datetime={new Date(fetchedAt!).toISOString()} data-fresh={fetchedAt}>{ageMin === 0 ? "just now" : `${ageMin} min ago`}</time></span>
              </div>
            )}
            <a class="btn btn--primary cta" href="/watchlist" aria-current={path === "/watchlist" ? "page" : undefined}>
              <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3.2l2.1 4.3 4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7L3.2 8.2l4.7-.7z" /></svg>
              <span class="cta__label">Pin contracts</span>
            </a>
          </div>
        </header>

        <main class="page">
          <slot />
          <footer>
            <nav aria-label="Footer">{FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
            <p style="margin:0">
              Market data via Hyperliquid. Not investment advice.
              {fetchedAt && <> Figures as of <time datetime={new Date(fetchedAt).toISOString()}>{new Date(fetchedAt).toISOString().replace("T", " ").slice(0, 16)} UTC</time>.</>}
            </p>
          </footer>
        </main>
      </div>
    </div>

    <nav class="tabbar" aria-label="Main mobile">
      {NAV.flatMap((g) => g.items).filter((i) => i.mobile && i.href).map((item) => (
        <a href={item.href!} aria-current={isActive(item.href!) ? "page" : undefined}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <script type="module" src="/typeahead.js"></script>
    <script type="module" src="/interact.js"></script>
  </body>
</html>
