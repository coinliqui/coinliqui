---
import { SITE, NAV, FOOTER_LINKS } from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
  fetchedAt?: number;
}
const { title, description, fetchedAt } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));

// Rail state is decided on the SERVER from a cookie: no flash, no layout shift, and a
// crawler (which sends no cookie) always receives the expanded rail with visible labels.
const collapsed = Astro.cookies.get("rail")?.value === "0";
const ageMin = fetchedAt ? Math.max(0, Math.round((Date.now() - fetchedAt) / 60000)) : null;

// WebSite carries name/url/alternateName only. SearchAction is deliberately absent —
// Google removed the sitelinks searchbox on 2024-11-21 and no other consumer parses it.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: SITE.name, alternateName: `${SITE.name} — ${SITE.tagline}`, url: SITE.url },
    { "@type": "Organization", name: SITE.name, url: SITE.url },
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, SITE.url).href} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      /* ==========================================================================
         DESIGN TOKENS
         Application-shell feel: neutral dark greys, quiet steps, rounded geometry,
         one restrained accent. Chrome is spacious; data grids are dense.
         ========================================================================== */
      :root {
        /* surfaces — three quiet steps, never pure black (YouTube/Drive/Gemini dark) */
        --bg:        #16181b;
        --surface-1: #1c1f23;   /* rail, topbar */
        --surface-2: #212529;   /* cards, panels */
        --surface-3: #2a2f35;   /* hover, inputs, chips */
        --border:    #2e343b;
        --border-soft: #262b31;

        /* text */
        --text:  #e6e8ec;
        --text-dim:   #9aa1ab;
        --text-faint: #6c737d;

        /* one accent — active nav, links, primary action. Nowhere else. */
        --accent:       #8ab4f8;
        --accent-fill:  rgba(138,180,248,.15);
        --on-accent:    #17191c;

        /* semantic — direction of funding payment ONLY */
        --pays-l: #ef6b5e;   /* longs pay shorts */
        --pays-s: #58c48c;   /* shorts pay longs */

        /* radius */
        --r-sm: 8px; --r-md: 12px; --r-pill: 999px;

        /* shell metrics — comfortable, reference-set sized */
        --rail-w: 260px; --rail-w-collapsed: 72px; --topbar-h: 60px; --tabbar-h: 58px;

        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --mono: ui-monospace, "SF Mono", Menlo, monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg); color: var(--text);
        font: 14px/1.55 var(--sans);
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      }
      a { color: inherit; }
      ::selection { background: var(--accent-fill); }

      /* Monospace appears ONLY inside numeric cells, for figure alignment — never as a
         design language. Widths are reserved so live updates cannot shift layout. */
      .num { font-family: var(--mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
      .pays-l { color: var(--pays-l); }
      .pays-s { color: var(--pays-s); }
      .dim { color: var(--text-dim); }
      .faint { color: var(--text-faint); }

      /* ==========================================================================
         SHELL
         ========================================================================== */
      .app { display: grid; grid-template-columns: var(--rail-w) minmax(0,1fr); min-height: 100vh; }
      .app.is-collapsed { grid-template-columns: var(--rail-w-collapsed) minmax(0,1fr); }

      /* --- rail: comfortable rows, soft pill active state (Drive / Gemini) --- */
      .rail { background: var(--surface-1); position: sticky; top: 0; height: 100vh; overflow-y: auto; overflow-x: hidden; padding-bottom: 24px; }
      .rail__top { display: flex; align-items: center; gap: 4px; height: var(--topbar-h); padding: 0 12px; }
      .icon-btn {
        width: 40px; height: 40px; flex: 0 0 40px; display: grid; place-items: center;
        background: none; border: 0; border-radius: var(--r-pill); color: var(--text-dim); cursor: pointer;
      }
      .icon-btn:hover { background: var(--surface-3); color: var(--text); }
      .brand { display: flex; align-items: center; gap: 10px; padding: 0 8px; text-decoration: none; font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
      .brand__mark { width: 22px; height: 22px; flex: 0 0 22px; border-radius: 7px; background: var(--accent); }

      .nav-group { padding: 6px 12px 0; }
      .nav-group__title { font-size: 12px; font-weight: 500; color: var(--text-faint); padding: 10px 16px 4px; }
      .nav-item {
        display: flex; align-items: center; gap: 16px; height: 44px; padding: 0 16px;
        border-radius: var(--r-pill); color: var(--text-dim); text-decoration: none;
        font-size: 14px; font-weight: 500; white-space: nowrap;
      }
      a.nav-item:hover { background: var(--surface-3); color: var(--text); }
      a.nav-item[aria-current="page"] { background: var(--accent-fill); color: var(--accent); }
      a.nav-item[aria-current="page"] .nav-item__icon { color: var(--accent); }
      /* unbuilt: a span, never an anchor — creates no URL and cannot be clicked */
      span.nav-item { color: var(--text-faint); opacity: .72; cursor: default; }
      .nav-item__icon { flex: 0 0 20px; color: var(--text-faint); }
      a.nav-item:hover .nav-item__icon { color: var(--text-dim); }
      .nav-item__soon {
        margin-left: auto; font-size: 11px; font-weight: 500; color: var(--text-faint);
        background: var(--surface-3); border-radius: 6px; padding: 2px 7px;
      }

      /* Collapsed hides labels only; anchors, hrefs and text nodes are untouched.
         1px clip, never off-screen positioning (a named spam-policy example). */
      .vh,
      .is-collapsed .nav-item__label,
      .is-collapsed .nav-item__soon,
      .is-collapsed .nav-group__title,
      .is-collapsed .brand span {
        position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
        border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
      }
      .is-collapsed .nav-item { justify-content: center; padding: 0; width: 48px; margin: 0 auto; }
      /* With labels and the "soon" chip hidden, opacity is the only remaining signal that
         an entry is unbuilt — so it carries more of the weight than in the expanded rail. */
      .is-collapsed span.nav-item { opacity: .34; }
      .is-collapsed .nav-group__title { display: block; height: 8px; }

      /* --- topbar: search pill + freshness, balanced --- */
      .topbar {
        display: flex; align-items: center; gap: 16px; height: var(--topbar-h); padding: 0 24px;
        background: var(--bg); position: sticky; top: 0; z-index: 5;
      }
      .search { flex: 1 1 auto; max-width: 560px; position: relative; display: flex; align-items: center; }
      .search svg { position: absolute; left: 16px; color: var(--text-faint); pointer-events: none; }
      .search input {
        width: 100%; height: 44px; padding: 0 18px 0 46px; font: 14px var(--sans); color: var(--text);
        background: var(--surface-2); border: 1px solid transparent; border-radius: var(--r-pill);
      }
      .search input::placeholder { color: var(--text-faint); }
      .search input:hover { background: var(--surface-3); }
      .search input:focus { outline: 0; background: var(--surface-3); border-color: var(--accent); }
      .freshness {
        margin-left: auto; display: flex; align-items: center; gap: 8px; flex: 0 0 auto;
        font-size: 13px; color: var(--text-dim); background: var(--surface-2);
        border-radius: var(--r-pill); padding: 8px 14px; white-space: nowrap;
      }
      .freshness__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pays-s); }

      .page { padding: 8px 24px 80px; max-width: 1320px; }

      /* --- page header: spacious chrome --- */
      .page-head { margin: 8px 0 24px; }
      .page-head h1 { font-size: 22px; font-weight: 600; letter-spacing: -.015em; margin: 0 0 6px; }
      .page-head p { margin: 0; color: var(--text-dim); max-width: 76ch; }
      .crumb { font-size: 13px; color: var(--text-faint); margin: 0 0 8px; }
      .crumb a { text-decoration: none; }
      .crumb a:hover { color: var(--text); }

      h2.section { font-size: 16px; font-weight: 600; letter-spacing: -.01em; margin: 32px 0 4px; }
      .section-note { font-size: 13px; color: var(--text-faint); margin: 0 0 12px; max-width: 80ch; }
      .prose { max-width: 72ch; color: var(--text-dim); }
      .prose strong { color: var(--text); font-weight: 600; }
      .prose a, .link { color: var(--accent); }
      code { background: var(--surface-2); border-radius: 5px; padding: 1px 6px; font: 12.5px var(--mono); }

      /* --- cards --- */
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px,1fr)); gap: 12px; }
      .card {
        background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md);
        padding: 16px 18px; text-decoration: none; display: block;
      }
      a.card:hover { background: var(--surface-3); }
      .card { display: flex; flex-direction: column; }
      .card__label { font-size: 13px; color: var(--text-dim); margin-bottom: 8px; min-height: 20px; }
      /* The VALUE is the live part, so its line box is fixed — that is what must never
         shift. Label and meta are static copy and may wrap freely; clipping them to a
         fixed height (as an earlier pass did) truncates real text for no benefit. */
      .card__value { font-size: 26px; font-weight: 600; letter-spacing: -.02em; line-height: 32px; height: 32px; font-variant-numeric: tabular-nums; }
      .card__meta { font-size: 13px; color: var(--text-faint); margin-top: 6px; margin-bottom: 0; min-height: 20px; }
      .card__label + .card__value { margin-top: auto; }

      /* --- buttons --- */
      .btn {
        display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px;
        border-radius: var(--r-sm); font: 500 14px var(--sans); text-decoration: none;
        background: var(--surface-3); color: var(--text); border: 1px solid var(--border);
      }
      .btn:hover { border-color: var(--text-faint); }
      .btn--primary { background: var(--accent); color: var(--on-accent); border-color: transparent; font-weight: 600; }
      .btn--primary:hover { filter: brightness(1.08); }

      .banner {
        display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
        background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md);
        padding: 16px 18px; margin: 12px 0 8px;
      }
      .banner__title { font-weight: 600; }
      .banner__sub { font-size: 13px; color: var(--text-dim); }
      .banner .btn { margin-left: auto; }

      .chip { display: inline-block; font-size: 12px; color: var(--text-dim); background: var(--surface-3); border-radius: 6px; padding: 2px 8px; }

      /* ==========================================================================
         DATA GRID — deliberately denser than the chrome around it
         ========================================================================== */
      .panel { background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--r-md); overflow: hidden; }
      table.tbl { border-collapse: collapse; width: 100%; font-size: 13px; }
      .tbl th {
        font-size: 12px; font-weight: 500; color: var(--text-faint); text-align: left;
        padding: 10px 14px; background: var(--surface-1); border-bottom: 1px solid var(--border-soft); white-space: nowrap;
      }
      .tbl td { padding: 7px 14px; border-bottom: 1px solid var(--border-soft); }
      .tbl tbody tr:last-child td { border-bottom: 0; }
      .tbl th.num, .tbl td.num { text-align: right; }
      .tbl tbody tr:hover { background: var(--surface-3); }
      .tbl td a { text-decoration: none; font-weight: 500; }
      .tbl td a:hover { color: var(--accent); }
      .tbl .sym { font-weight: 600; }

      /* quiet in-row magnitude — CSS only, no charting dependency */
      .magnitude { display: flex; align-items: center; gap: 10px; justify-content: flex-end; }
      .magnitude__track { flex: 0 0 56px; height: 4px; border-radius: 2px; background: var(--surface-3); overflow: hidden; }
      .magnitude__fill { display: block; height: 100%; border-radius: 2px; background: var(--text-faint); }

      .legend { font-size: 12.5px; color: var(--text-faint); margin: 0 0 10px; }
      .legend b { font-weight: 500; }

      footer { margin-top: 56px; padding: 20px 0 0; border-top: 1px solid var(--border-soft); color: var(--text-faint); font-size: 13px; }
      footer nav { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 12px; }
      footer a { text-decoration: none; }
      footer a:hover { color: var(--text); }

      /* --- mobile: same anchors, re-laid-out. Never a second DOM copy. --- */
      .tabbar { display: none; }
      @media (max-width: 900px) {
        .app, .app.is-collapsed { grid-template-columns: minmax(0,1fr); }
        .rail { display: none; }
        .topbar { padding: 0 16px; }
        .page { padding: 8px 16px calc(var(--tabbar-h) + 32px); }
        .freshness { padding: 8px 10px; }
        .tabbar {
          display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
          position: fixed; inset-inline: 0; bottom: 0; height: var(--tabbar-h); z-index: 20;
          background: var(--surface-1); border-top: 1px solid var(--border-soft);
        }
        .tabbar a { display: grid; place-items: center; gap: 3px; text-decoration: none; color: var(--text-faint); font-size: 11px; }
        .tabbar a[aria-current="page"] { color: var(--accent); }
      }
    </style>
  </head>
  <body>
    <div class:list={["app", { "is-collapsed": collapsed }]}>
      <!-- ONE nav element. The mobile bar below reuses these same anchors via CSS. -->
      <nav class="rail" aria-label="Main">
        <div class="rail__top">
          <form method="POST" action="/rail" style="display:contents">
            <button class="icon-btn" type="submit" name="collapsed" value={collapsed ? "0" : "1"}
                    aria-label={collapsed ? "Expand navigation" : "Collapse navigation"}>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
            </button>
          </form>
          <a class="brand" href="/"><span class="brand__mark" aria-hidden="true"></span><span>{SITE.name}</span></a>
        </div>

        {NAV.map((group) => (
          <div class="nav-group">
            <div class="nav-group__title">{group.title}</div>
            {group.items.map((item) =>
              item.href ? (
                <a class="nav-item" href={item.href} title={item.label} aria-current={isActive(item.href) ? "page" : undefined}>
                  <svg class="nav-item__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
                  <span class="nav-item__label">{item.label}</span>
                </a>
              ) : (
                <span class="nav-item" title={`${item.label} — not built yet`}>
                  <svg class="nav-item__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
                  <span class="nav-item__label">{item.label}</span>
                  <span class="nav-item__soon">soon</span>
                </span>
              ),
            )}
          </div>
        ))}
      </nav>

      <div>
        <header class="topbar">
          <div class="search">
            <label class="vh" for="q">Search</label>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="5.5" /><path d="m13 13 4 4" /></svg>
            <input id="q" type="search" autocomplete="off" placeholder="Search token, chain, unlock, protocol" />
            <div class="search__results" id="qr"></div>
          </div>
          {ageMin !== null && (
            <div class="freshness">
              <span class="freshness__dot" aria-hidden="true"></span>
              Updated {ageMin === 0 ? "just now" : `${ageMin} min ago`}
            </div>
          )}
        </header>

        <main class="page">
          <slot />
          <footer>
            <nav aria-label="Footer">{FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
            <p style="margin:0">
              Market data via Hyperliquid. Not investment advice.
              {fetchedAt && <> Figures as of <time datetime={new Date(fetchedAt).toISOString()}>{new Date(fetchedAt).toISOString().replace("T", " ").slice(0, 16)} UTC</time>.</>}
            </p>
          </footer>
        </main>
      </div>
    </div>

    <nav class="tabbar" aria-label="Main mobile">
      {NAV.flatMap((g) => g.items).filter((i) => i.mobile && i.href).map((item) => (
        <a href={item.href!} aria-current={isActive(item.href!) ? "page" : undefined}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <script type="module" src="/typeahead.js"></script>
  </body>
</html>
